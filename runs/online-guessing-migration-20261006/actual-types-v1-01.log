project_unitInterval : ∀ (z : ℝ), project BanditRL.OnlineGradientDescent.unitInterval z = min (max z 0) 1
square_regular : ∀ (y : ℝ), RegularLoss BanditRL.OnlineGradientDescent.unitInterval fun x => (x - y) ^ 2
gradient_square : ∀ (y x : ℝ), gradient (fun x => (x - y) ^ 2) x = 2 * (x - y)
gradient_square_bound : ∀ (y x : ℝ), y ∈ Set.Icc 0 1 → x ∈ Set.Icc 0 1 → ‖gradient (fun x => (x - y) ^ 2) x‖ ≤ 2
square_step_clamp : ∀ (η y x : ℝ),
  step BanditRL.OnlineGradientDescent.unitInterval η (fun x => (x - y) ^ 2) x = min (max (x - 2 * η * (x - y)) 0) 1
example_2_14 : ∀ (y : ℕ → ℝ),
  ∀ x0 ∈ Set.Icc 0 1,
    ∀ (T : ℕ),
      0 < T →
        (∀ t < T, y t ∈ Set.Icc 0 1) →
          ∀ u ∈ Set.Icc 0 1,
            regret BanditRL.OnlineGradientDescent.unitInterval (1 / (2 * √↑T)) (fun t x => (x - y t) ^ 2) x0 u T ≤
              2 * √↑T
guessing_zero_trajectory : ∀ (n : ℕ),
  0 < n →
    ∀ (t : ℕ),
      iterate BanditRL.OnlineGradientDescent.unitInterval (1 / (4 * ↑n)) (fun x x_1 => (x_1 - 0) ^ 2) 1 t =
        (1 - 1 / (2 * ↑n)) ^ t
guessing_tuned_eta_square : ∀ (n : ℕ), 1 / (2 * √↑((2 * n) ^ 2)) = 1 / (4 * ↑n)
guessing_squared_horizon_lower : ∀ (n : ℕ),
  0 < n →
    ↑n / 4 ≤
      regret BanditRL.OnlineGradientDescent.unitInterval (1 / (2 * √↑((2 * n) ^ 2))) (fun x x_1 => (x_1 - 0) ^ 2) 1 0
        ((2 * n) ^ 2)
BanditRL.OnlineGradientDescent.unitInterval : Domain ℝ
@iterate_prefix : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E]
  [inst_2 : CompleteSpace E] (V : Domain E) (η : ℝ) (loss loss' : ℕ → E → ℝ) (x₁ : E) (t : ℕ),
  (∀ s < t, loss s = loss' s) → iterate V η loss x₁ t = iterate V η loss' x₁ t
@equation_2_1 : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E]
  [inst_2 : CompleteSpace E] (V : Domain E) (loss : ℕ → E → ℝ),
  ∀ x₁ ∈ V.carrier,
    ∀ (T : ℕ),
      0 < T →
        ∀ (D G : ℝ),
          0 < D →
            0 < G →
              (∀ x ∈ V.carrier, ∀ y ∈ V.carrier, ‖x - y‖ ≤ D) →
                (∀ t < T, RegularLoss V (loss t)) →
                  (∀ t < T, ‖gradient (loss t) (iterate V (D / (G * √↑T)) loss x₁ t)‖ ≤ G) →
                    ∀ u ∈ V.carrier, regret V (D / (G * √↑T)) loss x₁ u T ≤ D * G * √↑T
BanditRL.OnlineLearning.meanPredict : (ℕ → ℝ) → ℕ → ℝ
BanditRL.OnlineLearning.meanPredict_prefix : ∀ (y z : ℕ → ℝ) (t : ℕ),
  (∀ i < t, y i = z i) → BanditRL.OnlineLearning.meanPredict y t = BanditRL.OnlineLearning.meanPredict z t
BanditRL.OnlineLearning.theorem_1_3 : ∀ (y : ℕ → ℝ) (T : ℕ),
  0 < T →
    (∀ t < T, y t ∈ Set.Icc 0 1) →
      ∑ t ∈ Finset.range T, (BanditRL.OnlineLearning.meanPredict y t - y t) ^ 2 -
          ∑ t ∈ Finset.range T, (BanditRL.OnlineLearning.empiricalMean y T - y t) ^ 2 ≤
        4 + 4 * Real.log ↑T
BanditRL.OnlineLearning.empiricalMean : (ℕ → ℝ) → ℕ → ℝ
@exists_nat_gt : ∀ {R : Type u_1} [inst : Semiring R] [inst_1 : PartialOrder R] [IsStrictOrderedRing R] [Archimedean R]
  (x : R), ∃ n, x < ↑n
@sum_ite_eq : ∀ {ι : Type u_1} {M : Type u_2} [inst : AddCommMonoid M] [inst_1 : DecidableEq ι] (s : Finset ι) (a : ι)
  (b : ι → M), (∑ x ∈ s, if a = x then b x else 0) = if a ∈ s then b a else 0
@sum_ite_eq' : ∀ {ι : Type u_1} {M : Type u_2} [inst : AddCommMonoid M] [inst_1 : DecidableEq ι] (s : Finset ι) (a : ι)
  (b : ι → M), (∑ x ∈ s, if x = a then b x else 0) = if a ∈ s then b a else 0
@Finset.mem_range : ∀ {n m : ℕ}, m ∈ Finset.range n ↔ m < n
∀ (T : ℕ), 0 < T → ∑ t ∈ Finset.range T, BanditRL.OnlineLearning.meanPredict (fun x => 0) t ^ 2 = 1 / 4 : Prop
∀ (n : ℕ),
  0 < n →
    ↑n / 4 - 1 / 4 ≤
      regret BanditRL.OnlineGradientDescent.unitInterval (1 / (2 * √↑((2 * n) ^ 2))) (fun x x_1 => (x_1 - 0) ^ 2) 1 0
          ((2 * n) ^ 2) -
        ∑ t ∈ Finset.range ((2 * n) ^ 2), BanditRL.OnlineLearning.meanPredict (fun x => 0) t ^ 2 : Prop
∀ (C : ℝ) (N : ℕ),
  ∃ n,
    N < n ∧
      C <
        regret BanditRL.OnlineGradientDescent.unitInterval (1 / (2 * √↑((2 * n) ^ 2))) (fun x x_1 => (x_1 - 0) ^ 2) 1 0
            ((2 * n) ^ 2) -
          ∑ t ∈ Finset.range ((2 * n) ^ 2), BanditRL.OnlineLearning.meanPredict (fun x => 0) t ^ 2 : Prop
