  ∀ (T : ℕ),
    0 < T →
      ∑ t ∈ Finset.range T,
              BanditRL.OnlineLearning.failureCoefficient t *
                BanditRL.OnlineLearning.linearFTLPredict BanditRL.OnlineLearning.failureCoefficient x0 t -
