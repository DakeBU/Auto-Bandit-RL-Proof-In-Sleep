  "statement": "theorem energy_scaling (c : ℝ) (hc : 0 < c) (η : ℕ → ℝ) (loss : ℕ → E → EReal) (x₁ : E) (p : SupportPolicy (E := E)) (T : ℕ) : (∑ t ∈ range T, ‖selected V (scaledEta c η) (fun s => scaledLoss c (loss s)) (c⁻¹ • x₁) (scaledPolicy c p) t‖ ^ 2) = c ^ 2 * (∑ t ∈ range T, ‖selected V η loss x₁ p t‖ ^ 2)",
