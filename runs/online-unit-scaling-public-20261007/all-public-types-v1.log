          (BanditRL.OnlineUnitScaling.scaledEta 1000 UnitScalingProbe.eta)
          (fun s => BanditRL.OnlineUnitScaling.scaledLoss 1000 (UnitScalingProbe.loss s)) (1000⁻¹ • 0)
