@BanditRL.OnlineUnitScaling.unit_exponents : ∀ {D : Type u_1} [inst : AddCommGroup D] (X L H : D),
  H + (L - X) = X → H = X + X - L
@BanditRL.OnlineUnitScaling.regret_unit_exponents : ∀ {D : Type u_1} [inst : AddCommGroup D] (X L : D),
  X + X - (X + X - L) = L ∧ X + X - L + (L - X) + (L - X) = L
@BanditRL.OnlineUnitScaling.inverse_loss : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [FiniteDimensional ℝ E] (c : ℝ),
  0 < c → ∀ (f : E → EReal), BanditRL.OnlineUnitScaling.scaledLoss c⁻¹ (BanditRL.OnlineUnitScaling.scaledLoss c f) = f
@BanditRL.OnlineUnitScaling.proper_scaled_loss : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [FiniteDimensional ℝ E] (c : ℝ),
  0 < c →
    ∀ (f : E → EReal),
      BanditRL.OnlineConvex.SourceProper f →
        BanditRL.OnlineConvex.SourceProper (BanditRL.OnlineUnitScaling.scaledLoss c f)
@BanditRL.OnlineUnitScaling.subgradient_scaled : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [FiniteDimensional ℝ E] (c : ℝ),
  0 < c →
    ∀ (f : E → EReal),
      BanditRL.OnlineConvex.SourceProper f →
        ∀ (y g : E),
          g ∈ BanditRL.OnlineConvex.SourceSubdifferential f (c • y) →
            c • g ∈ BanditRL.OnlineConvex.SourceSubdifferential (BanditRL.OnlineUnitScaling.scaledLoss c f) y
@BanditRL.OnlineUnitScaling.subdifferentiable_scaled : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [FiniteDimensional ℝ E] (c : ℝ),
  0 < c →
    ∀ (f : E → EReal),
      BanditRL.OnlineSubgradientDescent.SubdifferentiableOn BanditRL.OnlineUnitScaling.V f →
        BanditRL.OnlineSubgradientDescent.SubdifferentiableOn BanditRL.OnlineUnitScaling.V
          (BanditRL.OnlineUnitScaling.scaledLoss c f)
@BanditRL.OnlineUnitScaling.hasGradientAt_scaled : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (c : ℝ) (f : E → ℝ) (y g : E),
  HasGradientAt f g (c • y) → HasGradientAt (fun z => f (c • z)) (c • g) y
@BanditRL.OnlineUnitScaling.gradient_scaled : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (c : ℝ) (f : E → ℝ) (y : E),
  DifferentiableAt ℝ f (c • y) → gradient (fun z => f (c • z)) y = c • gradient f (c • y)
@BanditRL.OnlineUnitScaling.step_scaling : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [FiniteDimensional ℝ E] (c : ℝ),
  0 < c → ∀ (η : ℝ) (x g : E), c⁻¹ • (x - η • g) = c⁻¹ • x - (η / c ^ 2) • c • g
@BanditRL.OnlineUnitScaling.wrong_step_scaling : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [FiniteDimensional ℝ E] (c : ℝ),
  0 < c → ∀ (η : ℝ) (x g : E), c • (c⁻¹ • x - η • c • g) = x - (c ^ 2 * η) • g
BanditRL.OnlineUnitScaling.scaled_eta_positive : ∀ (c : ℝ),
  0 < c → ∀ (η : ℕ → ℝ) (t : ℕ), 0 < η t → 0 < BanditRL.OnlineUnitScaling.scaledEta c η t
@BanditRL.OnlineUnitScaling.history_scaling : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (c : ℝ),
  0 < c →
    ∀ (η : ℕ → ℝ) (loss : ℕ → E → EReal) (x₁ : E) (p : BanditRL.OnlineSubgradientPolicy.SupportPolicy) (t : ℕ),
      BanditRL.OnlineSubgradientPolicy.history BanditRL.OnlineUnitScaling.V (BanditRL.OnlineUnitScaling.scaledEta c η)
          (fun s => BanditRL.OnlineUnitScaling.scaledLoss c (loss s)) (c⁻¹ • x₁)
          (BanditRL.OnlineUnitScaling.scaledPolicy c p) t =
        fun i => c⁻¹ • BanditRL.OnlineSubgradientPolicy.history BanditRL.OnlineUnitScaling.V η loss x₁ p t i
@BanditRL.OnlineUnitScaling.output_scaling : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (c : ℝ),
  0 < c →
    ∀ (η : ℕ → ℝ) (loss : ℕ → E → EReal) (x₁ : E) (p : BanditRL.OnlineSubgradientPolicy.SupportPolicy) (t : ℕ),
      BanditRL.OnlineSubgradientPolicy.output BanditRL.OnlineUnitScaling.V (BanditRL.OnlineUnitScaling.scaledEta c η)
          (fun s => BanditRL.OnlineUnitScaling.scaledLoss c (loss s)) (c⁻¹ • x₁)
          (BanditRL.OnlineUnitScaling.scaledPolicy c p) t =
        c⁻¹ • BanditRL.OnlineSubgradientPolicy.output BanditRL.OnlineUnitScaling.V η loss x₁ p t
@BanditRL.OnlineUnitScaling.selected_scaling : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (c : ℝ),
  0 < c →
    ∀ (η : ℕ → ℝ) (loss : ℕ → E → EReal) (x₁ : E) (p : BanditRL.OnlineSubgradientPolicy.SupportPolicy) (t : ℕ),
      BanditRL.OnlineSubgradientPolicy.selected BanditRL.OnlineUnitScaling.V (BanditRL.OnlineUnitScaling.scaledEta c η)
          (fun s => BanditRL.OnlineUnitScaling.scaledLoss c (loss s)) (c⁻¹ • x₁)
          (BanditRL.OnlineUnitScaling.scaledPolicy c p) t =
        c • BanditRL.OnlineSubgradientPolicy.selected BanditRL.OnlineUnitScaling.V η loss x₁ p t
@BanditRL.OnlineUnitScaling.legal_feedback_scaling : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (c : ℝ),
  0 < c →
    ∀ (η : ℕ → ℝ) (loss : ℕ → E → EReal) (x₁ : E) (p : BanditRL.OnlineSubgradientPolicy.SupportPolicy) (T : ℕ),
      (∀ t < T, BanditRL.OnlineConvex.SourceProper (loss t)) →
        BanditRL.OnlineSubgradientPolicy.LegalFeedback BanditRL.OnlineUnitScaling.V η loss x₁ p T →
          BanditRL.OnlineSubgradientPolicy.LegalFeedback BanditRL.OnlineUnitScaling.V
            (BanditRL.OnlineUnitScaling.scaledEta c η) (fun s => BanditRL.OnlineUnitScaling.scaledLoss c (loss s))
            (c⁻¹ • x₁) (BanditRL.OnlineUnitScaling.scaledPolicy c p) T
@BanditRL.OnlineUnitScaling.loss_value_scaling : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (c : ℝ),
  0 < c →
    ∀ (η : ℕ → ℝ) (loss : ℕ → E → EReal) (x₁ : E) (p : BanditRL.OnlineSubgradientPolicy.SupportPolicy) (t : ℕ),
      BanditRL.OnlineUnitScaling.scaledLoss c (loss t)
          (BanditRL.OnlineSubgradientPolicy.output BanditRL.OnlineUnitScaling.V
            (BanditRL.OnlineUnitScaling.scaledEta c η) (fun s => BanditRL.OnlineUnitScaling.scaledLoss c (loss s))
            (c⁻¹ • x₁) (BanditRL.OnlineUnitScaling.scaledPolicy c p) t) =
        loss t (BanditRL.OnlineSubgradientPolicy.output BanditRL.OnlineUnitScaling.V η loss x₁ p t)
@BanditRL.OnlineUnitScaling.regret_scaling : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (c : ℝ),
  0 < c →
    ∀ (η : ℕ → ℝ) (loss : ℕ → E → EReal) (x₁ : E) (p : BanditRL.OnlineSubgradientPolicy.SupportPolicy) (u : E) (T : ℕ),
      BanditRL.OnlineSubgradientPolicy.regret BanditRL.OnlineUnitScaling.V (BanditRL.OnlineUnitScaling.scaledEta c η)
          (fun s => BanditRL.OnlineUnitScaling.scaledLoss c (loss s)) (c⁻¹ • x₁)
          (BanditRL.OnlineUnitScaling.scaledPolicy c p) (c⁻¹ • u) T =
        BanditRL.OnlineSubgradientPolicy.regret BanditRL.OnlineUnitScaling.V η loss x₁ p u T
@BanditRL.OnlineUnitScaling.wrong_step_output : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (c : ℝ),
  0 < c →
    ∀ (η : ℕ → ℝ) (loss : ℕ → E → EReal) (x₁ : E) (p : BanditRL.OnlineSubgradientPolicy.SupportPolicy) (t : ℕ),
      c •
          BanditRL.OnlineSubgradientPolicy.output BanditRL.OnlineUnitScaling.V η
            (fun s => BanditRL.OnlineUnitScaling.scaledLoss c (loss s)) (c⁻¹ • x₁)
            (BanditRL.OnlineUnitScaling.scaledPolicy c p) t =
        BanditRL.OnlineSubgradientPolicy.output BanditRL.OnlineUnitScaling.V (fun s => c ^ 2 * η s) loss x₁ p t
@BanditRL.OnlineUnitScaling.distance_square_scaling : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [FiniteDimensional ℝ E] (c : ℝ),
  0 < c → ∀ (x u : E), ‖c⁻¹ • x - c⁻¹ • u‖ ^ 2 = ‖x - u‖ ^ 2 / c ^ 2
@BanditRL.OnlineUnitScaling.energy_scaling : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (c : ℝ),
  0 < c →
    ∀ (η : ℕ → ℝ) (loss : ℕ → E → EReal) (x₁ : E) (p : BanditRL.OnlineSubgradientPolicy.SupportPolicy) (T : ℕ),
      ∑ t ∈ Finset.range T,
          ‖BanditRL.OnlineSubgradientPolicy.selected BanditRL.OnlineUnitScaling.V
                (BanditRL.OnlineUnitScaling.scaledEta c η) (fun s => BanditRL.OnlineUnitScaling.scaledLoss c (loss s))
                (c⁻¹ • x₁) (BanditRL.OnlineUnitScaling.scaledPolicy c p) t‖ ^
            2 =
        c ^ 2 *
          ∑ t ∈ Finset.range T,
            ‖BanditRL.OnlineSubgradientPolicy.selected BanditRL.OnlineUnitScaling.V η loss x₁ p t‖ ^ 2
BanditRL.OnlineUnitScaling.upper_bound_scaling : ∀ (c : ℝ),
  0 < c →
    ∀ (A B η : ℝ),
      0 < η →
        BanditRL.OnlineOptimalStep.upperBound (A / c ^ 2) (c ^ 2 * B) (η / c ^ 2) =
          BanditRL.OnlineOptimalStep.upperBound A B η
@BanditRL.OnlineUnitScaling.regret_fixed_scaled : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (c : ℝ),
  0 < c →
    ∀ (η : ℝ),
      0 < η →
        ∀ (loss : ℕ → E → EReal) (x₁ : E) (p : BanditRL.OnlineSubgradientPolicy.SupportPolicy) (T : ℕ),
          (∀ t < T, BanditRL.OnlineSubgradientDescent.SubdifferentiableOn BanditRL.OnlineUnitScaling.V (loss t)) →
            BanditRL.OnlineSubgradientPolicy.LegalFeedback BanditRL.OnlineUnitScaling.V (fun x => η) loss x₁ p T →
              ∀ (u : E),
                BanditRL.OnlineSubgradientPolicy.regret BanditRL.OnlineUnitScaling.V
                    (BanditRL.OnlineUnitScaling.scaledEta c fun x => η)
                    (fun s => BanditRL.OnlineUnitScaling.scaledLoss c (loss s)) (c⁻¹ • x₁)
                    (BanditRL.OnlineUnitScaling.scaledPolicy c p) (c⁻¹ • u) T ≤
                  ‖x₁ - u‖ ^ 2 / (2 * η) +
                      η / 2 *
                        ∑ t ∈ Finset.range T,
                          ‖BanditRL.OnlineSubgradientPolicy.selected BanditRL.OnlineUnitScaling.V (fun x => η) loss x₁ p
                                t‖ ^
                            2 -
                    ‖BanditRL.OnlineSubgradientPolicy.output BanditRL.OnlineUnitScaling.V (fun x => η) loss x₁ p T -
                            u‖ ^
                        2 /
                      (2 * η)
