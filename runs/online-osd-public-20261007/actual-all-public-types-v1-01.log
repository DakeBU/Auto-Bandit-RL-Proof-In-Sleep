@BanditRL.OnlineSubgradientDescent.lemma_2_31 : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (V : BanditRL.OnlineSubgradientDescent.Domain)
  (f : E → EReal),
  BanditRL.OnlineSubgradientDescent.SubdifferentiableOn V f →
    ∀ (η : ℝ),
      0 < η →
        ∀ (x u : E),
          u ∈ V.carrier →
            ∀ g ∈ BanditRL.OnlineConvex.SourceSubdifferential f x,
              η * ((f x).toReal - (f u).toReal) ≤ η * inner ℝ g (x - u) ∧
                η * inner ℝ g (x - u) ≤
                  ‖x - u‖ ^ 2 / 2 - ‖BanditRL.OnlineGradientDescent.project V (x - η • g) - u‖ ^ 2 / 2 +
                    η ^ 2 / 2 * ‖g‖ ^ 2
@BanditRL.OnlineSubgradientDescent.currentSubgradient_mem : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [FiniteDimensional ℝ E] (V : BanditRL.OnlineSubgradientDescent.Domain)
  (f : E → EReal),
  BanditRL.OnlineSubgradientDescent.SubdifferentiableOn V f →
    ∀ x ∈ V.carrier,
      BanditRL.OnlineSubgradientDescent.currentSubgradient f x ∈ BanditRL.OnlineConvex.SourceSubdifferential f x
@BanditRL.OnlineSubgradientDescent.finite_loss : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [FiniteDimensional ℝ E] (V : BanditRL.OnlineSubgradientDescent.Domain)
  (f : E → EReal), BanditRL.OnlineSubgradientDescent.SubdifferentiableOn V f → ∀ x ∈ V.carrier, f x = ↑(f x).toReal
@BanditRL.OnlineSubgradientDescent.iterate_mem : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (V : BanditRL.OnlineSubgradientDescent.Domain)
  (η : ℕ → ℝ) (loss : ℕ → E → EReal),
  ∀ x₁ ∈ V.carrier, ∀ (t : ℕ), BanditRL.OnlineSubgradientDescent.iterate V η loss x₁ t ∈ V.carrier
@BanditRL.OnlineSubgradientDescent.iterate_prefix : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (V : BanditRL.OnlineSubgradientDescent.Domain)
  (η η' : ℕ → ℝ) (loss loss' : ℕ → E → EReal) (x₁ : E) (t : ℕ),
  (∀ s < t, η s = η' s) →
    (∀ s < t, loss s = loss' s) →
      BanditRL.OnlineSubgradientDescent.iterate V η loss x₁ t =
        BanditRL.OnlineSubgradientDescent.iterate V η' loss' x₁ t
@BanditRL.OnlineSubgradientDescent.iterate_support : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (V : BanditRL.OnlineSubgradientDescent.Domain)
  (η : ℕ → ℝ) (loss : ℕ → E → EReal),
  ∀ x₁ ∈ V.carrier,
    ∀ (t : ℕ),
      BanditRL.OnlineSubgradientDescent.SubdifferentiableOn V (loss t) →
        BanditRL.OnlineSubgradientDescent.currentSubgradient (loss t)
            (BanditRL.OnlineSubgradientDescent.iterate V η loss x₁ t) ∈
          BanditRL.OnlineConvex.SourceSubdifferential (loss t) (BanditRL.OnlineSubgradientDescent.iterate V η loss x₁ t)
@BanditRL.OnlineSubgradientDescent.iterate_finite_loss : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (V : BanditRL.OnlineSubgradientDescent.Domain)
  (η : ℕ → ℝ) (loss : ℕ → E → EReal),
  ∀ x₁ ∈ V.carrier,
    ∀ (t : ℕ),
      BanditRL.OnlineSubgradientDescent.SubdifferentiableOn V (loss t) →
        ∀ u ∈ V.carrier,
          loss t (BanditRL.OnlineSubgradientDescent.iterate V η loss x₁ t) =
              ↑(loss t (BanditRL.OnlineSubgradientDescent.iterate V η loss x₁ t)).toReal ∧
            loss t u = ↑(loss t u).toReal
@BanditRL.OnlineSubgradientDescent.one_step_chain : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (V : BanditRL.OnlineSubgradientDescent.Domain)
  (η : ℕ → ℝ) (loss : ℕ → E → EReal),
  ∀ x₁ ∈ V.carrier,
    ∀ (t : ℕ),
      0 < η t →
        BanditRL.OnlineSubgradientDescent.SubdifferentiableOn V (loss t) →
          ∀ u ∈ V.carrier,
            η t * ((loss t (BanditRL.OnlineSubgradientDescent.iterate V η loss x₁ t)).toReal - (loss t u).toReal) ≤
                η t *
                  inner ℝ
                    (BanditRL.OnlineSubgradientDescent.currentSubgradient (loss t)
                      (BanditRL.OnlineSubgradientDescent.iterate V η loss x₁ t))
                    (BanditRL.OnlineSubgradientDescent.iterate V η loss x₁ t - u) ∧
              η t *
                  inner ℝ
                    (BanditRL.OnlineSubgradientDescent.currentSubgradient (loss t)
                      (BanditRL.OnlineSubgradientDescent.iterate V η loss x₁ t))
                    (BanditRL.OnlineSubgradientDescent.iterate V η loss x₁ t - u) ≤
                ‖BanditRL.OnlineSubgradientDescent.iterate V η loss x₁ t - u‖ ^ 2 / 2 -
                    ‖BanditRL.OnlineSubgradientDescent.iterate V η loss x₁ (t + 1) - u‖ ^ 2 / 2 +
                  η t ^ 2 / 2 *
                    ‖BanditRL.OnlineSubgradientDescent.currentSubgradient (loss t)
                          (BanditRL.OnlineSubgradientDescent.iterate V η loss x₁ t)‖ ^
                      2
@BanditRL.OnlineSubgradientDescent.one_step : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (V : BanditRL.OnlineSubgradientDescent.Domain)
  (η : ℕ → ℝ) (loss : ℕ → E → EReal),
  ∀ x₁ ∈ V.carrier,
    ∀ (t : ℕ),
      0 < η t →
        BanditRL.OnlineSubgradientDescent.SubdifferentiableOn V (loss t) →
          ∀ u ∈ V.carrier,
            (loss t (BanditRL.OnlineSubgradientDescent.iterate V η loss x₁ t)).toReal - (loss t u).toReal ≤
              (‖BanditRL.OnlineSubgradientDescent.iterate V η loss x₁ t - u‖ ^ 2 -
                    ‖BanditRL.OnlineSubgradientDescent.iterate V η loss x₁ (t + 1) - u‖ ^ 2) /
                  (2 * η t) +
                η t / 2 *
                  ‖BanditRL.OnlineSubgradientDescent.currentSubgradient (loss t)
                        (BanditRL.OnlineSubgradientDescent.iterate V η loss x₁ t)‖ ^
                    2
@BanditRL.OnlineSubgradientDescent.regret_fixed : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (V : BanditRL.OnlineSubgradientDescent.Domain)
  (η : ℝ),
  0 < η →
    ∀ (loss : ℕ → E → EReal),
      ∀ x₁ ∈ V.carrier,
        ∀ (T : ℕ),
          (∀ t < T, BanditRL.OnlineSubgradientDescent.SubdifferentiableOn V (loss t)) →
            ∀ u ∈ V.carrier,
              BanditRL.OnlineSubgradientDescent.regret V (fun x => η) loss x₁ u T ≤
                ‖x₁ - u‖ ^ 2 / (2 * η) +
                    η / 2 *
                      ∑ t ∈ Finset.range T,
                        ‖BanditRL.OnlineSubgradientDescent.currentSubgradient (loss t)
                              (BanditRL.OnlineSubgradientDescent.iterate V (fun x => η) loss x₁ t)‖ ^
                          2 -
                  ‖BanditRL.OnlineSubgradientDescent.iterate V (fun x => η) loss x₁ T - u‖ ^ 2 / (2 * η)
@BanditRL.OnlineSubgradientDescent.regret_fixed_coarse : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (V : BanditRL.OnlineSubgradientDescent.Domain)
  (η : ℝ),
  0 < η →
    ∀ (loss : ℕ → E → EReal),
      ∀ x₁ ∈ V.carrier,
        ∀ (T : ℕ),
          (∀ t < T, BanditRL.OnlineSubgradientDescent.SubdifferentiableOn V (loss t)) →
            ∀ u ∈ V.carrier,
              BanditRL.OnlineSubgradientDescent.regret V (fun x => η) loss x₁ u T ≤
                ‖x₁ - u‖ ^ 2 / (2 * η) +
                  η / 2 *
                    ∑ t ∈ Finset.range T,
                      ‖BanditRL.OnlineSubgradientDescent.currentSubgradient (loss t)
                            (BanditRL.OnlineSubgradientDescent.iterate V (fun x => η) loss x₁ t)‖ ^
                        2
@BanditRL.OnlineSubgradientDescent.regret_variable_bound : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (V : BanditRL.OnlineSubgradientDescent.Domain)
  (η : ℕ → ℝ) (loss : ℕ → E → EReal),
  ∀ x₁ ∈ V.carrier,
    ∀ (T : ℕ),
      0 < T →
        (∀ t < T, 0 < η t) →
          (∀ (t : ℕ), t + 1 < T → η (t + 1) ≤ η t) →
            (∀ t < T, BanditRL.OnlineSubgradientDescent.SubdifferentiableOn V (loss t)) →
              ∀ (D : ℝ),
                (∀ x ∈ V.carrier, ∀ y ∈ V.carrier, ‖x - y‖ ≤ D) →
                  ∀ u ∈ V.carrier,
                    BanditRL.OnlineSubgradientDescent.regret V η loss x₁ u T ≤
                      D ^ 2 / (2 * η (T - 1)) +
                          ∑ t ∈ Finset.range T,
                            η t / 2 *
                              ‖BanditRL.OnlineSubgradientDescent.currentSubgradient (loss t)
                                    (BanditRL.OnlineSubgradientDescent.iterate V η loss x₁ t)‖ ^
                                2 -
                        ‖BanditRL.OnlineSubgradientDescent.iterate V η loss x₁ T - u‖ ^ 2 / (2 * η (T - 1))
@BanditRL.OnlineSubgradientDescent.regret_variable : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (V : BanditRL.OnlineSubgradientDescent.Domain),
  Bornology.IsBounded V.carrier →
    ∀ (η : ℕ → ℝ) (loss : ℕ → E → EReal),
      ∀ x₁ ∈ V.carrier,
        ∀ (T : ℕ),
          0 < T →
            (∀ t < T, 0 < η t) →
              (∀ (t : ℕ), t + 1 < T → η (t + 1) ≤ η t) →
                (∀ t < T, BanditRL.OnlineSubgradientDescent.SubdifferentiableOn V (loss t)) →
                  ∀ u ∈ V.carrier,
                    BanditRL.OnlineSubgradientDescent.regret V η loss x₁ u T ≤
                      Metric.diam V.carrier ^ 2 / (2 * η (T - 1)) +
                          ∑ t ∈ Finset.range T,
                            η t / 2 *
                              ‖BanditRL.OnlineSubgradientDescent.currentSubgradient (loss t)
                                    (BanditRL.OnlineSubgradientDescent.iterate V η loss x₁ t)‖ ^
                                2 -
                        ‖BanditRL.OnlineSubgradientDescent.iterate V η loss x₁ T - u‖ ^ 2 / (2 * η (T - 1))
@BanditRL.OnlineSubgradientDescent.regret_tuned_distance : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (V : BanditRL.OnlineSubgradientDescent.Domain)
  (loss : ℕ → E → EReal),
  ∀ x₁ ∈ V.carrier,
    ∀ (T : ℕ),
      0 < T →
        ∀ (D G : ℝ),
          0 < D →
            0 < G →
              (∀ t < T, BanditRL.OnlineSubgradientDescent.SubdifferentiableOn V (loss t)) →
                ∀ u ∈ V.carrier,
                  ‖x₁ - u‖ ≤ D →
                    (∀ t < T,
                        ‖BanditRL.OnlineSubgradientDescent.currentSubgradient (loss t)
                              (BanditRL.OnlineSubgradientDescent.iterate V (fun x => D / (G * √↑T)) loss x₁ t)‖ ≤
                          G) →
                      BanditRL.OnlineSubgradientDescent.regret V (fun x => D / (G * √↑T)) loss x₁ u T ≤ D * G * √↑T
@BanditRL.OnlineSubgradientDescent.regret_tuned : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (V : BanditRL.OnlineSubgradientDescent.Domain)
  (loss : ℕ → E → EReal),
  ∀ x₁ ∈ V.carrier,
    ∀ (T : ℕ),
