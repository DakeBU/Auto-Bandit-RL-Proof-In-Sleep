        ∀ (D G : ℝ),
          0 < D →
            0 < G →
              (∀ x ∈ V.carrier, ∀ y ∈ V.carrier, ‖x - y‖ ≤ D) →
                (∀ t < T, BanditRL.OnlineSubgradientDescent.SubdifferentiableOn V (loss t)) →
                  (∀ t < T,
                      ‖BanditRL.OnlineSubgradientDescent.currentSubgradient (loss t)
                            (BanditRL.OnlineSubgradientDescent.iterate V (fun x => D / (G * √↑T)) loss x₁ t)‖ ≤
                        G) →
                    ∀ u ∈ V.carrier,
                      BanditRL.OnlineSubgradientDescent.regret V (fun x => D / (G * √↑T)) loss x₁ u T ≤ D * G * √↑T
