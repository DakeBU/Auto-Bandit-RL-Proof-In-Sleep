  OSDOutsideProbe.linearLoss
OSDOutsideProbe.support_at_two : 3 ∈ BanditRL.OnlineConvex.SourceSubdifferential OSDOutsideProbe.linearLoss 2
OSDOutsideProbe.project_neg_four : BanditRL.OnlineGradientDescent.project OSDOutsideProbe.interval (-4) = -1
OSDOutsideProbe.arbitrary_current_and_actual_clipping : 2 ∉ OSDOutsideProbe.interval.carrier ∧
  BanditRL.OnlineGradientDescent.project OSDOutsideProbe.interval (2 - 2 • 3) = -1 ∧
    2 * ((OSDOutsideProbe.linearLoss 2).toReal - (OSDOutsideProbe.linearLoss 0).toReal) ≤ 2 * inner ℝ 3 (2 - 0) ∧
      2 * inner ℝ 3 (2 - 0) ≤
        ‖2 - 0‖ ^ 2 / 2 - ‖BanditRL.OnlineGradientDescent.project OSDOutsideProbe.interval (2 - 2 • 3) - 0‖ ^ 2 / 2 +
          2 ^ 2 / 2 * ‖3‖ ^ 2
OSDAlgorithmProbe.absolute_on : BanditRL.OnlineSubgradientDescent.SubdifferentiableOn OSDAlgorithmProbe.interval
  OSDAlgorithmProbe.absoluteLoss
