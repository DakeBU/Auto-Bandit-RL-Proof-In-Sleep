  ‖1 - 0‖ ^ 2 / (2 * 3) +
      3 / 2 *
        ∑ t ∈ Finset.range 2,
          ‖BanditRL.OnlineSubgradientDescent.currentSubgradient (OSDAlgorithmProbe.losses t)
                (BanditRL.OnlineSubgradientDescent.iterate OSDAlgorithmProbe.interval (fun x => 3)
                  OSDAlgorithmProbe.losses 1 t)‖ ^
            2 -
    ‖BanditRL.OnlineSubgradientDescent.iterate OSDAlgorithmProbe.interval (fun x => 3) OSDAlgorithmProbe.losses 1 2 -
            0‖ ^
        2 /
      (2 * 3)
