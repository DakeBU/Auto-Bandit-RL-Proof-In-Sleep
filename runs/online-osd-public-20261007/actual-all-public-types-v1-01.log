      (fun x => 3) OSDAlgorithmProbe.losses 1 0 =
    1 ∧
  BanditRL.OnlineSubgradientDescent.iterate OSDAlgorithmProbe.interval (fun x => 3) OSDAlgorithmProbe.losses 1 1 = -1 ∧
    BanditRL.OnlineSubgradientDescent.iterate OSDAlgorithmProbe.interval (fun x => 3) OSDAlgorithmProbe.losses 1 2 = 1 ∧
      BanditRL.OnlineSubgradientDescent.regret OSDAlgorithmProbe.interval (fun x => 3) OSDAlgorithmProbe.losses 1 0 2 =
          2 ∧
        1 - 3 • BanditRL.OnlineSubgradientDescent.currentSubgradient OSDAlgorithmProbe.absoluteLoss 1 = -2 ∧
          -1 - 3 • BanditRL.OnlineSubgradientDescent.currentSubgradient OSDAlgorithmProbe.absoluteLoss (-1) = 2
