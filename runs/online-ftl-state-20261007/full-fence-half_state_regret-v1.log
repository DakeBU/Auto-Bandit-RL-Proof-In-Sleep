  "statement": "theorem half_state_regret : ((∑ t ∈ Finset.range 2, ((ftlState ((1 : ℝ) / 2) probeTargets t).2 - probeTargets t)^2) - (∑ t ∈ Finset.range 2, (empiricalMean probeTargets 2 - probeTargets t)^2)) = (3 : ℝ) / 4 ∧ ((∑ t ∈ Finset.range 2, ((ftlState ((1 : ℝ) / 2) probeTargets t).2 - probeTargets t)^2) - (∑ t ∈ Finset.range 2, (empiricalMean probeTargets 2 - probeTargets t)^2)) ≤ (1 : ℝ) / 4 + ∑ t ∈ Finset.range (2 - 1), 4 / ((t : ℝ) + 2)",
