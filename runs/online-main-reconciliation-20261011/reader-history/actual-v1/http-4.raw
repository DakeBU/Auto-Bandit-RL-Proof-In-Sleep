    <pre class="lean-code"><code><span class="kw">theorem</span> finite_regret_identity {E : Type*} (psi loss : ℕ → E → ℝ) (x : ℕ → E) (u z : E) (T : ℕ) (hT : <span class="num">0</span> &lt; T) : <span class="kw">let</span> y : ℕ → E := <span class="kw">fun</span> t =&gt; <span class="kw">if</span> t = T <span class="kw">then</span> z <span class="kw">else</span> x t <span class="kw">let</span> G : ℕ → E → ℝ := <span class="kw">fun</span> t v =&gt; psi t v + ∑ i ∈ range (t + <span class="num">1</span>), loss i v (∑ t ∈ range T, (loss t (y t) - loss t u)) = psi (T - <span class="num">1</span>) u - psi <span class="num">0</span> (y <span class="num">0</span>) + (∑ t ∈ range T, (G t (y t) - G t (y (t + <span class="num">1</span>)))) + (∑ t ∈ range (T - <span class="num">1</span>), (psi t (y (t + <span class="num">1</span>)) - psi (t + <span class="num">1</span>) (y (t + <span class="num">1</span>)))) + G (T - <span class="num">1</span>) z - G (T - <span class="num">1</span>) u</code></pre>
