+def expected_book_chapters(books: list[dict], book_id: str, chapter_slugs: set[str]) -> set[str]:
+    book = next(book for book in books if book["id"] == book_id)
+    return {ref.removeprefix("teaching:") for ref in book["chapter_refs"]
+            if ref.startswith("teaching:") and ref.removeprefix("teaching:") in chapter_slugs}
+
+
+def expected_navigation_groups(books: list[dict], chapter_slugs: set[str]) -> set[str]:
+    groups = {"start", "books", "bandit-book", "research", "library", "formalize", "community"}
+    owners: dict[str, str] = {}
+    for book in books:
+        if book.get("status") == "source-mapped":
+            for ref in book["chapter_refs"]:
+                if ref.startswith("teaching:") and ref.removeprefix("teaching:") in chapter_slugs:
+                    owners.setdefault(ref, book["id"])
+    groups.update(owner + "-book" for owner in set(owners.values()) if owner != "bandit")
+    return groups
 
 
