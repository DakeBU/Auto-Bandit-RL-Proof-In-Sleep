e-identity-v1/canary-freeze-receipt-v1.json\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/canary-neutral-one-round-frozen-header-v1.txt\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/canary-neutral-two-round-frozen-header-v1.txt\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/leaf-freeze-receipt-v1.json\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/neutral-frozen-header-v1.txt\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/precanary-preparation-addendum-v1.json\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/proof-digestion-record-v1.json\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/source-contract-proposal-v1.json\"\n+  ],\n+  \"command_started\": true,\n+  \"actual_exit\": 0,\n+  \"ZIP_is_whole_repository_archive\": false,\n+  \"ZIP_scope\": \"Selected active source/input trees and current leaf contracts; historical runs excluded; curated current runs/process_memory.json included\",\n+  \"full_RAW_inventory_scope\": \"Every library/Test source and enumerated current harness/site source/input tree plus current leaf contracts. Historical archives not separately RAW-hashed (curated current process memory is an active input); committed HEAD and clean Git status bind repository state.\",\n+  \"leaf_contract_roots\": [\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1\"\n+  ],\n+  \"pre_git\": {\n+    \"HEAD\": \"7b372d79fcd3228d8d2cece73ad0181f94a70cf1\",\n+    \"branch\": \"codex/research-online-ch2-b4-finite-identity\",\n+    \"status_porcelain_v1_z_hex\": \"\"\n+  },\n+  \"ZIP_selected_files\": 1322,\n+  \"full_RAW_inventory_files\": 1322,\n+  \"precommand_check\": \"Selected ZIP RAW hashes and Git state; no redundant second full inventory. Full pre/post manifests remain authoritative.\",\n+  \"start_utc\": \"2026-10-11T09:03:57.259547+00:00\",\n+  \"end_utc\": \"2026-10-11T09:03:57.326171+00:00\",\n+  \"post_git\": {\n+    \"HEAD\": \"7b372d79fcd3228d8d2cece73ad0181f94a70cf1\",\n+    \"branch\": \"codex/research-online-ch2-b4-finite-identity\",\n+    \"status_porcelain_v1_z_hex\": \"\"\n+  },\n+  \"complete_source_path_set_and_RAW_unchanged\": true,\n+  \"HEAD_and_branch_unchanged\": true,\n+  \"git_status_unchanged\": true,\n+  \"capture_integrity_ok\": true,\n+  \"stdout.raw_sha256\": \"9eaf787390c5f1bf4dea8a4f7b1cf06937163fda2f17afdffafddbb4672c10bb\",\n+  \"stderr.raw_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n+  \"pre-source-inputs.json_sha256\": \"2b5c8985e0faf3d033c5db0586cfdf423ed1217869aa12992aca615bc1b49d07\",\n+  \"post-source-inputs.json_sha256\": \"2b5c8985e0faf3d033c5db0586cfdf423ed1217869aa12992aca615bc1b49d07\",\n+  \"pre-selected-ZIP-inputs.json_sha256\": \"2b5c8985e0faf3d033c5db0586cfdf423ed1217869aa12992aca615bc1b49d07\",\n+  \"pre-selected-source-raw.zip_sha256\": \"7189231ead6d82414e93ec34324e725c2568e9385f0438bbaadeec78284b0e24\"\n+}"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"runs/online-ch2-b4-finite-identity-20261011/actual-gates/process-memory-v1/stderr.raw","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fprocess-memory-v1%2Fstderr.raw","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fprocess-memory-v1%2Fstderr.raw","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fprocess-memory-v1%2Fstderr.raw?ref=c445c93f7e4cda1408279d614858c904e346ad47"},{"sha":"4de0e2ffd6bbf9f721bcbcf29fc62cc08edf6eba","filename":"runs/online-ch2-b4-finite-identity-20261011/actual-gates/process-memory-v1/stdout.raw","status":"added","additions":1,"deletions":0,"changes":1,"