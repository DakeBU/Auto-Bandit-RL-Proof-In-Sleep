[{"sha":"b8b5c1f8892b98d705329c8d46c1c6a82045ffff","filename":"BanditRLProof.lean","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/BanditRLProof.lean","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/BanditRLProof.lean","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/BanditRLProof.lean?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -793,3 +793,4 @@ import BanditRLProof.OnlineAdaptiveBenchmark\n import BanditRLProof.OnlineWeightedPotential\n import BanditRLProof.OnlineUnboundedOGD\n import BanditRLProof.OnlinePrescientEuclidean\n+import BanditRLProof.OnlineCumulativePotential"},{"sha":"056ac1fb5399ddd8db4475d13b002940b9c59c0d","filename":"BanditRLProof/OnlineCumulativePotential.lean","status":"added","additions":50,"deletions":0,"changes":50,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/BanditRLProof%2FOnlineCumulativePotential.lean","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/BanditRLProof%2FOnlineCumulativePotential.lean","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/BanditRLProof%2FOnlineCumulativePotential.lean?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,50 @@\n+import Mathlib.Algebra.BigOperators.Module\n+import Mathlib.Tactic\n+\n+noncomputable section\n+open Finset\n+namespace BanditRL.OnlineCumulativePotential\n+\n+theorem finite_regret_identity {E : Type*}\n+    (psi loss : ℕ → E → ℝ) (x : ℕ → E) (u z : E)\n+    (T : ℕ) (hT : 0 < T) :\n+    let y : ℕ → E := fun t => if t = T then z else x t\n+    let G : ℕ → E → ℝ := fun t v => psi t v + ∑ i ∈ range (t + 1), loss i v\n+    (∑ t ∈ range T, (loss t (y t) - loss t u)) =\n+      psi (T - 1) u - psi 0 (y 0) +\n+      (∑ t ∈ range T, (G t (y t) - G t (y (t + 1)))) +\n+      (∑ t ∈ range (T - 1),\n+        (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))) +\n+      G (T - 1) z - G (T - 1) u := by\n+  let y : ℕ → E := fun t => if t = T then z else x t\n+  let G : ℕ → E → ℝ := fun t v => psi t v + ∑ i ∈ range (t + 1), loss i v\n+  change (∑ t ∈ range T, (loss t (y t) - loss t u)) =\n+    psi (T - 1) u - psi 0 (y 0) +\n+    (∑ t ∈ range T, (G t (y t) - G t (y (t + 1)))) +\n+    (∑ t ∈ range (T - 1),\n+      (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))) +\n+    G (T - 1) z - G (T - 1) u\n+  have hG (n : ℕ) (v : E) :\n+      G (n + 1) v = G n v + psi (n + 1) v - psi n v + loss (n + 1) v := by\n+    simp only [G, sum_range_succ]\n+    ring\n+  have hmain (n : ℕ) :\n+      (∑ t ∈ range (n + 1), (loss t (y t) - loss t u)) =\n+        psi n u - psi 0 (y 0) +\n+        (∑ t ∈ range (n + 1), (G t (y t) - G t (y (t + 1)))) +\n+        (∑ t ∈ range n, (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))) +\n+        G n (y (n + 1)) - G n u := by\n+    induction n with\n+    | zero =>\n+      simp only [sum_range_succ, sum_range_zero, zero_add, G]\n+      ring\n+    | succ n ih =>\n+      simp only [sum_range_succ] at ih ⊢\n+      rw [hG n (y (n + 1)), hG n (y (n + 1 + 1)), hG n u]\n+      linarith\n+  have hindex : T - 1 + 1 = T := Nat.sub_add_cancel hT\n+  have hend : y T = z := by simp [y]\n+  simpa only [hindex, hend] using hmain (T - 1)\n+\n+\n+end BanditRL.OnlineCumulativePotential"},{"sha":"97ebe977c8a8c2340973b8a1e009c7f752c5ecd3","filename":"MANIFEST.md","status":"modified","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/MANIFEST.md","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/MANIFEST.md","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/MANIFEST.md?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -15592,3 +15592,8 @@ Orabona v10 unnumberedexample afterT2.30/endSection2.2.1 immediatelybefore2.2.2\n - `2026-10-08T18:45:32+00:00` `bandit.py new-task` `task` `tasks/ONLINE-FTL-OBSTRUCTION-20261009.md` - Actual bounded FTL ordinary-limit reconciliation\n \n Prescient Euclidean source specialization: `BanditRLProof/OnlinePrescientEuclidean.lean` proves one shared actual-gradient/divergence identity and both general extended-loss, same-Option-run specializations of Orabona v10 Theorem15.30. `Tests/OnlinePrescientEuclideanCanary.lean` contains two complete nonlinear finite-domain actual-run canaries. Source topology, frozen interfaces, independent reviews and failed attempts are retained in `runs/online-ch2-prescient-euclidean-20261011`; package validation is recorded separately. Seven required Chapter2 forward containers and six future claims, including the B4 terminal corrections, remain open. Chapter2 is partial; the Chapters1-16 Goal remains active. Unmerged and unpublished.\n+\n+\n+### B4 finite-real cumulative regret identity\n+\n+`BanditRL.OnlineCumulativePotential.finite_regret_identity` is a locally compiled and independently BODY-reviewed finite-real corrected algebra subclause near Orabona v10 Theorem7.47 (PDF141-142), related to the Theorem15.31 terminal repair (PDF278-279). It retains the final comparator regularizer minus initial played regularizer, within-potential sum, signed interior drift and arbitrary terminal gap. Two independently reviewed public canaries actually specialize the same core. No optimizer/actual algorithm/EReal performance endpoint is asserted. Fresh shared root/Tests/full-harness/site and final acceptance evidence are separate in `runs/online-ch2-b4-finite-identity-20261011`. Full EReal/producer/attainment/support/stability/Young and both corrected parent endpoints remain open. Chapter2 remains partial:7requiredcontainers/6futureclaims,accepted=false,complete proof denominator=null; Chapters1-16 Goal ACTIVE. Unmerged and unpublished."},{"sha":"ca559664b4d8580f0e1dedb7b954d4c934968b0a","filename":"Tests.lean","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/Tests.lean","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/Tests.lean","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/Tests.lean?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -208,3 +208,4 @@ import Tests.OnlineAdaptiveOSDCanary\n import Tests.OnlineWeightedPotentialCanary\n import Tests.OnlineUnboundedOGDCanary\n import Tests.OnlinePrescientEuclideanCanary\n+import Tests.OnlineCumulativePotentialCanary"},{"sha":"efd17769f844788d600030b96a1a8e1985994e6d","filename":"Tests/OnlineCumulativePotentialCanary.lean","status":"added","additions":73,"deletions":0,"changes":73,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/Tests%2FOnlineCumulativePotentialCanary.lean","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/Tests%2FOnlineCumulativePotentialCanary.lean","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/Tests%2FOnlineCumulativePotentialCanary.lean?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,73 @@\n+import BanditRLProof.OnlineCumulativePotential\n+import Mathlib.Algebra.BigOperators.Module\n+import Mathlib.Tactic\n+\n+noncomputable section\n+open Finset\n+namespace BanditRL.OnlineCumulativePotentialCanary\n+\n+theorem finite_identity_one_round_positive_gap :\n+    let psi : ℕ → ℝ → ℝ := fun _ v => v ^ 2 / 2\n+    let loss : ℕ → ℝ → ℝ := fun _ v => (v - 1) ^ 2 / 2\n+    let x : ℕ → ℝ := fun _ => 1 / 2\n+    let u : ℝ := 1 / 2\n+    let z : ℝ := 2 / 3\n+    let T : ℕ := 1\n+    let y : ℕ → ℝ := fun t => if t = T then z else x t\n+    let G : ℕ → ℝ → ℝ := fun t v => psi t v + ∑ i ∈ range (t + 1), loss i v\n+    ((∑ t ∈ range T, (loss t (y t) - loss t u)) =\n+      psi (T - 1) u - psi 0 (y 0) +\n+      (∑ t ∈ range T, (G t (y t) - G t (y (t + 1)))) +\n+      (∑ t ∈ range (T - 1),\n+        (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))) +\n+      G (T - 1) z - G (T - 1) u) ∧\n+    (∑ t ∈ range T, (loss t (y t) - loss t u)) = 0 ∧\n+    (psi (T - 1) u - psi 0 (y 0)) = 0 ∧\n+    (∑ t ∈ range T, (G t (y t) - G t (y (t + 1)))) = -(1 / 36 : ℝ) ∧\n+    (∑ t ∈ range (T - 1),\n+        (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))) = 0 ∧\n+    (G (T - 1) z - G (T - 1) u) = (1 / 36 : ℝ) ∧\n+    ¬ ((∑ t ∈ range T, (loss t (y t) - loss t u)) ≤\n+      (psi (T - 1) u - psi 0 (y 0)) + (∑ t ∈ range T, (G t (y t) - G t (y (t + 1)))) +\n+      (∑ t ∈ range (T - 1),\n+        (psi t (y (t + 1)) - psi (t + 1) (y (t + 1))))) := by\n+  dsimp only\n+  constructor\n+  · exact BanditRL.OnlineCumulativePotential.finite_regret_identity\n+      (fun (_ : ℕ) (v : ℝ) => v ^ 2 / 2) (fun (_ : ℕ) (v : ℝ) => (v - 1) ^ 2 / 2)\n+      (fun _ => (1 / 2 : ℝ)) (1 / 2) (2 / 3) 1 (by decide)\n+  · norm_num [Finset.sum_range_succ]\n+\n+theorem finite_identity_two_round_terminal_splice :\n+    let psi : ℕ → ℝ → ℝ := fun t v => ((t : ℝ) + 1) * v ^ 2 / 2\n+    let loss : ℕ → ℝ → ℝ := fun t v =>\n+      if t = 0 then v else if t = 1 then -2 * v + 1 else 0\n+    let x : ℕ → ℝ := fun t => if t = 0 then 0 else if t = 1 then 1 else 100\n+    let u : ℝ := 3\n+    let z : ℝ := 2\n+    let T : ℕ := 2\n+    let y : ℕ → ℝ := fun t => if t = T then z else x t\n+    let G : ℕ → ℝ → ℝ := fun t v => psi t v + ∑ i ∈ range (t + 1), loss i v\n+    ((∑ t ∈ range T, (loss t (y t) - loss t u)) =\n+      psi (T - 1) u - psi 0 (y 0) +\n+      (∑ t ∈ range T, (G t (y t) - G t (y (t + 1)))) +\n+      (∑ t ∈ range (T - 1),\n+        (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))) +\n+      G (T - 1) z - G (T - 1) u) ∧\n+    (∑ t ∈ range T, (loss t (y t) - loss t u)) = 1 ∧\n+    (psi (T - 1) u - psi 0 (y 0)) = 9 ∧\n+    (∑ t ∈ range T, (G t (y t) - G t (y (t + 1)))) = -(7 / 2 : ℝ) ∧\n+    (∑ t ∈ range (T - 1),\n+        (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))) = -(1 / 2 : ℝ) ∧\n+    (G (T - 1) z - G (T - 1) u) = -4 ∧\n+    x 2 = 100 ∧ y 2 = 2 ∧ y 2 ≠ x 2 := by\n+  dsimp only\n+  constructor\n+  · exact BanditRL.OnlineCumulativePotential.finite_regret_identity\n+      (fun (t : ℕ) (v : ℝ) => ((t : ℝ) + 1) * v ^ 2 / 2)\n+      (fun (t : ℕ) (v : ℝ) => if t = 0 then v else if t = 1 then -2 * v + 1 else 0)\n+      (fun t => if t = 0 then (0 : ℝ) else if t = 1 then 1 else 100)\n+      3 2 2 (by decide)\n+  · norm_num [Finset.sum_range_succ]\n+\n+end BanditRL.OnlineCumulativePotentialCanary"},{"sha":"fa1385d99a319b43c06f5309d1aae9fdd3adea46","filename":"docs/contracts/online-ch2-b4-finite-identity-v1/.gitattributes","status":"added","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/docs%2Fcontracts%2Fonline-ch2-b4-finite-identity-v1%2F.gitattributes","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/docs%2Fcontracts%2Fonline-ch2-b4-finite-identity-v1%2F.gitattributes","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/docs%2Fcontracts%2Fonline-ch2-b4-finite-identity-v1%2F.gitattributes?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1 @@\n+* -text"},{"sha":"f976b5a1b6e62583002777fc3cac95956f80d8f3","filename":"docs/contracts/online-ch2-b4-finite-identity-v1/canary-freeze-proposal-v1.json","status":"added","additions":84,"deletions":0,"changes":84,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/docs%2Fcontracts%2Fonline-ch2-b4-finite-identity-v1%2Fcanary-freeze-proposal-v1.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/docs%2Fcontracts%2Fonline-ch2-b4-finite-identity-v1%2Fcanary-freeze-proposal-v1.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/docs%2Fcontracts%2Fonline-ch2-b4-finite-identity-v1%2Fcanary-freeze-proposal-v1.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,84 @@\n+{\n+  \"UTC\": \"2026-10-11T08:35:49.169693+00:00\",\n+  \"status\": \"CANARY FREEZE PROPOSAL; independent review pending; NO Test BODY AUTHORIZATION\",\n+  \"requested_model_effort\": \"GPT-6 Astra / medium; runtime not independently attested\",\n+  \"production_core\": {\n+    \"path\": \"BanditRLProof/OnlineCumulativePotential.lean\",\n+    \"sha256\": \"61c811c0b1f941ec22ac41f64e555a0e4d4d8dc32b8145ea53808dbdc0fc17da\",\n+    \"bytes\": 1980\n+  },\n+  \"production_header\": {\n+    \"path\": \"docs/contracts/online-ch2-b4-finite-identity-v1/neutral-frozen-header-v1.txt\",\n+    \"sha256\": \"92e0dcfac53595e35b68bfd8083c09640d06da809355ab02ec4eb4b007b0bd67\",\n+    \"bytes\": 735\n+  },\n+  \"production_statement_seal\": {\n+    \"path\": \"docs/contracts/online-ch2-b4-finite-identity-v1/leaf-freeze-receipt-v1.json\",\n+    \"sha256\": \"9150e0fd1342375bf13c7313b7b6715e7e4bdde5edd6078689474381d3ca80cd\",\n+    \"bytes\": 28834\n+  },\n+  \"production_report\": {\n+    \"path\": \"runs/online-ch2-b4-finite-identity-20261011/production-core/core-report-v2.json\",\n+    \"sha256\": \"5c55e8ea41cf2c18af4c47f9929233e7e4afcf903de00f654fd00edec1ab98aa\",\n+    \"bytes\": 4030\n+  },\n+  \"reviews\": [\n+    {\n+      \"path\": \"runs/online-ch2-b4-finite-identity-20261011/canary-neutral-blind/fresh-blind-v1.json\",\n+      \"sha256\": \"f29ac0fd3ed86e73cb5cc0ff52600750c86505f03fb7547f3d028790bc431428\",\n+      \"bytes\": 10943\n+    },\n+    {\n+      \"path\": \"runs/online-ch2-b4-finite-identity-20261011/canary-source-header/source-header-review-v1.json\",\n+      \"sha256\": \"b581b3fff2379b4805fd7e472b12bd7d4cca4e2dc13d519b3d2e4f7f3b364939\",\n+      \"bytes\": 9795\n+    },\n+    {\n+      \"path\": \"runs/online-ch2-b4-finite-identity-20261011/independent-production-body/fresh-production-body-review-v1.json\",\n+      \"sha256\": \"4b3246ef699eba8c3df7a8063e12342f86211c43b60efd121ce2bccb58c8aac6\",\n+      \"bytes\": 26772\n+    }\n+  ],\n+  \"header_elaboration\": {\n+    \"path\": \"runs/online-ch2-b4-finite-identity-20261011/canary-header-elaboration/canary-header-elaboration-report-v1.json\",\n+    \"sha256\": \"e9602bd4e769c44a00e458372d8f0e4fc833bddccfc846532710b461a06e32a7\",\n+    \"bytes\": 2364\n+  },\n+  \"headers\": [\n+    {\n+      \"path\": \"docs/contracts/online-ch2-b4-finite-identity-v1/canary-neutral-one-round-frozen-header-v1.txt\",\n+      \"sha256\": \"7d10ab86d93f97a5ac03db64ce96b8759a0a64d7bd440fa5bfbbe666717be75e\",\n+      \"bytes\": 1518\n+    },\n+    {\n+      \"path\": \"docs/contracts/online-ch2-b4-finite-identity-v1/canary-neutral-two-round-frozen-header-v1.txt\",\n+      \"sha256\": \"718a2eb714597c34033cc4d35af06b00b3718768cd60799800c6e487c777af64\",\n+      \"bytes\": 1418\n+    }\n+  ],\n+  \"test_module\": \"Tests/OnlineCumulativePotentialCanary.lean\",\n+  \"public_theorems\": 2,\n+  \"public_definitions\": 0,\n+  \"semantic_delta\": \"Concrete finite-real algebra witnesses only. No optimizer/actual algorithm/EReal/analytic performance theorem asserted.\",\n+  \"consumer_requirement\": \"FIRST conjunct of EACH theorem must specialize BanditRL.OnlineCumulativePotential.finite_regret_identity directly; numeric remaining conjuncts may use norm_num. Actual compiled VALUE occurrence of the production theorem must be verified.\",\n+  \"source_witnesses\": [\n+    \"T=1 positive retained terminal gap 1/36, truncated bound false.\",\n+    \"T=2 signed regularizer drift -1/2 and terminal y2=2 differs from unscored x2=100.\"\n+  ],\n+  \"shared_context\": \"Each complete header retains its exact three imports, noncomputable section/open Finset/namespace and all local lets. Shared combined Test file may deduplicate common context only with exact per-theorem reconstruction.\",\n+  \"chapter_state\": {\n+    \"chapter2\": \"partial\",\n+    \"accepted\": false,\n+    \"required_open_containers\": 7,\n+    \"future_claims_open\": 6,\n+    \"whole_B4\": \"OPEN\",\n+    \"Goal\": \"ACTIVE\",\n+    \"main_live_updated\": false\n+  },\n+  \"authorization\": \"Independent contract audit, exact canary seal, clean committed context, independent pre-canary review, then explicit parent authorization are required before Test BODY.\",\n+  \"ports\": {\n+    \"path\": \"runs/online-ch2-b4-finite-identity-20261011/exact-proof-and-canary-input-port-manifest-v1.json\",\n+    \"sha256\": \"de35d3906a468576f8e2089e120312cb33cfd11ef54b9dcaa33c532d9b52452c\",\n+    \"bytes\": 50593\n+  }\n+}"},{"sha":"bdd3774f284fb2ec3c3b11c486ac6bd0a6ab61e7","filename":"docs/contracts/online-ch2-b4-finite-identity-v1/canary-freeze-receipt-v1.json","status":"added","additions":1613,"deletions":0,"changes":1613,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/docs%2Fcontracts%2Fonline-ch2-b4-finite-identity-v1%2Fcanary-freeze-receipt-v1.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/docs%2Fcontracts%2Fonline-ch2-b4-finite-identity-v1%2Fcanary-freeze-receipt-v1.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/docs%2Fcontracts%2Fonline-ch2-b4-finite-identity-v1%2Fcanary-freeze-receipt-v1.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,1613 @@\n+{\n+  \"UTC\": \"2026-10-11T08:39:17.281142+00:00\",\n+  \"decision\": \"CANARY STATEMENTS SEALED; explicit Test BODY authorization remains pending clean committed context and independent review\",\