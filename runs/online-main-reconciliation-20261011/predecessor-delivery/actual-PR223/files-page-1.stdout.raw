ch2-b4-finite-identity-20261011%2Factual-freeze-commit-v2%2Fstaged-files.receipt.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-freeze-commit-v2%2Fstaged-files.receipt.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-freeze-commit-v2%2Fstaged-files.receipt.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,15 @@\n+{\n+  \"argv\": [\n+    \"git\",\n+    \"diff\",\n+    \"--cached\",\n+    \"--name-only\",\n+    \"-z\"\n+  ],\n+  \"cwd\": \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\",\n+  \"startUTC\": \"2026-10-11T08:12:14.797029+00:00\",\n+  \"endUTC\": \"2026-10-11T08:12:14.829023+00:00\",\n+  \"actual_exit\": 0,\n+  \"stdout_sha256\": \"f7dc369c59e849b914442711863aee8b7c3d8cc2eafd62cb78a6e50c34906402\",\n+  \"stderr_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"\n+}"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"runs/online-ch2-b4-finite-identity-20261011/actual-freeze-commit-v2/staged-files.stderr.raw","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-freeze-commit-v2%2Fstaged-files.stderr.raw","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-freeze-commit-v2%2Fstaged-files.stderr.raw","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-freeze-commit-v2%2Fstaged-files.stderr.raw?ref=c445c93f7e4cda1408279d614858c904e346ad47"},{"sha":"65d98fb4eb395a2b993f25f0ada92ed56494e1d3","filename":"runs/online-ch2-b4-finite-identity-20261011/actual-freeze-commit-v2/staged-files.stdout.raw","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-freeze-commit-v2%2Fstaged-files.stdout.raw","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-freeze-commit-v2%2Fstaged-files.stdout.raw","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-freeze-commit-v2%2Fstaged-files.stdout.raw?ref=c445c93f7e4cda1408279d614858c904e346ad47"},{"sha":"2e062aad2f482dcd8e6b4945ddea46e7e4b432b3","filename":"runs/online-ch2-b4-finite-identity-20261011/actual-freeze-commit-v2/status-after.receipt.json","status":"added","additions":13,"deletions":0,"changes":13,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-freeze-commit-v2%2Fstatus-after.receipt.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-freeze-commit-v2%2Fstatus-after.receipt.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-freeze-commit-v2%2Fstatus-after.receipt.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,13 @@\n+{\n+  \"argv\": [\n+    \"git\",\n+    \"status\",\n+    \"--porcelain\"\n+  ],\n+  \"cwd\": \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\",\n+  \"startUTC\": \"2026-10-11T08:12:19.909056+00:00\",\n+  \"endUTC\": \"2026-10-11T08:12:19.963606+00:00\",\n+  \"actual_exit\": 0,\n+  \"stdout_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n+  \"stderr_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"\n+}"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"runs/online-ch2-b4-finite-identity-20261011/actual-freeze-commit-v2/status-after.stderr.raw","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-freeze-commit-v2%2Fstatus-after.stderr.raw","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-freeze-commit-v2%2Fstatus-after.stderr.raw","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-freeze-commit-v2%2Fstatus-after.stderr.raw?ref=c445c93f7e4cda1408279d614858c904e346ad47"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"runs/online-ch2-b4-finite-identity-20261011/actual-freeze-commit-v2/status-after.stdout.raw","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-freeze-commit-v2%2Fstatus-after.stdout.raw","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-freeze-commit-v2%2Fstatus-after.stdout.raw","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-freeze-commit-v2%2Fstatus-after.stdout.raw?ref=c445c93f7e4cda1408279d614858c904e346ad47"},{"sha":"0229df948fb28a111a1f9f93882ffa3cf3f4e761","filename":"runs/online-ch2-b4-finite-identity-20261011/actual-gates/.gitattributes","status":"added","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2F.gitattributes","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2F.gitattributes","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2F.gitattributes?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,5 @@\n+* -text\n+* whitespace=cr-at-eol\n+*.raw -diff\n+*.zip -diff\n+*.png -diff"},{"sha":"086dbcb9dd4b1ca275e6aaed7ad694c95aa51780","filename":"runs/online-ch2-b4-finite-identity-20261011/actual-gates/contributor-contract-v1/capture-helper.py.txt","status":"added","additions":184,"deletions":0,"changes":184,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fcontributor-contract-v1%2Fcapture-helper.py.txt","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fcontributor-contract-v1%2Fcapture-helper.py.txt","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fcontributor-contract-v1%2Fcapture-helper.py.txt?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,184 @@\n+\"\"\"Gate recorder for prescient Euclidean and current-main governance, Python3.8 stdlib; no gate executed by preparation.\"\"\"\n+import argparse\n+import datetime\n+import hashlib\n+import json\n+import os\n+from pathlib import Path\n+import re\n+import subprocess\n+import sys\n+import zipfile\n+\n+\n+def utc():\n+    return datetime.datetime.now(datetime.timezone.utc).isoformat()\n+\n+\n+def digest(data):\n+    return hashlib.sha256(data).hexdigest()\n+\n+\n+def create(path, data):\n+    if not isinstance(data, bytes):\n+        data = (json.dumps(data, ensure_ascii=False, indent=2) + \"\\n\").encode(\"utf-8\")\n+    with path.open(\"xb\") as stream:\n+        stream.write(data)\n+\n+\n+def git(root, *args):\n+    proc = subprocess.run([\"git\"] + list(args), cwd=str(root), stdout=subprocess.PIPE,\n+                          stderr=subprocess.PIPE)\n+    if proc.returncode:\n+        raise RuntimeError(\"git failed: \" + repr(args) + \": \" + proc.stderr.decode(\"utf-8\", \"replace\"))\n+    return proc.stdout\n+\n+\n+def state(root):\n+    return {\"HEAD\": git(root, \"rev-parse\", \"HEAD\").decode().strip(),\n+            \"branch\": git(root, \"branch\", \"--show-current\").decode().strip(),\n+            \"status_porcelain_v1_z_hex\": git(root, \"status\", \"--porcelain=v1\", \"-z\").hex()}\n+\n+\n+def inventory(root, run, owned):\n+    # Start with tracked names, then explicitly filter to current source/input trees below.\n+    names = set(x.decode(\"utf-8\") for x in git(root, \"ls-files\", \"-z\", \"--cached\").split(b\"\\0\") if x)\n+    # Add new source paths, including ignored additions inside actual source trees.\n+    for folder in (\"BanditRLProof\", \"Tests\", \"tools\", \"website/scripts\", \"website/content\",\n+                   \"website/static\", \"research-wiki/contribution-contracts\"):\n+        for path in (root / folder).rglob(\"*\"):\n+            if path.is_file() and \"__pycache__\" not in path.parts:\n+                names.add(path.relative_to(root).as_posix())\n+    for name in (\"BanditRLProof.lean\", \"Tests.lean\", \"lean-toolchain\", \"lakefile.lean\",\n+                 \"lake-manifest.json\", \".gitattributes\"):\n+        names.add(name)\n+    names.update(owned)\n+    contract_roots = [name.rsplit(\"/\", 1)[0] for name in owned if name.startswith(\"docs/contracts/\")]\n+    extra = {\"README.md\", \"AGENTS.md\", \"CONTRIBUTING.md\", \"docs/contribution-contract.schema.json\", \"docs/contributor-codex-contract.md\", \"docs/theorem-publication-protocol.md\", \"docs/contracts/online-book-v1/coverage.json\", \"docs/proof-digestion-protocol.md\", \"docs/evidence-routed-memory-protocol.md\", \"docs/openai-math-assimilation-protocol.md\", \"research-wiki/openai-math-2026-intake.json\", \"runs/process_memory.json\"}\n+    names = {name for name in names if selected_for_zip(name, contract_roots) or name in extra}\n+    result = []\n+    for name in sorted(names):\n+        path = root / name\n+        resolved = path.resolve()\n+        if resolved == run or run in resolved.parents:\n+            continue\n+        if root not in resolved.parents or path.is_symlink() or not path.is_file():\n+            raise RuntimeError(\"Input must be an existing ordinary repository file: \" + name)\n+        data = path.read_bytes()\n+        result.append({\"path\": name, \"raw_sha256\": digest(data), \"bytes\": len(data)})\n+    return result\n+\n+\n+def selected_for_zip(name, contract_roots):\n+    # Historical runs are excluded from both selected RAW inventory and ZIP; clean HEAD binds them.\n+    if name == \"runs/process_memory.json\":\n+        return True\n+    if name.startswith(\"runs/\"):\n+        return False\n+    prefixes = (\"BanditRLProof/\", \"Tests/\", \"tools/\", \"website/scripts/\",\n+                \"website/content/\", \"website/static/\", \"research-wiki/contribution-contracts/\")\n+    exact = {\"README.md\", \"AGENTS.md\", \"CONTRIBUTING.md\", \"docs/contribution-contract.schema.json\", \"docs/contributor-codex-contract.md\", \"docs/theorem-publication-protocol.md\", \"docs/contracts/online-book-v1/coverage.json\", \"BanditRLProof.lean\", \"Tests.lean\", \"lean-toolchain\", \"lakefile.lean\",\n+             \"lake-manifest.json\", \".gitattributes\", \"docs/proof-digestion-protocol.md\", \"docs/evidence-routed-memory-protocol.md\", \"docs/openai-math-assimilation-protocol.md\", \"research-wiki/openai-math-2026-intake.json\"}\n+    return (name in exact or name.startswith(prefixes) or\n+            any(name.startswith(folder.rstrip(\"/\") + \"/\") for folder in contract_roots))\n+\n+\n+def main():\n+    parser = argparse.ArgumentParser()\n+    parser.add_argument(\"--root\", required=True)\n+    parser.add_argument(\"--run\", required=True, help=\"New evidence namespace beneath runs/ or an already ignored tmp/ namespace\")\n+    parser.add_argument(\"--label\", required=True)\n+    parser.add_argument(\"--owned-source\", action=\"append\", default=[])\n+    parser.add_argument(\"--leaf-contract\", action=\"append\", required=True,\n+                        help=\"Current leaf docs/contracts subtree to include in ZIP\")\n+    parser.add_argument(\"argv\", nargs=argparse.REMAINDER)\n+    args = parser.parse_args()\n+    root = Path(args.root).resolve()\n+    run = (root / args.run).resolve()\n+    argv = args.argv[1:] if args.argv[:1] == [\"--\"] else args.argv\n+    if not argv or not re.fullmatch(r\"[A-Za-z0-9][A-Za-z0-9_.-]*\", args.label):\n+        raise RuntimeError(\"Exact argv and safe unique label required\")\n+    if root / \"runs\" not in run.parents and root / \"tmp\" not in run.parents:\n+        raise RuntimeError(\"Evidence namespace must be beneath root/runs/ or root/tmp/\")\n+    if root / \"tmp\" in run.parents:\n+        probe = run.relative_to(root).as_posix() + \"/.capture-ignore-probe\"\n+        result = subprocess.run([\"git\", \"check-ignore\", \"--quiet\", \"--\", probe],\n+                                cwd=str(root), stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n+        if result.returncode != 0:\n+            raise RuntimeError(\"tmp evidence namespace must already be ignored; no ignore rule changes permitted\")\n+    for folder in args.leaf_contract:\n+        resolved = (root / folder).resolve()\n+        if root / \"docs\" / \"contracts\" not in resolved.parents:\n+            raise RuntimeError(\"Leaf contract must be a docs/contracts subtree\")\n+        if not resolved.is_dir():\n+            raise RuntimeError(\"Leaf contract subtree missing\")\n+        args.owned_source.extend(path.relative_to(root).as_posix()\n+                                 for path in resolved.rglob(\"*\") if path.is_file())\n+    dest = run / args.label\n+    dest.mkdir(parents=True, exist_ok=False)\n+    helper = Path(__file__).resolve().read_bytes()\n+    create(dest / \"capture-helper.py.txt\", helper)\n+    record = {\"argv\": argv, \"cwd\": str(root), \"helper_sha256\": digest(helper),\n+              \"evidence_namespace_excluded\": run.relative_to(root).as_posix(),\n+              \"actual_evidence_namespace\": str(run),\n+              \"evidence_port_boundary\": \"Receipts originate here; any later exact copy into RUN requires a separate port manifest. No contemporaneous canonical RUN claim.\",\n+              \"owned_source\": args.owned_source, \"command_started\": False, \"actual_exit\": None,\n+              \"ZIP_is_whole_repository_archive\": False,\n+              \"ZIP_scope\": \"Selected active source/input trees and current leaf contracts; historical runs excluded; curated current runs/process_memory.json included\",\n+              \"full_RAW_inventory_scope\": \"Every library/Test source and enumerated current harness/site source/input tree plus current leaf contracts. Historical archives not separately RAW-hashed (curated current process memory is an active input); committed HEAD and clean Git status bind repository state.\",\n+              \"leaf_contract_roots\": args.leaf_contract}\n+    try:\n+        before = inventory(root, run, args.owned_source)\n+        record[\"pre_git\"] = state(root)\n+        if record[\"pre_git\"][\"status_porcelain_v1_z_hex\"]:\n+            raise RuntimeError(\"Clean committed candidate required before gate\")\n+        create(dest / \"pre-source-inputs.json\", before)\n+        selected = [row for row in before if selected_for_zip(row[\"path\"], args.leaf_contract)]\n+        create(dest / \"pre-selected-ZIP-inputs.json\", selected)\n+        record[\"ZIP_selected_files\"] = len(selected)\n+        record[\"full_RAW_inventory_files\"] = len(before)\n+        with zipfile.ZipFile(str(dest / \"pre-selected-source-raw.zip\"), \"x\", zipfile.ZIP_DEFLATED) as archive:\n+            for row in selected:\n+                data = (root / row[\"path\"]).read_bytes()\n+                if digest(data) != row[\"raw_sha256\"]:\n+                    raise RuntimeError(\"Source changed during snapshot: \" + row[\"path\"])\n+                archive.writestr(row[\"path\"], data)\n+        if any(digest((root / row[\"path\"]).read_bytes()) != row[\"raw_sha256\"] for row in selected):\n+            raise RuntimeError(\"Selected ZIP source changed before command\")\n+        if state(root) != record[\"pre_git\"]:\n+            raise RuntimeError(\"Git changed before command\")\n+        record[\"precommand_check\"] = \"Selected ZIP RAW hashes and Git state; no redundant second full inventory. Full pre/post manifests remain authoritative.\"\n+        record[\"start_utc\"] = utc()\n+        record[\"command_started\"] = True\n+        with (dest / \"stdout.raw\").open(\"xb\") as out, (dest / \"stderr.raw\").open(\"xb\") as err:\n+            proc = subprocess.run(argv, cwd=str(root), stdout=out, stderr=err,\n+                                  env=dict(os.environ, PYTHONDONTWRITEBYTECODE=\"1\"))\n+        record[\"end_utc\"] = utc()\n+        record[\"actual_exit\"] = proc.returncode\n+        after = inventory(root, run, args.owned_source)\n+        create(dest / \"post-source-inputs.json\", after)\n+        record[\"post_git\"] = state(root)\n+        record[\"complete_source_path_set_and_RAW_unchanged\"] = before == after\n+        record[\"HEAD_and_branch_unchanged\"] = all(record[\"pre_git\"][k] == record[\"post_git\"][k]\n+                                                 for k in (\"HEAD\", \"branch\"))\n+        record[\"git_status_unchanged\"] = record[\"pre_git\"] == record[\"post_git\"]\n+        record[\"capture_integrity_ok\"] = before == after and record[\"HEAD_and_branch_unchanged\"] and record[\"git_status_unchanged\"]\n+    except Exception as exc:\n+        record[\"capture_error\"] = repr(exc)\n+        record[\"capture_integrity_ok\"] = False\n+        record.setdefault(\"end_utc\", utc())\n+    for name in (\"stdout.raw\", \"stderr.raw\", \"pre-source-inputs.json\", \"post-source-inputs.json\",\n+                 \"pre-selected-ZIP-inputs.json\", \"pre-selected-source-raw.zip\"):\n+        path = dest / name\n+        if path.exists():\n+            record[name + \"_sha256\"] = digest(path.read_bytes())\n+    create(dest / \"receipt.json\", record)\n+    print(json.dumps({\"receipt\": str(dest / \"receipt.json\"), \"actual_exit\": record[\"actual_exit\"],\n+                      \"capture_integrity_ok\": record[\"capture_integrity_ok\"]}))\n+    if not record[\"capture_integrity_ok\"]:\n+        return 125\n+    return record[\"actual_exit\"] if record[\"actual_exit\"] is not None else 125\n+\n+\n+if __name__ == \"__main__\":\n+    sys.exit(main())"},{"sha":"7d2a2e5648b34c6129d688e8d0b4f74c043bd388","filename":"runs/online-ch2-b4-finite-identity-20261011/actual-gates/contributor-contract-v1/post-source-inputs.json","status":"added","additions":6612,"deletions":0,"changes":6612,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fcontributor-contract-v1%2Fpost-source-inputs.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fcontributor-contract-v1%2Fpost-source-inputs.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fcontributor-contract-v1%2Fpost-source-inputs.json?ref=c445c93f7e4cda1408279d614858c904e346ad47"},{"sha":"7d2a2e5648b34c6129d688e8d0b4f74c043bd388","filename":"runs/online-ch2-b4-finite-identity-20261011/actual-gates/contributor-contract-v1/pre-selected-ZIP-inputs.json","status":"added","additions":6612,"deletions":0,"changes":6612,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fcontributor-contract-v1%2Fpre-selected-ZIP-inputs.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fcontributor-contract-v1%2Fpre-selected-ZIP-inputs.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fcontributor-contract-v1%2Fpre-selected-ZIP-inputs.json?ref=c445c93f7e4cda1408279d614858c904e346ad47"},{"sha":"54aa53fc77a449eebbd538d19ee4d40200686283","filename":"runs/online-ch2-b4-finite-identity-20261011/actual-gates/contributor-contract-v1/pre-selected-source-raw.zip","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fcontributor-contract-v1%2Fpre-selected-source-raw.zip","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fcontributor-contract-v1%2Fpre-selected-source-raw.zip","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fcontributor-contract-v1%2Fpre-selected-source-raw.zip?ref=c445c93f7e4cda1408279d614858c904e346ad47"},{"sha":"7d2a2e5648b34c6129d688e8d0b4f74c043bd388","filename":"runs/online-ch2-b4-finite-identity-20261011/actual-gates/contributor-contract-v1/pre-source-inputs.json","status":"added","additions":6612,"deletions":0,"changes":6612,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fcontributor-contract-v1%2Fpre-source-inputs.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fcontributor-contract-v1%2Fpre-source-inputs.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fcontributor-contract-v1%2Fpre-source-inputs.json?ref=c445c93f7e4cda1408279d614858c904e346ad47"},{"sha":"a4c35b3e3a2a3924fba228160965d19be30bd6e4","filename":"runs/online-ch2-b4-finite-identity-20261011/actual-gates/contributor-contract-v1/receipt.json","status":"added","additions":67,"deletions":0,"changes":67,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fcontributor-contract-v1%2Freceipt.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fcontributor-contract-v1%2Freceipt.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fcontributor-contract-v1%2Freceipt.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,67 @@\n+{\n+  \"argv\": [\n+    \"C:/Users/admin/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/python.exe\",\n+    \"-B\",\n+    \"-X\",\n+    \"utf8\",\n+    \"tools/check_contributor_contract.py\",\n+    \"--base\",\n+    \"b8a4b13ca96709b1adff0d1907814dc3d3d76cc8\"\n+  ],\n+  \"cwd\": \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\",\n+  \"helper_sha256\": \"bafe784fad8810f866105ffd19e3504f70ebf1e28949611549d584630a5b7ce8\",\n+  \"evidence_namespace_excluded\": \"tmp/online-ch2-b4-finite-identity-gates-20261011\",\n+  \"actual_evidence_namespace\": \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\\\\tmp\\\\online-ch2-b4-finite-identity-gates-20261011\",\n+  \"evidence_port_boundary\": \"Receipts originate here; any later exact copy into RUN requires a separate port manifest. No contemporaneous canonical RUN claim.\",\n+  \"owned_source\": [\n+    \"AGENTS.md\",\n+    \"CONTRIBUTING.md\",\n+    \"docs/contributor-codex-contract.md\",\n+    \"docs/theorem-publication-protocol.md\",\n+    \"docs/proof-digestion-protocol.md\",\n+    \"docs/evidence-routed-memory-protocol.md\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/.gitattributes\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/canary-freeze-proposal-v1.json\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/canary-freeze-receipt-v1.json\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/canary-neutral-one-round-frozen-header-v1.txt\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/canary-neutral-two-round-frozen-header-v1.txt\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/leaf-freeze-receipt-v1.json\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/neutral-frozen-header-v1.txt\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/precanary-preparation-addendum-v1.json\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/proof-digestion-record-v1.json\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/source-contract-proposal-v1.json\"\n+  ],\n+  \"command_started\": true,\n+  \"actual_exit\": 0,\n+  \"ZIP_is_whole_repository_archive\": false,\n+  \"ZIP_scope\": \"Selected active source/input trees and current leaf contracts; historical runs excluded; curated current runs/process_memory.json included\",\n+  \"full_RAW_inventory_scope\": \"Every library/Test source and enumerated current harness/site source/input tree plus current leaf contracts. Historical archives not separately RAW-hashed (curated current process memory is an active input); committed HEAD and clean Git status bind repository state.\",\n+  \"leaf_contract_roots\": [\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1\"\n+  ],\n+  \"pre_git\": {\n+    \"HEAD\": \"7b372d79fcd3228d8d2cece73ad0181f94a70cf1\",\n+    \"branch\": \"codex/research-online-ch2-b4-finite-identity\",\n+    \"status_porcelain_v1_z_hex\": \"\"\n+  },\n+  \"ZIP_selected_files\": 1322,\n+  \"full_RAW_inventory_files\": 1322,\n+  \"precommand_check\": \"Selected ZIP RAW hashes and Git state; no redundant second full inventory. Full pre/post manifests remain authoritative.\",\n+  \"start_utc\": \"2026-10-11T09:03:56.977468+00:00\",\n+  \"end_utc\": \"2026-10-11T09:03:57.086280+00:00\",\n+  \"post_git\": {\n+    \"HEAD\": \"7b372d79fcd3228d8d2cece73ad0181f94a70cf1\",\n+    \"branch\": \"codex/research-online-ch2-b4-finite-identity\",\n+    \"status_porcelain_v1_z_hex\": \"\"\n+  },\n+  \"complete_source_path_set_and_RAW_unchanged\": true,\n+  \"HEAD_and_branch_unchanged\": true,\n+  \"git_status_unchanged\": true,\n+  \"capture_integrity_ok\": true,\n+  \"stdout.raw_sha256\": \"3a4f4d6e3054cc5ca9f4cc407138717cb1df54cd2fd4df06840441aaf0c0c71b\",\n+  \"stderr.raw_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n+  \"pre-source-inputs.json_sha256\": \"2b5c8985e0faf3d033c5db0586cfdf423ed1217869aa12992aca615bc1b49d07\",\n+  \"post-source-inputs.json_sha256\": \"2b5c8985e0faf3d033c5db0586cfdf423ed1217869aa12992aca615bc1b49d07\",\n+  \"pre-selected-ZIP-inputs.json_sha256\": \"2b5c8985e0faf3d033c5db0586cfdf423ed1217869aa12992aca615bc1b49d07\",\n+  \"pre-selected-source-raw.zip_sha256\": \"7189231ead6d82414e93ec34324e725c2568e9385f0438bbaadeec78284b0e24\"\n+}"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"runs/online-ch2-b4-finite-identity-20261011/actual-gates/contributor-contract-v1/stderr.raw","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fcontributor-contract-v1%2Fstderr.raw","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fcontributor-contract-v1%2Fstderr.raw","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fcontributor-contract-v1%2Fstderr.raw?ref=c445c93f7e4cda1408279d614858c904e346ad47"},{"sha":"3a3d6945087ef9ec03d45b3d6764fd4b58028800","filename":"runs/online-ch2-b4-finite-identity-20261011/actual-gates/contributor-contract-v1/stdout.raw","status":"added","additions":10,"deletions":0,"changes":10,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fcontributor-contract-v1%2Fstdout.raw","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fcontributor-contract-v1%2Fstdout.raw","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Fcontributor-contract-v1%2Fstdout.raw?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,10 @@\n+contributor base: b8a4b13ca96709b1adff0d1907814dc3d3d76cc8\r\n+changed paths: 498\r\n+affected production paths: 5\r\n+changed contribution contracts: 1\r\n+Contributor contract passed.\r\n+ - covered: BanditRLProof.lean\r\n+ - covered: BanditRLProof/OnlineCumulativePotential.lean\r\n+ - covered: website/content/chapters.json\r\n+ - covered: website/content/highlights.json\r\n+ - covered: website/content/readings.json\r"},{"sha":"086dbcb9dd4b1ca275e6aaed7ad694c95aa51780","filename":"runs/online-ch2-b4-finite-identity-20261011/actual-gates/full-harness-v1/capture-helper.py.txt","status":"added","additions":184,"deletions":0,"changes":184,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Ffull-harness-v1%2Fcapture-helper.py.txt","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Ffull-harness-v1%2Fcapture-helper.py.txt","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Ffull-harness-v1%2Fcapture-helper.py.txt?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,184 @@\n+\"\"\"Gate recorder for prescient Euclidean and current-main governance, Python3.8 stdlib; no gate executed by preparation.\"\"\"\n+import argparse\n+import datetime\n+import hashlib\n+import json\n+import os\n+from pathlib import Path\n+import re\n+import subprocess\n+import sys\n+import zipfile\n+\n+\n+def utc():\n+    return datetime.datetime.now(datetime.timezone.utc).isoformat()\n+\n+\n+def digest(data):\n+    return hashlib.sha256(data).hexdigest()\n+\n+\n+def create(path, data):\n+    if not isinstance(data, bytes):\n+        data = (json.dumps(data, ensure_ascii=False, indent=2) + \"\\n\").encode(\"utf-8\")\n+    with path.open(\"xb\") as stream:\n+        stream.write(data)\n+\n+\n+def git(root, *args):\n+    proc = subprocess.run([\"git\"] + list(args), cwd=str(root), stdout=subprocess.PIPE,\n+                          stderr=subprocess.PIPE)\n+    if proc.returncode:\n+        raise RuntimeError(\"git failed: \" + repr(args) + \": \" + proc.stderr.decode(\"utf-8\", \"replace\"))\n+    return proc.stdout\n+\n+\n+def state(root):\n+    return {\"HEAD\": git(root, \"rev-parse\", \"HEAD\").decode().strip(),\n+            \"branch\": git(root, \"branch\", \"--show-current\").decode().strip(),\n+            \"status_porcelain_v1_z_hex\": git(root, \"status\", \"--porcelain=v1\", \"-z\").hex()}\n+\n+\n+def inventory(root, run, owned):\n+    # Start with tracked names, then explicitly filter to current source/input trees below.\n+    names = set(x.decode(\"utf-8\") for x in git(root, \"ls-files\", \"-z\", \"--cached\").split(b\"\\0\") if x)\n+    # Add new source paths, including ignored additions inside actual source trees.\n+    for folder in (\"BanditRLProof\", \"Tests\", \"tools\", \"website/scripts\", \"website/content\",\n+                   \"website/static\", \"research-wiki/contribution-contracts\"):\n+        for path in (root / folder).rglob(\"*\"):\n+            if path.is_file() and \"__pycache__\" not in path.parts:\n+                names.add(path.relative_to(root).as_posix())\n+    for name in (\"BanditRLProof.lean\", \"Tests.lean\", \"lean-toolchain\", \"lakefile.lean\",\n+                 \"lake-manifest.json\", \".gitattributes\"):\n+        names.add(name)\n+    names.update(owned)\n+    contract_roots = [name.rsplit(\"/\", 1)[0] for name in owned if name.startswith(\"docs/contracts/\")]\n+    extra = {\"README.md\", \"AGENTS.md\", \"CONTRIBUTING.md\", \"docs/contribution-contract.schema.json\", \"docs/contributor-codex-contract.md\", \"docs/theorem-publication-protocol.md\", \"docs/contracts/online-book-v1/coverage.json\", \"docs/proof-digestion-protocol.md\", \"docs/evidence-routed-memory-protocol.md\", \"docs/openai-math-assimilation-protocol.md\", \"research-wiki/openai-math-2026-intake.json\", \"runs/process_memory.json\"}\n+    names = {name for name in names if selected_for_zip(name, contract_roots) or name in extra}\n+    result = []\n+    for name in sorted(names):\n+        path = root / name\n+        resolved = path.resolve()\n+        if resolved == run or run in resolved.parents:\n+            continue\n+        if root not in resolved.parents or path.is_symlink() or not path.is_file():\n+            raise RuntimeError(\"Input must be an existing ordinary repository file: \" + name)\n+        data = path.read_bytes()\n+        result.append({\"path\": name, \"raw_sha256\": digest(data), \"bytes\": len(data)})\n+    return result\n+\n+\n+def selected_for_zip(name, contract_roots):\n+    # Historical runs are excluded from both selected RAW inventory and ZIP; clean HEAD binds them.\n+    if name == \"runs/process_memory.json\":\n+        return True\n+    if name.startswith(\"runs/\"):\n+        return False\n+    prefixes = (\"BanditRLProof/\", \"Tests/\", \"tools/\", \"website/scripts/\",\n+                \"website/content/\", \"website/static/\", \"research-wiki/contribution-contracts/\")\n+    exact = {\"README.md\", \"AGENTS.md\", \"CONTRIBUTING.md\", \"docs/contribution-contract.schema.json\", \"docs/contributor-codex-contract.md\", \"docs/theorem-publication-protocol.md\", \"docs/contracts/online-book-v1/coverage.json\", \"BanditRLProof.lean\", \"Tests.lean\", \"lean-toolchain\", \"lakefile.lean\",\n+             \"lake-manifest.json\", \".gitattributes\", \"docs/proof-digestion-protocol.md\", \"docs/evidence-routed-memory-protocol.md\", \"docs/openai-math-assimilation-protocol.md\", \"research-wiki/openai-math-2026-intake.json\"}\n+    return (name in exact or name.startswith(prefixes) or\n+            any(name.startswith(folder.rstrip(\"/\") + \"/\") for folder in contract_roots))\n+\n+\n+def main():\n+    parser = argparse.ArgumentParser()\n+    parser.add_argument(\"--root\", required=True)\n+    parser.add_argument(\"--run\", required=True, help=\"New evidence namespace beneath runs/ or an already ignored tmp/ namespace\")\n+    parser.add_argument(\"--label\", required=True)\n+    parser.add_argument(\"--owned-source\", action=\"append\", default=[])\n+    parser.add_argument(\"--leaf-contract\", action=\"append\", required=True,\n+                        help=\"Current leaf docs/contracts subtree to include in ZIP\")\n+    parser.add_argument(\"argv\", nargs=argparse.REMAINDER)\n+    args = parser.parse_args()\n+    root = Path(args.root).resolve()\n+    run = (root / args.run).resolve()\n+    argv = args.argv[1:] if args.argv[:1] == [\"--\"] else args.argv\n+    if not argv or not re.fullmatch(r\"[A-Za-z0-9][A-Za-z0-9_.-]*\", args.label):\n+        raise RuntimeError(\"Exact argv and safe unique label required\")\n+    if root / \"runs\" not in run.parents and root / \"tmp\" not in run.parents:\n+        raise RuntimeError(\"Evidence namespace must be beneath root/runs/ or root/tmp/\")\n+    if root / \"tmp\" in run.parents:\n+        probe = run.relative_to(root).as_posix() + \"/.capture-ignore-probe\"\n+        result = subprocess.run([\"git\", \"check-ignore\", \"--quiet\", \"--\", probe],\n+                                cwd=str(root), stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n+        if result.returncode != 0:\n+            raise RuntimeError(\"tmp evidence namespace must already be ignored; no ignore rule changes permitted\")\n+    for folder in args.leaf_contract:\n+        resolved = (root / folder).resolve()\n+        if root / \"docs\" / \"contracts\" not in resolved.parents:\n+            raise RuntimeError(\"Leaf contract must be a docs/contracts subtree\")\n+        if not resolved.is_dir():\n+            raise RuntimeError(\"Leaf contract subtree missing\")\n+        args.owned_source.extend(path.relative_to(root).as_posix()\n+                                 for path in resolved.rglob(\"*\") if path.is_file())\n+    dest = run / args.label\n+    dest.mkdir(parents=True, exist_ok=False)\n+    helper = Path(__file__).resolve().read_bytes()\n+    create(dest / \"capture-helper.py.txt\", helper)\n+    record = {\"argv\": argv, \"cwd\": str(root), \"helper_sha256\": digest(helper),\n+              \"evidence_namespace_excluded\": run.relative_to(root).as_posix(),\n+              \"actual_evidence_namespace\": str(run),\n+              \"evidence_port_boundary\": \"Receipts originate here; any later exact copy into RUN requires a separate port manifest. No contemporaneous canonical RUN claim.\",\n+              \"owned_source\": args.owned_source, \"command_started\": False, \"actual_exit\": None,\n+              \"ZIP_is_whole_repository_archive\": False,\n+              \"ZIP_scope\": \"Selected active source/input trees and current leaf contracts; historical runs excluded; curated current runs/process_memory.json included\",\n+              \"full_RAW_inventory_scope\": \"Every library/Test source and enumerated current harness/site source/input tree plus current leaf contracts. Historical archives not separately RAW-hashed (curated current process memory is an active input); committed HEAD and clean Git status bind repository state.\",\n+              \"leaf_contract_roots\": args.leaf_contract}\n+    try:\n+        before = inventory(root, run, args.owned_source)\n+        record[\"pre_git\"] = state(root)\n+        if record[\"pre_git\"][\"status_porcelain_v1_z_hex\"]:\n+            raise RuntimeError(\"Clean committed candidate required before gate\")\n+        create(dest / \"pre-source-inputs.json\", before)\n+        selected = [row for row in before if selected_for_zip(row[\"path\"], args.leaf_contract)]\n+        create(dest / \"pre-selected-ZIP-inputs.json\", selected)\n+        record[\"ZIP_selected_files\"] = len(selected)\n+        record[\"full_RAW_inventory_files\"] = len(before)\n+        with zipfile.ZipFile(str(dest / \"pre-selected-source-raw.zip\"), \"x\", zipfile.ZIP_DEFLATED) as archive:\n+            for row in selected:\n+                data = (root / row[\"path\"]).read_bytes()\n+                if digest(data) != row[\"raw_sha256\"]:\n+                    raise RuntimeError(\"Source changed during snapshot: \" + row[\"path\"])\n+                archive.writestr(row[\"path\"], data)\n+        if any(digest((root / row[\"path\"]).read_bytes()) != row[\"raw_sha256\"] for row in selected):\n+            raise RuntimeError(\"Selected ZIP source changed before command\")\n+        if state(root) != record[\"pre_git\"]:\n+            raise RuntimeError(\"Git changed before command\")\n+        record[\"precommand_check\"] = \"Selected ZIP RAW hashes and Git state; no redundant second full inventory. Full pre/post manifests remain authoritative.\"\n+        record[\"start_utc\"] = utc()\n+        record[\"command_started\"] = True\n+        with (dest / \"stdout.raw\").open(\"xb\") as out, (dest / \"stderr.raw\").open(\"xb\") as err:\n+            proc = subprocess.run(argv, cwd=str(root), stdout=out, stderr=err,\n+                                  env=dict(os.environ, PYTHONDONTWRITEBYTECODE=\"1\"))\n+        record[\"end_utc\"] = utc()\n+        record[\"actual_exit\"] = proc.returncode\n+        after = inventory(root, run, args.owned_source)\n+        create(dest / \"post-source-inputs.json\", after)\n+        record[\"post_git\"] = state(root)\n+        record[\"complete_source_path_set_and_RAW_unchanged\"] = before == after\n+        record[\"HEAD_and_branch_unchanged\"] = all(record[\"pre_git\"][k] == record[\"post_git\"][k]\n+                                                 for k in (\"HEAD\", \"branch\"))\n+        record[\"git_status_unchanged\"] = record[\"pre_git\"] == record[\"post_git\"]\n+        record[\"capture_integrity_ok\"] = before == after and record[\"HEAD_and_branch_unchanged\"] and record[\"git_status_unchanged\"]\n+    except Exception as exc:\n+        record[\"capture_error\"] = repr(exc)\n+        record[\"capture_integrity_ok\"] = False\n+        record.setdefault(\"end_utc\", utc())\n+    for name in (\"stdout.raw\", \"stderr.raw\", \"pre-source-inputs.json\", \"post-source-inputs.json\",\n+                 \"pre-selected-ZIP-inputs.json\", \"pre-selected-source-raw.zip\"):\n+        path = dest / name\n+        if path.exists():\n+            record[name + \"_sha256\"] = digest(path.read_bytes())\n+    create(dest / \"receipt.json\", record)\n+    print(json.dumps({\"receipt\": str(dest / \"receipt.json\"), \"actual_exit\": record[\"actual_exit\"],\n+                      \"capture_integrity_ok\": record[\"capture_integrity_ok\"]}))\n+    if not record[\"capture_integrity_ok\"]:\n+        return 125\n+    return record[\"actual_exit\"] if record[\"actual_exit\"] is not None else 125\n+\n+\n+if __name__ == \"__main__\":\n+    sys.exit(main())"},{"sha":"7d2a2e5648b34c6129d688e8d0b4f74c043bd388","filename":"runs/online-ch2-b4-finite-identity-20261011/actual-gates/full-harness-v1/post-source-inputs.json","status":"added","additions":6612,"deletions":0,"changes":6612,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Ffull-harness-v1%2Fpost-source-inputs.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Ffull-harness-v1%2Fpost-source-inputs.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Ffull-harness-v1%2Fpost-source-inputs.json?ref=c445c93f7e4cda1408279d614858c904e346ad47"},{"sha":"7d2a2e5648b34c6129d688e8d0b4f74c043bd388","filename":"runs/online-ch2-b4-finite-identity-20261011/actual-gates/full-harness-v1/pre-selected-ZIP-inputs.json","status":"added","additions":6612,"deletions":0,"changes":6612,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Ffull-harness-v1%2Fpre-selected-ZIP-inputs.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Ffull-harness-v1%2Fpre-selected-ZIP-inputs.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Ffull-harness-v1%2Fpre-selected-ZIP-inputs.json?ref=c445c93f7e4cda1408279d614858c904e346ad47"},{"sha":"3274dbfe5f173d93ad8021ea66fc0b6b5dc7c88c","filename":"runs/online-ch2-b4-finite-identity-20261011/actual-gates/full-harness-v1/pre-selected-source-raw.zip","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Ffull-harness-v1%2Fpre-selected-source-raw.zip","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Ffull-harness-v1%2Fpre-selected-source-raw.zip","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Ffull-harness-v1%2Fpre-selected-source-raw.zip?ref=c445c93f7e4cda1408279d614858c904e346ad47"},{"sha":"7d2a2e5648b34c6129d688e8d0b4f74c043bd388","filename":"runs/online-ch2-b4-finite-identity-20261011/actual-gates/full-harness-v1/pre-source-inputs.json","status":"added","additions":6612,"deletions":0,"changes":6612,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Ffull-harness-v1%2Fpre-source-inputs.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Ffull-harness-v1%2Fpre-source-inputs.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Ffull-harness-v1%2Fpre-source-inputs.json?ref=c445c93f7e4cda1408279d614858c904e346ad47"},{"sha":"596b558390831451f497a4930b47ac5036b6633e","filename":"runs/online-ch2-b4-finite-identity-20261011/actual-gates/full-harness-v1/receipt.json","status":"added","additions":65,"deletions":0,"changes":65,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Ffull-harness-v1%2Freceipt.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Ffull-harness-v1%2Freceipt.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Ffull-harness-v1%2Freceipt.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,65 @@\n+{\n+  \"argv\": [\n+    \"python\",\n+    \"-X\",\n+    \"utf8\",\n+    \"tools/bandit.py\",\n+    \"check\"\n+  ],\n+  \"cwd\": \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\",\n+  \"helper_sha256\": \"bafe784fad8810f866105ffd19e3504f70ebf1e28949611549d584630a5b7ce8\",\n+  \"evidence_namespace_excluded\": \"tmp/online-ch2-b4-finite-identity-gates-20261011\",\n+  \"actual_evidence_namespace\": \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\\\\tmp\\\\online-ch2-b4-finite-identity-gates-20261011\",\n+  \"evidence_port_boundary\": \"Receipts originate here; any later exact copy into RUN requires a separate port manifest. No contemporaneous canonical RUN claim.\",\n+  \"owned_source\": [\n+    \"AGENTS.md\",\n+    \"CONTRIBUTING.md\",\n+    \"docs/contributor-codex-contract.md\",\n+    \"docs/theorem-publication-protocol.md\",\n+    \"docs/proof-digestion-protocol.md\",\n+    \"docs/evidence-routed-memory-protocol.md\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/.gitattributes\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/canary-freeze-proposal-v1.json\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/canary-freeze-receipt-v1.json\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/canary-neutral-one-round-frozen-header-v1.txt\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/canary-neutral-two-round-frozen-header-v1.txt\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/leaf-freeze-receipt-v1.json\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/neutral-frozen-header-v1.txt\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/precanary-preparation-addendum-v1.json\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/proof-digestion-record-v1.json\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/source-contract-proposal-v1.json\"\n+  ],\n+  \"command_started\": true,\n+  \"actual_exit\": 0,\n+  \"ZIP_is_whole_repository_archive\": false,\n+  \"ZIP_scope\": \"Selected active source/input trees and current leaf contracts; historical runs excluded; curated current runs/process_memory.json included\",\n+  \"full_RAW_inventory_scope\": \"Every library/Test source and enumerated current harness/site source/input tree plus current leaf contracts. Historical archives not separately RAW-hashed (curated current process memory is an active input); committed HEAD and clean Git status bind repository state.\",\n+  \"leaf_contract_roots\": [\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1\"\n+  ],\n+  \"pre_git\": {\n+    \"HEAD\": \"7b372d79fcd3228d8d2cece73ad0181f94a70cf1\",\n+    \"branch\": \"codex/research-online-ch2-b4-finite-identity\",\n+    \"status_porcelain_v1_z_hex\": \"\"\n+  },\n+  \"ZIP_selected_files\": 1322,\n+  \"full_RAW_inventory_files\": 1322,\n+  \"precommand_check\": \"Selected ZIP RAW hashes and Git state; no redundant second full inventory. Full pre/post manifests remain authoritative.\",\n+  \"start_utc\": \"2026-10-11T09:13:29.230488+00:00\",\n+  \"end_utc\": \"2026-10-11T09:17:32.318399+00:00\",\n+  \"post_git\": {\n+    \"HEAD\": \"7b372d79fcd3228d8d2cece73ad0181f94a70cf1\",\n+    \"branch\": \"codex/research-online-ch2-b4-finite-identity\",\n+    \"status_porcelain_v1_z_hex\": \"\"\n+  },\n+  \"complete_source_path_set_and_RAW_unchanged\": true,\n+  \"HEAD_and_branch_unchanged\": true,\n+  \"git_status_unchanged\": true,\n+  \"capture_integrity_ok\": true,\n+  \"stdout.raw_sha256\": \"9a8b4131daee812ca5eb5e74d5c1286dfcd1df14c7984d4e72d1f5c581aea236\",\n+  \"stderr.raw_sha256\": \"9b0bb3011ced45f4bec2b894f482e32ae18fa280a12d41ad1f6dba527213e974\",\n+  \"pre-source-inputs.json_sha256\": \"2b5c8985e0faf3d033c5db0586cfdf423ed1217869aa12992aca615bc1b49d07\",\n+  \"post-source-inputs.json_sha256\": \"2b5c8985e0faf3d033c5db0586cfdf423ed1217869aa12992aca615bc1b49d07\",\n+  \"pre-selected-ZIP-inputs.json_sha256\": \"2b5c8985e0faf3d033c5db0586cfdf423ed1217869aa12992aca615bc1b49d07\",\n+  \"pre-selected-source-raw.zip_sha256\": \"a5bdf8542d06d30243237c2d6a8b5709ef7bde2e23558d69858ef50335371877\"\n+}"},{"sha":"b1ac8ab466d65eb500f115f3b5055f411f97b538","filename":"runs/online-ch2-b4-finite-identity-20261011/actual-gates/full-harness-v1/stderr.raw","status":"added","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Ffull-harness-v1%2Fstderr.raw","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Ffull-harness-v1%2Fstderr.raw","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Ffull-harness-v1%2Fstderr.raw?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,5 @@\n+.......................................s..............................................................................................................................................................................................................................s.......s...............................................................................s.....................................................ss..........................s.........................................\r\n+----------------------------------------------------------------------\r\n+Ran 474 tests in 209.557s\r\n+\r\n+OK (skipped=7)\r"},{"sha":"332f1f6a81c967489f9ca35b9e80d8f000c4c43d","filename":"runs/online-ch2-b4-finite-identity-20261011/actual-gates/full-harness-v1/stdout.raw","status":"added","additions":39124,"deletions":0,"changes":39124,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Ffull-harness-v1%2Fstdout.raw","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Ffull-harness-v1%2Fstdout.raw","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Factual-gates%2Ffull-harness-v1%2Fstdout.raw?ref=c445c93f7e4cda1408279d614858c904e346ad47"},{"sha":"b6b3fd06531670f6b0d993