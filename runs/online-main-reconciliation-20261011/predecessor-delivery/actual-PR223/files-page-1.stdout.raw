/process-memory-consultation-v1.json\",\n+      \"sha256\": \"f3981d0a78057feef396bdb60e68fc9539cddfba797ae1adbe0263acab246886\",\n+      \"bytes\": 2606\n+    },\n+    {\n+      \"path\": \"runs/online-ch2-b4-finite-identity-20261011/source-header-topology/fresh-blind-binding-v1.json\",\n+      \"sha256\": \"0e0362c318b73877cb4d7fa1ce5294d33b56baa71d5ff2f73613722d7aa3be6e\",\n+      \"bytes\": 1280\n+    },\n+    {\n+      \"path\": \"runs/online-ch2-b4-finite-identity-20261011/source-header-topology/source-header-review-v1.json\",\n+      \"sha256\": \"adda7e17c6ebf0ba1b8c24d9cd78e0df763f55000521ec01fb8d94b51229228f\",\n+      \"bytes\": 8784\n+    },\n+    {\n+      \"path\": \"runs/online-ch2-b4-finite-identity-20261011/source-header-topology/source-header-review-v1.md\",\n+      \"sha256\": \"7cbae12617be985c7ffdbbcb888c3b95c9ff908c2412dbfefa07efbc31680bbf\",\n+      \"bytes\": 2217\n+    },\n+    {\n+      \"path\": \"runs/online-ch2-b4-finite-identity-20261011/source-header-topology/topology-proposal-v1.json\",\n+      \"sha256\": \"1338aa71bb80ab820b89f77d8f3e4e50dd9f9d0cdf05b16471859aaadc83e24f\",\n+      \"bytes\": 11200\n+    },\n+    {\n+      \"path\": \"runs/online-ch2-b4-finite-identity-20261011/source-header-topology/topology-proposal-v2.json\",\n+      \"sha256\": \"d7d6051f3788797b53a19d5d80f163bdca80491281ec13be998b4c2d106ad8bc\",\n+      \"bytes\": 35616\n+    },\n+    {\n+      \"path\": \"runs/online-ch2-b4-finite-identity-20261011/source-header-topology/topology-proposal-v2.md\",\n+      \"sha256\": \"9c9a7225a691a16dd07433f81a56bcb30920ab95306094b40b5822e49685e539\",\n+      \"bytes\": 2196\n+    },\n+    {\n+      \"path\": \"runs/online-ch2-b4-finite-identity-20261011/source-originals/page-141.png\",\n+      \"sha256\": \"5e84c10fca956ac5f61c577176da994d122e0aa4381547bf98b1af07d781dd96\",\n+      \"bytes\": 365806\n+    },\n+    {\n+      \"path\": \"runs/online-ch2-b4-finite-identity-20261011/source-originals/page-142.png\",\n+      \"sha256\": \"5c3589b9716f50adf599b796a6988cf7f5d711684801ca9105c1670acd58b8ea\",\n+      \"bytes\": 249006\n+    },\n+    {\n+      \"path\": \"runs/online-ch2-b4-finite-identity-20261011/source-originals/page-278.png\",\n+      \"sha256\": \"5fa1dea63493c7f7c6e198ea0a4daddf4c61cf8c0d65f7d2ee614e8270ace710\",\n+      \"bytes\": 231575\n+    },\n+    {\n+      \"path\": \"runs/online-ch2-b4-finite-identity-20261011/source-originals/page-279.png\",\n+      \"sha256\": \"b36cc73854971400a96fd6b5c68140a905efb4958e3142de6f80ed1440abce13\",\n+      \"bytes\": 300476\n+    }\n+  ],\n+  \"independent_contract_review\": {\n+    \"path\": \"runs/online-ch2-b4-finite-identity-20261011/independent-freeze/fresh-independent-contract-freeze-review-v1.json\",\n+    \"sha256\": \"eaf9e2864cd0acd8c6fe1cc67a4e97d7688138ee33effc9b138657ac5483c686\",\n+    \"bytes\": 20266\n+  },\n+  \"independent_prepared_helper_review\": {\n+    \"path\": \"runs/online-ch2-b4-finite-identity-20261011/independent-freeze/prepared-preproof-helper-review-v3.json\",\n+    \"sha256\": \"65fdd8cb838c949e3138c5a7c6de6242ef6058e4314a69028677578655624fc8\",\n+    \"bytes\": 3746\n+  },\n+  \"exact_header_sha256\": \"92e0dcfac53595e35b68bfd8083c09640d06da809355ab02ec4eb4b007b0bd67\",\n+  \"source_topology_sha256\": \"d7d6051f3788797b53a19d5d80f163bdca80491281ec13be998b4c2d106ad8bc\",\n+  \"sole_public_declaration\": \"BanditRL.OnlineCumulativePotential.finite_regret_identity\",\n+  \"planned_core\": \"BanditRLProof/OnlineCumulativePotential.lean\",\n+  \"semantic_scope\": \"Arbitrary carrier; total real psi/loss; exact inclusive cumulative identity with arbitrary unscored terminal splice and full terminal gap; positive T. No new public proof ingredients as assumptions.\",\n+  \"both_whole_parent_repairs\": \"OPEN; frozen original parent rows preserved, no whole7.47/15.31 performance bound accepted.\",\n+  \"canaries\": \"Only ignored future proposals; require distinct blind/source reviews, exact later freeze after production BODY acceptance and clean pre-canary context before Test BODY.\",\n+  \"current\": {\n+    \"required_open_forward_containers\": 7,\n+    \"future_claims_open\": 6,\n+    \"chapter2_status\": \"partial\",\n+    \"chapter2_accepted\": false,\n+    \"mandatory_count\": null,\n+    \"Goal\": \"ACTIVE\"\n+  },\n+  \"purification\": \"pending\",\n+  \"authorization\": \"Parent must capture actual clean committed preproof context, obtain independent verification then explicitly authorize production BODY. This receipt alone gives no BODY authority.\"\n+}"},{"sha":"068a89ecf930cb15d0cdfc9b88209841e648c100","filename":"docs/contracts/online-ch2-b4-finite-identity-v1/neutral-frozen-header-v1.txt","status":"added","additions":20,"deletions":0,"changes":20,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/docs%2Fcontracts%2Fonline-ch2-b4-finite-identity-v1%2Fneutral-frozen-header-v1.txt","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/docs%2Fcontracts%2Fonline-ch2-b4-finite-identity-v1%2Fneutral-frozen-header-v1.txt","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/docs%2Fcontracts%2Fonline-ch2-b4-finite-identity-v1%2Fneutral-frozen-header-v1.txt?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,20 @@\n+import Mathlib.Algebra.BigOperators.Module\n+import Mathlib.Tactic\n+\n+noncomputable section\n+open Finset\n+namespace BanditRL.OnlineCumulativePotential\n+\n+theorem finite_regret_identity {E : Type*}\n+    (psi loss : ℕ → E → ℝ) (x : ℕ → E) (u z : E)\n+    (T : ℕ) (hT : 0 < T) :\n+    let y : ℕ → E := fun t => if t = T then z else x t\n+    let G : ℕ → E → ℝ := fun t v => psi t v + ∑ i ∈ range (t + 1), loss i v\n+    (∑ t ∈ range T, (loss t (y t) - loss t u)) =\n+      psi (T - 1) u - psi 0 (y 0) +\n+      (∑ t ∈ range T, (G t (y t) - G t (y (t + 1)))) +\n+      (∑ t ∈ range (T - 1),\n+        (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))) +\n+      G (T - 1) z - G (T - 1) u\n+\n+end BanditRL.OnlineCumulativePotential"},{"sha":"91103bd908cdae067f951a22f2a921fa801371c8","filename":"docs/contracts/online-ch2-b4-finite-identity-v1/precanary-preparation-addendum-v1.json","status":"added","additions":297,"deletions":0,"changes":297,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/docs%2Fcontracts%2Fonline-ch2-b4-finite-identity-v1%2Fprecanary-preparation-addendum-v1.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/docs%2Fcontracts%2Fonline-ch2-b4-finite-identity-v1%2Fprecanary-preparation-addendum-v1.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/docs%2Fcontracts%2Fonline-ch2-b4-finite-identity-v1%2Fprecanary-preparation-addendum-v1.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,297 @@\n+{\n+  \"UTC\": \"2026-10-11T08:44:45.860526+00:00\",\n+  \"original_seal_sha256\": \"7d69c7a32df454ab91324c7b2aeb120e6bc736847fc3c429695711e2678504e8\",\n+  \"added_inputs\": [\n+    {\n+      \"path\": \"runs/online-ch2-b4-finite-identity-20261011/independent-precanary-preparation-v2/fresh-independent-precanary-preparation-review-v2.json\",\n+      \"sha256\": \"e48bf15cdbd2a93e78f554445984cbe05a6b0aee845a7e8e21ee9e17bd167364\",\n+      \"bytes\": 5055\n+    },\n+    {\n+      \"path\": \"runs/online-ch2-b4-finite-identity-20261011/independent-precanary-preparation-v2/fresh-independent-precanary-preparation-review-v2.md\",\n+      \"sha256\": \"18f060947c9884c96af391c02919792d6ce2830ae6523f6e68317cdc4ad1b755\",\n+      \"bytes\": 736\n+    },\n+    {\n+      \"path\": \"runs/online-ch2-b4-finite-identity-20261011/independent-precanary-preparation-v2/prepared-checker-v3-repair-record-v1.json\",\n+      \"sha256\": \"a7e45bb2c97e8ad808f6d191da4d083a7efb4958c3430e5