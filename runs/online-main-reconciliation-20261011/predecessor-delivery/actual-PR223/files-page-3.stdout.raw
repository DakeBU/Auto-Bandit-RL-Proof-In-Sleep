ages\\importGraph\\.lake\\build\\lib\\lean;E:\\ABRL\\research\\.lake\\packages\\LeanSearchClient\\.lake\\build\\lib\\lean;E:\\ABRL\\research\\.lake\\packages\\plausible\\.lake\\build\\lib\\lean;E:\\ABRL\\research\\.lake\\packages\\mathlib\\.lake\\build\\lib\\lean;E:\\ABRL\\worktrees\\research-online-book\\.lake\\build\\lib\\lean;c:\\Users\\admin\\.elan\\toolchains\\leanprover--lean4---v4.29.1\\lib\\lean\r"},{"sha":"e174f6c39c0a0c69d379898963dac3640eb82afb","filename":"runs/online-ch2-b4-finite-identity-20261011/canary-core/native-fences-v1.json","status":"added","additions":48,"deletions":0,"changes":48,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fcanary-core%2Fnative-fences-v1.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fcanary-core%2Fnative-fences-v1.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fcanary-core%2Fnative-fences-v1.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,48 @@\n+[\n+  {\n+    \"declaration\": \"finite_identity_one_round_positive_gap\",\n+    \"frozen_complete_header_sha256\": \"7d10ab86d93f97a5ac03db64ce96b8759a0a64d7bd440fa5bfbbe666717be75e\",\n+    \"whole_header_reconstructed_exact\": true,\n+    \"fence\": {\n+      \"schema_version\": 1,\n+      \"declaration\": \"BanditRL.OnlineCumulativePotentialCanary.finite_identity_one_round_positive_gap\",\n+      \"file\": \"Tests/OnlineCumulativePotentialCanary.lean\",\n+      \"statement\": \"theorem finite_identity_one_round_positive_gap : let psi : \\u2115 \\u2192 \\u211d \\u2192 \\u211d := fun _ v => v ^ 2 / 2 let loss : \\u2115 \\u2192 \\u211d \\u2192 \\u211d := fun _ v => (v - 1) ^ 2 / 2 let x : \\u2115 \\u2192 \\u211d := fun _ => 1 / 2 let u : \\u211d := 1 / 2 let z : \\u211d := 2 / 3 let T : \\u2115 := 1 let y : \\u2115 \\u2192 \\u211d := fun t => if t = T then z else x t let G : \\u2115 \\u2192 \\u211d \\u2192 \\u211d := fun t v => psi t v + \\u2211 i \\u2208 range (t + 1), loss i v ((\\u2211 t \\u2208 range T, (loss t (y t) - loss t u)) = psi (T - 1) u - psi 0 (y 0) + (\\u2211 t \\u2208 range T, (G t (y t) - G t (y (t + 1)))) + (\\u2211 t \\u2208 range (T - 1), (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))) + G (T - 1) z - G (T - 1) u) \\u2227 (\\u2211 t \\u2208 range T, (loss t (y t) - loss t u)) = 0 \\u2227 (psi (T - 1) u - psi 0 (y 0)) = 0 \\u2227 (\\u2211 t \\u2208 range T, (G t (y t) - G t (y (t + 1)))) = -(1 / 36 : \\u211d) \\u2227 (\\u2211 t \\u2208 range (T - 1), (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))) = 0 \\u2227 (G (T - 1) z - G (T - 1) u) = (1 / 36 : \\u211d) \\u2227 \\u00ac ((\\u2211 t \\u2208 range T, (loss t (y t) - loss t u)) \\u2264 (psi (T - 1) u - psi 0 (y 0)) + (\\u2211 t \\u2208 range T, (G t (y t) - G t (y (t + 1)))) + (\\u2211 t \\u2208 range (T - 1), (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))))\",\n+      \"statement_hash\": \"9b11049f357e8ab40671bd431890b7266221fa70baf2a9822d683026386c1c13\",\n+      \"source_assumptions\": [],\n+      \"created_at\": \"2026-10-11T08:51:09+00:00\"\n+    },\n+    \"result\": {\n+      \"ok\": true,\n+      \"declaration\": \"BanditRL.OnlineCumulativePotentialCanary.finite_identity_one_round_positive_gap\",\n+      \"expected_statement_hash\": \"9b11049f357e8ab40671bd431890b7266221fa70baf2a9822d683026386c1c13\",\n+      \"actual_statement_hash\": \"9b11049f357e8ab40671bd431890b7266221fa70baf2a9822d683026386c1c13\",\n+      \"source_assumptions_preserved\": true,\n+      \"findings\": []\n+    },\n+    \"source_assumptions_reason\": \"Closed concrete canary: no logical input binders; all objects are explicit statement-local lets preserved by full byte fence.\"\n+  },\n+  {\n+    \"declaration\": \"finite_identity_two_round_terminal_s