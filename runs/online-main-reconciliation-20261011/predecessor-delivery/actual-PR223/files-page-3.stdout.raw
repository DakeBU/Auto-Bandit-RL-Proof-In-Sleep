84f1058dc951ad5906abe0c58e87bc6d60f22494f681a80e10eef56959\",\n+      \"bytes\": 3164,\n+      \"rawExactBeforeDOM\": true\n+    },\n+    {\n+      \"url\": \"http://127.0.0.1:8891/chapters/online-ogd/\",\n+      \"file\": \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\\\\tmp\\\\online-ch2-b4-finite-identity-site-20261011-v1\\\\chapters\\\\online-ogd\\\\index.html\",\n+      \"sha256\": \"d55988148941cee80a7a7263a615144f31af40dee7c1bef0cab5825d1841e7d8\",\n+      \"bytes\": 929158,\n+      \"rawExactBeforeDOM\": true\n+    },\n+    {\n+      \"url\": \"http://127.0.0.1:8891/modules/banditrlproof-onlinecumulativepotential/index.html\",\n+      \"file\": \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\\\\tmp\\\\online-ch2-b4-finite-identity-site-20261011-v1\\\\modules\\\\banditrlproof-onlinecumulativepotential\\\\index.html\",\n+      \"sha256\": \"9e71f085843d6ba7a336c001c1abece463c4fcc1dd4ba443db876c351c58f806\",\n+      \"bytes\": 18711,\n+      \"rawExactBeforeDOM\": true\n+    },\n+    {\n+      \"url\": \"http://127.0.0.1:8891/chapters/online-ogd/\",\n+      \"file\": \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\\\\tmp\\\\online-ch2-b4-finite-identity-site-20261011-v1\\\\chapters\\\\online-ogd\\\\index.html\",\n+      \"sha256\": \"d55988148941cee80a7a7263a615144f31af40dee7c1bef0cab5825d1841e7d8\",\n+      \"bytes\": 929158,\n+      \"rawExactBeforeDOM\": true\n+    },\n+    {\n+      \"url\": \"http://127.0.0.1:8891/modules/banditrlproof-onlinecumulativepotential/index.html\",\n+      \"file\": \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\\\\tmp\\\\online-ch2-b4-finite-identity-site-20261011-v1\\\\modules\\\\banditrlproof-onlinecumulativepotential\\\\index.html\",\n+      \"sha256\": \"9e71f085843d6ba7a336c001c1abece463c4fcc1dd4ba443db876c351c58f806\",\n+      \"bytes\": 18711,\n+      \"rawExactBeforeDOM\": true\n+    }\n+  ],\n+  \"registrySHA256\": \"70a97a312c062c13cc54f99ebfba69636e7f55080a7039316a02543e1ef23047\",\n+  \"sourceSHA256\": \"61c811c0b1f941ec22ac41f64e555a0e4d4d8dc32b8145ea53808dbdc0fc17da\",\n+  \"frozenHeadersSHA256\": \"92e0dcfac53595e35b68bfd8083c09640d06da809355ab02ec4eb4b007b0bd67\",\n+  \"rootImportVerified\": true,\n+  \"canonicalBindings\": [\n+    {\n+      \"fullName\": \"BanditRL.OnlineCumulativePotential.finite_regret_identity\",\n+      \"node\": {\n+        \"id\": \"declaration:BanditRL.OnlineCumulativePotential.finite_regret_identity\",\n+        \"module\": \"BanditRLProof.OnlineCumulativePotential\",\n+        \"url\": \"modules/banditrlproof-onlinecumulativepotential/index.html#decl-3d85ef2d0774\",\n+        \"status\": \"compiled\",\n+        \"statement_sha256\": \"c2cb4ca47c4dfdf02982813b71c52e17d402971cbe6a48fdecf69591a21f0fad\",\n+        \"identity_basis\": \"source-qualified-name\",\n+        \"books\": [\n+          \"online-learning\"\n+        ],\n+        \"chapters\": [\n+          \"teaching:online-ogd\"\n+        ],\n+        \"settings\": []\n+      },\n+      \"actualSourceLine\": 8\n+    }\n+  ],\n+  \"panels\": [\n+    {\n+      \"kind\": \"coherent-source-card\",\n+      \"text\": \"SOURCE THEOREM · FAITHFUL RESTATEMENT\\nCorrected terminal accounting: the finite-real regret identity\\nOriginal at printed129–130,266–267 / PDF141–142,278–279 ↗\\nLOCALLY COMPILED CORRECTED FINITE-REAL IDENTITY\\nLocally compiled and independently production-BODY-reviewed finite-real identity; two compiled public canaries specialize the same core to check a positive gap, nonzero drift and the terminal splice. Full source performance bounds remain open. Unmerged and unpublished.\\n\\nAn arbitrary state type E, total real-valued functions psi and loss on natural time and E, an arbitrary sequence x, comparator u and terminal z, and a natural horizon T>0. No convexity, norm, optimizer, algorithm, probability or causal premise is required. Finite real arithmetic is a specialization: the full EReal/domain adapter remains separate. Indices are zero-based: source round s corresponds to t=s-1. G includes the current loss through t. Only the unscored coordinate T is spliced to z; all y(t)=x(t) for t<T. The original x(T) is unused. The interior drift has indices0..T-2; forT1 it is empty. T0 is not claimed.\\n\\nMODEL\\nExact deterministic accounting for arbitrary states and functions; no algorithmic run is asserted. Indices are zero-based: source round s corresponds to t=s-1. G includes the current loss through t. Only the unscored coordinate T is spliced to z; all y(t)=x(t) for t<T. The original x(T) is unused. The interior drift has indices0..T-2; forT1 it is empty. T0 is not claimed.\\nASSUMPTIONS\\nAn arbitrary state type E, total real-valued functions psi and loss on natural time and E, an arbitrary sequence x, comparator u and terminal z, and a natural horizon T>0. No convexity, norm, optimizer, algorithm, probability or causal premise is required. Finite real arithmetic is a specialization: the full EReal/domain adapter remains separate.\\nALGORITHM PARAMETERS\\nT is a positive natural number. u and z are independent arbitrary states; no relation between z and original x(T).\\nREGRET NOTION\\nR_T(u)=sum_{t<T}(loss_t(y_t)-loss_t(u)); the scored states are unchanged by the terminal splice.\\nGUARANTEE\\nFull equality including every endpoint and drift term. The full EReal adapter, actual optimistic-FTRL/BTRL producers, ghost attainment, support qualification, strong-convex stability, Young estimate and whole corrected7.47/15.31 bounds remain open. A positive arbitrary terminal gap cannot be discarded.\\nSource mathematical statement.\\n\\n\\n\\t\\n\\t\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n𝐺\\n𝑡\\n(\\n𝑣\\n)\\n=\\n𝜓\\n𝑡\\n(\\n𝑣\\n)\\n+\\n∑\\n𝑖\\n=\\n0\\n𝑡\\nℓ\\n𝑖\\n(\\n𝑣\\n)\\n,\\n𝑦\\n𝑡\\n=\\n{\\n𝑧\\n\\t\\n𝑡\\n=\\n𝑇\\n,\\n\\n\\n𝑥\\n𝑡\\n\\t\\n𝑡\\n≠\\n𝑇\\n.\\n\\n\\n𝑅\\n𝑇\\n(\\n𝑢\\n)\\n=\\n∑\\n𝑡\\n=\\n0\\n𝑇\\n−\\n1\\n(\\nℓ\\n𝑡\\n(\\n𝑦\\n𝑡\\n)\\n−\\nℓ\\n𝑡\\n(\\n𝑢\\n)\\n)\\n\\n\\n=\\n𝜓\\n𝑇\\n−\\n1\\n(\\n𝑢\\n)\\n−\\n𝜓\\n0\\n(\\n𝑦\\n0\\n)\\n+\\n∑\\n𝑡\\n=\\n0\\n𝑇\\n−\\n1\\n(\\n𝐺\\n𝑡\\n(\\n𝑦\\n𝑡\\n)\\n−\\n𝐺\\n𝑡\\n(\\n𝑦\\n𝑡\\n+\\n1\\n)\\n)\\n\\n\\n+\\n∑\\n𝑡\\n=\\n0\\n𝑇\\n−\\n2\\n(\\n𝜓\\n𝑡\\n(\\n𝑦\\n𝑡\\n+\\n1\\n)\\n−\\n𝜓\\n𝑡\\n+\\n1\\n(\\n𝑦\\n𝑡\\n+\\n1\\n)\\n)\\n+\\n𝐺\\n𝑇\\n−\\n1\\n(\\n𝑧\\n)\\n−\\n𝐺\\n𝑇\\n−\\n1\\n(\\n𝑢\\n)\\n.\\n\\nBanditRLlib relationship. This is the finite-real corrected algebra subclause of repair:7.47-terminal, related to the terminal correction of Theorem15.31; it is not the literal full printed theorem. The source uses Euclidean feasible states and extended losses; the algebra abstracts the carrier and uses globally real functions. Repeating a virtual final hint is legitimate, but omitting its terminal residual can invalidate the sharp bound. The full EReal adapter, actual optimistic-FTRL/BTRL producers, ghost attainment, support qualification, strong-convex stability, Young estimate and whole corrected7.47/15.31 bounds remain open. A positive arbitrary terminal gap cannot be discarded.\\n\\nThe mathematical content is restated in this site's notation; wording is ours. See printed129–130,266–267 / PDF141–142,278–279 in the linked source for the original statement and full assumptions.\",\n+      \"mathContainers\": 1,\n+      \"mathErrors\": 0,\n+      \"links\": [\n+        {\n+          \"text\": \"Original at printed129–130,266–267 / PDF141–142,278–279 ↗\",\n+          \"href\": \"https://arxiv.org/pdf/1912.13213v10#page=142\"\n+        }\n+      ],\n+      \"formulas\": [\n+        \"Gt(v)=ψt(v)+∑i=0tℓi(v),yt={zt=T,xtt≠T.RT(u)=∑t=0T−1(ℓt(yt)−ℓt(u))=ψT−1(u)−ψ0(y0)+∑t=0T−1(Gt(yt)−Gt(yt+1))+∑t=0T−2(ψt(yt+1)−ψt+1(yt+1))+GT−1(z)−GT−1(u).\"\n+      ],\n+      \"screenshot\": {\n+        \"file\": \"source-card-v1.png\",\n+        \"sha256\": \"f0f8aa7e36028d12dfb191c34045bf63bae60a97c4c4ab27cf1d41db0386fa66\",\n+        \"geometry\": {\n+          \"left\": 343.390625,\n+          \"right\": 1400.609375,\n+          \"top\": 179.859375,\n+          \"bottom\": 1579.921875,\n+          \"height\": 1400.0625,\n+          \"scrollWidth\": 1057,\n+          \"clientWidth\": 1057,\n+          \"viewportWidth\": 1440,\n+          \"viewportHeight\": 1801\n+        }\n+      }\n+    },\n+    {\n+      \"kind\": \"teaching\",\n+      \"fullName\": \"BanditRL.OnlineCumulativePotential.finite_regret_identity\",\n+      \"text\": \"MATHEMATICS ↔ LEAN\\nClosest local match to the source theorem\\nWhy the terminal gap belongs in the regret identity\\n\\nLEAN DECLARATION\\nBanditRL.OnlineCumulativePotential.finite_regret_identity\\n\\nCOMPILED\\n\\nPlain-English statement. An arbitrary state type E, total real-valued functions psi and loss on natural time and E, an arbitrary sequence x, comparator u and terminal z, and a natural horizon T>0. No convexity, norm, optimizer, algorithm, probability or causal premise is required. Finite real arithmetic is a specialization: the full EReal/domain adapter remains separate. Indices are zero-based: source round s corresponds to t=s-1. G includes the current loss through t. Only the unscored coordinate T is spliced to z; all y(t)=x(t) for t<T. The original x(T) is unused. The interior drift has indices0..T-2; forT1 it is empty. T0 is not claimed.\\n\\nMathematical reading.\\n\\n\\n\\t\\n\\t\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n𝐺\\n𝑡\\n(\\n𝑣\\n)\\n=\\n𝜓\\n𝑡\\n(\\n𝑣\\n)\\n+\\n∑\\n𝑖\\n=\\n0\\n𝑡\\nℓ\\n𝑖\\n(\\n𝑣\\n)\\n,\\n𝑦\\n𝑡\\n=\\n{\\n𝑧\\n\\t\\n𝑡\\n=\\n𝑇\\n,\\n\\n\\n𝑥\\n𝑡\\n\\t\\n𝑡\\n≠\\n𝑇\\n.\\n\\n\\n𝑅\\n𝑇\\n(\\n𝑢\\n)\\n=\\n∑\\n𝑡\\n=\\n0\\n𝑇\\n−\\n1\\n(\\nℓ\\n𝑡\\n(\\n𝑦\\n𝑡\\n)\\n−\\nℓ\\n𝑡\\n(\\n𝑢\\n)\\n)\\n\\n\\n=\\n𝜓\\n𝑇\\n−\\n1\\n(\\n𝑢\\n)\\n−\\n𝜓\\n0\\n(\\n𝑦\\n0\\n)\\n+\\n∑\\n𝑡\\n=\\n0\\n𝑇\\n−\\n1\\n(\\n𝐺\\n𝑡\\n(\\n𝑦\\n𝑡\\n)\\n−\\n𝐺\\n𝑡\\n(\\n𝑦\\n𝑡\\n+\\n1\\n)\\n)\\n\\n\\n+\\n∑\\n𝑡\\n=\\n0\\n𝑇\\n−\\n2\\n(\\n𝜓\\n𝑡\\n(\\n𝑦\\n𝑡\\n+\\n1\\n)\\n−\\n𝜓\\n𝑡\\n+\\n1\\n(\\n𝑦\\n𝑡\\n+\\n1\\n)\\n)\\n+\\n𝐺\\n𝑇\\n−\\n1\\n(\\n𝑧\\n)\\n−\\n𝐺\\n𝑇\\n−\\n1\\n(\\n𝑢\\n)\\n.\\nIntuition\\nThe terminal point appears once with a minus sign inside the last within-potential difference and once with a plus sign in the endpoint gap. Their cancellation explains why the scored regret does not depend on an unplayed endpoint.\\nWhy it is needed\\nOne shared algebraic component needed by labeled terminal corrections, not a complete regret theorem or source-container count.\\nPlace in the proof\\nFinite-real corrected accounting near Theorem7.47 proof, PDF141–142; related Theorem15.31 terminal convention, PDF278–279. The full EReal adapter, actual optimistic-FTRL/BTRL producers, ghost attainment, support qualification, strong-convex stability, Young estimate and whole corrected7.47/15.31 bounds remain open. A positive arbitrary terminal gap cannot be discarded.\\nProof and Lean reading notes\\nProof idea\\nPut H_t(v)=sum_{i<t}loss_i(v), so G_t=psi_t+H_(t+1). The regularizer parts of the within-G sum, together with the interior drift, telescope to psi_0(y_0)-psi_(T-1)(z). The cumulative-loss parts telescope to sum_{t<T}loss_t(y_t)-H_T(z). Adding the final comparator regularizer minus the initial played regularizer and the retained G_(T-1)(z)-G_(T-1)(u) leaves exactly the regret. This is the mathematical cancellation argument, not a claimed implementation route.\\nLean reading notes\\nE has no additional typeclass assumptions; psi/loss are real-valued and T>0 is the only propositional premise. The boundary regularizer difference is psi_(T-1)(u)-psi_0(y_0): final comparator regularizer minus initial played regularizer. Local y and G are definitions, not extra hypotheses. The exact Lean header and full-proof source link use the declaration fold; these notes do not claim a complete rendered source-proof graph. Selected actual compiled direct VALUE occurrences are Nat.recAux, Finset.sum_range_succ, Finset.sum_range_zero and Nat.sub_add_cancel. Occurrence does not establish logical necessity or a complete transitive graph; Nat.rec is not the exported direct constant. The source-only AND topology remains distinct from these implementation occurrences. Locally compiled and independently production-BODY-reviewed finite-real identity; two compiled public canaries specialize the same core to check a positive gap, nonzero drift and the terminal splice. Full source performance bounds remain open. Unmerged and unpublished.\\nTeaching dependencies\\nNo direct teaching dependency recorded.\\nExact Lean statement\\nOpen in the declaration catalog\\nOpen source at line 8\",\n+      \"mathContainers\": 1,\n+      \"mathErrors\": 0,\n+      \"links\": [\n+        {\n+          \"text\": \"Open in the declaration catalog\",\n+          \"href\": \"http://127.0.0.1:8891/modules/banditrlproof-onlinecumulativepotential/index.html#decl-3d85ef2d0774\"\n+        },\n+        {\n+          \"text\": \"Open source at line 8\",\n+          \"href\": \"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/7b372d79fcd3228d8d2cece73ad0181f94a70cf1/BanditRLProof/OnlineCumulativePotential.lean#L8\"\n+        }\n+      ],\n+      \"formulas\": [\n+        \"Gt(v)=ψt(v)+∑i=0tℓi(v),yt={zt=T,xtt≠T.RT(u)=∑t=0T−1(ℓt(yt)−ℓt(u))=ψT−1(u)−ψ0(y0)+∑t=0T−1(Gt(yt)−Gt(yt+1))+∑t=0T−2(ψt(yt+1)−ψt+1(yt+1))+GT−1(z)−GT−1(u).\"\n+      ],\n+      \"foldedExactStatement\": \"theorem finite_regret_identity {E : Type*} (psi loss : ℕ → E → ℝ) (x : ℕ → E) (u z : E) (T : ℕ) (hT : 0 < T) : let y : ℕ → E := fun t => if t = T then z else x t let G : ℕ → E → ℝ := fun t v => psi t v + ∑ i ∈ range (t + 1), loss i v (∑ t ∈ range T, (loss t (y t) - loss t u)) = psi (T - 1) u - psi 0 (y 0) + (∑ t ∈ range T, (G t (y t) - G t (y (t + 1)))) + (∑ t ∈ range (T - 1), (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))) + G (T - 1) z - G (T - 1) u\",\n+      \"screenshot\": {\n+        \"file\": \"lesson-finite_regret_identity-v1.png\",\n+        \"sha256\": \"3696b3a9b64832917c4e4eb5230349ed27f21b8184b982bd9d108711bf1249a5\",\n+        \"geometry\": {\n+          \"left\": 357.78125,\n+          \"right\": 1386.21875,\n+          \"top\": 180.015625,\n+          \"bottom\": 2275.0625,\n+          \"height\": 2095.046875,\n+          \"scrollWidth\": 1026,\n+          \"clientWidth\": 1026,\n+          \"viewportWidth\": 1440,\n+          \"viewportHeight\": 2496\n+        }\n+      }\n+    },\n+    {\n+      \"kind\": \"chapter-boundary\",\n+      \"text\": \"Maintainer contract\\nOpen the canonical completion definition and blockers\\n\\nAlgorithm 2.1, Proposition 2.11, Lemma 2.12, both fixed and positive nonincreasing-step branches of Theorem 2.13, and Eq. (2.1), arXiv:1912.13213v10. This is not completion of all Chapter 2; convex analysis, subgradient and linearization results remain required. Source-facing loss bounds use OnlineGradientDescentSource through the proved arbitrary-open adapter; old RegularLoss declarations retain their stronger scope. Package and chapter gates are distinct. Additive affine prescient foundation: seven public producer-chain terminals and five complementary canaries; this does not close the general prescient observation or Chapter2. This is an affine-loss quadratic Euclidean prescient foundation, explicitly extended to complete real Hilbert spaces; seven declarations form one producer chain, not seven printed results. The full general convex/subdifferentiable/Bregman/time-varying Algorithm15.8/Theorem15.30 and the full Chapter2 prescient source container remain REQUIRED/OPEN, including the source constant-step proof left as an exercise. All eight Chapter2 mathematical forward containers remain open. Chapter2 and whole Chapters1–16 Goal are incomplete; no main/live, merge or deployment claim. This branch is stacked on exact unmerged PR204 head b1486aa11451556858fda44eabf356ba26ab01b8. Additive general prescient foundation: one real convex minimizer-comparison dependency and3nondegenerate Test families; full general source and Chapter2 remain open. One reusable real-valued convex minimizer comparison, explicitly generalized to arbitrary real normed spaces. This is a dependency of the Chapter2 prescient forward observation, not full Algorithm15.8/Theorem15.30 or a new printed theorem. The actual supplied minimizer is a premise of this helper, not an existence/uniqueness or causal-update conclusion. General Bregman/extended-real finite-domain/subgradient bridges, attained current-loss recursion/interior validity and same-run fixed/variable-step source bounds remain REQUIRED/OPEN, including the main-text constant-step proof left as an exercise. All eight Chapter2 forward containers remain open; Chapter2 is partial and the Chapters1–16 Goal ACTIVE. Stacked on unmerged PR205 exact head 29086b6f3a033f6536054f4d9a06ae0e9b2f8a91. No merge/deploy/main/live/CI acceptance claim. Additive general prescient foundation: five Bregman helper proofs and one canonical definition; no full source-container closure. A necessary Bregman foundation for the Chapter2 prescient forward dependency, not complete Algorithm15.8/Theorem15.30 or acceptance of Chapter6/15. Source X/interior and local-extension validity, finite-domain extended-real loss/subgradient/convexity/minimum bridges, attained causal current-loss recursion/interior invariants, and sharp fixed/variable same-run telescopes remain REQUIRED/OPEN, including the main-text fixed-step exercise. All eight Chapter2 forward containers remain open; Chapter2 partial, Chapters1–16 Goal ACTIVE. Stacked on OPEN draft unmerged PR208 exact 71f2219fa1648094eba8aa17b50e443258f436cb. No merge/deploy/main/live/CI acceptance claim. Additive extended-loss foundation: three derived helper proofs, zero new definitions and no full source-container closure. These three derived bridges lower a required Chapter 2 prescient forward dependency. They do not complete Algorithm 15.8 or Theorem 15.30, or accept Chapters 6 or 15. The source domain X, interior and ambient extension locality, attained current-loss causal recursion, interior invariants and sharp fixed/variable same-run telescopes remain REQUIRED/OPEN, including the main-text fixed-step exercise. All eight Chapter 2 forward containers remain open; Chapter 2 is partial and the Chapters 1–16 Goal is ACTIVE. Stacked on OPEN draft unmerged PR #209 exact 65e21be78abfbd4255798e54265ce418651ef70f. No merge, deployment, main, live or CI acceptance claim. Additive actual-update foundation: eight derived proofs and two exact definitions; full cumulative source container remains open. This package adds eight derived proofs and two exact partial definitions for a required Chapter 2 prescient forward dependency. It does not complete Algorithm 15.8 or Theorem 15.30, or accept Chapters 6 or 15. Local ambient-extension equality and the actual current-only partial recursion are now proved; transport of the source X/interior regularity into a valid generated run, its source interior conditions, and sharp fixed/variable same-run cumulative bounds remain REQUIRED/OPEN, including the main-text fixed-step exercise. Earlier package boundary paragraphs describe their respective bounded scopes; the new locality and partial-state results are additive progress. All eight Chapter 2 forward containers stay open; Chapter 2 is partial, its complete proof denominator remains null, and the Chapters 1-16 Goal is ACTIVE. Stacked on OPEN draft unmerged PR #210 exact 41f1fb26915b3bf7f84035393080991c38aeba64. No merge, deployment, main, live or CI acceptance claim. Additive conditional cumulative progress: five derived same-run interfaces; full source transport and valid-run wrapper remain open. Five derived same-run cumulative interfaces are additive progress for a REQUIRED Chapter 2 prescient forward dependency. Successful actual Option outputs and all reached states in interior X are explicit conditional hypotheses; source closedness and strict convexity are not asserted to guarantee a valid run. The source X/interior generator representation, finite-on-V/no-bottom source loss transport into proper/global-support premises, and a full source valid-run wrapper remain REQUIRED/OPEN. This does not complete Algorithm 15.8, Theorem 15.30, Chapters 6 or 15, or Chapter 2. All eight Chapter 2 forward containers remain open; Chapter 2 is partial with null complete proof denominator, Chapters 3-16 unenumerated/null, and the whole Chapters 1-16 Goal ACTIVE. Historical package boundary paragraphs describe their respective scopes; these five new interfaces add sharp fixed/variable cumulative bounds under their explicitly stated actual-run assumptions. Stacked on OPEN draft unmerged PR #211 exact 24de0231aa067f141251aac5c20deb58e448ea66. No merge, deployment, main, live or CI acceptance claim. Additive source valid-run progress: six fixed transport proofs, not universal attainment or chapter acceptance. This package transports source loss hypotheses and actual valid argmin runs into the SAME current-loss Option recursion; it is not universal attainment or automatic interior preservation. Closedness and strict convexity do not imply an attained penalized minimum, as the existing exponential counterexample shows. The six proof terminals and two concrete canaries are bounded dependency progress, not six printed source results or a chapter denominator. All eight Chapter 2 forward containers remain required/open pending dedicated source reconciliation and chapter gates; Chapter 2 is partial with null complete proof denominator, Chapters 3-16 remain unenumerated/null, and the Chapters 1-16 Goal stays active. Prior package boundaries describe their historical scope; this additional package now derives properness and the source valid-run identity rather than assuming hseq. Stacked on OPEN draft unmerged PR #212 exact 547137ea02c59c24424e2fb448174875845fadb4. No merge, deployment, main/live, CI or retirement claim. Additive required dependency progress: complete Theorem5.4 proof package, not Chapter2 or Chapter5 acceptance. This is the required Chapter2 forward dependency on the failure of THIS unprojected OSD algorithm with polynomially decreasing steps, not a lower bound against all learners. The fixed learner receives only the current loss and point when selecting a subgradient; eta_t=t^(-alpha) is a function of the current index and alpha. The adversarial witness may depend on the chosen horizon T. Four source witness definitions and eleven proof terminals close one source theorem plus its mandatory phi range/limit and proof dependencies; their count is not a printed-result or chapter denominator. All eight Chapter2 forward containers remain required/open pending dedicated source reconciliation and chapter gates; Chapter2 is partial with null complete proof denominator, Chapters3-16 remain unenumerated/null, and the Chapters1-16 Goal stays ACTIVE. Positive dimension is source-implicit and mathematically necessary: the zero space cannot have positive regret at comparator0. No bounded feasible domain, assumed desired regret, prescribed trajectory, minimax, oracle-distance-energy, PAC, adaptive or parameter-free endpoint is added. Stacked on OPEN draft unmerged PR213 exact 2f039d55ad2f9a9f9b97027287709804689cf46d. No merge, deployment, main/live, CI or retirement claim. Additive algorithm-definition foundation and qualified provenance reconciliation; no new regret bound or chapter acceptance. This is one generic strict-past FTL algorithm-definition foundation: four definitions and nine derived proof terminals, not thirteen printed results or a regret guarantee. The source argmin rule is completed as a classical partial Option selector. No unconditional attainment, executable/measurable optimizer, full valid run for arbitrary losses or new FTL performance bound is proved. The fixed choice is compared only when its entire minimizer set agrees; arbitrary tied choices are not identified. The old scalar linear and squared-loss FTL strategies remain source-qualified instances, with no proved definitional equality to this classical selector. In the recovery canary P1=none supplies no playable action; P2=some0 is a separate longer-prefix query, not a valid complete online interaction continuing after failure. The65overlapping source containers are not an independent theorem or proof-obligation denominator. All eight forward containers remain required/open at chapter level: prescient and OSD package bindings are reconciled as bounded candidates, while six future mathematical claims remain required/open and unenumerated. Ownership/navigation does not discharge them. Chapter2 remains partial with null proof total; Chapters3-16 unenumerated/null; whole Goal ACTIVE. Stacked on OPEN draft unmerged PR214 exact 2e06e21d2acb0bf41142b19266d66d89364e17a0. No merge, deployment, main/live, CI or retirement claim. Additive adaptive-rate prerequisite: Orabona Lemma4.13. One reusable integral-comparison lemma is a prerequisite for the required Chapter2 adaptive-rate forward claim. Actual causal adaptive OSD, zero-gradient skipping, zero-radius/zero-energy cases, inverse-square-root energy summation, Eq.(4.4), Theorem4.14 and its displayed minimum-versus-infimum edge remain required/open. All eight Chapter2 forward containers and six future mathematical claims remain required/open. Chapter2 remains partial with null complete proof total; Chapters3-16 remain unenumerated/null. Chapter4 is not a new main task. Whole Chapters1-16 Goal ACTIVE. Stacked on OPEN draft unmerged PR215 exact 8f31042350bd8eeb1c9108257c58e2b3aafaebfb. No merge, deployment, main/live or retirement claim. Additive adaptive energy prerequisite: One source energy-display family is now a reusable prerequisite for the required Chapter2 adaptive-rate forward claim, represented by three production proofs and two full canaries, not three independent source results. Actual causal adaptive OSD, zero-feedback skipping, zero-radius/zero-energy regret, zero-weight potential, Eq.(4.4), Theorem4.14 and its minimum-versus-infimum edge remain required/open. All eight Chapter2 forward containers and six future mathematical claims remain required/open. Chapter2 partial/null; Chapters3-16 unenumerated/null; Chapter4 is not a competing main task. Whole Chapters1-16 Goal ACTIVE. Stacked on OPEN draft unmerged PR216 exact 873039ee2d3247eacaa9b3c95d765954e6453611. No merge, deployment, main/live or retirement claim. Current superseding candidate frontier: the actual causal adaptive OSD recursion, explicit zero-feedback skip, signed weighted-potential estimate, general-alpha terminal-residual regret bound, Eq.(4.4), and Theorem4.14 regret plus separately disclosed infimum/attainment benchmark are locally compiled candidates. Earlier cards and contracts retain their historical open-state wording. Current distinct production/source and canary BODY reviews are accepted-with-explicit-delta; exact integration review, combined root/Tests/full harness, contributor and site/registry checks remain required. This does not close any of the eight Chapter2 required forward containers or certify all six future mathematical claims. Chapter2 remains partial, accepted=false and mandatory proof total=null; Chapters3-16 remain unenumerated/null. Whole Chapters1-16 Goal ACTIVE. No merge, deployment, live-site or retirement claim. Locally compiled and independently source/BODY-reviewed exact identity with explicit algebraic generalization. Combined package gates remain pending. Chapter2 remains partial, accepted=false and complete proof denominator=null; all eight forward containers and six future claims remain open. Whole Chapters1-16 Goal ACTIVE; unmerged and unpublished. Current superseding authority: The actual OGD package is accepted-local; docs/contracts/online-ch2-unbounded-ogd-v1/source-target-reconciliation-accepted-v1.json reconciles only the unbounded-variable-OGD-failure container. Seven required Chapter 2 forward containers and all six future mathematical claims remain open. B1-B7 and all other hard targets are preserved. Chapter 2 remains partial, accepted=false and complete proof denominator=null; Chapters 1-16 Goal ACTIVE. Main and live publication are unchanged; no merge, deployment or native whole-loop acceptance is claimed. Metadata validation is recorded separately and is not inferred from the earlier proof gate.\\n\\nRemaining blockers\\nRemaining Chapter 2 convex analysis, subgradient and linearization results are required future packages.\\nCurrent source-repair package final harness/graph/reader/site/PR gates remain pending; historical scope is preserved separately.\",\n+      \"mathContainers\": 0,\n+      \"mathErrors\": 0,\n+      \"links\": [],\n+      \"formulas\": [],\n+      \"screenshot\": {\n+        \"file\": \"chapter-boundary-v1.png\",\n+        \"sha256\": \"0fdc758e6a3409191d7f4738103fffbc402562ce32171b096524c1ab601ebc49\",\n+        \"geometry\": {\n+          \"left\": 342.390625,\n+          \"right\": 1401.609375,\n+          \"top\": 180.109375,\n+          \"bottom\": 3088.6875,\n+          \"height\": 2908.578125,\n+          \"scrollWidth\": 1059,\n+          \"clientWidth\": 1059,\n+          \"viewportWidth\": 1440,\n+          \"viewportHeight\": 3309\n+        }\n+      }\n+    }\n+  ],\n+  \"modules\": [\n+    {\n+      \"fullName\": \"BanditRL.OnlineCumulativePotential.finite_regret_identity\",\n+      \"moduleURL\": \"http://127.0.0.1:8891/modules/banditrlproof-onlinecumulativepotential/index.html\",\n+      \"code\": {\n+        \"text\": \"theorem finite_regret_identity {E : Type*} (psi loss : ℕ → E → ℝ) (x : ℕ → E) (u z : E) (T : ℕ) (hT : 0 < T) : let y : ℕ → E := fun t => if t = T then z else x t let G : ℕ → E → ℝ := fun t v => psi t v + ∑ i ∈ range (t + 1), loss i v (∑ t ∈ range T, (loss t (y t) - loss t u)) = psi (T - 1) u - psi 0 (y 0) + (∑ t ∈ range T, (G t (y t) - G t (y (t + 1)))) + (∑ t ∈ range (T - 1), (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))) + G (T - 1) z - G (T - 1) u\",\n+        \"scrollWidth\": 1030,\n+        \"clientWidth\": 1030\n+      },\n+      \"sourceLink\": \"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/7b372d79fcd3228d8d2cece73ad0181f94a70cf1/BanditRLProof/OnlineCumulativePotential.lean#L8\",\n+      \"contextViaPinnedWholeSource\": true,\n+      \"sourceAmbientContext\": \"import Mathlib.Algebra.BigOperators.Module\\nimport Mathlib.Tactic\\n\\nnoncomputable section\\nopen Finset\\nnamespace BanditRL.OnlineCumulativePotential\\n\\n\",\n+      \"screenshot\": {\n+        \"file\": \"catalog-finite_regret_identity-v1.png\",\n+        \"sha256\": \"354229ca1d46e4c96b49d36d05c02922f1c8364cb6a45d28c028a951533e6d88\",\n+        \"geometry\": {\n+          \"left\": 342.390625,\n+          \"right\": 1401.609375,\n+          \"top\": 996.390625,\n+          \"bottom\": 1544.375,\n+          \"height\": 547.984375,\n+          \"scrollWidth\": 1057,\n+          \"clientWidth\": 1057,\n+          \"viewportWidth\": 1440,\n+          \"viewportHeight\": 1800\n+        }\n+      }\n+    }\n+  ],\n+  \"images\": [\n+    {\n+      \"file\": \"source-card-v1.png\",\n+      \"sha256\": \"f0f8aa7e36028d12dfb191c34045bf63bae60a97c4c4ab27cf1d41db0386fa66\",\n+      \"geometry\": {\n+        \"left\": 343.390625,\n+        \"right\": 1400.609375,\n+        \"top\": 179.859375,\n+        \"bottom\": 1579.921875,\n+        \"height\": 1400.0625,\n+        \"scrollWidth\": 1057,\n+        \"clientWidth\": 1057,\n+        \"viewportWidth\": 1440,\n+        \"viewportHeight\": 1801\n+      }\n+    },\n+    {\n+      \"file\": \"lesson-finite_regret_identity-v1.png\",\n+      \"sha256\": \"3696b3a9b64832917c4e4eb5230349ed27f21b8184b982bd9d108711bf1249a5\",\n+      \"geometry\": {\n+        \"left\": 357.78125,\n+        \"right\": 1386.21875,\n+        \"top\": 180.015625,\n+        \"bottom\": 2275.0625,\n+        \"height\": 2095.046875,\n+        \"scrollWidth\": 1026,\n+        \"clientWidth\": 1026,\n+        \"viewportWidth\": 1440,\n+        \"viewportHeight\": 2496\n+      }\n+    },\n+    {\n+      \"file\": \"chapter-boundary-v1.png\",\n+      \"sha256\": \"0fdc758e6a3409191d7f47381