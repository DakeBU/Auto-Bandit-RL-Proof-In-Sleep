self-bounding conversion, or a final Tsallis-INF regret theorem.\r\n+23:noncomputable def cumulativeLoss {Action : Type u}\r\n+27:@[simp] theorem cumulativeLoss_zero {Action : Type u}\r\n+29:    cumulativeLoss loss 0 = 0 := by\r\n+31:  simp [cumulativeLoss]\r\n+34:theorem cumulativeLoss_succ {Action : Type u}\r\n+36:    cumulativeLoss loss (t + 1) =\r\n+37:      fun action => cumulativeLoss loss t action + loss t action := by\r\n+39:  simp [cumulativeLoss, Finset.sum_range_succ]\r\n+42:theorem linearLoss_add_right {Action : Type u}\r\n+49:theorem linearLoss_cumulativeLoss {Action : Type u}\r\n+52:    linearLoss arms p (cumulativeLoss loss T) =\r\n+54:  simp only [linearLoss, cumulativeLoss, Finset.mul_sum]\r\n+58:theorem regularizedObjective_cumulativeLoss_succ {Action : Type u}\r\n+62:    regularizedObjective arms eta regularizer (cumulativeLoss loss (t + 1)) p =\r\n+63:      regularizedObjective arms eta regularizer (cumulativeLoss loss t) p +\r\n+65:  rw [cumulativeLoss_succ, regularizedObjective, regularizedObjective,\r\n+76:theorem eta_mul_sum_next_linearLoss_add_regularizer_zero_le_objective\r\n+85:        (cumulativeLoss loss t) (p t)) :\r\n+90:          (cumulativeLoss loss T) (p T) := by\r\n+93:      simp [regularizedObjective, cumulativeLoss, linearLoss]\r\n+97:            (cumulativeLoss loss t) (p t) := by\r\n+105:              (cumulativeLoss loss T) (p T) <=\r\n+107:              (cumulativeLoss loss T) (p (T + 1)) :=\r\n+120:              (cumulativeLoss loss T) (p (T + 1)) +\r\n+127:              (cumulativeLoss loss (T + 1)) (p (T + 1)) :=\r\n+128:          (regularizedObjective_cumulativeLoss_succ\r\n+134:theorem sum_next_linearLoss_sub_comparator_le_regularizer_penalty\r\n+144:        (cumulativeLoss loss t) (p t))\r\n+156:          (cumulativeLoss loss T) (p T) <=\r\n+158:          (cumulativeLoss loss T) q :=\r\n+162:  rw [regularizedObjective, linearLoss_cumulativeLoss] at htotal\r\n+178:regularizer penalty. No convexity or minimizer-existence theorem is hidden:\r\n+181:theorem cumulativeLinearLoss_sub_comparator_le_stability_add_penalty\r\n+191:        (cumulativeLoss loss t) (p t))\r\n+227:theorem cumulativeLinearLoss_sub_comparator_le_stability_add_penalty_simplex\r\n+236:        (cumulativeLoss loss t) (p t))\r\n+254:theorem negEntropyRegularizer_sub_eq_powerSum_sub_div\r\n+273:theorem cumulativeLinearLoss_sub_comparator_le_stability_add_powerSumPenalty\r\n+282:        (FTRL.cumulativeLoss loss t) (p t))\r"},{"sha":"1593e12288a5c01c37e2f19705e0dc319a4c25a1","filename":"runs/online-ch2-b4-finite-identity-20261011/header-proposal/retrieval-03.json","status":"added","additions":22,"deletions":0,"changes":22,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fheader-proposal%2Fretrieval-03.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fheader-proposal%2Fretrieval-03.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fheader-proposal%2Fretrieval-03.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,22 @@\n+{\n+  \"argv\": [\n+    \"rg\",\n+    \"-n\",\n+    \"sum_range_sub|sum_range_by_parts\",\n+    \".lake/packages/mathlib/Mathlib/Algebra/BigOperators\"\n+  ],\n+  \"cwd\": \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\",\n+  \"startUTC\": \"2026-10-11T07:28:54.237574+00:00\",\n+  \"endUTC\": \"2026-10-11T07:28:54.400592+00:00\",\n+  \"actual_exit\": 0,\n+  \"streams\": {\n+    \"stdout\": {\n+      \"file\": \"retrieval-03.stdout.raw\",\n+      \"sha256\": \"9b95a5fc1a662aa769e4118722fc3276669beb2a4ab9b9c574108ea273251852\"\n+    },\n+    \"stderr\": {\n+      \"file\": \"retrieval-03.stderr.raw\",\n+      \"sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b9