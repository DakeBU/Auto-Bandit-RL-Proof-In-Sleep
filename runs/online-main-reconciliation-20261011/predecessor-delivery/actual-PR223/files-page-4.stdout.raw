e":"runs/online-ch2-b4-finite-identity-20261011/header-proposal/neutral-proposed-header-v1.txt","status":"added","additions":20,"deletions":0,"changes":20,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fheader-proposal%2Fneutral-proposed-header-v1.txt","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fheader-proposal%2Fneutral-proposed-header-v1.txt","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fheader-proposal%2Fneutral-proposed-header-v1.txt?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,20 @@\n+import Mathlib.Algebra.BigOperators.Module\n+import Mathlib.Tactic\n+\n+noncomputable section\n+open Finset\n+namespace BanditRL.OnlineCumulativePotential\n+\n+theorem finite_regret_identity {E : Type*}\n+    (psi loss : ℕ → E → ℝ) (x : ℕ → E) (u z : E)\n+    (T : ℕ) (hT : 0 < T) :\n+    let y : ℕ → E := fun t => if t = T then z else x t\n+    let G : ℕ → E → ℝ := fun t v => psi t v + ∑ i ∈ range (t + 1), loss i v\n+    (∑ t ∈ range T, (loss t (y t) - loss t u)) =\n+      psi (T - 1) u - psi 0 (y 0) +\n+      (∑ t ∈ range T, (G t (y t) - G t (y (t + 1)))) +\n+      (∑ t ∈ range (T - 1),\n+        (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))) +\n+      G (T - 1) z - G (T - 1) u\n+\n+end BanditRL.OnlineCumulativePotential"},{"sha":"e11088f9edd01fadb67a81e63a4a2d18950f4bb4","filename":"runs/online-ch2-b4-finite-identity-20261011/header-proposal/retrieval-01.json","status":"added","additions":24,"deletions":0,"changes":24,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fheader-proposal%2Fretrieval-01.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fheader-proposal%2Fretrieval-01.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fheader-proposal%2Fretrieval-01.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,24 @@\n+{\n+  \"argv\": [\n+    \"rg\",\n+    \"-n\",\n+    \"cumulative|telescop|regret.*eq\",\n+    \"BanditRLProof\",\n+    \"-g\",\n+    \"Online*.lean\"\n+  ],\n+  \"cwd\": \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\",\n+  \"startUTC\": \"2026-10-11T07:28:54.202169+00:00\",\n+  \"endUTC\": \"2026-10-11T07:28:54.221040+00:00\",\n+  \"actual_exit\": 0,\n+  \"streams\": {\n+    \"stdout\": {\n+      \"file\": \"retrieval-01.stdout.raw\",\n+      \"sha256\": \"8768ec4c52c99cb104df0506340375a0df451544641181ef55424568e00340e4\"\n+    },\n+    \"stderr\": {\n+      \"file\": \"retrieval-01.stderr.raw\",\n+      \"sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"\n+    }\n+  }\n+}"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"runs/online-ch2-b4-finite-identity-20261011/header-proposal/retrieval-01.stderr.raw","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fheader-proposal%2Fretrieval-01.stderr.raw","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fheader-proposal%2Fretrieval-01.stderr.raw","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fheader-proposal%2Fretrieval-01.stderr.raw?ref=c445c93f7e4cda1408279d614858c904e346ad47"},{"sha":"6f90a3c8d8ffa5c308982aa6cf0fb28650f970e4","filename":"runs/online-ch2-b4-finite-identity-20261011/header-proposal/retrieval-01.stdout.raw","status":"added","additions":33,"deletions":0,"changes":33,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fheader-proposal%2Fretrieval-01.stdout.raw","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fheader-proposal%2Fretrieval-01.stdout.raw","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fheader-proposal%2Fretrieval-01.stdout.raw?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,33 @@\n+BanditRLProof\\OnlineAdaptiveOSD.lean:206:  · simp only [regret, heq, sub_self, sum_const_zero]\n+BanditRLProof\\OnlineGuessingRandomizedIID.lean:137:    exact iid_cumulative_prediction_decomposition μ Y hY hlaw hb prediction hL hInd T\n+BanditRLProof\\OnlineGuessingLogLower.lean:294:/-- Source cumulative learner squared loss on exactly the decoded path. -/\n+BanditRLProof\\OnlineGuessingIIDBenchmark.lean:79:theorem iid_cumulative_prediction_decomposition {Ω : Type*} [MeasurableSpace Ω]\n+BanditRLProof\\OnlineGuessingIIDBenchmark.lean:131:    exact iid_cumulative_prediction_decomposition μ Y hY hlaw hb _ hP hInd T\n+BanditRLProof\\OnlineGuessingIIDBenchmark.lean:160:    exact iid_cumulative_prediction_decomposition μ Y hY hlaw hb _ hP hInd T\n+BanditRLProof\\OnlineGuessingComparison.lean:5:cumulative square loss 1/4. The actual horizon-tuned projected OGD starts at 1\r\n+BanditRLProof\\OnlineGuessingComparison.lean:23:theorem meanPredict_zero_cumulativeLoss (T : ℕ) (hT : 0 < T) :\r\n+BanditRLProof\\OnlineGuessingComparison.lean:43:  rw [meanPredict_zero_cumulativeLoss ((2*n)^2) (by positivity)]\r\n+BanditRLProof\\OnlineGuessingSubgradientPolicy.lean:16:not a supplied regret inequality or a universal off-path oracle premise.\n+BanditRLProof\\OnlineGuessingAECausal.lean:99:    exact iid_cumulative_prediction_decomposition μ Y hY hlaw hb prediction hL hInd T\n+BanditRLProof\\OnlineGradientDescentSource.lean:81:/-- Fixed-step telescope on the actual recurrence; no bounded-domain premise. -/\n+BanditRLProof\\OnlineGradientDescentSource.lean:129:/-- The weighted potential telescope retains the negative terminal at the last played step. -/\n+BanditRLProof\\OnlineLearningRegret.lean:39:/-- Upper sublinear regret. This does not require nonnegative regret or existence of its limit. -/\r\n+BanditRLProof\\OnlineLearningMean.lean:47:/-- Positive-horizon cumulative squared loss has the unique empirical-mean minimizer. -/\r\n+BanditRLProof\\OnlineNoRegretSemantics.lean:54:theorem regret_eq (T : ℕ) (u : ℝ) :\n+BanditRLProof\\OnlineNoRegretSemantics.lean:75:  rw [regret_eq]\n+BanditRLProof\\OnlineNoRegretSemantics.lean:88:  rw [regret_eq]\n+BanditRLProof\\OnlineNoRegretSemantics.lean:97:  rw [regret_eq]\n+BanditRLProof\\OnlineFTLSelector.lean:10:def cumulative (past : Fin n → X → ℝ) (x : X) : ℝ :=\n+BanditRLProof\\OnlineFTLSelector.lean:14:  {x | x ∈ V ∧ IsMinOn (cumulative past) V x}\n+BanditRLProof\\OnlineFTLSelector.lean:24:    p ∈ V ∧ IsMinOn (cumulative past) V p := by\n+BanditRLProof\\OnlineFTLSelector.lean:32:    select V past = none ↔ ¬ ∃ p, p ∈ V ∧ IsMinOn (cumulative past) V p := by\n+BanditRLProof\\OnlineFTLSelector.lean:43:theorem cumulative_prefix (loss : ℕ → X → ℝ) (t : ℕ) (x : X) :\n+BanditRLProof\\OnlineFTLSelector.lean:44:    cumulative (fun i : Fin t => loss i.val) x = ∑ i ∈ range t, loss i x := by\n+BanditRLProof\\OnlineFTLSelector.lean:50:  have hc : EqOn (cumulative past) (cumulative past') V := by\n+BanditRLProof\\OnlineFTLSelector.lean:74:theorem select_eq_some_of_unique (V : Set X) (past : Fin n → X → ℝ) (p : X) (hp : p ∈ V) (hmin : IsMinOn (cumulative past) V p) (hunique : ∀ q ∈ V, IsMinOn (cumulative past) V q → q = p) :\n+BanditRLProof\\OnlineFTLSelector.lean:91:  · have hc : cumulative (fun i : Fin t => loss i.val) =\n+BanditRLProof\\OnlineFTLSelector.lean:94:      exact cumulative_prefix loss t x\n+BanditRLProof\\OnlineFTLSelector.lean:112:  · have hc : cumulative (fun i : Fin t => loss i.val) =\n+BanditRLProof\\OnlineFTLSelector.lean:115:      exact cumulative_prefix loss t x\n+BanditRLProof\\OnlinePrescientLinear.lean:107:theorem regret_eq_loss_difference (V : Domain E) (η : ℝ) (g : ℕ → E) (b : ℕ → ℝ)\n+BanditRLProof\\OnlineSquareMinimum.lean:41:/-- Signed pathwise minimum regret equals regret at the produced empirical mean. -/"},{"sha":"16c8169e5df7830227158db9f47efc8afeb328f1","filename":"runs/online-ch2-b4-finite-identity-20261011/header-proposal/retrieval-02.json","status":"added","additions":22,"deletions":0,"changes":22,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fheader-proposal%2Fretrieval-02.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fheader-proposal%2Fretrieval-02.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fheader-proposal%2Fretrieval-02.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,22 @@\n+{\n+  \"argv\": [\n+    \"rg\",\n+    \"-n\",\n+    \"theorem|cumulativeLoss\",\n+    \"BanditRLProof/TsallisFTRLRegret.lean\"\n+  ],\n+  \"cwd\": \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\",\n+  \"startUTC\": \"2026-10-11T07:28:54.226861+00:00\",\n+  \"endUTC\": \"2026-10-11T07:28:54.237574+00:00\",\n+  \"actual_exit\": 0,\n+  \"streams\": {\n+    \"stdout\": {\n+      \"file\": \"retrieval-02.stdout.raw\",\n+      \"sha256\": \"e73b9cacafc46bd4a16a0c0b26f02f8edb492bd367401aaaf00a7136