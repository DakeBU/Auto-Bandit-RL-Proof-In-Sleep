Finset.sum_range_succ (fun x => loss x v) t))\n+                    (n + 1))\n+                  v)\n+                (congrArg (HAdd.hAdd (psi (n + 1) v))\n+                  (congrFun' (congrArg HAdd.hAdd (Finset.sum_range_succ (fun x => loss x v) n)) (loss (n + 1) v)))))\n+            (congrFun'\n+              (congrArg HAdd.hAdd\n+                (congrFun'\n+                  (congrArg HSub.hSub\n+                    (congrFun'\n+                      (congrArg HAdd.hAdd\n+                        (congrFun'\n+                          (congrFun'\n+                            (funext fun t =>\n+                              funext fun v =>\n+                                congrArg (HAdd.hAdd (psi t v)) (Finset.sum_range_succ (fun x => loss x v) t))\n+                            n)\n+                          v))\n+                      (psi (n + 1) v)))\n+                  (psi n v)))\n+              (loss (n + 1) v))))\n+        (Mathlib.Tactic.Ring.of_eq\n+          (Mathlib.Tactic.Ring.add_congr (Mathlib.Tactic.Ring.atom_pf (psi (n + 1) v))\n+            (Mathlib.Tactic.Ring.add_congr\n+              (Mathlib.Tactic.Ring.add_congr (Mathlib.Tactic.Ring.atom_pf (∑ i ∈ Finset.range n, loss i v))\n+                (Mathlib.Tactic.Ring.atom_pf (loss n v))\n+                (Mathlib.Tactic.Ring.add_pf_add_lt ((∑ i ∈ Finset.range n, loss i v) ^ Nat.rawCast 1 * Nat.rawCast 1)\n+                  (Mathlib.Tactic.Ring.add_pf_zero_add (loss n v ^ Nat.rawCast 1 * Nat.rawCast 1 + 0))))\n+              (Mathlib.Tactic.Ring.atom_pf (loss (n + 1) v))\n+              (Mathlib.Tactic.Ring.add_pf_add_lt ((∑ i ∈ Finset.range n, loss i v) ^ Nat.rawCast 1 * Nat.rawCast 1)\n+                (Mathlib.Tactic.Ring.add_pf_add_lt (loss n v ^ Nat.rawCast 1 * Nat.rawCast 1)\n+                  (Mathlib.Tactic.Ring.add_pf_zero_add (loss (n + 1) v ^ Nat.rawCast 1 * Nat.rawCast 1 + 0)))))\n+            (Mathlib.Tactic.Ring.add_pf_add_lt (psi (n + 1) v ^ Nat.rawCast 1 * Nat.rawCast 1)\n+   