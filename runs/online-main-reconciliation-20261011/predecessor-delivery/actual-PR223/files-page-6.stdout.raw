/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Fartifact-manifest-verification-v2.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Fartifact-manifest-verification-v2.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,12 @@\n+{\n+  \"UTC\": \"2026-10-11T08:24:45.504816+00:00\",\n+  \"manifest_sha256\": \"fe00a4a795b7115857de046c1d21207bf91e5ee33437f2d134a63eda7b3c710a\",\n+  \"all_rows_verified\": true,\n+  \"rows\": 54,\n+  \"exact_file_set_matches\": true,\n+  \"excluded\": [\n+    \"artifact-manifest-v2.json\",\n+    \"artifact-manifest-verification-v2.json\"\n+  ],\n+  \"core_sha256\": \"61c811c0b1f941ec22ac41f64e555a0e4d4d8dc32b8145ea53808dbdc0fc17da\"\n+}"},{"sha":"12e1ace89877b5117a6d4752d2ab7c6e50378ca8","filename":"runs/online-ch2-b4-finite-identity-20261011/production-core/audit-full-v1.py","status":"added","additions":8,"deletions":0,"changes":8,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Faudit-full-v1.py","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Faudit-full-v1.py","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Faudit-full-v1.py?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,8 @@\n+from pathlib import Path\n+import os\n+p=Path('tmp/online-ch2-b4-finite-identity-core-20261011')\n+s=(p/'audit-v1.py').read_text(encoding='utf-8').split('sys.path.insert')[0];exec(s)\n+probe=(out/'PublicCompiledProbe.lean').read_text(encoding='utf-8').replace('open Lean Elab Command\\n','open Lean Elab Command\\nset_option pp.all true\\nset_option pp.proofs true\\nset_option pp.maxDepth 100000\\nset_option pp.maxSteps 10000000\\n').replace('compiled-constant-occurrences-v1.json','compiled-constant-occurrences-v2.json')\n+put('PublicCompiledProbeFull.lean',probe)\n+env=os.environ.copy();env['LEAN_PATH']=str(out/'compiled')+os.pathsep+(out/'lake-search-path-v1.stdout.raw').read_text().strip()\n+run('public-compiled-probe-full-v1',['lean','tmp/online-ch2-b4-finite-identity-core-20261011/PublicCompiledProbeFull.lean'],env)\n\\ No newline at end of file"},{"sha":"c2ea5756340b1e3b6da37dc0d54278190c5ff6c5","filename":"runs/online-ch2-b4-finite-identity-20261011/production-core/audit-full-v2.py","status":"added","additions":8,"deletions":0,"changes":8,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Faudit-full-v2.py","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Faudit-full-v2.py","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Faudit-full-v2.py?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,8 @@\n+from pathlib import Path\n+import os\n+p=Path('tmp/online-ch2-b4-finite-identity-core-20261011')\n+s=(p/'audit-v1.py').read_text(encoding='utf-8').split('sys.path.insert')[0];exec(s)\n+probe=(out/'PublicCompiledProbeFull.lean').read_text(encoding='utf-8').replace('set_option pp.maxDepth 100000\\n','').replace('compiled-constant-occurrences-v2.json','compiled-constant-occurrences-v3.json')\n+put('PublicCompiledProbeFullV2.lean',probe)\n+env=os.environ.copy();env['LEAN_PATH']=str(out/'compiled')+os.pathsep+(out/'lake-search-path-v1.stdout.raw').read_text().strip()\n+run('public-compiled-probe-full-v2',['lean','tmp/online-ch2-b4-finite-identity-core-20261011/PublicCompiledProbeFullV2.lean'],env)\n\\ No newline at end of file"},{"sha":"30777c92ed6e25032404dbc41eb4fe5d07d06706","filename":"runs/online-ch2-b4-finite-identity-20261011/production-core/audit-v1.py","status":"added","additions":41,"deletions":0,"changes":41,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Faudit-v1.py","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Faudit-v1.py","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Faudit-v1.py?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,41 @@\n+from pathlib import Path\n+import hashlib,json,subprocess,datetime,os,sys\n+root=Path('E:/ABRL/worktrees/research-online-book');out=root/'tmp/online-ch2-b4-finite-identity-core-20261011'\n+def sha(b):return hashlib.sha256(b).hexdigest()\n+def put(n,b):\n+ if isinstance(b,str):b=b.encode('utf-8')\n+ with (out/n).open('xb') as f:f.write(b)\n+def run(n,argv,env=None):\n+ start=datetime.datetime.now(datetime.timezone.utc).isoformat();p=subprocess.run(argv,cwd=str(root),env=env,stdout=subprocess.PIPE,stderr=subprocess.PIPE)\n+ put(n+'.stdout.raw',p.stdout);put(n+'.stderr.raw',p.stderr)\n+ put(n+'.json',json.dumps(dict(argv=argv,cwd=str(root),startUTC=start,endUTC=datetime.datetime.now(datetime.timezone.utc).isoformat(),actual_exit=p.returncode,stdout_sha256=sha(p.stdout),stderr_sha256=sha(p.stderr),LEAN_PATH=None if env is None else env.get('LEAN_PATH'),core_sha256=sha((root/'BanditRLProof/OnlineCumulativePotential.lean').read_bytes())),indent=2)+'\\n')\n+ print(n,p.returncode);return p\n+sys.path.insert(0,str(root/'tools'));import abrl_lifecycle as native\n+h=(root/'docs/contracts/online-ch2-b4-finite-identity-v1/neutral-frozen-header-v1.txt').read_text(encoding='utf-8');statement=h[h.index('theorem finite_regret_identity'):h.index('\\n\\nend BanditRL.OnlineCumulativePotential')]\n+fence=native.make_statement_fence(declaration='BanditRL.OnlineCumulativePotential.finite_regret_identity',file='BanditRLProof/OnlineCumulativePotential.lean',statement=statement,source_assumptions=['hT : 0 < T'])\n+put('native-statement-fence-v1.json',json.dumps(fence,indent=2)+'\\n')\n+v=native.safe_verify(root,fence,lean_files=[root/'BanditRLProof/OnlineCumulativePotential.lean'])\n+put('native-safe-verify-v1.json',json.dumps(v,indent=2)+'\\n');assert v['ok']\n+compiled=out/'compiled';(compiled/'BanditRLProof').mkdir(parents=True,exist_ok=True)\n+assert run('focused-olean-v1',['lake','env','lean','-o',str(compiled/'BanditRLProof/OnlineCumulativePotential.olean'),'BanditRLProof/OnlineCumulativePotential.lean']).returncode==0\n+probe='''import BanditRLProof.OnlineCumulativePotential\n+import Lean.Util.FoldConsts\n+open Lean Elab Command\n+#check BanditRL.OnlineCumulativePotential.finite_regret_identity\n+#print BanditRL.OnlineCumulativePotential.finite_regret_identity\n+#print axioms BanditRL.OnlineCumulativePotential.finite_regret_identity\n+run_cmd do\n+  let env ← getEnv\n+  let name := `BanditRL.OnlineCumulativePotential.finite_regret_identity\n+  let some info := env.find? name | throwError \"Missing compiled target\"\n+  let deps := fun (e : Expr) => (e.getUsedConstantsAsSet.toArray.map Name.toString).qsort (· < ·)\n+  let some value := info.value? (allowOpaque := true) | throwError \"Missing proof value\"\n+  let obj := Json.mkObj [\n+    (\"declaration\", toJson name.toString),\n+    (\"TYPE\", toJson (deps info.type)),\n+    (\"VALUE\", toJson (deps value))]\n+  liftIO <| IO.FS.writeFile \"tmp/online-ch2-b4-finite-identity-core-20261011/compiled-constant-occurrences-v1.json\" (obj.pretty ++ \"\\\\n\")\n+'''\n+put('PublicCompiledProbe.lean',probe)\n+env=os.environ.copy();env['LEAN_PATH']=str(compiled)+os.pathsep+env.get('LEAN_PATH','')\n+run('public-compiled-probe-v1',['lake','env','lean','tmp/online-ch2-b4-finite-identity-core-20261011/PublicCompiledProbe.lean'],env)\n\\ No newline at end of file"},{"sha":"9420675adc7b75a68c3a80abb6764c919413876c","filename":"runs/online-ch2-b4-finite-identity-20261011/production-core/audit-v2.py","status":"added","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Faudit-v2.py","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Faudit-v2.py","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Faudit-v2.py?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,7 @@\n+from pathlib import Path\n+import os,json\n+p=Path('tmp/online-ch2-b4-finite-identity-core-20261011')\n+s=(p/'audit-v1.py').read_text(encoding='utf-8').split('sys.path.insert')[0];exec(s)\n+r=run('lake-search-path-v1',['lake','env','python','-c','import os; print(os.environ.get(\"LEAN_PATH\", \"\"))']);assert r.returncode==0\n+lakepath=r.stdout.decode().strip(); env=os.environ.copy();env['LEAN_PATH']=str(out/'compiled')+os.pathsep+lakepath\n+run('public-compiled-probe-v2',['lean','tmp/online-ch2-b4-finite-identity-core-20261011/PublicCompiledProbe.lean'],env)\n\\ No newline at end of file"},{"sha":"ea6b4e3a50989629f00fca9a7a596912de225408","filename":"runs/online-ch2-b4-finite-identity-20261011/production-core/authorization-verified-v1.json","status":"added","additions":16,"deletions":0,"changes":16,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Fauthorization-verified-v1.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Fauthorization-verified-v1.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Fauthorization-verified-v1.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,16 @@\n+{\n+  \"UTC\": \"2026-10-11T08:17:04.423662+00:00\",\n+  \"HEAD\": \"40c2f30f7cee38c9d2f716ffdac18a459a5af25a\",\n+  \"branch\": \"codex/research-online-ch2-b4-finite-identity\",\n+  \"clean\": true,\n+  \"core_absent\": true,\n+  \"frozen_rows_verified\": 116,\n+  \"preproof_rows_verified\": 1220,\n+  \"hashes\": {\n+    \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\\\\tmp\\\\online-ch2-b4-finite-identity-body-authorization-20261011\\\\parent-authorization-v1.json\": \"d2ddf2ec4aa1aba8186125b6dcbf81e9d8fa3155c9cfbb21eab323ab1197db29\",\n+    \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\\\\docs\\\\contracts\\\\online-ch2-b4-finite-identity-v1\\\\leaf-freeze-receipt-v1.json\": \"9150e0fd1342375bf13c7313b7b6715e7e4bdde5edd6078689474381d3ca80cd\",\n+    \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\\\\docs\\\\contracts\\\\online-ch2-b4-finite-identity-v1\\\\neutral-frozen-header-v1.txt\": \"92e0dcfac53595e35b68bfd8083c09640d06da809355ab02ec4eb4b007b0bd67\",\n+    \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\\\\tmp\\\\online-ch2-b4-finite-identity-preproof-20261011\\\\capture-v3\\\\receipt.json\": \"6a041c95d768f92237d00f8fc4979dc6b03b25db79badb368a88eb8a352be7cd\",\n+    \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\\\\tmp\\\\online-ch2-b4-finite-identity-preproof-review-20261011\\\\fresh-independent-preproof-context-review-v1.json\": \"fe427b8f397edd570e8c5f7960c7d0a35fbf8465f10b3b8d35fb27636be2eb4c\"\n+  }\n+}"},{"sha":"9a230229dcf134d34a03b50bdf2177b555018a8c","filename":"runs/online-ch2-b4-finite-identity-20261011/production-core/body-v1.txt","status":"added","additions":30,"deletions":0,"changes":30,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Fbody-v1.txt","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Fbody-v1.txt","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Fbody-v1.txt?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,30 @@\n+  let y : ℕ → E := fun t => if t = T then z else x t\n+  let G : ℕ → E → ℝ := fun t v => psi t v + ∑ i ∈ range (t + 1), loss i v\n+  change (∑ t ∈ range T, (loss t (y t) - loss t u)) =\n+    psi (T - 1) u - psi 0 (y 0) +\n+    (∑ t ∈ range T, (G t (y t) - G t (y (t + 1)))) +\n+    (∑ t ∈ range (T - 1),\n+      (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))) +\n+    G (T - 1) z - G (T - 1) u\n+  have hG (n : ℕ) (v : E) :\n+      G (n + 1) v = G n v + psi (n + 1) v - psi n v + loss (n + 1) v := by\n+    simp only [G, sum_range_succ]\n+    ring\n+  have hmain (n : ℕ) :\n+      (∑ t ∈ range (n + 1), (loss t (y t) - loss t u)) =\n+        psi n u - psi 0 (y 0) +\n+        (∑ t ∈ range (n + 1), (G t (y t) - G t (y (t + 1)))) +\n+        (∑ t ∈ range n, (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))) +\n+        G n (y (n + 1)) - G n u := by\n+    induction n with\n+    | zero =>\n+      simp only [sum_range_succ, sum_range_zero, zero_add, G]\n+      simp only [sum_range_succ, sum_range_zero, zero_add]\n+      ring\n+    | succ n ih =>\n+      simp only [Nat.succ_eq_add_one, sum_range_succ] at ih ⊢\n+      rw [hG n (y (n + 1)), hG n (y (n + 1 + 1)), hG n u]\n+      linarith\n+  have hindex : T - 1 + 1 = T := Nat.sub_add_cancel hT\n+  have hend : y T = z := by simp [y]\n+  simpa only [hindex, hend] using hmain (T - 1)"},{"sha":"bfe2e61f9096abc994ee77bb444f2dced42eda30","filename":"runs/online-ch2-b4-finite-identity-20261011/production-core/body-v2.txt","status":"added","additions":29,"deletions":0,"changes":29,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Fbody-v2.txt","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Fbody-v2.txt","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Fbody-v2.txt?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,29 @@\n+  let y : ℕ → E := fun t => if t = T then z else x t\n+  let G : ℕ → E → ℝ := fun t v => psi t v + ∑ i ∈ range (t + 1), loss i v\n+  change (∑ t ∈ range T, (loss t (y t) - loss t u)) =\n+    psi (T - 1) u - psi 0 (y 0) +\n+    (∑ t ∈ range T, (G t (y t) - G t (y (t + 1)))) +\n+    (∑ t ∈ range (T - 1),\n+      (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))) +\n+    G (T - 1) z - G (T - 1) u\n+  have hG (n : ℕ) (v : E) :\n+      G (n + 1) v = G n v + psi (n + 1) v - psi n v + loss (n + 1) v := by\n+    simp only [G, sum_range_succ]\n+    ring\n+  have hmain (n : ℕ) :\n+      (∑ t ∈ range (n + 1), (loss t (y t) - loss t u)) =\n+        psi n u - psi 0 (y 0) +\n+        (∑ t ∈ range (n + 1), (G t (y t) - G t (y (t + 1)))) +\n+        (∑ t ∈ range n, (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))) +\n+        G n (y (n + 1)) - G n u := by\n+    induction n with\n+    | zero =>\n+      simp only [sum_range_succ, sum_range_zero, zero_add, G]\n+      ring\n+    | succ n ih =>\n+      simp only [sum_range_succ] at ih ⊢\n+      rw [hG n (y (n + 1)), hG n (y (n + 1 + 1)), hG n u]\n+      linarith\n+  have hindex : T - 1 + 1 = T := Nat.sub_add_cancel hT\n+  have hend : y T = z := by simp [y]\n+  simpa only [hindex, hend] using hmain (T - 1)"},{"sha":"84f2c741720c7618f7c4bc8b4fef3d2a4d79868d","filename":"runs/online-ch2-b4-finite-identity-20261011/production-core/candidate-v1.lean","status":"added","additions":51,"deletions":0,"changes":51,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Fcandidate-v1.lean","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Fcandidate-v1.lean","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Fcandidate-v1.lean?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,51 @@\n+import Mathlib.Algebra.BigOperators.Module\n+import Mathlib.Tactic\n+\n+noncomputable section\n+open Finset\n+namespace BanditRL.OnlineCumulativePotential\n+\n+theorem finite_regret_identity {E : Type*}\n+    (psi loss : ℕ → E → ℝ) (x : ℕ → E) (u z : E)\n+    (T : ℕ) (hT : 0 < T) :\n+    let y : ℕ → E := fun t => if t = T then z else x t\n+    let G : ℕ → E → ℝ := fun t v => psi t v + ∑ i ∈ range (t + 1), loss i v\n+    (∑ t ∈ range T, (loss t (y t) - loss t u)) =\n+      psi (T - 1) u - psi 0 (y 0) +\n+      (∑ t ∈ range T, (G t (y t) - G t (y (t + 1)))) +\n+      (∑ t ∈ range (T - 1),\n+        (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))) +\n+      G (T - 1) z - G (T - 1) u := by\n+  let y : ℕ → E := fun t => if t = T then z else x t\n+  let G : ℕ → E → ℝ := fun t v => psi t v + ∑ i ∈ range (t + 1), loss i v\n+  change (∑ t ∈ range T, (loss t (y t) - loss t u)) =\n+    psi (T - 1) u - psi 0 (y 0) +\n+    (∑ t ∈ range T, (G t (y t) - G t (y (t + 1)))) +\n+    (∑ t ∈ range (T - 1),\n+      (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))) +\n+    G (T - 1) z - G (T - 1) u\n+  have hG (n : ℕ) (v : E) :\n+      G (n + 1) v = G n v + psi (n + 1) v - psi n v + loss (n + 1) v := by\n+    simp only [G, sum_range_succ]\n+    ring\n+  have hmain (n : ℕ) :\n+      (∑ t ∈ range (n + 1), (loss t (y t) - loss t u)) =\n+        psi n u - psi 0 (y 0) +\n+        (∑ t ∈ range (n + 1), (G t (y t) - G t (y (t + 1)))) +\n+        (∑ t ∈ range n, (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))) +\n+        G n (y (n + 1)) - G n u := by\n+    induction n with\n+    | zero =>\n+      simp only [sum_range_succ, sum_range_zero, zero_add, G]\n+      simp only [sum_range_succ, sum_range_zero, zero_add]\n+      ring\n+    | succ n ih =>\n+      simp only [Nat.succ_eq_add_one, sum_range_succ] at ih ⊢\n+      rw [hG n (y (n + 1)), hG n (y (n + 1 + 1)), hG n u]\n+      linarith\n+  have hindex : T - 1 + 1 = T := Nat.sub_add_cancel hT\n+  have hend : y T = z := by simp [y]\n+  simpa only [hindex, hend] using hmain (T - 1)\n+\n+\n+end BanditRL.OnlineCumulativePotential"},{"sha":"056ac1fb5399ddd8db4475d13b002940b9c59c0d","filename":"runs/online-ch2-b4-finite-identity-20261011/production-core/candidate-v2.lean","status":"added","additions":50,"deletions":0,"changes":50,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Fcandidate-v2.lean","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Fcandidate-v2.lean","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Fcandidate-v2.lean?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,50 @@\n+import Mathlib.Algebra.BigOperators.Module\n+import Mathlib.Tactic\n+\n+noncomputable section\n+open Finset\n+namespace BanditRL.OnlineCumulativePotential\n+\n+theorem finite_regret_identity {E : Type*}\n+    (psi loss : ℕ → E → ℝ) (x : ℕ → E) (u z : E)\n+    (T : ℕ) (hT : 0 < T) :\n+    let y : ℕ → E := fun t => if t = T then z else x t\n+    let G : ℕ → E → ℝ := fun t v => psi t v + ∑ i ∈ range (t + 1), loss i v\n+    (∑ t ∈ range T, (loss t (y t) - loss t u)) =\n+      psi (T - 1) u - psi 0 (y 0) +\n+      (∑ t ∈ range T, (G t (y t) - G t (y (t + 1)))) +\n+      (∑ t ∈ range (T - 1),\n+        (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))) +\n+      G (T - 1) z - G (T - 1) u := by\n+  let y : ℕ → E := fun t => if t = T then z else x t\n+  let G : ℕ → E → ℝ := fun t v => psi t v + ∑ i ∈ range (t + 1), loss i v\n+  change (∑ t ∈ range T, (loss t (y t) - loss t u)) =\n+    psi (T - 1) u - psi 0 (y 0) +\n+    (∑ t ∈ range T, (G t (y t) - G t (y (t + 1)))) +\n+    (∑ t ∈ range (T - 1),\n+      (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))) +\n+    G (T - 1) z - G (T - 1) u\n+  have hG (n : ℕ) (v : E) :\n+      G (n + 1) v = G n v + psi (n + 1) v - psi n v + loss (n + 1) v := by\n+    simp only [G, sum_range_succ]\n+    ring\n+  have hmain (n : ℕ) :\n+      (∑ t ∈ range (n + 1), (loss t (y t) - loss t u)) =\n+        psi n u - psi 0 (y 0) +\n+        (∑ t ∈ range (n + 1), (G t (y t) - G t (y (t + 1)))) +\n+        (∑ t ∈ range n, (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))) +\n+        G n (y (n + 1)) - G n u := by\n+    induction n with\n+    | zero =>\n+      simp only [sum_range_succ, sum_range_zero, zero_add, G]\n+      ring\n+    | succ n ih =>\n+      simp only [sum_range_succ] at ih ⊢\n+      rw [hG n (y (n + 1)), hG n (y (n + 1 + 1)), hG n u]\n+      linarith\n+  have hindex : T - 1 + 1 = T := Nat.sub_add_cancel hT\n+  have hend : y T = z := by simp [y]\n+  simp