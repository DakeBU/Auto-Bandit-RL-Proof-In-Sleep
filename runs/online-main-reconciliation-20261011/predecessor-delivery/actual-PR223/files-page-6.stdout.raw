ithub.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/deployments\",\"created_at\":\"2026-06-25T01:29:20Z\",\"updated_at\":\"2026-10-11T06:21:29Z\",\"pushed_at\":\"2026-10-11T07:55:59Z\",\"git_url\":\"git://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep.git\",\"ssh_url\":\"git@github.com:DakeBU/Auto-Bandit-RL-Proof-In-Sleep.git\",\"clone_url\":\"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep.git\",\"svn_url\":\"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep\",\"homepage\":\"https://dakebu.github.io/Auto-Bandit-RL-Proof-In-Sleep/\",\"size\":301224,\"stargazers_count\":1,\"watchers_count\":1,\"language\":\"Lean\",\"has_issues\":true,\"has_projects\":true,\"has_downloads\":false,\"has_wiki\":false,\"has_pages\":true,\"has_discussions\":false,\"forks_count\":0,\"mirror_url\":null,\"archived\":false,\"disabled\":false,\"open_issues_count\":104,\"license\":{\"key\":\"mit\",\"name\":\"MIT License\",\"spdx_id\":\"MIT\",\"url\":\"https://api.github.com/licenses/mit\",\"node_id\":\"MDc6TGljZW5zZTEz\"},\"allow_forking\":true,\"is_template\":false,\"web_commit_signoff_required\":false,\"has_pull_requests\":true,\"pull_request_creation_policy\":\"all\",\"topics\":[],\"visibility\":\"public\",\"forks\":0,\"open_issues\":104,\"watchers\":1,\"default_branch\":\"main\"}},\"base\":{\"label\":\"DakeBU:codex/research-online-ch2-unbounded-ogd\",\"ref\":\"codex/research-online-ch2-unbounded-ogd\",\"sha\":\"8045070bf1ee53c83778d04eb168f8ad6f728b59\",\"user\":{\"login\":\"DakeBU\",\"id\":159223240,\"node_id\":\"U_kgDOCX2NyA\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/159223240?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/DakeBU\",\"html_url\":\"https://github.com/DakeBU\",\"followers_url\":\"https://api.github.com/users/DakeBU/followers\",\"following_url\":\"https://api.github.com/users/DakeBU/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/DakeBU/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/Dak