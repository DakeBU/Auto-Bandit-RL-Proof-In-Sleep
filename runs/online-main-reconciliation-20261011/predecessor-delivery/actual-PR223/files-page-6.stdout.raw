s\n+                    (Finset.sum_congr (congrArg Finset.range (zero_add 1)) fun x a => Eq.refl (loss x (y x) - loss x u))\n+                    (Finset.sum_range_succ (fun x => loss x (y x) - loss x u) 0))\n+                  (Eq.trans\n+                    (congrFun' (congrArg HAdd.hAdd (Finset.sum_range_zero fun k => loss k (y k) - loss k u))\n+                      (loss 0 (y 0) - loss 0 u))\n+                    (zero_add (loss 0 (y 0) - loss 0 u)))))\n+              (congr\n+                (congrArg HSub.hSub\n+                  (congr\n+                    (congrArg HAdd.hAdd\n+                      (congr\n+                        (congrArg HAdd.hAdd\n+                          (congrArg (HAdd.hAdd (psi 0 u - psi 0 (y 0)))\n+                            (Eq.trans\n+                              (Eq.trans\n+                                (Finset.sum_congr (congrArg Finset.range (zero_add 1)) fun x a =>\n+                                  congr\n+                                    (congrArg HSub.hSub\n+                                      (congrFun'\n+                                        (congrFun'\n+                                          (funext fun t =>\n+                                            funext fun v =>\n+                                              congrArg (HAdd.hAdd (psi t v))\n+                                                (Finset.sum_range_succ (fun x => loss x v) t))\n+                                          x)\n+                                        (y x)))\n+                                    (congrFun'\n+                                      (congrFun'\n+                                        (funext fun t =>\n+                                          funext fun v =>\n+                                            congrArg (HAdd.hAdd (psi t v))\n+                                              (Finset.sum_range_succ (fun x => loss x v) t))\n+                                        x)\n+                                      (y (x + 1))))\n+                                (Finset.sum_range_succ\n+                                  (fun x =>\n+                                    psi x (y x) + (∑ i ∈ Finset.range x, loss i (y x) + loss x (y x)) -\n+                                      (psi x (y (x + 1)) +\n+                                        (∑ i ∈ Finset.range x, loss i (y (x + 1)) + loss x (y (x + 1)))))\n+                                  0))\n+                              (Eq.trans\n+                                (congr\n+                                  (congrArg HAdd.hAdd\n+                                    (Finset.sum_range_zero fun k =>\n+                                      psi k (y k) + (∑ i ∈ Finset.range k, loss i (y k) + loss k (y k)) -\n+                                        (psi k (y (k + 1)) +\n+                                          (∑ i ∈ Finset.range k, loss i (y (k + 1)) + loss k (y (k + 1))))))\n+                                  (congr\n+                                    (congrArg HSub.hSub\n+                                      (congrArg (HAdd.hAdd (psi 0 (y 0)))\n+                                        (Eq.trans\n+                                          (congrFun' (congrArg HAdd.hAdd (Finset.sum_range_zero fun k => loss k (y 0)))\n+                                            (loss 0 (y 0)))\n+                                          (zero_add (loss 0 (y 0))))))\n+                                    (congr (congrArg HAdd.hAdd (congrArg (psi 0) (congrArg y (zero_add 1))))\n+                                      (Eq.trans\n+                                        (congr\n+                                          (congrArg HAdd.hAdd\n+                                            (Eq.trans\n+                                              (Finset.sum_congr (Eq.refl (Finset.range 0)) fun x a =>\n+                                                congrArg (loss x) (congrArg y (zero_add 1)))\n+                                              (Finset.sum_