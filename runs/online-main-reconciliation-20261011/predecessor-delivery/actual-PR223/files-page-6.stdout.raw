ing.neg_one_mul\n+                                              (Mathlib.Meta.NormNum.IsInt.to_raw_eq\n+                                                (Mathlib.Meta.NormNum.isInt_mul (Eq.refl HMul.hMul)\n+                                                  (Mathlib.Meta.NormNum.IsInt.of_raw ℝ (Int.negOfNat 1))\n+                                                  (Mathlib.Meta.NormNum.IsNat.to_isInt\n+                                                    (Mathlib.Meta.NormNum.IsNat.of_raw ℝ 1))\n+                                                  (Eq.refl (Int.negOfNat 1))))))\n+                                          (Mathlib.Tactic.Ring.neg_add\n+                                            (Mathlib.Tactic.Ring.neg_mul\n+                                              (∑ t ∈ Finset.range n, (G t (y t) - G t (y (t + 1)))) (Nat.rawCast 1)\n+                                              (Mathlib.Tactic.Ring.neg_one_mul\n+                                                (Mathlib.Meta.NormNum.IsNat.to_raw_eq\n+                                                  (Mathlib.Meta.NormNum.IsInt.to_isNat\n+                                                    (Mathlib.Meta.NormNum.isInt_mul (Eq.refl HMul.hMul)\n+                                                      (Mathlib.Meta.NormNum.IsInt.of_raw ℝ (Int.negOfNat 1))\n+                                                      (Mathlib.Meta.NormNum.IsInt.of_raw ℝ (Int.negOfNat 1))\n+                                                      (Eq.refl (Int.ofNat 1)))))))\n+                                            (Mathlib.Tactic.Ring.neg_add\n+                                              (Mathlib.Tactic.Ring.neg_mul (psi n (y n)) (Nat.rawCast 1)\n+                                                (Mathlib.Tactic.Ring.neg_one_mul\n+                                                  (Mathlib.Meta.NormNum.IsNat.to_raw_eq\n+                                                    (Mathlib.Meta.NormNum.IsInt.to_isNat\n+                                                      (Mathlib.Meta.NormNum.isInt_mul (Eq.refl HMul.hMul)\n+                                                        (Mathlib.Meta.NormNum.IsInt.of_raw ℝ (Int.negOfNat 1))\n+                                                        (Mathlib.Meta.NormNum.IsInt.of_raw ℝ (Int.negOfNat 1))\n+                                                        (Eq.refl (Int.ofNat 1)))))))\n+                                              (Mathlib.Tactic.Ring.neg_add\n+                                                (Mathlib.Tactic.Ring.neg_mul (∑ i ∈ Finset.range (n + 1), loss i (y n))\n+                                                  (Nat.rawCast 1)\n+                                                  (Mathlib.Tactic.Ring.neg_one_mul\n+                                                    (Mathlib.Meta.NormNum.IsNat.to_raw_eq\n+                                                      (Mathlib.Meta.NormNum.IsInt.to_isNat\n+                                                        (Mathlib.Meta.NormNum.isInt_mul (Eq.refl HMul.hMul)\n+                                                          (Mathlib.Meta.NormNum.IsInt.of_raw ℝ (Int.negOfNat 1))\n+                                                          (Mathlib.Meta.NormNum.IsInt.of_raw ℝ (Int.negOfNat 1))\n+                                                          (Eq.refl (Int.ofNat 1)))))))\n+                                                (Mathlib.Tactic.Ring.neg_add\n+                                                  (Mathlib.Tactic.Ring.neg_mul\n+                                                    (∑ t ∈ Finset.range n,\n+                                                      (psi t (y (t + 1)) - psi (t + 1) (y (t + 1))))\n+                                                    (Nat.rawCast 1)\n+                                                    (Mathlib.Tactic.Ring.neg_one_mul\n+                                                      (Mathlib.Meta.NormNum.IsNat.to_raw_eq\n+                                                        (Mathlib.Meta.NormNum.IsInt.to_isNat\n+                                                          (Mathlib.Meta.NormNum.isInt_mul (Eq.refl HMul.hMul)\n+                                                            (Mathlib.Meta.NormNum.IsInt.of_raw ℝ (Int.negOfNat 1))\n+                                                            (Mathlib.Meta.NormNum.IsInt.of_raw ℝ (Int.negOfNat 1))\n+                                                            (Eq.refl (Int.ofNat 1)))))))\n+                                                  (Mathlib.Tactic.Ring.neg_add\n+                                                    (Mathlib.Tactic.Ring.neg_mul (∑ i ∈ Finset.range (n + 1), loss i u)\n+                                                      (Nat.rawCast 1)\n+                                                      (Mathlib.Tactic.Ring.neg_one_mul\n+                                                        (Mathlib.Meta.NormNum.IsInt.to_raw_eq\n+                                                          (Mathlib.Meta.NormNum.isInt_mul (Eq.refl HMul.hMul)\n+                                                            (Mathlib.Meta.NormNum.IsInt.of_raw ℝ (Int.negOfNat 1))\n+                                                            (Mathlib.Meta.NormNum.IsNat.to_isInt\n+                                                              (Mathlib.Meta.NormNum.IsNat.of_raw ℝ 1))\n+                                                            (Eq.refl (Int.negOfNat 1))))))\n+                                                    Mathlib.Tactic.Ring.neg_zero))))))))))\n+                                (Mathlib.Tactic.Ring.sub_congr\n+                                  (Mathlib.Tactic.Ring.add_congr\n+                                    (Mathlib.Tactic.Ring.add_congr\n+                                      (Mathlib.Tactic.Ring.atom_pf (∑ t ∈ Finset.range n, (loss t (y t) - loss t u)))\n+                                      (Mathlib.Tactic.Ring.sub_congr (Mathlib.Tactic.Ring.atom_pf (loss n (y n)))\n+                                        (Mathlib.Tactic.Ring.atom_pf (loss n u))\n+                                        (Mathlib.Tactic.Ring.sub_pf\n+                                          (Mathlib.Tactic.Ring.neg_add (Mathlib.Tactic.Ring.neg_mul (loss n u) ⋯ ⋯) ⋯)\n+                                          ⋯))\n+                                      ⋯)\n+                                    ⋯ ⋯)\n+                                  ⋯ ⋯)\n+                                ⋯)\n+                              ⋯))\n+                          ⋯))\n+                    ⋯)))))\n+        ⋯;\n+    ⋯)\n+'BanditRL.OnlineCumulativePotential.finite_regret_identity' depends on axioms: [propext, Classical.choice, Quot.sound]"},{"sha":"e5bffe8f46adc67ee6ba665aae00f050ecdd8695","filename":"runs/online-ch2-b4-finite-identity-20261011/production-core/reader-proof-outline-v1.md","status":"added","additions":9,"deletions":0,"changes":9,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Freader-proof-outline-v1.md","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Freader-proof-outline-v1.md","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Freader-proof-outline-v1.md?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,9 @@\n+The finite-real identity is established for an arbitrary spliced trajectory y, arbitrary losses and regularizers, and positive finite T.\n+\n+1. Inclusive cumulative potentials satisfy G_(n+1)(v) = G_n(v) + psi_(n+1)(v) - psi_n(v) + loss_(n+1)(v). This is Finset.sum_range_succ and real algebra.\n+2. Prove the displayed identity for every prefix n+1 while keeping y fixed. The one-round base case is the direct difference of G_0 values. At the successor, split the final loss difference, the final within-round potential difference, and the final regularizer drift. Substituting the cumulative-potential recurrence cancels the interior terms; the induction hypothesis leaves exactly the new endpoint gap.\n+3. Instantiate n=T-1. Positivity gives (T-1)+1=T; the literal endpoint splice gives y(T)=z. No minimizer, convexity, or algorithm premise is used.\n+\n+Actual authored mathematical parents: Finset.sum_range_succ, Finset.sum_range_zero, Nat.sub_add_cancel, ordinary real ring/linear arithmetic and equality simplification. The compiled constant-occurrence export supplies the full elaborator-level TYPE/VALUE inventory; it is neither a minimal necessity claim nor a transitive graph.\n+\n+Boundary: this proves only the frozen finite-real algebra identity locally. EReal finiteness adaptation, attainment, optimizer/trajectory producers, sharp Young endpoints, complete B4 parents, all seven containers and six future claims, chapter/Goal closure and integration remain open. A distinct BODY review is still required."},{"sha":"4c2658f28c1550f383faf30b37cda73babe7cee6","filename":"runs/online-ch2-b4-finite-identity-20261011/production-core/run-candidate.py","status":"added","additions":21,"deletions":0,"changes":21,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Frun-candidate.py","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Frun-candidate.py","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Frun-candidate.py?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,21 @@\n+from pathlib import Path\n+import hashlib,json,subprocess,datetime,sys\n+root=Path('E:/ABRL/worktrees/research-online-book'); out=root/'tmp/online-ch2-b4-finite-identity-core-20261011'\n+def sha(b):return hashlib.sha256(b).hexdigest()\n+def put(n,b):\n+ if isinstance(b,str):b=b.encode()\n+ with (out/n).open('xb') as f:f.write(b)\n+v=sys.argv[1]\n+h=(root/'docs/contracts/online-ch2-b4-finite-identity-v1/neutral-frozen-header-v1.txt').read_bytes(); assert sha(h)=='92e0dcfac53595e35b68bfd8083c09640d06da809355ab02ec4eb4b007b0bd67'\n+marker=b'\\n\\nend BanditRL.OnlineCumulativePotential\\n'; prefix,suffix=h.split(marker)\n+body=(out/('body-'+v+'.txt')).read_bytes()\n+candidate=prefix+b' := by\\n'+body+marker\n+assert candidate.split(b' := by\\n',1)[0]+marker==h\n+core=root/'BanditRLProof/OnlineCumulativePotential.lean'\n+core.write_bytes(candidate);put('candidate-'+v+'.lean',candidate)\n+start=datetime.datetime.now(datetime.timezone.utc).isoformat()\n+argv=['lake','env','lean','BanditRLProof/OnlineCumulativePotential.lean']\n+p=subprocess.run(argv,cwd=str(root),stdout=subprocess.PIPE,stderr=subprocess.PIPE)\n+put('focused-'+v+'.stdout.raw',p.stdout);put('focused-'+v+'.stderr.raw',p.stderr)\n+put('focused-'+v+'.json',json.dumps(dict(argv=argv,cwd=str(root),startUTC=start,endUTC=datetime.datetime.now(datetime.timezone.utc).isoformat(),actual_exit=p.returncode,candidate_sha256=sha(candidate),stdout_sha256=sha(p.stdout),stderr_sha256=sha(p.stderr),failure_class='NONE' if p.returncode==0 else 'IMPLEMENTATION_FAILED',HEAD=subprocess.check_output(['git','rev-parse','HEAD'],cwd=str(root)).decode().strip(),header_erasure_exact=True),indent=2)+'\\n')\n+print('actual_exit',p.returncode)\n\\ No newline at end of file"},{"sha":"b62ad7bf245fc0734539732f0638876c414663ed","filename":"runs/online-ch2-b4-finite-identity-20261011/production-core/verify-authorization-v1.py","status":"added","additions":21,"deletions":0,"changes":21,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Fverify-authorization-v1.py","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Fverify-authorization-v1.py","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fproduction-core%2Fverify-authorization-v1.py?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,21 @@\n+from pathlib import Path\n+import hashlib,json,subprocess,datetime\n+root=Path('E:/ABRL/worktrees/research-online-book'); out=root/'tmp/online-ch2-b4-finite-identity-core-20261011'; out.mkdir(exist_ok=True)\n+def sha(p): return hashlib.sha256(p.read_bytes()).hexdigest()\n+def put(n,s):\n+ b=s.encode('utf-8') if isinstance(s,str) else s\n+ with (out/n).open('xb') as f:f.write(b)\n+auth=root/'tmp/online-ch2-b4-finite-identity-body-authorization-20261011/parent-authorization-v1.json'\n+assert sha(auth)=='d2ddf2ec4aa1aba8186125b6dcbf81e9d8fa3155c9cfbb21eab323ab1197db29'\n+a=json.loads(auth.read_text()); checks=[(auth,a and sha(auth))]\n+for p,k in [('docs/contracts/online-ch2-b4-finite-identity-v1/leaf-freeze-receipt-v1.json','seal_sha256'),('docs/contracts/online-ch2-b4-finite-identity-v1/neutral-frozen-header-v1.txt','header_sha256'),('tmp/online-ch2-b4-finite-identity-preproof-20261011/capture-v3/receipt.json','actual_preproof_context_sha256'),('tmp/online-ch2-b4-finite-identity-preproof-review-20261011/fresh-independent-preproof-context-review-v1.json','independent_preproof_review_sha256')]:\n+ assert sha(root/p)==a[k];checks.append((root/p,a[k]))\n+assert subprocess.check_output(['git','rev-parse','HEAD'],cwd=str(root)).decode().strip()==a['HEAD']\n+assert subprocess.check_output(['git','branch','--show-current'],cwd=str(root)).decode().strip()==a['branch']\n+assert not subprocess.check_output(['git','status','--porcelain'],cwd=str(root)).strip()\n+assert not (root/'BanditRLProof/OnlineCumulativePotential.lean').exists()\n+seal=json.loads((root/'docs/contracts/online-ch2-b4-finite-identity-v1/leaf-freeze-receipt-v1.json').read_text())\n+rows=json.loads((root/'tmp/online-ch2-b4-finite-identity-preproof-20261011/capture-v3/source-RAW-before.json').read_text())\n+for r in seal['frozen_inputs']+rows:\n+ assert sha(root/r['path'])==r['sha256'],r['path']\n+put('authorization-verified-v1.json',json.dumps(dict(UTC=datetime.datetime.now(datetime.timezone.utc).isoformat(),HEAD=a['HEAD'],branch=a['branch'],clean=True,core_absent=True,frozen_rows_verified=len(seal['frozen_inputs']),preproof_rows_verified=len(rows),hashes={str(p):h for p,h in checks}),indent=2)+'\\n')\n\\ No newline at end of file"},{"sha":"0c78badcba6fecb331d49bbb47c2378a7c8cbb3b","filename":"runs/online-ch2-b4-finite-identity-20261011/reader-proposal-v1/.gitattributes","status":"added","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v1%2F.gitattributes","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v1%2F.gitattributes","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v1%2F.gitattributes?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,4 @@\n+* -text\n+* whitespace=cr-at-eol\n+*.raw -diff\n+*.olean -diff"},{"sha":"dc48717bad6fcef939405b8e0df2714b5b302fa5","filename":"runs/online-ch2-b4-finite-identity-20261011/reader-proposal-v1/chapters-append-patch-v1.json","status":"added","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v1%2Fchapters-append-patch-v1.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v1%2Fchapters-append-patch-v1.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v1%2Fchapters-append-patch-v1.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,7 @@\n+[\n+  {\n+    \"op\": \"add\",\n+    \"path\": \"/chapters/10/module_globs/-\",\n+    \"value\": \"BanditRLProof/OnlineCumulativePotential.lean\"\n+  }\n+]"},{"sha":"fda7ec05c77bb7a208276ade51eee9ce44e756e9","filename":"runs/online-ch2-b4-finite-identity-20261011/reader-proposal-v1/highlights-append-patch-v1.json","status":"added","additions":22,"deletions":0,"changes":22,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v1%2Fhighlights-append-patch-v1.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v1%2Fhighlights-append-patch-v1.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v1%2Fhighlights-append-patch-v1.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,22 @@\n+[\n+  {\n+    \"op\": \"add\",\n+    \"path\": \"/highlights/-\",\n+    \"value\": {\n+      \"full_name\": \"BanditRL.OnlineCumulativePotential.finite_regret_identity\",\n+      \"title\": \"Why the terminal gap belongs in the regret identity\",\n+      \"chapter\": \"online-ogd\",\n+      \"featured\": false,\n+      \"teaching_order\": 340,\n+      \"source_match\": \"closest-source\",\n+      \"plain\": \"An arbitrary state type E, total real-valued functions psi and loss on natural time and E, an arbitrary sequence x, comparator u and terminal z, and a natural horizon T>0. No convexity, norm, optimizer, algorithm, probability or causal premise is required. Finite real arithmetic is a specialization: the full EReal/domain adapter remains separate. Indices are zero-based: source round s corresponds to t=s-1. G includes the current loss through t. Only the unscored coordinate T is spliced to z; all y(t)=x(t) for t<T. The original x(T) is unused. The interior drift has indices0..T-2; forT1 it is empty. T0 is not claimed.\",\n+      \"math\": \"\\\\begin{gathered}G_t(v)=\\\\psi_t(v)+\\\\sum_{i=0}^{t}\\\\ell_i(v),\\\\quad y_t=\\\\begin{cases}z&t=T,\\\\\\\\x_t&t\\\\ne T.\\\\end{cases}\\\\\\\\R_T(u)=\\\\sum_{t=0}^{T-1}(\\\\ell_t(y_t)-\\\\ell_t(u))\\\\\\\\=\\\\psi_{T-1}(u)-\\\\psi_0(y_0)+\\\\sum_{t=0}^{T-1}\\\\bigl(G_t(y_t)-G_t(y_{t+1})\\\\bigr)\\\\\\\\\\\\quad+\\\\sum_{t=0}^{T-2}\\\\bigl(\\\\psi_t(y_{t+1})-\\\\psi_{t+1}(y_{t+1})\\\\bigr)+G_{T-1}(z)-G_{T-1}(u).\\\\end{gathered}\",\n+      \"intuition\": \"The terminal point appears once with a minus sign inside the last within-potential difference and once with a plus sign in the endpoint gap. Their cancellation explains why the scored regret does not depend on an unplayed endpoint.\",\n+      \"why\": \"One shared algebraic component needed by labeled terminal corrections, not a complete regret theorem or source-container count.\",\n+      \"position\": \"Finite-real corrected accounting near Theorem7.47 proof, PDF141–142; related Theorem15.31 terminal convention, PDF278–279. The full EReal adapter, actual optimistic-FTRL/BTRL producers, ghost attainment, support qualification, strong-convex stability, Young estimate and whole corrected7.47/15.31 bounds remain open. A positive arbitrary terminal gap cannot be discarded.\",\n+      \"proof_idea\": \"Put H_t(v)=sum_{i<t}loss_i(v), so G_t=psi_t+H_(t+1). The regularizer parts of the within-G sum, together with the interior drift, telescope to psi_0(y_0)-psi_(T-1)(z). The cumulative-loss parts telescope to sum_{t<T}loss_t(y_t)-H_T(z). Adding the initial comparator term and the retained G_(T-1)(z)-G_(T-1)(u) leaves exactly the regret. This is the mathematical cancellation argument, not a claimed implementation route.\",\n+      \"lean_notes\": \"E has no additional typeclass assumptions; psi/loss are real-valued and T>0 is the only propositional premise. Local y and G are definitions, not extra hypotheses. The exact Lean header and eventual full-proof source link use the declaration fold; the current renderer exposes these notes, not a complete rendered source-proof graph. Actual compiled VALUE parents are pending an export and will be recorded separately from the source-only AND topology. Prepared one-round and two-round canary headers check a positive gap and nonzero drift/terminal splice; their BODY and compilation are not claimed. Candidate finite-real corrected algebra subclause. Production BODY acceptance, actual VALUE export and package gates are pending; no compiled claim is made. Unmerged and unpublished.\",\n+      \"dependencies\": []\n+    }\n+  }\n+]"},{"sha":"8dc74124b401dc669cfe892023fd4148feee16cd","filename":"runs/online-ch2-b4-finite-identity-20261011/reader-proposal-v1/plan-v1.md","status":"added","additions":11,"deletions":0,"changes":11,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v1%2Fplan-v1.md","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v1%2Fplan-v1.md","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v1%2Fplan-v1.md?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,11 @@\n+# Finite identity Book integration proposal v1\n+\n+Three append operations only: one online-ogd module glob, one coherent corrected-algebra source card, and one full_name-bound lesson at teaching order340. All22 existing source cards, all old highlights, all other chapters and historical completion text are preserved as complete parsed objects. Reversing only the three in-memory appends reproduces all original documents exactly. No canonical file was changed.\n+\n+The complete displayed equality retains initial potential, within-G differences, interior regularizer drift and terminal G gap, with inclusive cumulative losses and only the unscored endpoint spliced. Adjacent assumptions identify arbitrary carrier, globally real typing, T>0 and emptyT1 drift. The source attribution is explicitly the corrected finite-real algebra subclause, not literal full7.47/15.31. The independent explanatory outline uses regularizer and cumulative-loss telescoping.\n+\n+Actual compiled status, BODY acceptance and TYPE/VALUE parents remain null/pending. The proposed card uses the renderer's planned status with a candidate label. Dependencies stays empty until actual export and registry-compatible review; Mathlib nodes are not invented. Source topology, future Lean proof edges, compressed teaching outline and conceptual generalization are kept distinct. Existing lean_notes/fold support is used; a full source-graph rendering is not claimed.\n+\n+Both canaries are prepared HEADER contracts only. No compilation, apply, root/Test/manifest/DOC/RUN/site writes, freeze or canary BODY authorization. Parent owns eventual imports. Seven containers and six future claims stay open; Chapter2 partial/accepted=false/denominator=null, Goal ACTIVE, PURIFIED pending, unmerged/unpublished. Full EReal/producer/attainment/support/stability/Young and corrected parent endpoints remain open.\n+\n+Read proposal-v1.json for exact baseline pins, atomic binder audit, RFC6902 patch payloads, invariants and later validation hooks. Successor v2 must bind actual export and review evidence before a publication decision."},{"sha":"8f8d9ba2a2efe4e4f4f495b71d224da670f6059c","filename":"runs/online-ch2-b4-finite-identity-20261011/reader-proposal-v1/proposal-v1.json","status":"added","additions":182,"deletions":0,"changes":182,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v1%2Fproposal-v1.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v1%2Fproposal-v1.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v1%2Fproposal-v1.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,182 @@\n+{\n+  \"status\": \"PROOF-FREE INTEGRATION PROPOSAL v1; not applied; distinct review required\",\n+  \"actor\": \"/root/adaptive_decoder\",\n+  \"requested_model_effort\": \"GPT-6 Astra / medium; runtime not attested\",\n+  \"input_raw_sha256\": {\n+    \"website/content/chapters.json\": \"17fe0e096447259511e706179a8ebe5eae4d19a6b26764ccd073d02e287db795\",\n+    \"website/content/readings.json\": \"fa35944998387cf579ca9b88c71bcf1d73e2b0400335c17cb6938d54a8fa26f2\",\n+    \"website/content/highlights.json\": \"43df4440422f70f042c6468af344fcc51fb3adfa798c79bf08227fcac2c4abda\",\n+    \"website/scripts/build_site.py\": \"4fe18b8b9a543ff5256a278f49d160424b30ba2185c946f3d6081ad5460ccaff\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/neutral-frozen-header-v1.txt\": \"92e0dcfac53595e35b68bfd8083c09640d06da809355ab02ec4eb4b007b0bd67\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/source-contract-proposal-v1.json\": \"939a72100fe5a416a19aace105b95dad38cd4fc5713cdb4c9edf7a61d6197e6a\",\n+    \"docs/contracts/online-ch2-b4-finite-identity-v1/leaf-freeze-receipt-v1.json\": \"9150e0fd1342375bf13c7313b7b6715e7e4bdde5edd6078689474381d3ca80cd\",\n+    \"tmp/online-ch2-b4-finite-identity-source-review-20261011/source-header-review-v1.json\": \"adda7e17c6ebf0ba1b8c24d9cd78e0df763f55000521ec01fb8d94b51229228f\",\n+    \"tmp/online-ch2-b4-finite-identity-source-review-20261011/topology-proposal-v2.json\": \"d7d6051f3788797b53a19d5d80f163bdca80491281ec13be998b4c2d106ad8bc\",\n+    \"tmp/online-ch2-b4-finite-identity-canary-source-review-20261011/source-header-review-v1.json\": \"b581b3fff2379b4805fd7e472b12bd7d4cca4e2dc13d519b3d2e4f7f3b364939\"\n+  },\n+  \"allowed_future_product_scope\": [\n+    \"website/content/chapters.json\",\n+    \"website/content/readings.json\",\n+    \"website/content/highlights.json\"\n+  ],\n+  \"patch_format\": \"RFC6902 add operations only; apply only to exact hash-bound baseline or independently reviewed rebase; these are proposals, not an apply tool\",\n+  \"patches\": {\n+    \"website/content/chapters.json\": [\n+      {\n+        \"op\": \"add\",\n+        \"path\": \"/chapters/10/module_globs/-\",\n+        \"value\": \"BanditRLProof/OnlineCumulativePotential.lean\"\n+      }\n+    ],\n+    \"website/content/readings.json\": [\n+      {\n+        \"op\": \"add\",\n+        \"path\": \"/readings/10/source_theorems/-\",\n+        \"value\": {\n+          \"label\": \"Corrected terminal accounting: the finite-real regret identity\",\n+          \"pages\": \"printed129–130,266–267 / PDF141–142,278–279\",\n+          \"pdf_page\": 142,\n+          \"url\": \"https://arxiv.org/pdf/1912.13213v10#page=142\",\n+          \"math\": \"\\\\begin{gathered}G_t(v)=\\\\psi_t(v)+\\\\sum_{i=0}^{t}\\\\ell_i(v),\\\\quad y_t=\\\\begin{cases}z&t=T,\\\\\\\\x_t&t\\\\ne T.\\\\end{cases}\\\\\\\\R_T(u)=\\\\sum_{t=0}^{T-1}(\\\\ell_t(y_t)-\\\\ell_t(u))\\\\\\\\=\\\\psi_{T-1}(u)-\\\\psi_0(y_0)+\\\\sum_{t=0}^{T-1}\\\\bigl(G_t(y_t)-G_t(y_{t+1})\\\\bigr)\\\\\\\\\\\\quad+\\\\sum_{t=0}^{T-2}\\\\bigl(\\\\psi_t(y_{t+1})-\\\\psi_{t+1}(y_{t+1})\\\\bigr)+G_{T-1}(z)-G_{T-1}(u).\\\\end{gathered}\",\n+          \"plain\": \"An arbitrary state type E, total real-valued functions psi and loss on natural time and E, an arbitrary sequence x, comparator u and terminal z, and a natural horizon T>0. No convexity, norm, optimizer, algorithm, probability or causal premise is required. Finite real arithmetic is a specialization: the full EReal/domain adapter remains separate. Indices are zero-based: source round s corresponds to t=s-1. G includes the current loss through t. Only the unscored coordinate T is spliced to z; all y(t)=x(t) for t<T. The original x(T) is unused. The interior drift has indices0..T-2; forT1 it is empty. T0 is not claimed.\",\n+          \"fallback\": \"Regret equals initial regularizer difference plus within-potential differences plus interior regularizer drift plus the terminal cumulative-objective gap.\",\n+          \"relationship\": \"This is the finite-real corrected algebra subclause of repair:7.47-terminal, related to the terminal correction of Theorem15.31; it is not the literal full printed theorem. The source uses Euclidean feasible states and extended losses; the algebra abstracts the carrier and uses globally real functions. Repeating a virtual final hint is legitimate, but omitting its terminal residual can invalidate the sharp bound. The full EReal adapter, actual optimistic-FTRL/BTRL producers, ghost attainment, support qualification, strong-convex stability, Young estimate and whole corrected7.47/15.31 bounds remain open. A positive arbitrary terminal gap cannot be discarded.\",\n+          \"contract\": {\n+            \"model\": \"Exact deterministic accounting for arbitrary states and functions; no algorithmic run is asserted. Indices are zero-based: source round s corresponds to t=s-1. G includes the current loss through t. Only the unscored coordinate T is spliced to z; all y(t)=x(t) for t<T. The original x(T) is unused. The interior drift has indices0..T-2; forT1 it is empty. T0 is not claimed.\",\n+            \"assumptions\": \"An arbitrary state type E, total real-valued functions psi and loss on natural time and E, an arbitrary sequence x, comparator u and terminal z, and a natural horizon T>0. No convexity, norm, optimizer, algorithm, probability or causal premise is required. Finite real arithmetic is a specialization: the full EReal/domain adapter remains separate.\",\n+            \"parameters\": \"T is a positive natural number. u and z are independent arbitrary states; no relation between z and original x(T).\",\n+            \"regret\": \"R_T(u)=sum_{t<T}(loss_t(y_t)-loss_t(u)); the scored states are unchanged by the terminal splice.\",\n+            \"guarantee\": \"Full equality including every endpoint and drift term. The full EReal adapter, actual optimistic-FTRL/BTRL producers, ghost attainment, support qualification, strong-convex stability, Young estimate and whole corrected7.47/15.31 bounds remain open. A positive arbitrary terminal gap cannot be discarded.\"\n+          },\n+          \"local_status\": {\n+            \"status\": \"planned\",\n+            \"label\": \"Candidate corrected finite-real identity\",\n+            \"boundary\": \"Candidate finite-real corrected algebra subclause. Production BODY acceptance, actual VALUE export and package gates are pending; no compiled claim is made. Unmerged and unpublished.\"\n+          }\n+        }\n+      }\n+    ],\n+    \"website/content/highlights.json\": [\n+      {\n+        \"op\": \"add\",\n+        \"path\": \"/highlights/-\",\n+        \"value\": {\n+          \"full_name\": \"BanditRL.OnlineCumulativePotential.finite_regret_identity\",\n+          \"title\": \"Why the terminal gap belongs in the regret identity\",\n+          \"chapter\": \"online-ogd\",\n+          \"featured\": false,\n+          \"teaching_order\": 340,\n+          \"source_match\": \"closest-source\",\n+          \"plain\": \"An arbitrary state type E, total real-valued functions psi and loss on natural time and E, an arbitrary sequence x, comparator u and terminal z, and a natural horizon T>0. No convexity, norm, optimizer, algorithm, probability or causal premise is required. Finite real arithmetic is a specialization: the full EReal/domain adapter remains separate. Indices are zero-based: source round s corresponds to t=s-1. G includes the current loss through t. Only the unscored coordinate T is spliced to z; all y(t)=x(t) for t<T. The original x(T) is unused. The interior drift has indices0..T-2; forT1 it is empty. T0 is not claimed.\",\n+          \"math\": \"\\\\begin{gathered}G_t(v)=\\\\psi_t(v)+\\\\sum_{i=0}^{t}\\\\ell_i(v),\\\\quad y_t=\\\\begin{cases}z&t=T,\\\\\\\\x_t&t\\\\ne T.\\\\end{cases}\\\\\\\\R_T(u)=\\\\sum_{t=0}^{T-1}(\\\\ell_t(y_t)-\\\\ell_t(u))\\\\\\\\=\\\\psi_{T-1}(u)-\\\\psi_0(y_0)+\\\\sum_{t=0}^{T-1}\\\\bigl(G_t(y_t)-G_t(y_{t+1})\\\\bigr)\\\\\\\\\\\\quad+\\\\sum_{t=0}^{T-2}\\\\bigl(\\\\psi_t(y_{t+1})-\\\\psi_{t+1}(y_{t+1})\\\\bigr)+G_{T-1}(z)-G_{T-1}(u).\\\\end{gathered}\",\n+          \"intuition\": \"The terminal point appears once with a minus sign inside the last within-potential difference and once with a plus sign in the endpoint gap. Their cancellation explains why the scored regret does not depend on an unplayed endpoint.\",\n+          \"why\": \"One shared algebraic component needed by labeled terminal corrections, not a complete regret theorem or source-container count.\",\n+          \"position\": \"Finite-real corrected accounting near Theorem7.47 proof, PDF141–142; related Theorem15.31 terminal convention, PDF278–279. The full EReal adapter, actual optimistic-FTRL/BTRL producers, ghost attainment, support qualification, strong-convex stability, Young estimate and whole corrected7.47/15.31 bounds remain open. A positive arbitrary terminal gap cannot be discarded.\",\n+          \"proof_idea\": \"Put H_t(v)=sum_{i<t}loss_i(v), so G_t=psi_t+H_(t+1). The regularizer parts of the within-G sum, together with the interior drift, telescope to psi_0(y_0)-psi_(T-1)(z). The cumulative-loss parts telescope to sum_{t<T}loss_t(y_t)-H_T(z). Adding the initial comparator term and the retained G_(T-1)(z)-G_(T-1)(u) leaves exactly the regret. This is the mathematical cancellation argument, not a claimed implementation route.\",\n+          \"lean_notes\": \"E has no additional typeclass assumptions; psi/loss are real-valued and T>0 is the only propositional premise. Local y and G are definitions, not extra hypotheses. The exact Lean header and eventual full-proof source link use the declaration fold; the current renderer exposes these notes, not a complete rendered source-proof graph. Actual compiled VALUE parents are pending an export and will be recorded separately from the source-only AND topology. Prepared one-round and two-round canary headers check a positive gap and nonzero drift/terminal splice; their BODY and compilation are not claimed. Candidate finite-real corrected algebra subclause. Production BODY acceptance, actual VALUE export and package gates are pending; no compiled claim is made. Unmerged and unpublished.\",\n+          \"dependencies\": []\n+        }\n+      }\n+    ]\n+  },\n+  \"production_declaration\": \"BanditRL.OnlineCumulativePotential.finite_regret_identity\",\n+  \"compiled\": null,\n+  \"production_BODY_review\": null,\n+  \"actual_TYPE_VALUE_export\": null,\n+  \"actual_VALUE_parents\": null,\n+  \"pending_evidence\": \"No new production implementation read; no actual dependency/compiled status invented. Follow-up v2 must bind actual export/BODY acceptance and gate status before review/apply.\",\n+  \"in_memory_invariants\": {\n+    \"restoring_only_three_appends_equals_entire_old_documents\": true,\n+    \"all22_old_source_cards_exact_objects_preserved\": true,\n+    \"proposed_card_count\": 23,\n+    \"all_old_highlights_preserved\": true,\n+    \"all_other_chapter_objects_preserved\": true,\n+    \"historical_completion_definition_unchanged\": true,\n+    \"operation_count\": 3,\n+    \"new_highlights\": 1\n+  },\n+  \"atomic_binder_ledger\": [\n+    {\n+      \"binder\": \"E\",\n+      \"classification\": \"TYPING\",\n+      \"reason\": \"Type*; arbitrary carrier generalizes source Euclidean feasible states for algebra only.\"\n+    },\n+    {\n+      \"binder\": \"psi\",\n+      \"classification\": \"STANDING\",\n+      \"reason\": \"Natural-time total real-valued functions; source regularizer values restricted to this finite-real algebra interface.\"\n+    },\n+    {\n+      \"binder\": \"loss\",\n+      \"classification\": \"STANDING\",\n+      \"reason\": \"Natural-time total real-valued functions; source EReal losses require a separate finite-evaluation adapter.\"\n+    },\n+    {\n+      \"binder\": \"x\",\n+      \"classification\": \"SOURCE\",\n+      \"reason\": \"Played finite sequence extended to a total sequence for indexing, with arbitrary unused tail; no algorithm premise needed for equality.\"\n+    },\n+    {\n+      \"binder\": \"u\",\n+      \"classification\": \"SOURCE\",\n+      \"reason\": \"Arbitrary comparator in the chosen carrier; feasible-set embedding remains external.\"\n+    },\n+    {\n+      \"binder\": \"z\",\n+      \"classification\": \"SOURCE\",\n+      \"reason\": \"Arbitrary terminal point of frozen corrected algebra clause; no minimizer or recurrence assumed.\"\n+    },\n+    {\n+      \"binder\": \"T\",\n+      \"classification\": \"SOURCE\",\n+      \"reason\": \"Finite natural horizon.\"\n+    },\n+    {\n+      \"binder\": \"hT\",\n+      \"classification\": \"STANDING\",\n+      \"reason\": \"Positive horizon of frozen correction; avoids Nat-subtraction terminal degeneracy.\"\n+    }\n+  ],\n+  \"local_let_ledger\": [\n+    {\n+      \"name\": \"y\",\n+      \"classification\": \"TYPING\",\n+      \"meaning\": \"Endpoint splice, no hypothesis; t<T unchanged and y(T)=z.\"\n+    },\n+    {\n+      \"name\": \"G\",\n+      \"classification\": \"TYPING\",\n+      \"meaning\": \"Inclusive cumulative potential definition, no extra premise.\"\n+    }\n+  ],\n+  \"graph_contract\": {\n+    \"source_topology_sha256\": \"d7d6051f3788797b53a19d5d80f163bdca80491281ec13be998b4c2d106ad8bc\",\n+    \"source_topology\": \"Source-only unverified AND obligations and separate literal/corrected endpoint nodes, not actual Lean proof edges.\",\n+    \"future_Lean_VALUE\": \"Pending actual export; dependencies=[] avoids inventing Mathlib project-registry nodes. Any eventual selected occurrences go into lean_notes with occurrence/not-necessity limit.\",\n+    \"compressed_spine\": \"Expository initial/within/drift/gap grouping only; no additional theorem or verified route.\",\n+    \"functor\": \"Arbitrary-carrier algebra abstraction is conceptual; no formal categorical transport/functor claimed.\",\n+    \"rendering\": \"Current renderer supports lean_notes and declaration folds; full source graph visual rendering is not asserted.\"\n+  },\n+  \"governance_boundary\": {\n+    \"open_forward_containers\": 7,\n+    \"future_claims_open\": 6,\n+    \"Chapter2\": \"partial\",\n+    \"accepted\": false,\n+    \"denominator\": null,\n+    \"Goal\": \"ACTIVE boundary; no tool query in this task\",\n+    \"PURIFIED\": \"pending\",\n+    \"unmerged\": true,\n+    \"unpublished\": true,\n+    \"root_Tests_manifest_DOC_RUN_site_writes\": false,\n+    \"canary_BODY_authorization\": false\n+  },\n+  \"validation_hooks\": [\n+    \"Verify exact input RAW hashes and independently review proposed rows before apply.\",\n+    \"After actual core BODY acceptance/export, prepare successor binding current truthful status and selected VALUE parents.\",\n+    \"Later check module declaration fold/header/fullproof link against actual candidate commit; no link invented now.\",\n+    \"Later registry-preservation and renderer checks must run against current prior baseline; no node-count/source-denominator inference.\",\n+    \"MathJax full identity and boundary adjacent prose require actual rendered review.\",\n+    \"Any root/Test imports are parent-owned and outside these three patches.\"\n+  ],\n+  \"inputs_unchanged\": true\n+}"},{"sha":"8394a4a05847e8f28e98acc24fc6f1a92e44ea09","filename":"runs/online-ch2-b4-finite-identity-20261011/reader-proposal-v1/readings-append-patch-v1.json","status":"added","additions":28,"deletions":0,"changes":28,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v1%2Freadings-append-patch-v1.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v1%2Freadings-append-patch-v1.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v1%2Freadings-append-patch-v1.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,28 @@\n+[\n+  {\n+    \"op\": \"add\",\n+    \"path\": \"/readings/10/source_theorems/-\",\n+    \"value\": {\n+      \"label\": \"Corrected terminal accounting: the finite-real regret identity\",\n+      \"pages\": \"printed129–130,266–267 / PDF141–142,278–279\",\n+      \"pdf_page\": 142,\n+      \"url\": \"https://arxiv.org/pdf/1912.13213v10#page=142\",\n+      \"math\": \"\\\\begin{gathered}G_t(v)=\\\\psi_t(v)+\\\\sum_{i=0}^{t}\\\\ell_i(v),\\\\quad y_t=\\\\begin{cases}z&t=T,\\\\\\\\x_t&t\\\\ne T.\\\\end{cases}\\\\\\\\R_T(u)=\\\\sum_{t=0}^{T-1}(\\\\ell_t(y_t)-\\\\ell_t(u))\\\\\\\\=\\\\psi_{T-1}(u)-\\\\psi_0(y_0)+\\\\sum_{t=0}^{T-1}\\\\bigl(G_t(y_t)-G_t(y_{t+1})\\\\bigr)\\\\\\\\\\\\quad+\\\\sum_{t=0}^{T-2}\\\\bigl(\\\\psi_t(y_{t+1})-\\\\psi_{t+1}(y_{t+1})\\\\bigr)+G_{T-1}(z)-G_{T-1}(u).\\\\end{gathered}\",\n+      \"plain\": \"An arbitrary state type E, total real-valued functions psi and loss on natural time and E, an arbitrary sequence x, comparator u and terminal z, and a natural horizon T>0. No convexity, norm, optimizer, algorithm, probability or causal premise is required. Finite real arithmetic is a specialization: the full EReal/domain adapter remains separate. Indices are zero-based: source round s corresponds to t=s-1. G includes the current loss through t. Only the unscored coordinate T is spliced to z; all y(t)=x(t) for t<T. The original x(T) is unused. The interior drift has indices0..T-2; forT1 it is empty. T0 is not claimed.\",\n+      \"fallback\": \"Regret equals initial regularizer difference plus within-potential differences plus interior regularizer drift plus the terminal cumulative-objective gap.\",\n+      \"relationship\": \"This is the finite-real corrected algebra subclause of repair:7.47-terminal, related to the terminal correction of Theorem15.31; it is not the literal full printed theorem. The source uses Euclidean feasible states and extended losses; the algebra abstracts the carrier and uses globally real functions. Repeating a virtual final hint is legitimate, but omitting its terminal residual can invalidate the sharp bound. The full EReal adapter, actual optimistic-FTRL/BTRL producers, ghost attainment, support qualification, strong-convex stability, Young estimate and whole corrected7.47/15.31 bounds remain open. A positive arbitrary terminal gap cannot be discarded.\",\n+      \"contract\": {\n+        \"model\": \"Exact deterministic accounting for arbitrary states and functions; no algorithmic run is asserted. Indices are zero-based: source round s corresponds to t=s-1. G includes the current loss through t. Only the unscored coordinate T is spliced to z; all y(t)=x(t) for t<T. The original x(T) is unused. The interior drift has indices0..T-2; forT1 it is empty. T0 is not claimed.\",\n+        \"assumptions\": \"An arbitrary state type E, total real-valued functions psi and loss on natural time and E, an arbitrary sequence x, comparator u and terminal z, and a natural horizon T>0. No convexity, norm, optimizer, algorithm, probability or causal premise is required. Finite real arithmetic is a specialization: the full EReal/domain adapter remains separate.\",\n+        \"parameters\": \"T is a positive natural number. u and z are independent arbitrary states; no relation between z and original x(T).\",\n+        \"regret\": \"R_T(u)=sum_{t<T}(loss_t(y_t)-loss_t(u)); the scored states are unchanged by the terminal splice.\",\n+        \"guarantee\": \"Full equality including every endpoint and drift term. The full EReal adapter, actual optimistic-FTRL/BTRL producers, ghost attainment, support qualification, strong-convex stability, Young estimate and whole corrected7.47/15.31 bounds remain open. A positive arbitrary terminal gap cannot be discarded.\"\n+      },\n+      \"local_status\": {\n+        \"status\": \"planned\",\n+        \"label\": \"Candidate corrected finite-real identity\",\n+        \"boundary\": \"Candidate finite-real corrected algebra subclause. Production BODY acceptance, actual VALUE export and package gates are pending; no compiled claim is made. Unmerged and unpublished.\"\n+      }\n+    }\n+  }\n+]"},{"sha":"0c78badcba6fecb331d49bbb47c2378a7c8cbb3b","filename":"runs/online-ch2-b4-finite-identity-20261011/reader-proposal-v2/.gitattributes","status":"added","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v2%2F.gitattributes","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v2%2F.gitattributes","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v2%2F.gitattributes?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,4 @@\n+* -text\n+* whitespace=cr-at-eol\n+*.raw -diff\n+*.olean -diff"},{"sha":"dc48717bad6fcef939405b8e0df2714b5b302fa5","filename":"runs/online-ch2-b4-finite-identity-20261011/reader-proposal-v2/chapters-append-patch-v2.json","status":"added","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v2%2Fchapters-append-patch-v2.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v2%2Fchapters-append-patch-v2.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v2%2Fchapters-append-patch-v2.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,7 @@\n+[\n+  {\n+    \"op\": \"add\",\n+    \"path\": \"/chapters/10/module_globs/-\",\n+    \"value\": \"BanditRLProof/OnlineCumulativePotential.lean\"\n+  }\n+]"},{"sha":"efb15517fb8183d83a576e6af9279cf994edcd62","filename":"runs/online-ch2-b4-finite-identity-20261011/reader-proposal-v2/highlights-append-patch-v2.json","status":"added","additions":22,"deletions":0,"changes":22,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v2%2Fhighlights-append-patch-v2.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v2%2Fhighlights-append-patch-v2.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v2%2Fhighlights-append-patch-v2.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,22 @@\n+[\n+  {\n+    \"op\": \"add\",\n+    \"path\": \"/highlights/-\",\n+    \"value\": {\n+      \"full_name\": \"BanditRL.OnlineCumulativePotential.finite_regret_identity\",\n+      \"title\": \"Why the terminal gap belongs in the regret identity\",\n+      \"chapter\": \"online-ogd\",\n+      \"featured\": false,\n+      \"teaching_order\": 340,\n+      \"source_match\": \"closest-source\",\n+      \"plain\": \"An arbitrary state type E, total real-valued functions psi and loss on natural time and E, an arbitrary sequence x, comparator u and terminal z, and a natural horizon T>0. No convexity, norm, optimizer, algorithm, probability or causal premise is required. Finite real arithmetic is a specialization: the full EReal/domain adapter remains separate. Indices are zero-based: source round s corresponds to t=s-1. G includes the current loss through t. Only the unscored coordinate T is spliced to z; all y(t)=x(t) for t<T. The original x(T) is unused. The interior drift has indices0..T-2; forT1 it is empty. T0 is not claimed.\",\n+      \"math\": \"\\\\begin{gathered}G_t(v)=\\\\psi_t(v)+\\\\sum_{i=0}^{t}\\\\ell_i(v),\\\\quad y_t=\\\\begin{cases}z&t=T,\\\\\\\\x_t&t\\\\ne T.\\\\end{cases}\\\\\\\\R_T(u)=\\\\sum_{t=0}^{T-1}(\\\\ell_t(y_t)-\\\\ell_t(u))\\\\\\\\=\\\\psi_{T-1}(u)-\\\\psi_0(y_0)+\\\\sum_{t=0}^{T-1}\\\\bigl(G_t(y_t)-G_t(y_{t+1})\\\\bigr)\\\\\\\\\\\\quad+\\\\sum_{t=0}^{T-2}\\\\bigl(\\\\psi_t(y_{t+1})-\\\\psi_{t+1}(y_{t+1})\\\\bigr)+G_{T-1}(z)-G_{T-1}(u).\\\\end{gathered}\",\n+      \"intuition\": \"The terminal point appears once with a minus sign inside the last within-potential difference and once with a plus sign in the endpoint gap. Their cancellation explains why the scored regret does not depend on an unplayed endpoint.\",\n+      \"why\": \"One shared algebraic component needed by labeled terminal corrections, not a complete regret theorem or source-container count.\",\n+      \"position\": \"Finite-real corrected accounting near Theorem7.47 proof, PDF141–142; related Theorem15.31 terminal convention, PDF278–279. The full EReal adapter, actual optimistic-FTRL/BTRL producers, ghost attainment, support qualification, strong-convex stability, Young estimate and whole corrected7.47/15.31 bounds remain open. A positive arbitrary terminal gap cannot be discarded.\",\n+      \"proof_idea\": \"Put H_t(v)=sum_{i<t}loss_i(v), so G_t=psi_t+H_(t+1). The regularizer parts of the within-G sum, together with the interior drift, telescope to psi_0(y_0)-psi_(T-1)(z). The cumulative-loss parts telescope to sum_{t<T}loss_t(y_t)-H_T(z). Adding the final comparator regularizer minus the initial played regularizer and the retained G_(T-1)(z)-G_(T-1)(u) leaves exactly the regret. This is the mathematical cancellation argument, not a claimed implementation route.\",\n+      \"lean_notes\": \"E has no additional typeclass assumptions; psi/loss are real-valued and T>0 is the only propositional premise. The boundary regularizer difference is psi_(T-1)(u)-psi_0(y_0): final comparator regularizer minus initial played regularizer. Local y and G are definitions, not extra hypotheses. The exact Lean header and eventual full-proof source link use the declaration fold; these notes do not claim a complete rendered source-proof graph. Selected actual compiled direct VALUE occurrences are Nat.recAux, Finset.sum_range_succ, Finset.sum_range_zero and Nat.sub_add_cancel. Occurrence does not establish logical necessity or a complete transitive graph; Nat.rec is not the exported direct constant. The source-only AND topology remains distinct from these implementation occurrences. Prepared one-round and two-round canary headers check a positive gap and nonzero drift/terminal splice; their BODY acceptance and compilation remain pending. Locally compiled finite-real identity with independent production BODY acceptance as a bounded candidate. Canary and combined package validation remain pending. Unmerged and unpublished.\",\n+      \"dependencies\": []\n+    }\n+  }\n+]"},{"sha":"c970676a46540fa109a958d5746ca8cdcb8779dc","filename":"runs/online-ch2-b4-finite-identity-20261011/reader-proposal-v2/plan-v2.md","status":"added","additions":9,"deletions":0,"changes":9,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v2%2Fplan-v2.md","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v2%2Fplan-v2.md","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v2%2Fplan-v2.md?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,9 @@\n+# Book integration proposal v2\n+\n+One module glob, one coherent source card and one lesson remain the entire proposed change. All22 prior cards and every other old parsed object are preserved; reversing the three in-memory appends restores the complete originals. V1 is unchanged. No canonical apply or build occurred.\n+\n+The production status now binds the independently accepted local candidate: core61c811...; report5c55e8...; distinct BODY review4b3246.... Actual direct VALUE occurrences selected from the export are Nat.recAux, Finset.sum_range_succ, Finset.sum_range_zero and Nat.sub_add_cancel. No Nat.rec, necessity, transitive graph or local Mathlib registry node is invented. Dependencies stays empty; names appear in lean_notes. No Lean BODY or pp.proofs was read.\n+\n+Boundary wording now says “final comparator regularizer minus initial played regularizer,” exactly psi_(T-1)(u)-psi_0(y0). The full equality and independent mathematical telescoping outline are retained. Source-only topology remains distinct from actual constant occurrence evidence.\n+\n+Canary compilation/acceptance and combined package gates remain pending. Source corrected-subclause attribution, EReal/producer/attainment/support/stability/Young debts, Chapter2 partial with7+6 open, Goal ACTIVE, unmerged/unpublished and PURIFIED pending are unchanged. Root/Tests/manifest/DOC/RUN/site edits remain outside this proposal."},{"sha":"5bb3a4b50a96a08927d5c63198b974aa04b05fe4","filename":"runs/online-ch2-b4-finite-identity-20261011/reader-proposal-v2/proposal-v2.json","status":"added","additions":129,"deletions":0,"changes":129,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v2%2Fproposal-v2.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v2%2Fproposal-v2.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v2%2Fproposal-v2.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,129 @@\n+{\n+  \"status\": \"INTEGRATION PROPOSAL v2; not applied; independent review required\",\n+  \"actor\": \"/root/adaptive_decoder\",\n+  \"requested_model_effort\": \"GPT-6 Astra / medium; runtime not attested\",\n+  \"input_raw_sha256\": {\n+    \"website/content/chapters.json\": \"17fe0e096447259511e706179a8ebe5eae4d19a6b26764ccd073d02e287db795\",\n+    \"website/content/readings.json\": \"fa35944998387cf579ca9b88c71bcf1d73e2b0400335c17cb6938d54a8fa26f2\",\n+    \"website/content/highlights.json\": \"43df4440422f70f042c6468af344fcc51fb3adfa798c79bf08227fcac2c4abda\",\n+    \"tmp/online-ch2-b4-finite-identity-integration-proposal-20261011/proposal-v1.json\": \"48e166aa04c4ad645a84a4ef4ede200e646383b7ba7f7e96bee5d9ba2242dc30\",\n+    \"tmp/online-ch2-b4-finite-identity-core-20261011/core-report-v2.json\": \"5c55e8ea41cf2c18af4c47f9929233e7e4afcf903de00f654fd00edec1ab98aa\",\n+    \"tmp/online-ch2-b4-finite-identity-core-20261011/compiled-constant-occurrences-v3.json\": \"7fc98eedc77882cc97cc9923f50073b79991b96e547fe1c8d1ec4f4dcd82f6f1\",\n+    \"tmp/online-ch2-b4-finite-identity-body-review-20261011/fresh-production-body-review-v1.json\": \"4b3246ef699eba8c3df7a8063e12342f86211c43b60efd121ce2bccb58c8aac6\"\n+  },\n+  \"prior_proposal\": {\n+    \"path\": \"tmp/online-ch2-b4-finite-identity-integration-proposal-20261011/proposal-v1.json\",\n+    \"sha256\": \"48e166aa04c4ad645a84a4ef4ede200e646383b7ba7f7e96bee5d9ba2242dc30\",\n+    \"preserved\": true\n+  },\n+  \"patches\": {\n+    \"website/content/chapters.json\": [\n+      {\n+        \"op\": \"add\",\n+        \"path\": \"/chapters/10/module_globs/-\",\n+        \"value\": \"BanditRLProof/OnlineCumulativePotential.lean\"\n+      }\n+    ],\n+    \"website/content/readings.json\": [\n+      {\n+        \"op\": \"add\",\n+        \"path\": \"/readings/10/source_theorems/-\",\n+        \"value\": {\n+          \"label\": \"Corrected terminal accounting: the finite-real regret identity\",\n+          \"pages\": \"printed129–130,266–267 / PDF141–142,278–279\",\n+          \"pdf_page\": 142,\n+          \"url\": \"https://arxiv.org/pdf/1912.13213v10#page=142\",\n+          \"math\": \"\\\\begin{gathered}G_t(v)=\\\\psi_t(v)+\\\\sum_{i=0}^{t}\\\\ell_i(v),\\\\quad y_t=\\\\begin{cases}z&t=T,\\\\\\\\x_t&t\\\\ne T.\\\\end{cases}\\\\\\\\R_T(u)=\\\\sum_{t=0}^{T-1}(\\\\ell_t(y_t)-\\\\ell_t(u))\\\\\\\\=\\\\psi_{T-1}(u)-\\\\psi_0(y_0)+\\\\sum_{t=0}^{T-1}\\\\bigl(G_t(y_t)-G_t(y_{t+1})\\\\bigr)\\\\\\\\\\\\quad+\\\\sum_{t=0}^{T-2}\\\\bigl(\\\\psi_t(y_{t+1})-\\\\psi_{t+1}(y_{t+1})\\\\bigr)+G_{T-1}(z)-G_{T-1}(u).\\\\end{gathered}\",\n+          \"plain\": \"An arbitrary state type E, total real-valued functions psi and loss on natural time and E, an arbitrary sequence x, comparator u and terminal z, and a natural horizon T>0. No convexity, norm, optimizer, algorithm, probability or causal premise is required. Finite real arithmetic is a specialization: the full EReal/domain adapter remains separate. Indices are zero-based: source round s corresponds to t=s-1. G includes the current loss through t. Only the unscored coordinate T is spliced to z; all y(t)=x(t) for t<T. The original x(T) is unused. The interior drift has indices0..T-2; forT1 it is empty. T0 is not claimed.\",\n+          \"fallback\": \"Regret equals the final comparator regularizer minus the initial played regularizer, plus within-potential differences, interior regularizer drift and the terminal cumulative-objective gap.\",\n+          \"relationship\": \"This is the finite-real corrected algebra subclause of repair:7.47-terminal, related to the terminal correction of Theorem15.31; it is not the literal full printed theorem. The source uses Euclidean feasible states and extended losses; the algebra abstracts the carrier and uses globally real functions. Repeating a virtual final hint is legitimate, but omitting its terminal residual can invalidate the sharp bound. The full EReal adapter, actual optimistic-FTRL/BTRL producers, ghost attainment, support qualification, strong-convex stability, Young estimate and whole corrected7.47/15.31 bounds remain open. A positive arbitrary terminal gap cannot be discarded.\",\n+          \"contract\": {\n+            \"model\": \"Exact deterministic accounting for arbitrary states and functions; no algorithmic run is asserted. Indices are zero-based: source round s corresponds to t=s-1. G includes the current loss through t. Only the unscored coordinate T is spliced to z; all y(t)=x(t) for t<T. The original x(T) is unused. The interior drift has indices0..T-2; forT1 it is empty. T0 is not claimed.\",\n+            \"assumptions\": \"An arbitrary state type E, total real-valued functions psi and loss on natural time and E, an arbitrary sequence x, comparator u and terminal z, and a natural horizon T>0. No convexity, norm, optimizer, algorithm, probability or causal premise is required. Finite real arithmetic is a specialization: the full EReal/domain adapter remains separate.\",\n+            \"parameters\": \"T is a positive natural number. u and z are independent arbitrary states; no relation between z and original x(T).\",\n+            \"regret\": \"R_T(u)=sum_{t<T}(loss_t(y_t)-loss_t(u)); the scored states are unchanged by the terminal splice.\",\n+            \"guarantee\": \"Full equality including every endpoint and drift term. The full EReal adapter, actual optimistic-FTRL/BTRL producers, ghost attainment, support qualification, strong-convex stability, Young estimate and whole corrected7.47/15.31 bounds remain open. A positive arbitrary terminal gap cannot be discarded.\"\n+          },\n+          \"local_status\": {\n+            \"status\": \"compiled\",\n+            \"label\": \"Locally compiled corrected finite-real identity\",\n+            \"boundary\": \"Locally compiled finite-real identity with independent production BODY acceptance as a bounded candidate. Canary and combined package validation remain pending. Unmerged and unpublished.\"\n+          }\n+        }\n+      }\n+    ],\n+    \"website/content/highlights.json\": [\n+      {\n+        \"op\": \"add\",\n+        \"path\": \"/highlights/-\",\n+        \"value\": {\n+          \"full_name\": \"BanditRL.OnlineCumulativePotential.finite_regret_identity\",\n+          \"title\": \"Why the terminal gap belongs in the regret identity\",\n+          \"chapter\": \"online-ogd\",\n+          \"featured\": false,\n+          \"teaching_order\": 340,\n+          \"source_match\": \"closest-source\",\n+          \"plain\": \"An arbitrary state type E, total real-valued functions psi and loss on natural time and E, an arbitrary sequence x, comparator u and terminal z, and a natural horizon T>0. No convexity, norm, optimizer, algorithm, probability or causal premise is required. Finite real arithmetic is a specialization: the full EReal/domain adapter remains separate. Indices are zero-based: source round s corresponds to t=s-1. G includes the current loss through t. Only the unscored coordinate T is spliced to z; all y(t)=x(t) for t<T. The original x(T) is unused. The interior drift has indices0..T-2; forT1 it is empty. T0 is not claimed.\",\n+          \"math\": \"\\\\begin{gathered}G_t(v)=\\\\psi_t(v)+\\\\sum_{i=0}^{t}\\\\ell_i(v),\\\\quad y_t=\\\\begin{cases}z&t=T,\\\\\\\\x_t&t\\\\ne T.\\\\end{cases}\\\\\\\\R_T(u)=\\\\sum_{t=0}^{T-1}(\\\\ell_t(y_t)-\\\\ell_t(u))\\\\\\\\=\\\\psi_{T-1}(u)-\\\\psi_0(y_0)+\\\\sum_{t=0}^{T-1}\\\\bigl(G_t(y_t)-G_t(y_{t+1})\\\\bigr)\\\\\\\\\\\\quad+\\\\sum_{t=0}^{T-2}\\\\bigl(\\\\psi_t(y_{t+1})-\\\\psi_{t+1}(y_{t+1})\\\\bigr)+G_{T-1}(z)-G_{T-1}(u).\\\\end{gathered}\",\n+          \"intuition\": \"The terminal point appears once with a minus sign inside the last within-potential difference and once with a plus sign in the endpoint gap. Their cancellation explains why the scored regret does not depend on an unplayed endpoint.\",\n+          \"why\": \"One shared algebraic component needed by labeled terminal corrections, not a complete regret theorem or source-container count.\",\n+          \"position\": \"Finite-real corrected accounting near Theorem7.47 proof, PDF141–142; related Theorem15.31 terminal convention, PDF278–279. The full EReal adapter, actual optimistic-FTRL/BTRL producers, ghost attainment, support qualification, strong-convex stability, Young estimate and whole corrected7.47/15.31 bounds remain open. A positive arbitrary terminal gap cannot be discarded.\",\n+          \"proof_idea\": \"Put H_t(v)=sum_{i<t}loss_i(v), so G_t=psi_t+H_(t+1). The regularizer parts of the within-G sum, together with the interior drift, telescope to psi_0(y_0)-psi_(T-1)(z). The cumulative-loss parts telescope to sum_{t<T}loss_t(y_t)-H_T(z). Adding the final comparator regularizer minus the initial played regularizer and the retained G_(T-1)(z)-G_(T-1)(u) leaves exactly the regret. This is the mathematical cancellation argument, not a claimed implementation route.\",\n+          \"lean_notes\": \"E has no additional typeclass assumptions; psi/loss are real-valued and T>0 is the only propositional premise. The boundary regularizer difference is psi_(T-1)(u)-psi_0(y_0): final comparator regularizer minus initial played regularizer. Local y and G are definitions, not extra hypotheses. The exact Lean header and eventual full-proof source link use the declaration fold; these notes do not claim a complete rendered source-proof graph. Selected actual compiled direct VALUE occurrences are Nat.recAux, Finset.sum_range_succ, Finset.sum_range_zero and Nat.sub_add_cancel. Occurrence does not establish logical necessity or a complete transitive graph; Nat.rec is not the exported direct constant. The source-only AND topology remains distinct from these implementation occurrences. Prepared one-round and two-round canary headers check a positive gap and nonzero drift/terminal splice; their BODY acceptance and compilation remain pending. Locally compiled finite-real identity with independent production BODY acceptance as a bounded candidate. Canary and combined package validation remain pending. Unmerged and unpublished.\",\n+          \"dependencies\": []\n+        }\n+      }\n+    ]\n+  },\n+  \"evidence_join\": {\n+    \"production_core_sha256_from_reviewed_reports\": \"61c811c0b1f941ec22ac41f64e555a0e4d4d8dc32b8145ea53808dbdc0fc17da\",\n+    \"frozen_header_sha256\": \"92e0dcfac53595e35b68bfd8083c09640d06da809355ab02ec4eb4b007b0bd67\",\n+    \"production_review_verdict\": \"accepted-local-candidate\",\n+    \"production_compilation\": \"Actual focused0 and compiled public probe0 verified by distinct reviewer; not rerun here\",\n+    \"compiled_direct_VALUE_parents_selected\": [\n+      \"Nat.recAux\",\n+      \"Finset.sum_range_succ\",\n+      \"Finset.sum_range_zero\",\n+      \"Nat.sub_add_cancel\"\n+    ],\n+    \"project_owned_direct_VALUE_parents\": [],\n+    \"occurrence_not_necessity_or_transitive_graph\": true,\n+    \"canary_BODY_acceptance\": \"pending\",\n+    \"canary_compilation\": \"pending\",\n+    \"combined_gates\": \"pending\"\n+  },\n+  \"in_memory_preservation\": {\n+    \"three_append_operations_only\": true,\n+    \"all_old_whole_parsed_objects_preserved\": true,\n+    \"old22_cards_preserved\": true,\n+    \"new_card_count\": 23,\n+    \"new_highlights\": 1,\n+    \"historical_blobs_and_other_chapters_unchanged\": true\n+  },\n+  \"unchanged_contracts\": {\n+    \"atomic_binder_ledger\": \"Exact v1 ledger retained by pinned prior-proposal reference; no binder/header edit.\",\n+    \"source_math_and_scope\": \"Full formula and finite-real corrected subclause unchanged. Terminal gap, inclusive G, T>0 and y(T)=z splice preserved.\",\n+    \"source_graph\": \"Source topology d7d605... distinct from actual compiled occurrence export. No rendered full graph or verified OR-route claimed.\",\n+    \"registry\": \"dependencies=[] because selected Mathlib/kernel parents are not local project registry nodes; actual names exposed in lean_notes.\",\n+    \"closure\": {\n+      \"open_forward_containers\": 7,\n+      \"future_claims_open\": 6,\n+      \"Chapter2\": \"partial\",\n+      \"accepted\": false,\n+      \"denominator\": null,\n+      \"Goal\": \"ACTIVE boundary; no tool query in this task\",\n+      \"PURIFIED\": \"pending\",\n+      \"unmerged\": true,\n+      \"unpublished\": true,\n+      \"root_Tests_manifest_DOC_RUN_site_writes\": false,\n+      \"canary_BODY_authorization\": false\n+    }\n+  },\n+  \"scope_exposure\": \"Read only permitted report/export/independent review and prior proposal/current JSON baseline. No production Lean BODY, snapshots or pp.proofs read.\",\n+  \"review_notes\": [\n+    \"Only comparator-boundary wording and timely production status/actual occurrence evidence changed from v1.\",\n+    \"First boundary term is final psi_(T-1)(u) minus initial psi_0(y0), not a same-time or initial-comparator difference.\",\n+    \"Future canary acceptance, full gates, root imports and integration application remain separate.\"\n+  ],\n+  \"input_hashes_unchanged\": true\n+}"},{"sha":"62d6bb38df05e7b43aad2b8d2683ce6c70d46059","filename":"runs/online-ch2-b4-finite-identity-20261011/reader-proposal-v2/readings-append-patch-v2.json","status":"added","additions":28,"deletions":0,"changes":28,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v2%2Freadings-append-patch-v2.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v2%2Freadings-append-patch-v2.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v2%2Freadings-append-patch-v2.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,28 @@\n+[\n+  {\n+    \"op\": \"add\",\n+    \"path\": \"/readings/10/source_theorems/-\",\n+    \"value\": {\n+      \"label\": \"Corrected terminal accounting: the finite-real regret identity\",\n+      \"pages\": \"printed129–130,266–267 / PDF141–142,278–279\",\n+      \"pdf_page\": 142,\n+      \"url\": \"https://arxiv.org/pdf/1912.13213v10#page=142\",\n+      \"math\": \"\\\\begin{gathered}G_t(v)=\\\\psi_t(v)+\\\\sum_{i=0}^{t}\\\\ell_i(v),\\\\quad y_t=\\\\begin{cases}z&t=T,\\\\\\\\x_t&t\\\\ne T.\\\\end{cases}\\\\\\\\R_T(u)=\\\\sum_{t=0}^{T-1}(\\\\ell_t(y_t)-\\\\ell_t(u))\\\\\\\\=\\\\psi_{T-1}(u)-\\\\psi_0(y_0)+\\\\sum_{t=0}^{T-1}\\\\bigl(G_t(y_t)-G_t(y_{t+1})\\\\bigr)\\\\\\\\\\\\quad+\\\\sum_{t=0}^{T-2}\\\\bigl(\\\\psi_t(y_{t+1})-\\\\psi_{t+1}(y_{t+1})\\\\bigr)+G_{T-1}(z)-G_{T-1}(u).\\\\end{gathered}\",\n+      \"plain\": \"An arbitrary state type E, total real-valued functions psi and loss on natural time and E, an arbitrary sequence x, comparator u and terminal z, and a natural horizon T>0. No convexity, norm, optimizer, algorithm, probability or causal premise is required. Finite real arithmetic is a specialization: the full EReal/domain adapter remains separate. Indices are zero-based: source round s corresponds to t=s-1. G includes the current loss through t. Only the unscored coordinate T is spliced to z; all y(t)=x(t) for t<T. The original x(T) is unused. The interior drift has indices0..T-2; forT1 it is empty. T0 is not claimed.\",\n+      \"fallback\": \"Regret equals the final comparator regularizer minus the initial played regularizer, plus within-potential differences, interior regularizer drift and the terminal cumulative-objective gap.\",\n+      \"relationship\": \"This is the finite-real corrected algebra subclause of repair:7.47-terminal, related to the terminal correction of Theorem15.31; it is not the literal full printed theorem. The source uses Euclidean feasible states and extended losses; the algebra abstracts the carrier and uses globally real functions. Repeating a virtual final hint is legitimate, but omitting its terminal residual can invalidate the sharp bound. The full EReal adapter, actual optimistic-FTRL/BTRL producers, ghost attainment, support qualification, strong-convex stability, Young estimate and whole corrected7.47/15.31 bounds remain open. A positive arbitrary terminal gap cannot be discarded.\",\n+      \"contract\": {\n+        \"model\": \"Exact deterministic accounting for arbitrary states and functions; no algorithmic run is asserted. Indices are zero-based: source round s corresponds to t=s-1. G includes the current loss through t. Only the unscored coordinate T is spliced to z; all y(t)=x(t) for t<T. The original x(T) is unused. The interior drift has indices0..T-2; forT1 it is empty. T0 is not claimed.\",\n+        \"assumptions\": \"An arbitrary state type E, total real-valued functions psi and loss on natural time and E, an arbitrary sequence x, comparator u and terminal z, and a natural horizon T>0. No convexity, norm, optimizer, algorithm, probability or causal premise is required. Finite real arithmetic is a specialization: the full EReal/domain adapter remains separate.\",\n+        \"parameters\": \"T is a positive natural number. u and z are independent arbitrary states; no relation between z and original x(T).\",\n+        \"regret\": \"R_T(u)=sum_{t<T}(loss_t(y_t)-loss_t(u)); the scored states are unchanged by the terminal splice.\",\n+        \"guarantee\": \"Full equality including every endpoint and drift term. The full EReal adapter, actual optimistic-FTRL/BTRL producers, ghost attainment, support qualification, strong-convex stability, Young estimate and whole corrected7.47/15.31 bounds remain open. A positive arbitrary terminal gap cannot be discarded.\"\n+      },\n+      \"local_status\": {\n+        \"status\": \"compiled\",\n+        \"label\": \"Locally compiled corrected finite-real identity\",\n+        \"boundary\": \"Locally compiled finite-real identity with independent production BODY acceptance as a bounded candidate. Canary and combined package validation remain pending. Unmerged and unpublished.\"\n+      }\n+    }\n+  }\n+]"},{"sha":"0c78badcba6fecb331d49bbb47c2378a7c8cbb3b","filename":"runs/online-ch2-b4-finite-identity-20261011/reader-proposal-v3/.gitattributes","status":"added","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v3%2F.gitattributes","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v3%2F.gitattributes","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v3%2F.gitattributes?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,4 @@\n+* -text\n+* whitespace=cr-at-eol\n+*.raw -diff\n+*.olean -diff"},{"sha":"dc48717bad6fcef939405b8e0df2714b5b302fa5","filename":"runs/online-ch2-b4-finite-identity-20261011/reader-proposal-v3/chapters-append-patch-v3.json","status":"added","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v3%2Fchapters-append-patch-v3.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v3%2Fchapters-append-patch-v3.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v3%2Fchapters-append-patch-v3.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,7 @@\n+[\n+  {\n+    \"op\": \"add\",\n+    \"path\": \"/chapters/10/module_globs/-\",\n+    \"value\": \"BanditRLProof/OnlineCumulativePotential.lean\"\n+  }\n+]"},{"sha":"88a99813ec3a90aaf2a4e23a8b4b253c8413a1ad","filename":"runs/online-ch2-b4-finite-identity-20261011/reader-proposal-v3/highlights-append-patch-v3.json","status":"added","additions":22,"deletions":0,"changes":22,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v3%2Fhighlights-append-patch-v3.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v3%2Fhighlights-append-patch-v3.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v3%2Fhighlights-append-patch-v3.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,22 @@\n+[\n+  {\n+    \"op\": \"add\",\n+    \"path\": \"/highlights/-\",\n+    \"value\": {\n+      \"full_name\": \"BanditRL.OnlineCumulativePotential.finite_regret_identity\",\n+      \"title\": \"Why the terminal gap belongs in the regret identity\",\n+      \"chapter\": \"online-ogd\",\n+      \"featured\": false,\n+      \"teaching_order\": 340,\n+      \"source_match\": \"closest-source\",\n+      \"plain\": \"An arbitrary state type E, total real-valued functions psi and loss on natural time and E, an arbitrary sequence x, comparator u and terminal z, and a natural horizon T>0. No convexity, norm, optimizer, algorithm, probability or causal premise is required. Finite real arithmetic is a specialization: the full EReal/domain adapter remains separate. Indices are zero-based: source round s corresponds to t=s-1. G includes the current loss through t. Only the unscored coordinate T is spliced to z; all y(t)=x(t) for t<T. The original x(T) is unused. The interior drift has indices0..T-2; forT1 it is empty. T0 is not claimed.\",\n+      \"math\": \"\\\\begin{gathered}G_t(v)=\\\\psi_t(v)+\\\\sum_{i=0}^{t}\\\\ell_i(v),\\\\quad y_t=\\\\begin{cases}z&t=T,\\\\\\\\x_t&t\\\\ne T.\\\\end{cases}\\\\\\\\R_T(u)=\\\\sum_{t=0}^{T-1}(\\\\ell_t(y_t)-\\\\ell_t(u))\\\\\\\\=\\\\psi_{T-1}(u)-\\\\psi_0(y_0)+\\\\sum_{t=0}^{T-1}\\\\bigl(G_t(y_t)-G_t(y_{t+1})\\\\bigr)\\\\\\\\\\\\quad+\\\\sum_{t=0}^{T-2}\\\\bigl(\\\\psi_t(y_{t+1})-\\\\psi_{t+1}(y_{t+1})\\\\bigr)+G_{T-1}(z)-G_{T-1}(u).\\\\end{gathered}\",\n+      \"intuition\": \"The terminal point appears once with a minus sign inside the last within-potential difference and once with a plus sign in the endpoint gap. Their cancellation explains why the scored regret does not depend on an unplayed endpoint.\",\n+      \"why\": \"One shared algebraic component needed by labeled terminal corrections, not a complete regret theorem or source-container count.\",\n+      \"position\": \"Finite-real corrected accounting near Theorem7.47 proof, PDF141–142; related Theorem15.31 terminal convention, PDF278–279. The full EReal adapter, actual optimistic-FTRL/BTRL producers, ghost attainment, support qualification, strong-convex stability, Young estimate and whole corrected7.47/15.31 bounds remain open. A positive arbitrary terminal gap cannot be discarded.\",\n+      \"proof_idea\": \"Put H_t(v)=sum_{i<t}loss_i(v), so G_t=psi_t+H_(t+1). The regularizer parts of the within-G sum, together with the interior drift, telescope to psi_0(y_0)-psi_(T-1)(z). The cumulative-loss parts telescope to sum_{t<T}loss_t(y_t)-H_T(z). Adding the final comparator regularizer minus the initial played regularizer and the retained G_(T-1)(z)-G_(T-1)(u) leaves exactly the regret. This is the mathematical cancellation argument, not a claimed implementation route.\",\n+      \"lean_notes\": \"E has no additional typeclass assumptions; psi/loss are real-valued and T>0 is the only propositional premise. The boundary regularizer difference is psi_(T-1)(u)-psi_0(y_0): final comparator regularizer minus initial played regularizer. Local y and G are definitions, not extra hypotheses. The exact Lean header and full-proof source link use the declaration fold; these notes do not claim a complete rendered source-proof graph. Selected actual compiled direct VALUE occurrences are Nat.recAux, Finset.sum_range_succ, Finset.sum_range_zero and Nat.sub_add_cancel. Occurrence does not establish logical necessity or a complete transitive graph; Nat.rec is not the exported direct constant. The source-only AND topology remains distinct from these implementation occurrences. Locally compiled and independently production-BODY-reviewed finite-real identity; two compiled public canaries specialize the same core to check a positive gap, nonzero drift and the terminal splice. Full source performance bounds remain open. Unmerged and unpublished.\",\n+      \"dependencies\": []\n+    }\n+  }\n+]"},{"sha":"43b56555009a4bd8f5f5abc348fdd90d5856f98e","filename":"runs/online-ch2-b4-finite-identity-20261011/reader-proposal-v3/plan-v3.md","status":"added","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v3%2Fplan-v3.md","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v3%2Fplan-v3.md","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v3%2Fplan-v3.md?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,7 @@\n+# B4 reader proposal v3\n+\n+Only two public string fields change from v2: the new card local-status boundary and the new lesson lean_notes. They now state local compilation, independent production BODY review, and the two compiled same-core canaries; full source performance bounds remain open. The exact Lean header/full-proof link wording no longer says eventual. Mathematics, module glob, card and lesson shape, dependencies and teaching order remain unchanged.\n+\n+Private evidence binds the actual canary report fd2b0d06..., artifact manifest 3fae4879..., and distinct bounded canary BODY acceptance 1547b91c... with no blockers. Report and review join on Test a3f7a41b... and core 61c811c0.... Focused, olean and public-probe exits are all zero according to these records; nothing was compiled here. Full gates, whole-package acceptance and PURIFIED remain pending.\n+\n+Three append patches only. Current content hashes still match the v2 baseline; the in-memory append/pop preservation check retains every old parsed object and all 22 old source cards. Only the two authorized string fields differ from v2 public payloads. Old v2 files remain byte-identical. Chapter2 partial, seven containers and six future claims open, denominator null, Goal ACTIVE, unmerged/unpublished remain unchanged. No canonical edits, application or BODY exposure. Requested GPT-6 Astra/medium, runtime not attested."},{"sha":"fa13b9d14051cad6f45a46dcc6dd0dcb92d826b4","filename":"runs/online-ch2-b4-finite-identity-20261011/reader-proposal-v3/proposal-v3.json","status":"added","additions":160,"deletions":0,"changes":160,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v3%2Fproposal-v3.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v3%2Fproposal-v3.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Freader-proposal-v3%2Fproposal-v3.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,160 @@\n+{\n+  \"status\": \"INTEGRATION PROPOSAL v3; not applied; independent review required\",\n+  \"actor\": \"/root/adaptive_decoder\",\n+  \"requested_model_effort\": \"GPT-6 Astra / medium; runtime not attested\",\n+  \"input_raw_sha256\": {\n+    \"website/content/chapters.json\": \"17fe0e096447259511e706179a8ebe5eae4d19a6b26764ccd073d02e287db795\",\n+    \"website/content/readings.json\": \"fa35944998387cf579ca9b88c71bcf1d73e2b0400335c17cb6938d54a8fa26f2\",\n+    \"website/content/highlights.json\": \"43df4440422f70f042c6468af344fcc51fb3adfa798c79bf08227fcac2c4abda\",\n+    \"tmp/online-ch2-b4-finite-identity-integration-proposal-20261011/proposal-v1.json\": \"48e166aa04c4ad645a84a4ef4ede200e646383b7ba7f7e96bee5d9ba2242dc30\",\n+    \"tmp/online-ch2-b4-finite-identity-core-20261011/core-report-v2.json\": \"5c55e8ea41cf2c18af4c47f9929233e7e4afcf903de00f654fd00edec1ab98aa\",\n+    \"tmp/online-ch2-b4-finite-identity-core-20261011/compiled-constant-occurrences-v3.json\": \"7fc98eedc77882cc97cc9923f50073b79991b96e547fe1c8d1ec4f4dcd82f6f1\",\n+    \"tmp/online-ch2-b4-finite-identity-body-review-20261011/fresh-production-body-review-v1.json\": \"4b3246ef699eba8c3df7a8063e12342f86211c43b60efd121ce2bccb58c8aac6\",\n+    \"tmp/online-ch2-b4-finite-identity-canary-core-20261011/canary-core-report-v1.json\": \"fd2b0d06cdc28dc9c4bd1da9bd72a7112ad7872097a8778a16143ebb9fd8b03f\",\n+    \"tmp/online-ch2-b4-finite-identity-canary-core-20261011/artifact-manifest-v1.json\": \"3fae4879dd6a0590cb4c47706560edf0d8ac6a597e981cd59801aec708b8ec76\",\n+    \"tmp/online-ch2-b4-finite-identity-canary-body-review-20261011/fresh-canary-body-review-v1.json\": \"1547b91ce76afe56c7c7a54be446887b8058fb071e4ddb32e4e48547bf33b8f3\",\n+    \"tmp\\\\online-ch2-b4-finite-identity-integration-proposal-v2-20261011\\\\chapters-append-patch-v2.json\": \"f9726c1658f374b43e73a1f589c6d95c315255553aadddbd33051b258e6b011e\",\n+    \"tmp\\\\online-ch2-b4-finite-identity-integration-proposal-v2-20261011\\\\highlights-append-patch-v2.json\": \"77e5ef5d992a431b4b1878052ead9beb2ab2aa2da32ec4bd1c541a84bc138ea6\",\n+    \"tmp\\\\online-ch2-b4-finite-identity-integration-proposal-v2-20261011\\\\plan-v2.md\": \"841ce6595825733ef1e0fbdeed3c9d418b0ef23354804cac35d8f9bad091ae08\",\n+    \"tmp\\\\online-ch2-b4-finite-identity-integration-proposal-v2-20261011\\\\proposal-v2.json\": \"edd78e3b329bca4a50c03cc30449698e57397a17e62a840547f3521c613298b0\",\n+    \"tmp\\\\online-ch2-b4-finite-identity-integration-proposal-v2-20261011\\\\readings-append-patch-v2.json\": \"0f7046e7a1d8029b315af70bd492bbbdd1588ef953b8ab1a34d27382c3411636\"\n+  },\n+  \"prior_proposal\": {\n+    \"path\": \"tmp/online-ch2-b4-finite-identity-integration-proposal-v2-20261011/proposal-v2.json\",\n+    \"sha256\": \"edd78e3b329bca4a50c03cc30449698e57397a17e62a840547f3521c613298b0\",\n+    \"preserved\": true\n+  },\n+  \"patches\": {\n+    \"website/content/chapters.json\": [\n+      {\n+        \"op\": \"add\",\n+        \"path\": \"/chapters/10/module_globs/-\",\n+        \"value\": \"BanditRLProof/OnlineCumulativePotential.lean\"\n+      }\n+    ],\n+    \"website/content/readings.json\": [\n+      {\n+        \"op\": \"add\",\n+        \"path\": \"/readings/10/source_theorems/-\",\n+        \"value\": {\n+          \"label\": \"Corrected terminal accounting: the finite-real regret identity\",\n+          \"pages\": \"printed129–130,266–267 / PDF141–142,278–279\",\n+          \"pdf_page\": 142,\n+          \"url\": \"https://arxiv.org/pdf/1912.13213v10#page=142\",\n+          \"math\": \"\\\\begin{gathered}G_t(v)=\\\\psi_t(v)+\\\\sum_{i=0}^{t}\\\\ell_i(v),\\\\quad y_t=\\\\begin{cases}z&t=T,\\\\\\\\x_t&t\\\\ne T.\\\\end{cases}\\\\\\\\R_T(u)=\\\\sum_{t=0}^{T-1}(\\\\ell_t(y_t)-\\\\ell_t(u))\\\\\\\\=\\\\psi_{T-1}(u)-\\\\psi_0(y_0)+\\\\sum_{t=0}^{T-1}\\\\bigl(G_t(y_t)-G_t(y_{t+1})\\\\bigr)\\\\\\\\\\\\quad+\\\\sum_{t=0}^{T-2}\\\\bigl(\\\\psi_t(y_{t+1})-\\\\psi_{t+1}(y_{t+1})\\\\bigr)+G_{T-1}(z)-G_{T-1}(u).\\\\end{gathered}\",\n+          \"plain\": \"An arbitrary state type E, total real-valued functions psi and loss on natural time and E, an arbitrary sequence x, comparator u and terminal z, and a natural horizon T>0. No convexity, norm, optimizer, algorithm, probability or causal premise is required. Finite real arithmetic is a specialization: the full EReal/domain adapter remains separate. Indices are zero-based: source round s corresponds to t=s-1. G includes the current loss through t. Only the unscored coordinate T is spliced to z; all y(t)=x(t) for t<T. The original x(T) is unused. The interior drift has indices0..T-2; forT1 it is empty. T0 is not claimed.\",\n+          \"fallback\": \"Regret equals the final comparator regularizer minus the initial played regularizer, plus within-potential differences, interior regularizer drift and the terminal cumulative-objective gap.\",\n+          \"relationship\": \"This is the finite-real corrected algebra subclause of repair:7.47-terminal, related to the terminal correction of Theorem15.31; it is not the literal full printed theorem. The source uses Euclidean feasible states and extended losses; the algebra abstracts the carrier and uses globally real functions. Repeating a virtual final hint is legitimate, but omitting its terminal residual can invalidate the sharp bound. The full EReal adapter, actual optimistic-FTRL/BTRL producers, ghost attainment, support qualification, strong-convex stability, Young estimate and whole corrected7.47/15.31 bounds remain open. A positive arbitrary terminal gap cannot be discarded.\",\n+          \"contract\": {\n+            \"model\": \"Exact deterministic accounting for arbitrary states and functions; no algorithmic run is asserted. Indices are zero-based: source round s corresponds to t=s-1. G includes the current loss through t. Only the unscored coordinate T is spliced to z; all y(t)=x(t) for t<T. The original x(T) is unused. The interior drift has indices0..T-2; forT1 it is empty. T0 is not claimed.\",\n+            \"assumptions\": \"An arbitrary state type E, total real-valued functions psi and loss on natural time and E, an arbitrary sequence x, comparator u and terminal z, and a natural horizon T>0. No convexity, norm, optimizer, algorithm, probability or causal premise is required. Finite real arithmetic is a specialization: the full EReal/domain adapter remains separate.\",\n+            \"parameters\": \"T is a positive natural number. u and z are independent arbitrary states; no relation between z and original x(T).\",\n+            \"regret\": \"R_T(u)=sum_{t<T}(loss_t(y_t)-loss_t(u)); the scored states are unchanged by the terminal splice.\",\n+            \"guarantee\": \"Full equality including every endpoint and drift term. The full EReal adapter, actual optimistic-FTRL/BTRL producers, ghost attainment, support qualification, strong-convex stability, Young estimate and whole corrected7.47/15.31 bounds remain open. A positive arbitrary terminal gap cannot be discarded.\"\n+          },\n+          \"local_status\": {\n+            \"status\": \"compiled\",\n+            \"label\": \"Locally compiled corrected finite-real identity\",\n+            \"boundary\": \"Locally compiled and independently production-BODY-reviewed finite-real identity; two compiled public canaries specialize the same core to check a positive gap, nonzero drift and the terminal splice. Full source performance bounds remain open. Unmerged and unpublished.\"\n+          }\n+        }\n+      }\n+    ],\n+    \"website/content/highlights.json\": [\n+      {\n+        \"op\": \"add\",\n+        \"path\": \"/highlights/-\",\n+        \"value\": {\n+          \"full_name\": \"BanditRL.OnlineCumulativePotential.finite_regret_identity\",\n+          \"title\": \"Why the terminal gap belongs in the regret identity\",\n+          \"chapter\": \"online-ogd\",\n+          \"featured\": false,\n+          \"teaching_order\": 340,\n+          \"source_match\": \"closest-source\",\n+          \"plain\": \"An arbitrary state type E, total real-valued functions psi and loss on natural time and E, an arbitrary sequence x, comparator u and terminal z, and a natural horizon T>0. No convexity, norm, optimizer, algorithm, probability or causal premise is required. Finite real arithmetic is a specialization: the full EReal/domain adapter remains separate. Indices are zero-based: source round s corresponds to t=s-1. G includes the current loss through t. Only the unscored coordinate T is spliced to z; all y(t)=x(t) for t<T. The original x(T) is unused. The interior drift has indices0..T-2; forT1 it is empty. T0 is not claimed.\",\n+          \"math\": \"\\\\begin{gathered}G_t(v)=\\\\psi_t(v)+\\\\sum_{i=0}^{t}\\\\ell_i(v),\\\\quad y_t=\\\\begin{cases}z&t=T,\\\\\\\\x_t&t\\\\ne T.\\\\end{cases}\\\\\\\\R_T(u)=\\\\sum_{t=0}^{T-1}(\\\\ell_t(y_t)-\\\\ell_t(u))\\\\\\\\=\\\\psi_{T-1}(u)-\\\\psi_0(y_0)+\\\\sum_{t=0}^{T-1}\\\\bigl(G_t(y_t)-G_t(y_{t+1})\\\\bigr)\\\\\\\\\\\\quad+\\\\sum_{t=0}^{T-2}\\\\bigl(\\\\psi_t(y_{t+1})-\\\\psi_{t+1}(y_{t+1})\\\\bigr)+G_{T-1}(z)-G_{T-1}(u).\\\\end{gathered}\",\n+          \"intuition\": \"The terminal point appears once with a minus sign inside the last within-potential difference and once with a plus sign in the endpoint gap. Their cancellation explains why the scored regret does not depend on an unplayed endpoint.\",\n+          \"why\": \"One shared algebraic component needed by labeled terminal corrections, not a complete regret theorem or source-container count.\",\n+          \"position\": \"Finite-real corrected accounting near Theorem7.47 proof, PDF141–142; related Theorem15.31 terminal convention, PDF278–279. The full EReal adapter, actual optimistic-FTRL/BTRL producers, ghost attainment, support qualification, strong-convex stability, Young estimate and whole corrected7.47/15.31 bounds remain open. A positive arbitrary terminal gap cannot be discarded.\",\n+          \"proof_idea\": \"Put H_t(v)=sum_{i<t}loss_i(v), so G_t=psi_t+H_(t+1). The regularizer parts of the within-G sum, together with the interior drift, telescope to psi_0(y_0)-psi_(T-1)(z). The cumulative-loss parts telescope to sum_{t<T}loss_t(y_t)-H_T(z). Adding the final comparator regularizer minus the initial played regularizer and the retained G_(T-1)(z)-G_(T-1)(u) leaves exactly the regret. This is the mathematical cancellation argument, not a claimed implementation route.\",\n+          \"lean_notes\": \"E has no additional typeclass assumptions; psi/loss are real-valued and T>0 is the only propositional premise. The boundary regularizer difference is psi_(T-1)(u)-psi_0(y_0): final comparator regularizer minus initial played regularizer. Local y and G are definitions, not extra hypotheses. The exact Lean header and full-proof source link use the declaration fold; these notes do not claim a complete rendered source-proof graph. Selected actual compiled direct VALUE occurrences are Nat.recAux, Finset.sum_range_succ, Finset.sum_range_zero and Nat.sub_add_cancel. Occurrence does not establish logical necessity or a complete transitive graph; Nat.rec is not the exported direct constant. The source-only AND topology remains distinct from these implementation occurrences. Locally compiled and independently production-BODY-reviewed finite-real identity; two compiled public canaries specialize the same core to check a positive gap, nonzero drift and the terminal splice. Full source performance bounds remain open. Unmerged and unpublished.\",\n+          \"dependencies\": []\n+        }\n+      }\n+    ]\n+  },\n+  \"evidence_join\": {\n+    \"production_core_sha256_from_reviewed_reports\": \"61c811c0b1f941ec22ac41f64e555a0e4d4d8dc32b8145ea53808dbdc0fc17da\",\n+    \"frozen_header_sha256\": \"92e0dcfac53595e35b68bfd8083c09640d06da809355ab02ec4eb4b007b0bd67\",\n+    \"production_review_verdict\": \"accepted-local-candidate\",\n+    \"production_compilation\": \"Actual focused0 and compiled public probe0 verified by distinct reviewer; not rerun here\",\n+    \"compiled_direct_VALUE_parents_selected\": [\n+      \"Nat.recAux\",\n+      \"Finset.sum_range_succ\",\n+      \"Finset.sum_range_zero\",\n+      \"Nat.sub_add_cancel\"\n+    ],\n+    \"project_owned_direct_VALUE_parents\": [],\n+    \"occurrence_not_necessity_or_transitive_graph\": true,\n+    \"canary_BODY_acceptance\": \"accepted-bounded-canary-candidates\",\n+    \"canary_compilation\": {\n+      \"focused_exit\": 0,\n+      \"olean_exit\": 0,\n+      \"public_import_check_print_axioms_exit\": 0,\n+      \"basis\": \"Bound report and distinct review; not rerun here\"\n+    },\n+    \"combined_gates\": \"pending\",\n+    \"canary_BODY_review_actor\": \"/root/adaptive_reviewer\",\n+    \"canary_BODY_review_blockers\": [],\n+    \"canary_Test_sha256_from_report_and_review\": \"a3f7a41bf1ddd25a4a623c865c028e029af267132faaeef9c70f9d28e3a30a8f\",\n+    \"canary_actual_direct_core_consumers\": [\n+      \"BanditRL.OnlineCumulativePotentialCanary.finite_identity_one_round_positive_gap\",\n+      \"BanditRL.OnlineCumulativePotentialCanary.finite_identity_two_round_terminal_splice\"\n+    ],\n+    \"canary_core_in_VALUE_each\": true,\n+    \"whole_package_acceptance\": \"pending\"\n+  },\n+  \"in_memory_preservation\": {\n+    \"three_append_operations_only\": true,\n+    \"all_old_whole_parsed_objects_preserved\": true,\n+    \"old22_cards_preserved\": true,\n+    \"new_card_count\": 23,\n+    \"new_highlights\": 1,\n+    \"historical_blobs_and_other_chapters_unchanged\": true\n+  },\n+  \"unchanged_contracts\": {\n+    \"atomic_binder_ledger\": \"Exact v1 ledger retained by pinned prior-proposal reference; no binder/header edit.\",\n+    \"source_math_and_scope\": \"Full formula and finite-real corrected subclause unchanged. Terminal gap, inclusive G, T>0 and y(T)=z splice preserved.\",\n+    \"source_graph\": \"Source topology d7d605... distinct from actual compiled occurrence export. No rendered full graph or verified OR-route claimed.\",\n+    \"registry\": \"dependencies=[] because selected Mathlib/kernel parents are not local project registry nodes; actual names exposed in lean_notes.\",\n+    \"closure\": {\n+      \"open_forward_containers\": 7,\n+      \"future_claims_open\": 6,\n+      \"Chapter2\": \"partial\",\n+      \"accepted\": false,\n+      \"denominator\": null,\n+      \"Goal\": \"ACTIVE boundary; no tool query in this task\",\n+      \"PURIFIED\": \"pending\",\n+      \"unmerged\": true,\n+      \"unpublished\": true,\n+      \"root_Tests_manifest_DOC_RUN_site_writes\": false,\n+      \"canary_BODY_authorization\": false\n+    }\n+  },\n+  \"scope_exposure\": \"Read prior proposal and the permitted canary report, artifact manifest and distinct BODY review only for this successor; no Test/core BODY, candidate Lean files or pp.proofs read.\",\n+  \"review_notes\": [\n+    \"Only reader current-status prose, eventual-link wording and private evidence bindings changed from v2.\",\n+    \"Both canary candidates have distinct bounded BODY acceptance; no whole-package, PURIFIED, source-container or chapter acceptance.\",\n+    \"Three append operations and all mathematical content remain identical.\"\n+  ],\n+  \"input_hashes_unchanged\": true,\n+  \"v3_delta_invariants\": {\n+    \"only_two_public_string_fields_changed\": true,\n+    \"three_append_operations_unchanged\": true,\n+    \"mathematics_all_unchanged\": true,\n+    \"current_baseline_matches_v2\": true,\n+    \"old_whole_parsed_objects_preserved_in_memory\": true,\n+    \"old_v2_files_unchanged\": true,\n+    \"read_no_BODY\": true\n+  }\n+}"}]