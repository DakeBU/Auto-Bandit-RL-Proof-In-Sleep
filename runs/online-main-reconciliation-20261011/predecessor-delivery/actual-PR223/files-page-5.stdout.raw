5e53859ce117fe560ae0","filename":"runs/online-ch2-b4-finite-identity-20261011/integration-commit-evidence/verification.json","status":"added","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fintegration-commit-evidence%2Fverification.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fintegration-commit-evidence%2Fverification.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fintegration-commit-evidence%2Fverification.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,7 @@\n+{\n+  \"HEAD\": \"7b372d79fcd3228d8d2cece73ad0181f94a70cf1\",\n+  \"all_changed_RAW_equal_Git\": true,\n+  \"paths\": 122,\n+  \"clean\": true,\n+  \"combined_gates\": \"pending\"\n+}"},{"sha":"0c78badcba6fecb331d49bbb47c2378a7c8cbb3b","filename":"runs/online-ch2-b4-finite-identity-20261011/integration-metadata-drafts/.gitattributes","status":"added","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fintegration-metadata-drafts%2F.gitattributes","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fintegration-metadata-drafts%2F.gitattributes","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fintegration-metadata-drafts%2F.gitattributes?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,4 @@\n+* -text\n+* whitespace=cr-at-eol\n+*.raw -diff\n+*.olean -diff"},{"sha":"d6c98dab63547a02743ff67cc7b37763d10a9b90","filename":"runs/online-ch2-b4-finite-identity-20261011/integration-metadata-drafts/MANIFEST-append-proposal-v1.md","status":"added","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fintegration-metadata-drafts%2FMANIFEST-append-proposal-v1.md","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fintegration-metadata-drafts%2FMANIFEST-append-proposal-v1.md","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fintegration-metadata-drafts%2FMANIFEST-append-proposal-v1.md?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,4 @@\n+\n+### B4 finite-real cumulative regret identity — proposed addition\n+\n+`BanditRL.OnlineCumulativePotential.finite_regret_identity` is one locally compiled and independently BODY-reviewed candidate for the finite-real corrected algebra subclause near Orabona v10 Theorem7.47 (PDF141–142), related to the Theorem15.31 terminal repair (PDF278–279). It retains the exact final comparator regularizer minus initial played regularizer, within-potential sum, interior drift and arbitrary terminal gap; T>0 and y(T)=z are explicit. No optimizer/algorithm or extended-real performance bound is asserted. Canary and combined package gates, publication and purification remain pending. Full EReal/producer/attainment/support/stability/Young and both corrected parent endpoints remain open. Chapter2 remains partial with seven containers and six future claims open, accepted=false and null complete proof denominator; Chapters1–16 Goal ACTIVE. Unmerged and unpublished."},{"sha":"9c867235b4a7fde435a7836304655b692c8aec26","filename":"runs/online-ch2-b4-finite-identity-20261011/integration-metadata-drafts/contribution-manifest-draft-v1.json","status":"added","additions":185,"deletions":0,"changes":185,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fintegration-metadata-drafts%2Fcontribution-manifest-draft-v1.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fintegration-metadata-drafts%2Fcontribution-manifest-draft-v1.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fintegration-metadata-drafts%2Fcontribution-manifest-draft-v1.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,185 @@\n+{\n+  \"schema_version\": \"3.0\",\n+  \"id\": \"ONLINE-CH2-B4-FINITE-IDENTITY-20261011\",\n+  \"route\": \"online-learning/chapter-2/b4-finite-identity\",\n+  \"frontier_cell\": \"online-ogd\",\n+  \"source_facing\": true,\n+  \"source\": {\n+    \"kind\": \"book\",\n+    \"title\": \"Online Learning: A Modern Introduction Using Convex Optimization\",\n+    \"version\": \"arXiv1912.13213v10 SHA256 cef4edfa97a6e063e53e9c532717c50aa156e5bc782ea49f969b3385011a1b17\",\n+    \"anchor\": \"Finite-real corrected algebra subclause of repair:7.47-terminal near PDF141-142/printed129-130; related repair:15.31-terminal PDF278-279/printed266-267. Not literal full printed endpoints.\",\n+    \"url\": \"https://arxiv.org/pdf/1912.13213v10#page=142\"\n+  },\n+  \"target\": \"Exact finite regret equality for arbitrary carrier and real-valued psi/loss, arbitrary x,u,z,T>0; inclusive G, unscored y(T)=z splice, interior drift and signed terminal gap retained. No optimizer, convexity, algorithm or desired inequality premise. DRAFT metadata, not applied. One locally compiled/source- and BODY-reviewed finite-real corrected algebra subclause only. Canary and combined package gates pending; no PROOF_SEALED/PUBLISHED/MERGED/PURIFIED or native whole-loop claim. Full EReal adapter, actual optimistic-FTRL/BTRL producer, ghost attainment, support, stability, Young and corrected whole7.47/15.31 remain OPEN. Seven Chapter2 containers and six future claims remain open; Chapter2 partial, accepted=false, complete proof denominator=null; Chapters1-16 Goal ACTIVE. Unmerged and unpublished; no live verification.\",\n+  \"affected_files\": [\n+    \"BanditRLProof/OnlineCumulativePotential.lean\",\n+    \"BanditRLProof.lean\",\n+    \"website/content/chapters.json\",\n+    \"website/content/readings.json\",\n+    \"website/content/highlights.json\"\n+  ],\n+  \"declarations\": [\n+    \"BanditRL.OnlineCumulativePotential.finite_regret_identity\"\n+  ],\n+  \"reuse_plan\": {\n+    \"classification\": \"missing\",\n+    \"decision\": \"new_shared\",\n+    \"searched_existing\": [\n+      \"OnlineWeightedPotential weighted_difference_sum_eq: separable scalar weighted telescope, no exact arbitrary-function identity.\",\n+      \"TsallisFTRLRegret cumulativeLoss/cumulativeLoss_succ: generic prefix infrastructure; regret endpoints require finite-action linear/minimizer scope.\",\n+      \"Mathlib finite-sum infrastructure inspected in sealed retrieval/source review.\"\n+    ],\n+    \"reused_declarations\": [\n+      \"Nat.recAux\",\n+      \"Finset.sum_range_succ\",\n+      \"Finset.sum_range_zero\",\n+      \"Nat.sub_add_cancel\"\n+    ],\n+    \"new_shared_declarations\": [\n+      \"BanditRL.OnlineCumulativePotential.finite_regret_identity\"\n+    ],\n+    \"known_consumers\": [],\n+    \"planned_consumers\": [\n+      \"Prepared one-round positive-gap and two-round nonzero-drift/terminal-splice canary headers; no accepted BODY consumer yet.\",\n+      \"Future finite corrected optimistic-FTRL and BTRL accounting adapters; not implemented.\"\n+    ],\n+    \"no_duplicate_wrapper\": true,\n+    \"decision_reason\": \"One