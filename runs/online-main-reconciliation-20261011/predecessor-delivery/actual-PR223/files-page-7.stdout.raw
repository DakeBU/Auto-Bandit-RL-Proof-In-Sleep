tents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fstabilization-metadata-correction%2Fcorrection-v1.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,12 @@\n+{\n+  \"before_sha256\": \"9d0880d79a5aa080598657d501661b50cd21b0ca1cda9f99f4e6ed2d9cf3360c\",\n+  \"after_sha256\": \"e413f5b000cc2424927710631a175a9bb085c610c6dc22468f49958ac3692122\",\n+  \"reason\": \"Bounded stale metadata repair before gate; no mathematical statement/proof/root/Test/site JSON change.\",\n+  \"changed_fields\": [\n+    \"graph_contribution.visual_review\",\n+    \"verification.bandit_check\",\n+    \"verification.site_build\",\n+    \"verification.site_check\",\n+    \"verification.focused_checks[4]\"\n+  ]\n+}"},{"sha":"ec9780c1b2f1f7183250a51fb0e8a73c57d951e7","filename":"runs/online-ch2-b4-finite-identity-20261011/stabilization-metadata-correction/manifest-after-v1.json","status":"added","additions":191,"deletions":0,"changes":191,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fstabilization-metadata-correction%2Fmanifest-after-v1.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/c445c93f7e4cda1408279d614858c904e346ad47/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fstabilization-metadata-correction%2Fmanifest-after-v1.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-b4-finite-identity-20261011%2Fstabilization-metadata-correction%2Fmanifest-after-v1.json?ref=c445c93f7e4cda1408279d614858c904e346ad47","patch":"@@ -0,0 +1,191 @@\n+{\n+  \"schema_version\": \"3.0\",\n+  \"id\": \"ONLINE-CH2-B4-FINITE-IDENTITY-20261011\",\n+  \"route\": \"online-learning/chapter-2/b4-finite-identity\",\n+  \"frontier_cell\": \"online-ogd\",\n+  \"source_facing\": true,\n+  \"source\": {\n+    \"kind\": \"book\",\n+    \"title\": \"Online Learning: A Modern Introduction Using Convex Optimization\",\n+    \"version\": \"arXiv1912.13213v10 SHA256 cef4edfa97a6e063e53e9c532717c50aa156e5bc782ea49f969b3385011a1b17\",\n+    \"anchor\": \"Finite-real corrected algebra subclause of repair:7.47-terminal near PDF141-142/printed129-130; related repair:15.31-terminal PDF278-279/printed266-267. Not literal full printed endpoints.\",\n+    \"url\": \"https://arxiv.org/pdf/1912.13213v10#page=142\"\n+  },\n+  \"target\": \"Exact finite regret equality for arbitrary carrier and real-valued psi/loss, arbitrary x,u,z,T>0; inclusive G, unscored y(T)=z splice, interior drift and signed terminal gap retained. No optimizer, convexity, algorithm or desired inequality premise. Only one finite-real corrected algebra subclause and its two concrete public canaries are locally compiled and independently BODY-reviewed. Read combined gate, final acceptance and reader status from separate actual receipts in this RUN; focused evidence does not replace them. Full EReal adapter, actual optimistic-FTRL/BTRL producer, ghost attainment, support, stability, Young and both corrected whole7.47/15.31 remain OPEN. Seven Chapter2 containers and six future claims remain open; Chapter2 partial,accepted=false,complete proof denominator=null; Chapters1-16 Goal ACTIVE. Unmerged/unpublished; no main/live/PURIFIED/native whole-loop claim.\",\n+  \"affected_files\": [\n+    \"BanditRLProof/OnlineCumulativePotential.lean\",\n+    \"BanditRLProof.lean\",\n+    \"website/content/chapters.json\",\n+    \"website/content/readings.json\",\n+    \"website/content/highlights.json\"\n+  ],\n+  \"declarations\": [\n+    \"BanditRL.OnlineCumulativePotential.finite_regret_identity\"\n+  ],\n+  \"reuse_plan\": {\n+    \"classification\": \"missing\",\n+    \"decision\": \"new_shared\",\n+    \"searched_existing\": [\n+      \"OnlineWeightedPotential weighted_difference_sum_eq: separable scalar weighted telescope, no exact arbitrary-function identity.\",\n+      \"TsallisFTRLRegret cumulativeLoss/cumulativeLoss_succ: generic prefix infrastructure; regret endpoints require finite-action linear/minimizer scope.\",\n+      \"Mathlib finite-sum infrastructure inspected in sealed retrieval/source review.\"\n+    ],\n+    \"reused_declarations\": [\n+      \"Nat.recAux\",\n+      \"Finset.sum_range_succ\",\n+      \"Finset.sum_range_zero\",\n+      \"Nat.sub_add_cancel\"\n+    ],\n+    \"new_shared_declarations\": [\n+      \"BanditRL.OnlineCumulativePotential.finite_regret_identity\"\n+    ],\n+    \"known_consumers\": [\n+      \"BanditRL.OnlineCumulativePotentialCanary.finite_identity_one_round_positive_gap\",\n+      \"BanditRL.OnlineCumulativePotentialCanary.finite_identity_two_round_terminal_splice\"\n+    ],\n+    \"planned_consumers\": [\n+      \"Future finite corrected optimistic-FTRL and BTRL accounting adapters; not implemented.\"\n+    ],\n+    \"no_duplicate_wrapper\": true,\n+    \"decision_reason\": \"One shared arbitrary-function algebra identity, zero new named helpers/definitions. Bounded reuse search and independent BODY review exclude a wrapper-only replacement.\"\n+  },\n+  \"reader_contract\": {\n+    \"source_anchor_visible\": true,\n+    \"natural_language_formula_proof\": true,\n+    \"hidden_assumptions_visible\": true,\n+    \"source_vs_lean_delta_visible\": true,\n+    \"lean_folded\": true,\n+    \"dependencies_visible\": true,\n+    \"remaining_boundary_visible\": true\n+  },\n+  \"semantic_roundtrip\": {\n+    \"required\": true,\n+    \"status\": \"accepted\",\n+    \"formalizer\": \"/root/b4_finite_identity_formalizer\",\n+    \"blind_decoder\": \"/root/b4_finite_identity_blind; runs/online-ch2-b4-finite-identity-20261011/neutral-blind/fresh-blind-v1.json SHA256 a76cbbfc57db5d4f9107574d2167435c06ad7bcb980e5a50554a8f8508e551bc\",\n+    \"source_reviewer\": \"/root/adaptive_decoder; runs/online-ch2-b4-finite-identity-20261011/source-header-topology/source-header-review-v1.json SHA256 adda7e17c6ebf0ba1b8c24d9cd78e0df763f55000521ec01fb8d94b5122