BanditRL.OnlineConvex.abs_subgradient_zero : BanditRL.OnlineConvex.SourceSubdifferential (fun y => ↑|y|) 0 =
  Set.Icc (-1) 1
BanditRL.OnlineConvex.abs_subgradient_positive : ∀ (x : ℝ),
  0 < x → BanditRL.OnlineConvex.SourceSubdifferential (fun y => ↑|y|) x = {1}
BanditRL.OnlineConvex.abs_subgradient_negative : ∀ x < 0,
  BanditRL.OnlineConvex.SourceSubdifferential (fun y => ↑|y|) x = {-1}
BanditRL.OnlineConvex.example_2_24 : ∀ (x : ℝ),
  BanditRL.OnlineConvex.SourceSubdifferential (fun y => ↑|y|) x =
    if 0 < x then {1} else if x = 0 then Set.Icc (-1) 1 else {-1}
AbsoluteZeroProbe.zero_boundary_canary : -1 ∈ BanditRL.OnlineConvex.SourceSubdifferential (fun y => ↑|y|) 0 ∧
  1 ∈ BanditRL.OnlineConvex.SourceSubdifferential (fun y => ↑|y|) 0 ∧
    1 / 2 ∈ BanditRL.OnlineConvex.SourceSubdifferential (fun y => ↑|y|) 0 ∧
      2 ∉ BanditRL.OnlineConvex.SourceSubdifferential (fun y => ↑|y|) 0
AbsoluteZeroProbe.zero_is_not_a_singleton : ¬∃ g, BanditRL.OnlineConvex.SourceSubdifferential (fun y => ↑|y|) 0 = {g}
AbsoluteAllPointsProbe.source_three_branches_canary : BanditRL.OnlineConvex.SourceSubdifferential (fun y => ↑|y|) 2 =
    {1} ∧
  BanditRL.OnlineConvex.SourceSubdifferential (fun y => ↑|y|) (-2) = {-1} ∧
    BanditRL.OnlineConvex.SourceSubdifferential (fun y => ↑|y|) 0 = Set.Icc (-1) 1
def BanditRL.OnlineConvex.SourceSubdifferential.{u_1} : {E : Type u_1} →
  [inst : NormedAddCommGroup E] → [InnerProductSpace ℝ E] → (E → EReal) → E → Set E :=
fun {E} [NormedAddCommGroup E] [InnerProductSpace ℝ E] f x => {g | ∀ (y : E), f x + ↑(inner ℝ g (y - x)) ≤ f y}
