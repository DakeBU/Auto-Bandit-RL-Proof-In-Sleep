BanditRL.OnlineLearning.iid_cumulative_prediction_decomposition.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] (μ : Measure Ω)
  [IsProbabilityMeasure μ] (Y : ℕ → Ω → ℝ) (hY : ∀ (t : ℕ), Measurable (Y t))
  (hlaw : ∀ (t : ℕ), IdentDistrib (Y t) (Y 0) μ μ) (hb : ∀ (t : ℕ), ∀ᵐ (ω : Ω) ∂μ, Y t ω ∈ Set.Icc 0 1)
  (prediction : ℕ → Ω → ℝ) (hP : ∀ (t : ℕ), MemLp (prediction t) 2 μ) (hInd : ∀ (t : ℕ), prediction t ⟂ᵢ[μ] Y t)
  (T : ℕ) :
  ∫ (ω : Ω), ∑ t ∈ Finset.range T, (prediction t ω - Y t ω) ^ 2 ∂μ - ↑T * Var[Y 0; μ] =
    ∑ t ∈ Finset.range T, ∫ (ω : Ω), (prediction t ω - ∫ (ω : Ω), Y 0 ω ∂μ) ^ 2 ∂μ
