  (F : MeasurableSpace Ω) (hF : F ≤ BanditRL.OnlineLearning.privateSeedPastInformation S Y t) (P : Ω → ℝ)
  (hP : Measurable P) : P ⟂ᵢ[μ] Y t
BanditRL.OnlineLearning.expectedFixedMinimum_eq_variance.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] (μ : Measure Ω)
  [IsProbabilityMeasure μ] (Y : ℕ → Ω → ℝ) (hY : ∀ (t : ℕ), Measurable (Y t))
  (hlaw : ∀ (t : ℕ), IdentDistrib (Y t) (Y 0) μ μ) (hb : ∀ (t : ℕ), ∀ᵐ (ω : Ω) ∂μ, Y t ω ∈ Set.Icc 0 1) (T : ℕ) :
