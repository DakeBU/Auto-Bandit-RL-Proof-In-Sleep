{
  "schema_version": 1,
  "policy": {
    "control_plane_math_authority": false,
    "salvage_before_discard": true,
    "scheduler_default_change_requires_matched_experiments": 2,
    "parallelism": "evidence-gated",
    "parallel_requires_distinct_direction_fingerprints": true,
    "cross_route_audit_if_parallel": true,
    "failure_classes": [
      "REFUTED",
      "SOURCE_INVALID",
      "API_BLOCKED",
      "ENV_BLOCKED",
      "IMPLEMENTATION_FAILED",
      "NONE"
    ],
    "reader_backpressure_tracks": [
      "merged_not_purified",
      "purification_age",
      "fine_to_conceptual_ratio"
    ]
  },
  "entries": [
    {
