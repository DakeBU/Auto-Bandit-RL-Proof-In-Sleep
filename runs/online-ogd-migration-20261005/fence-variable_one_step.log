  "statement": "theorem variable_one_step (V : Domain E) (η : ℕ → ℝ) (loss : ℕ → E → ℝ) (x₁ : E) (hx₁ : x₁ ∈ V.carrier) (t : ℕ) (hη : 0 < η t) (hloss : RegularLoss V (loss t)) (u : E) (hu : u ∈ V.carrier) : loss t (iterateVariable V η loss x₁ t) - loss t u ≤ (‖iterateVariable V η loss x₁ t - u‖ ^ 2 - ‖iterateVariable V η loss x₁ (t + 1) - u‖ ^ 2) / (2 * η t) + η t / 2 * ‖gradient (loss t) (iterateVariable V η loss x₁ t)‖ ^ 2",
