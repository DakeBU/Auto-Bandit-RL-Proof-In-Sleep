BanditRL.OnlineLearning.randomized_history_policy_expectedFixed_excess.{u, v} {Ω : Type u} {Seed : Type v}
  [MeasurableSpace.{u} Ω] [MeasurableSpace.{v} Seed] (μ : Measure.{u} Ω) [IsProbabilityMeasure.{u} μ]
  (Y : Nat → Ω → Real) (hY : ∀ (t : Nat), Measurable.{u, 0} (Y t))
  (hlaw : ∀ (t : Nat), IdentDistrib.{u, u, 0} (Y t) (Y 0) μ μ)
  (hb : ∀ (t : Nat), ∀ᵐ (ω : Ω) ∂μ, Membership.mem.{0, 0} (Set.Icc.{0} 0 1) (Y t ω)) (hind : iIndepFun.{u, 0, 0} Y μ)
  (S : Ω → Seed) (hS : Measurable.{u, v} S) (hseed : S ⟂ᵢ[μ] fun ω t => Y t ω)
  (policy : (t : Nat) → Prod.{v, 0} Seed (↥(Finset.range t) → Real) → Real)
  (hp : ∀ (t : Nat), Measurable.{v, 0} (policy t))
  (hpb :
    ∀ (t : Nat) (s : Seed) (z : ↥(Finset.range t) → Real),
      (∀ (i : ↥(Finset.range t)), Membership.mem.{0, 0} (Set.Icc.{0} 0 1) (z i)) →
        Membership.mem.{0, 0} (Set.Icc.{0} 0 1) (policy t (Prod.mk.{v, 0} s z)))
  (T : Nat) :
  And
    (Eq.{1}
      (BanditRL.OnlineLearning.expectedFixedRegret.{u} μ Y
        (fun t ω => policy t (Prod.mk.{v, 0} (S ω) fun i => Y (↑i) ω)) T)
      (∑ t ∈ Finset.range T,
        ∫ (ω : Ω),
          HPow.hPow.{0, 0, 0}
            (HSub.hSub.{0, 0, 0} (policy t (Prod.mk.{v, 0} (S ω) fun i => Y (↑i) ω)) (∫ (ω : Ω), Y 0 ω ∂μ)) 2 ∂μ))
    (LE.le.{0} 0
      (BanditRL.OnlineLearning.expectedFixedRegret.{u} μ Y
        (fun t ω => policy t (Prod.mk.{v, 0} (S ω) fun i => Y (↑i) ω)) T))
