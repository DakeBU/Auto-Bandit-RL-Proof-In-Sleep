PiLp.single_eq_same : ∀ (p : ENNReal) {ι : Type u_1} {β : ι → Type u_2} [inst : DecidableEq ι]
  [inst_1 : (i : ι) → Zero (β i)] (i : ι) (a : β i), (PiLp.single p i a).ofLp i = a
PiLp.single_eq_of_ne : ∀ (p : ENNReal) {ι : Type u_1} {β : ι → Type u_2} [inst : DecidableEq ι]
  [inst_1 : (i : ι) → Zero (β i)] {i i' : ι}, i' ≠ i → ∀ (a : β i), (PiLp.single p i a).ofLp i' = 0
