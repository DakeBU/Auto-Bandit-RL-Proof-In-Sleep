                          (BanditRL.OnlineLearning.kernelGeneratedHistory f t ω,
                            BanditRL.OnlineLearning.kernelGeneratedPrediction f t ω))
                        (BanditRL.OnlineLearning.kernelGameLaw ν) =
                      (MeasureTheory.Measure.map (BanditRL.OnlineLearning.kernelGeneratedHistory f t)
                            (BanditRL.OnlineLearning.kernelGameLaw ν)).compProd
                        (κ t)) ∧
