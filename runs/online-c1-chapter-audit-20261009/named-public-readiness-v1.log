                (∀ i ≤ t, ω.1 i = ω'.1 i) →
                  (∀ i < t, ω.2 i = ω'.2 i) →
                    BanditRL.OnlineLearning.kernelGeneratedPrediction f t ω =
                      BanditRL.OnlineLearning.kernelGeneratedPrediction f t ω') ∧
              ∀ (ν : MeasureTheory.ProbabilityMeasure (ℕ → ℝ)),
                (∀ (t : ℕ),
