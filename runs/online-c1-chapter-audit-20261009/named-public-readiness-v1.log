                          (BanditRL.OnlineLearning.kernelGameLaw ν)]
                        ⇑(κ t)) ∧
                    (ProbabilityTheory.iIndepFun (fun t y => y t) ↑ν →
                      (∀ (t : ℕ), ProbabilityTheory.IdentDistrib (fun y => y t) (fun y => y 0) ↑ν ↑ν) →
                        (∀ (t : ℕ), ∀ᵐ (y : ℕ → ℝ) ∂↑ν, y t ∈ Set.Icc 0 1) →
                          ∀ (T : ℕ),
                            BanditRL.OnlineLearning.expectedFixedRegret (BanditRL.OnlineLearning.kernelGameLaw ν)
                                  (fun t ω => ω.2 t)
                                  (fun t ω => ↑(BanditRL.OnlineLearning.kernelGeneratedPrediction f t ω)) T =
                                ∑ t ∈ Finset.range T,
                                  ∫ (ω : (ℕ → ↑unitInterval) × (ℕ → ℝ)),
                                    (↑(BanditRL.OnlineLearning.kernelGeneratedPrediction f t ω) -
                                        ∫ (ω : (ℕ → ↑unitInterval) × (ℕ → ℝ)),
                                          ω.2 0 ∂BanditRL.OnlineLearning.kernelGameLaw ν) ^
                                      2 ∂BanditRL.OnlineLearning.kernelGameLaw ν ∧
                              0 ≤
                                BanditRL.OnlineLearning.expectedFixedRegret (BanditRL.OnlineLearning.kernelGameLaw ν)
                                  (fun t ω => ω.2 t)
                                  (fun t ω => ↑(BanditRL.OnlineLearning.kernelGeneratedPrediction f t ω)) T)
