BanditRL.OnlineLearning.ftlPredict_bestRegret_initial_correction (initial : ℝ) (y : ℕ → ℝ) (T : ℕ) (hT : 0 < T) :
  squaredBestRegret y (ftlPredict initial y) T =
    squaredBestRegret y (meanPredict y) T + ((initial - y 0) ^ 2 - (1 / 2 - y 0) ^ 2)
'BanditRL.OnlineLearning.ftlPredict_bestRegret_initial_correction' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
BanditRL.OnlineLearning.ftlPredict_bestRegret_refined (initial : ℝ) (y : ℕ → ℝ) (T : ℕ) (hT : 0 < T)
  (hi : initial ∈ Set.Icc 0 1) (hy : ∀ t < T, y t ∈ Set.Icc 0 1) :
  squaredBestRegret y (ftlPredict initial y) T ≤ 1 + ∑ t ∈ Finset.range (T - 1), 4 / (↑t + 2)
'BanditRL.OnlineLearning.ftlPredict_bestRegret_refined' depends on axioms: [propext, Classical.choice, Quot.sound]
BanditRL.OnlineLearning.ftlPredict_upperNoRegret (initial : ℝ) (y : ℕ → ℝ) (hi : initial ∈ Set.Icc 0 1)
  (hy : ∀ (t : ℕ), y t ∈ Set.Icc 0 1) : NoRegret (Set.Icc 0 1) (fun t x => (x - y t) ^ 2) (ftlPredict initial y)
'BanditRL.OnlineLearning.ftlPredict_upperNoRegret' depends on axioms: [propext, Classical.choice, Quot.sound]
BanditRL.OnlineLearning.ftlPredict_bestRegret_average_tendsto_zero (initial : ℝ) (y : ℕ → ℝ)
  (hi : initial ∈ Set.Icc 0 1) (hy : ∀ (t : ℕ), y t ∈ Set.Icc 0 1) :
  Tendsto (fun T => squaredBestRegret y (ftlPredict initial y) T / ↑T) atTop (nhds 0)
'BanditRL.OnlineLearning.ftlPredict_bestRegret_average_tendsto_zero' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
