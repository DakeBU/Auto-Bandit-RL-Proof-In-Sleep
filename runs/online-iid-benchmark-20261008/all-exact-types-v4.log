BanditRL.OnlineLearning.iid_meanPredict_excess.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] (μ : Measure Ω)
  [IsProbabilityMeasure μ] (Y : ℕ → Ω → ℝ) (hY : ∀ (t : ℕ), Measurable (Y t)) (hind : iIndepFun Y μ)
