BanditRL.OnlineLearning.source_mean_optimal.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] (μ : Measure Ω)
  [IsProbabilityMeasure μ] (Y : Ω → ℝ) (hY : Measurable Y) (hb : ∀ (ω : Ω), Y ω ∈ Set.Icc 0 1) :
  ∫ (ω : Ω), Y ω ∂μ ∈ Set.Icc 0 1 ∧
