BanditRL.OnlineLearning.expected_square_decomposition.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] (μ : Measure Ω)
  [IsProbabilityMeasure μ] (Y : Ω → ℝ) (hY : MemLp Y 2 μ) (u : ℝ) :
  ∫ (ω : Ω), (u - Y ω) ^ 2 ∂μ = Var[Y; μ] + (u - ∫ (ω : Ω), Y ω ∂μ) ^ 2
BanditRL.OnlineLearning.independent_prediction_square.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] (μ : Measure Ω)
  [IsProbabilityMeasure μ] (P Y : Ω → ℝ) (hP : MemLp P 2 μ) (hY : MemLp Y 2 μ) (h : P ⟂ᵢ[μ] Y) :
  ∫ (ω : Ω), (P ω - Y ω) ^ 2 ∂μ = ∫ (ω : Ω), (P ω - ∫ (ω : Ω), Y ω ∂μ) ^ 2 ∂μ + Var[Y; μ]
