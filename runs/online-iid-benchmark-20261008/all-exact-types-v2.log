BanditRL.OnlineLearning.expected_square_decomposition.{u_1} {Ω : Type u_1} [MeasurableSpace Ω]
  (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ] (Y : Ω → ℝ) (hY : MeasureTheory.MemLp Y 2 μ)
  (u : ℝ) : ∫ (ω : Ω), (u - Y ω) ^ 2 ∂μ = ProbabilityTheory.variance Y μ + (u - ∫ (ω : Ω), Y ω ∂μ) ^ 2
BanditRL.OnlineLearning.independent_prediction_square.{u_1} {Ω : Type u_1} [MeasurableSpace Ω]
  (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ] (P Y : Ω → ℝ) (hP : MeasureTheory.MemLp P 2 μ)
  (hY : MeasureTheory.MemLp Y 2 μ) (h : ProbabilityTheory.IndepFun P Y μ) :
  ∫ (ω : Ω), (P ω - Y ω) ^ 2 ∂μ = ∫ (ω : Ω), (P ω - ∫ (ω : Ω), Y ω ∂μ) ^ 2 ∂μ + ProbabilityTheory.variance Y μ
BanditRL.OnlineLearning.history_policy_independent.{u_1} {Ω : Type u_1} [MeasurableSpace Ω]
  (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ] (Y : ℕ → Ω → ℝ)
  (hY : ∀ (t : ℕ), Measurable (Y t)) (hind : ProbabilityTheory.iIndepFun Y μ) (t : ℕ)
  (policy : (↥(Finset.range t) → ℝ) → ℝ) (hp : Measurable policy) :
  ProbabilityTheory.IndepFun (fun ω => policy fun i => Y (↑i) ω) (Y t) μ
BanditRL.OnlineLearning.meanPredict_independent.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
  [MeasureTheory.IsProbabilityMeasure μ] (Y : ℕ → Ω → ℝ) (hY : ∀ (t : ℕ), Measurable (Y t))
  (hind : ProbabilityTheory.iIndepFun Y μ) (t : ℕ) :
  ProbabilityTheory.IndepFun (fun ω => meanPredict (fun i => Y i ω) t) (Y t) μ
