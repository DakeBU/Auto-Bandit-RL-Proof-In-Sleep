  meanPredict y t ∈ Set.Icc 0 1
BanditRL.OnlineLearning.source_mean_optimal.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
  [MeasureTheory.IsProbabilityMeasure μ] (Y : Ω → ℝ) (hY : Measurable Y) (hb : ∀ (ω : Ω), Y ω ∈ Set.Icc 0 1) :
  ∫ (ω : Ω), Y ω ∂μ ∈ Set.Icc 0 1 ∧
    ∫ (ω : Ω), (∫ (ω : Ω), Y ω ∂μ - Y ω) ^ 2 ∂μ = ProbabilityTheory.variance Y μ ∧
      ∀ (u : ℝ), ProbabilityTheory.variance Y μ ≤ ∫ (ω : Ω), (u - Y ω) ^ 2 ∂μ
BanditRL.OnlineLearning.iid_meanPredict_excess.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
  [MeasureTheory.IsProbabilityMeasure μ] (Y : ℕ → Ω → ℝ) (hY : ∀ (t : ℕ), Measurable (Y t))
  (hind : ProbabilityTheory.iIndepFun Y μ) (hlaw : ∀ (t : ℕ), ProbabilityTheory.IdentDistrib (Y t) (Y 0) μ μ)
  (hb : ∀ (t : ℕ) (ω : Ω), Y t ω ∈ Set.Icc 0 1) (T : ℕ) :
  ∫ (ω : Ω), ∑ t ∈ Finset.range T, (meanPredict (fun i => Y i ω) t - Y t ω) ^ 2 ∂μ -
      ↑T * ProbabilityTheory.variance (Y 0) μ =
