BanditRL.OnlineConvex.theorem_2_23_inclusion.{u_1, u_2} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] {ι : Type u_2} [Fintype ι] (f : ι → E → EReal)
  (hp : ∀ (i : ι), BanditRL.OnlineConvex.SourceProper (f i)) (x : E) :
  BanditRL.OnlineConvex.SourceSubgradientSum f x ⊆ BanditRL.OnlineConvex.SourceSubdifferential (fun y => ∑ i, f i y) x
BanditRL.OnlineConvex.theorem_2_23_equality.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] (n : ℕ) (f : Fin (n + 1) → E → EReal)
  (hp : ∀ (i : Fin (n + 1)), BanditRL.OnlineConvex.SourceProper (f i))
  (hc : ∀ (i : Fin (n + 1)), BanditRL.OnlineConvex.IsConvexExtended (f i))
  (hclosed : ∀ (i : Fin (n + 1)), BanditRL.OnlineConvex.SourceClosed (f i))
  (hqual :
    ∃ z ∈ BanditRL.OnlineConvex.effectiveDomain (f (Fin.last n)),
      ∀ (i : Fin (n + 1)), i ≠ Fin.last n → z ∈ interior (BanditRL.OnlineConvex.effectiveDomain (f i)))
  (x : E) :
  BanditRL.OnlineConvex.SourceSubdifferential (fun y => ∑ i, f i y) x = BanditRL.OnlineConvex.SourceSubgradientSum f x
