:33,"right":357,"scrollWidth":324,"clientWidth":324}]},{"title":"Generic strict-past FTL: conditional minimizer and feasible initialization","left":17,"right":373,"scrollWidth":574,"clientWidth":356,"parts":[{"tag":"DIV","text":"Source theorem · faithful restatementGeneric strict-past FTL: conditional minimizer and feasible initializationOriginal at printed","overflowX":"visible","class":"source-theorem-heading","left":33,"right":357,"scrollWidth":324,"clientWidth":324},{"tag":"A","text":"Original at printed11-12 / PDF23-24 ↗","overflowX":"visible","class":"","left":33,"right":357,"scrollWidth":324,"clientWidth":324},{"tag":"DIV","text":"Generic conditional FTL foundation compiled; Chapter2 partialThis is one generic strict-past FTL algorithm-definition foundation: ","overflowX":"visible","class":"source-route-status","left":33,"right":357,"scrollWidth":322,"clientWidth":322},{"tag":"SPAN","text":"Generic conditional FTL foundation compiled; Chapter2 partial","overflowX":"visible","class":"status compiled","left":46.796875,"right":343.203125,"scrollWidth":296,"clientWidth":296},{"tag":"P","text":"An arbitrary type X, feasible subset V and real-valued losses represented on the ambient X. Only their restrictions to V determine","overflowX":"visible","class":"","left":33,"right":357,"scrollWidth":324,"clientWidth":324},{"tag":"DD","text":"One fixed classical partial selector of the full feasible strict-past minimizer set, with a supplied feasible first action.","overflowX":"visible","class":"","left":47.59375,"right":342.40625,"scrollWidth":295,"clientWidth":295},{"tag":"DD","text":"No convexity, closedness, compactness or attainment for this conditional foundation. Source Euclidean V is generalized to arbitrar","overflowX":"visible","class":"","left":47.59375,"right":342.40625,"scrollWidth":295,"clientWidth":295},{"tag":"DD","text":"Lean t0=source round1; Fin t/range t losses0..t-1. Initial and tie-choice convention fixed in equality comparisons.","overflowX":"visible","class":"","left":47.59375,"right":342.40625,"scrollWidth":295,"clientWidth":295},{"tag":"DD","text":"No new performance bound. Partial selection, exact feasibility/minimum and restricted-prefix invariance only.","overflowX":"visible","class":"","left":47.59375,"right":342.40625,"scrollWidth":295,"clientWidth":295},{"tag":"DD","text":"Eight complete public canaries prove the actual nonconstant trajectory3/4->1/4->1/2 with feasible prefix minima, current/future in","overflowX":"visible","class":"","left":47.59375,"right":342.40625,"scrollWidth":298,"clientWidth":295},{"tag":"DIV","text":"Source mathematical statement. Formula renderer unavailable; readable fallback: An arbitrary type X, feasible subset V and real-va","overflowX":"auto","class":"math-statement math-rendered is-scrollable","left":33,"right":357,"scrollWidth":382,"clientWidth":320},{"tag":"P","text":"BanditRLlib relationship. Orabona, Online Learning: A Modern Introduction Using Convex Optimization, arXiv:1912.13213v10 (2026-06-","overflowX":"visible","class":"source-note","left":33,"right":357,"scrollWidth":554,"clientWidth":320},{"tag":"P","text":"The mathematical content is restated in this site's notation; wording is ours. See printed11-12 / PDF23-24 in the linked source fo","overflowX":"visible","class":"copyright-note","left":33,"right":357,"scrollWidth":324,"clientWidth":324}]},{"title":"Required adaptive-rate prerequisite: Orabona Lemma4.13","left":17,"right":373,"scrollWidth":574,"clientWidth":356,"parts":[{"tag":"DIV","text":"Source theorem · faithful restatementRequired adaptive-rate prerequisite: Orabona Lemma4.13Original at printed40 / PDF52 ↗","overflowX":"visible","class":"source-theorem-heading","left":33,"right":357,"scrollWidth":324,"clientWidth":324},{"tag":"A","text":"Original at printed40 / PDF52 ↗","overflowX":"visible","class":"","left":33,"right":357,"scrollWidth":324,"clientWidth":324},{"tag":"DIV","text":"Integral prerequisite compiled; adaptive OSD and Chapter2 openOne reusa