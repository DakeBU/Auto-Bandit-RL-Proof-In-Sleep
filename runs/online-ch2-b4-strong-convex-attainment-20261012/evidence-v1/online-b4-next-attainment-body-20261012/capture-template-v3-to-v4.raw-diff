+  assert mapping[os.path.normcase(str(Path(row['path']).resolve()))]==row
+ assert rec['runtime_before']==rec['runtime_after']==runtime_snapshot(pins)
+ for kind in ['stdout','stderr']:assert bind(Path(rec[kind]['path']))==rec[kind]
