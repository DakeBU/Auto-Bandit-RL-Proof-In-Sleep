∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] (d : ℕ) (e : E ≃ₗ[ℝ] EuclideanSpace ℝ (Fin d))
  (f : E → EReal) (V : Set E) (lam : ℝ),
  SourceProper f →
    Convex ℝ V →
      0 ≤ lam →
        (∀ p ∈ V, (SourceSubdifferential (fun u => f (e.symm u)) (e p)).Nonempty) →
          ((∀ x ∈ V,
              ∀ y ∈ V,
                ∀ (a : ℝ),
                  0 < a →
                    a < 1 →
                      f (a • x + (1 - a) • y) ≤ ↑a * f x + ↑(1 - a) * f y - ↑(lam / 2 * a * (1 - a) * ‖x - y‖ ^ 2)) ↔
            ∀ p ∈ V,
              ∀ q ∈ V,
                ∀ g ∈ SourceSubdifferential (fun u => f (e.symm u)) (e p),
                  (f p).toReal + inner ℝ g (e (q - p)) + lam / 2 * ‖q - p‖ ^ 2 ≤ (f q).toReal) : Prop
