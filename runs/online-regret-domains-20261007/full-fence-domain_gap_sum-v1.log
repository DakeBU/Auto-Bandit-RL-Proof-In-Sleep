  "statement": "theorem domain_gap_sum {X : Type*} (V W : Set X) (hVW : V ⊆ W) (loss : ℕ → ↥W → ℝ) (prediction : ℕ → ↥W) (u : ↥V) (T : ℕ) : comparatorRegret loss prediction (embed V W hVW u) T = ∑ t ∈ Finset.range T, (loss t (prediction t) - loss t (embed V W hVW u))",
