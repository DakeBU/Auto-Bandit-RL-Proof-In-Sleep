Fin.snoc_last.{u_1} {n : ℕ} {α : Fin (n + 1) → Sort u_1} (x : α (Fin.last n)) (p : (i : Fin n) → α i.castSucc) :
  Fin.snoc p x (Fin.last n) = x
Fin.snoc_castSucc.{u_1} {n : ℕ} {α : Fin (n + 1) → Sort u_1} (x : α (Fin.last n)) (p : (i : Fin n) → α i.castSucc)
  (i : Fin n) : Fin.snoc p x i.castSucc = p i
