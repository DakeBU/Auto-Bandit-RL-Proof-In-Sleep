BanditRL.OnlineCumulativePotential.finite_regret_identity.{u_1} {E : Type u_1} (psi loss : ℕ → E → ℝ) (x : ℕ → E)
  (u z : E) (T : ℕ) (hT : 0 < T) :
  have y := fun t => if t = T then z else x t;
  have G := fun t v => psi t v + ∑ i ∈ Finset.range (t + 1), loss i v;
  ∑ t ∈ Finset.range T, (loss t (y t) - loss t u) =
    psi (T - 1) u - psi 0 (y 0) + ∑ t ∈ Finset.range T, (G t (y t) - G t (y (t + 1))) +
          ∑ t ∈ Finset.range (T - 1), (psi t (y (t + 1)) - psi (t + 1) (y (t + 1))) +
        G (T - 1) z -
      G (T - 1) u
