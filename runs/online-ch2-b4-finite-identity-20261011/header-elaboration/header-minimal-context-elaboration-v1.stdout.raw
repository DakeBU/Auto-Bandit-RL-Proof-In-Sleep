BanditRL.OnlineCumulativePotential.finite_regret_identity_typeprobe.{u_1} {E : Type u_1} (psi loss : ℕ → E → ℝ)
  (x : ℕ → E) (u z : E) (T : ℕ) (hT : 0 < T) : Prop
def BanditRL.OnlineCumulativePotential.finite_regret_identity_typeprobe.{u_1} : {E : Type u_1} →
  (ℕ → E → ℝ) → (ℕ → E → ℝ) → (ℕ → E) → E → E → (T : ℕ) → 0 < T → Prop :=
fun {E} psi loss x u z T hT =>
  have y := fun t => if t = T then z else x t;
  have G := fun t v => psi t v + ∑ i ∈ range (t + 1), loss i v;
  ∑ t ∈ range T, (loss t (y t) - loss t u) =
    psi (T - 1) u - psi 0 (y 0) + ∑ t ∈ range T, (G t (y t) - G t (y (t + 1))) +
          ∑ t ∈ range (T - 1), (psi t (y (t + 1)) - psi (t + 1) (y (t + 1))) +
        G (T - 1) z -
      G (T - 1) u
