BanditRL.OnlineCumulativePotentialCanary.finite_identity_one_round_positive_gap_typeprobe : Prop
def BanditRL.OnlineCumulativePotentialCanary.finite_identity_one_round_positive_gap_typeprobe : Prop :=
have psi := fun x v => v ^ 2 / 2;
have loss := fun x v => (v - 1) ^ 2 / 2;
have x := fun x => 1 / 2;
have u := 1 / 2;
have z := 2 / 3;
have T := 1;
have y := fun t => if t = T then z else x t;
have G := fun t v => psi t v + ∑ i ∈ range (t + 1), loss i v;
∑ t ∈ range T, (loss t (y t) - loss t u) =
    psi (T - 1) u - psi 0 (y 0) + ∑ t ∈ range T, (G t (y t) - G t (y (t + 1))) +
          ∑ t ∈ range (T - 1), (psi t (y (t + 1)) - psi (t + 1) (y (t + 1))) +
        G (T - 1) z -
      G (T - 1) u ∧
  ∑ t ∈ range T, (loss t (y t) - loss t u) = 0 ∧
    psi (T - 1) u - psi 0 (y 0) = 0 ∧
      ∑ t ∈ range T, (G t (y t) - G t (y (t + 1))) = -(1 / 36) ∧
        ∑ t ∈ range (T - 1), (psi t (y (t + 1)) - psi (t + 1) (y (t + 1))) = 0 ∧
          G (T - 1) z - G (T - 1) u = 1 / 36 ∧
            ¬∑ t ∈ range T, (loss t (y t) - loss t u) ≤
                psi (T - 1) u - psi 0 (y 0) + ∑ t ∈ range T, (G t (y t) - G t (y (t + 1))) +
                  ∑ t ∈ range (T - 1), (psi t (y (t + 1)) - psi (t + 1) (y (t + 1)))
