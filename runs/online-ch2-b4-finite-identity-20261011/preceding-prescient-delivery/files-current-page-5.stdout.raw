P-inputs.json\",\"additions\":6507,\"deletions\":0,\"changeType\":\"ADDED\"},{\"path\":\"runs/online-ch2-unbounded-ogd-20261011/combined-delivery-evidence-v1/gates/combined-v1/pre-selected-source-raw.zip\",\"additions\":0,\"deletions\":0,\"changeType\":\"ADDED\"},{\"path\":\"runs/online-ch2-unbounded-ogd-20261011/combined-delivery-evidence-v1/gates/combined-v1/pre-source-inputs.json\",\"additions\":6542,\"deletions\":0,\"changeType\":\"ADDED\"},{\"path\":\"runs/online-ch2-unbounded-ogd-20261011/combined-delivery-evidence-v1/gates/combined-v1/receipt.json\",\"additions\":60,\"deletions\":0,\"changeType\":\"ADDED\"},{\"path\":\"runs/online-ch2-unbounded-ogd-20261011/combined-delivery-evidence-v1/gates/combined-v1/stderr.raw\",\"additions\":5,\"deletions\":0,\"changeType\":\"ADDED\"},{\"path\":\"runs/online-ch2-unbounded-ogd-20261011/combined-delivery-evidence-v1/gates/combined-v1/stdout.raw\",\"additions\":39130,\"deletions\":0,\"changeType\":\"ADDED\"},{\"path\":\"runs/online-ch2-unbounded-ogd-20261011/combined-delivery-evidence-v1/gates/contributor-v1/capture-helper.py.txt\",\"additions\":182,\"deletions\":0,\"changeType\":\"ADDED\"},{\"path\":\"runs/online-ch2-unbounded-ogd-20261011/combined-delivery-evidence-v1/gates/contributor-v1/post-source-inputs.json\",\"additions\":6542,\"deletions\":0,\"changeType\":\"ADDED\"},{\"path\":\"runs/online-ch2-unbounded-ogd-20261011/combined-delivery-evidence-v1/gates/contributor-v1/pre-selected-ZIP-inputs.json\",\"additions\":6507,\"deletions\":0,\"changeType\":\"ADDED\"},{\"path\":\"runs/online-ch2-unbounded-ogd-20261011/combined-delivery-evidence-v1/gates/contributor-v1/pre-selected-source-raw.zip\",\"additions\":0,\"deletions\":0,\"changeType\":\"ADDED\"},{\"path\":\"runs/online-ch2-unbounded-ogd-20261011/combined-delivery-evidence-v1/gates/contributor-v1/pre-source-inputs.json\",\"additions\":6542,\"deletions\":0,\"changeType\":\"ADDED\"},{\"path\":\"runs/online-ch2-unbounded-ogd-20261011/combined-delivery-evidence-v1/gates/contributor-v1/receipt.json\",\"additions\":61,\"deletions\":0,\"changeType\":\"ADDED\"},{\"path\":\"runs/online-ch2-unbounded-ogd-20261011/combined-delivery-evidence-v1/gates/contributor-v1/stderr.raw\",\"additions\":0,\"deletions\":0,\"changeType\":\"ADDED\"},{\"path\":\"runs/online-ch2-unbounded-ogd-20261011/combined-delivery-evidence-v1/gates/contributor-v1/stdout.raw\",\"additions\":10,\"deletions\":0,\"changeType\":\"ADDED\"},{\"path\":\"runs/online-ch2-unbounded-ogd-20261011/combined-delivery-evidence-v1/gates/render-v1/capture-helper.py.txt\",\"additions\":182,\"deletions\":0,\"changeType\":\"ADDED\"},{\"path\":\"runs/online-ch2-unbounded-ogd-20261011/combined-delivery-evidence-v1/gates/render-v1/post-source-inputs.json\",\"additions\":6542,\"deletions\":0,\"changeType\":\"ADDED\"}],\"headRefName\":\"codex/research-online-ch2-unbounded-ogd\",\"headRefOid\":\"8045070bf1ee53c83778d04eb168f8ad6f728b59\",\"isDraft\":true,\"state\":\"OPEN\",\"statusCheckRollup\":[{\"__typename\":\"CheckRun\",\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"detailsUrl\":\"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/actions/runs/38118373179/job/114407807597\",\"name\":\"build\",\"startedAt\":\"2026-10-11T06:32:05Z\",\"status\":\"IN_PROGRESS\",\"workflowName\":\"Lean and documentation\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"detailsUrl\":\"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/actions/runs/38118373205/job/114407807826\",\"name\":\"result-free-lifecycle-probe\",\"startedAt\":\"2026-10-11T06:32:06Z\",\"status\":\"IN_PROGRESS\",\"workflowName\":\"Target-drift agent lifecycle\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"0001-01-01T00:00:00Z\",\"conclusion\":\"\",\"detailsUrl\":\"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/actions/runs/38118373197/job/114407807715\",\"name\":\"build-and-probe-result-free-candidate\",\"startedAt\":\"2026-10-11T06:32:06Z\",\"status\":\"IN_PROGRESS\",\"workflowName\":\"Target-drift provider-client agent image\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-11T06:32:42Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/actions/runs/38118373207/job/114407807652\",\"name\":\"contributor-contract\",\"startedAt\":\"2026-10-11T06:32:06Z\",\"status\":\"COMPLETED\",\"workflowName\":\"Contributor contract\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-11T06:32:35Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/actions/runs/38118364255/job/114407781567\",\"name\":\"contributor-contract\",\"startedAt\":\"2026-10-11T06:31:56Z\",\"status\":\"COMPLETED\",\"workflowName\":\"Contributor contract\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-11T06:32:52Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/actions/runs/38118373195/job/114407807800\",\"name\":\"Pinned public source preflight (0 model calls; not results)\",\"startedAt\":\"2026-10-11T06:32:06Z\",\"status\":\"COMPLETED\",\"workflowName\":\"LeanFlow pinned-source preflight (result-free, not results)\"}],\"url\":\"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/pull/220\"}"},{"sha":"a1f548cedb52528859b5e3fd1cb8e82969dcec6a","filename":"runs/online-ch2-prescient-euclidean-20261011/prepared-gate-recorder-review-v1.json","status":"added","additions":27,"deletions":0,"changes":27,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-gate-recorder-review-v1.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-gate-recorder-review-v1.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-gate-recorder-review-v1.json?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1,27 @@\n+{\n+  \"verdict\": \"accepted-prepared-gate-recorder\",\n+  \"blocking_repairs\": [],\n+  \"reviewer\": \"/root/adaptive_reviewer\",\n+  \"requested_model_effort\": \"GPT-6 Astra / medium; runtime not attested\",\n+  \"approved_helper_sha256\": \"d7d10142361f940c51712e7dd174dfae51ad768f65f87f26decd87d91faf58fc\",\n+  \"helper_path\": \"tmp/online-ch2-prescient-euclidean-gates-20261011/capture-gate-v1.py\",\n+  \"baseline_helper_sha256\": \"71f8e2fdb4494682a8358346ec253f699cb9d652d779b91e2feb26e344faf8af\",\n+  \"new_active_governance_inputs\": [\n+    \"docs/proof-digestion-protocol.md\",\n+    \"docs/evidence-routed-memory-protocol.md\",\n+    \"docs/openai-math-assimilation-protocol.md\",\n+    \"research-wiki/openai-math-2026-intake.json\",\n+    \"runs/process_memory.json\"\n+  ],\n+  \"findings\": [\n+    \"Only descriptive labels/scope strings and governance inclusion predicates changed. Main execution AST identical after normalizing two descriptive strings; actual argv, clean-state checks, raw capture, exit codes, pre/post inventories and integrity logic unchanged.\",\n+    \"runs/process_memory.json exact exception occurs before historical runs exclusion, so curated current process memory is selected in RAW and ZIP; other historical runs remain excluded.\",\n+    \"Four additional governance protocol/intake paths are in exact selected ZIP set and RAW extra set. Pure selector predicate checks passed; full recorder was not executed.\"\n+  ],\n+  \"limitations\": [\n+    \"Use only after main merge and committed clean candidate; added governance paths must exist and be tracked. Inventory starts from git ls-files and enumerates designated source trees; extra inclusion filters alone do not assert existence of absent/untracked governance files. Verify all five appear in actual pre/post manifest and ZIP before accepting a run.\",\n+    \"Selected ZIP is not whole repository archive; omitted historical archives remain bound by clean committed HEAD.\",\n+    \"Prepared helper approval is not gate execution or output acceptance. Actual source HEAD, argv, integrity, streams and full path sets must be reviewed after execution.\"\n+  ],\n+  \"utc\": \"2026-10-11T07:02:28.253550+00:00\"\n+}"},{"sha":"a4b6d81f03e3ec8864bb21086cf1f06a081ac8c6","filename":"runs/online-ch2-prescient-euclidean-20261011/prepared-gate-recorder-review-v1.md","status":"added","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-gate-recorder-review-v1.md","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-gate-recorder-review-v1.md","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-gate-recorder-review-v1.md?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1 @@\n+Accepted prepared recorder; no blockers. New helper preserves prior execution/integrity logic and adds five exact current-governance inputs, including process_memory before historical RUN exclusion. Pure selector checks passed; no recorder or gate executed. Use only after main merge and committed clean candidate with all five files tracked/present; verify them in actual RAW inventory and ZIP. This remains a selected snapshot, not whole archive or preapproved gate output."},{"sha":"b163a07b37600b03094396759906047dca2b0dc6","filename":"runs/online-ch2-prescient-euclidean-20261011/prepared-gate-recorder-v1.py","status":"added","additions":184,"deletions":0,"changes":184,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-gate-recorder-v1.py","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-gate-recorder-v1.py","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-gate-recorder-v1.py?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1,184 @@\n+\"\"\"Gate recorder for prescient Euclidean and current-main governance, Python3.8 stdlib; no gate executed by preparation.\"\"\"\n+import argparse\n+import datetime\n+import hashlib\n+import json\n+import os\n+from pathlib import Path\n+import re\n+import subprocess\n+import sys\n+import zipfile\n+\n+\n+def utc():\n+    return datetime.datetime.now(datetime.timezone.utc).isoformat()\n+\n+\n+def digest(data):\n+    return hashlib.sha256(data).hexdigest()\n+\n+\n+def create(path, data):\n+    if not isinstance(data, bytes):\n+        data = (json.dumps(data, ensure_ascii=False, indent=2) + \"\\n\").encode(\"utf-8\")\n+    with path.open(\"xb\") as stream:\n+        stream.write(data)\n+\n+\n+def git(root, *args):\n+    proc = subprocess.run([\"git\"] + list(args), cwd=str(root), stdout=subprocess.PIPE,\n+                          stderr=subprocess.PIPE)\n+    if proc.returncode:\n+        raise RuntimeError(\"git failed: \" + repr(args) + \": \" + proc.stderr.decode(\"utf-8\", \"replace\"))\n+    return proc.stdout\n+\n+\n+def state(root):\n+    return {\"HEAD\": git(root, \"rev-parse\", \"HEAD\").decode().strip(),\n+            \"branch\": git(root, \"branch\", \"--show-current\").decode().strip(),\n+            \"status_porcelain_v1_z_hex\": git(root, \"status\", \"--porcelain=v1\", \"-z\").hex()}\n+\n+\n+def inventory(root, run, owned):\n+    # Start with tracked names, then explicitly filter to current source/input trees below.\n+    names = set(x.decode(\"utf-8\") for x in git(root, \"ls-files\", \"-z\", \"--cached\").split(b\"\\0\") if x)\n+    # Add new source paths, including ignored additions inside actual source trees.\n+    for folder in (\"BanditRLProof\", \"Tests\", \"tools\", \"website/scripts\", \"website/content\",\n+                   \"website/static\", \"research-wiki/contribution-contracts\"):\n+        for path in (root / folder).rglob(\"*\"):\n+            if path.is_file() and \"__pycache__\" not in path.parts:\n+                names.add(path.relative_to(root).as_posix())\n+    for name in (\"BanditRLProof.lean\", \"Tests.lean\", \"lean-toolchain\", \"lakefile.lean\",\n+                 \"lake-manifest.json\", \".gitattributes\"):\n+        names.add(name)\n+    names.update(owned)\n+    contract_roots = [name.rsplit(\"/\", 1)[0] for name in owned if name.startswith(\"docs/contracts/\")]\n+    extra = {\"README.md\", \"AGENTS.md\", \"CONTRIBUTING.md\", \"docs/contribution-contract.schema.json\", \"docs/contributor-codex-contract.md\", \"docs/theorem-publication-protocol.md\", \"docs/contracts/online-book-v1/coverage.json\", \"docs/proof-digestion-protocol.md\", \"docs/evidence-routed-memory-protocol.md\", \"docs/openai-math-assimilation-protocol.md\", \"research-wiki/openai-math-2026-intake.json\", \"runs/process_memory.json\"}\n+    names = {name for name in names if selected_for_zip(name, contract_roots) or name in extra}\n+    result = []\n+    for name in sorted(names):\n+        path = root / name\n+        resolved = path.resolve()\n+        if resolved == run or run in resolved.parents:\n+            continue\n+        if root not in resolved.parents or path.is_symlink() or not path.is_file():\n+            raise RuntimeError(\"Input must be an existing ordinary repository file: \" + name)\n+        data = path.read_bytes()\n+        result.append({\"path\": name, \"raw_sha256\": digest(data), \"bytes\": len(data)})\n+    return result\n+\n+\n+def selected_for_zip(name, contract_roots):\n+    # Historical runs are excluded from both selected RAW inventory and ZIP; clean HEAD binds them.\n+    if name == \"runs/process_memory.json\":\n+        return True\n+    if name.startswith(\"runs/\"):\n+        return False\n+    prefixes = (\"BanditRLProof/\", \"Tests/\", \"tools/\", \"website/scripts/\",\n+                \"website/content/\", \"website/static/\", \"research-wiki/contribution-contracts/\")\n+    exact = {\"BanditRLProof.lean\", \"Tests.lean\", \"lean-toolchain\", \"lakefile.lean\",\n+             \"lake-manifest.json\", \".gitattributes\", \"docs/proof-digestion-protocol.md\", \"docs/evidence-routed-memory-protocol.md\", \"docs/openai-math-assimilation-protocol.md\", \"research-wiki/openai-math-2026-intake.json\"}\n+    return (name in exact or name.startswith(prefixes) or\n+            any(name.startswith(folder.rstrip(\"/\") + \"/\") for folder in contract_roots))\n+\n+\n+def main():\n+    parser = argparse.ArgumentParser()\n+    parser.add_argument(\"--root\", required=True)\n+    parser.add_argument(\"--run\", required=True, help=\"New evidence namespace beneath runs/ or an already ignored tmp/ namespace\")\n+    parser.add_argument(\"--label\", required=True)\n+    parser.add_argument(\"--owned-source\", action=\"append\", default=[])\n+    parser.add_argument(\"--leaf-contract\", action=\"append\", required=True,\n+                        help=\"Current leaf docs/contracts subtree to include in ZIP\")\n+    parser.add_argument(\"argv\", nargs=argparse.REMAINDER)\n+    args = parser.parse_args()\n+    root = Path(args.root).resolve()\n+    run = (root / args.run).resolve()\n+    argv = args.argv[1:] if args.argv[:1] == [\"--\"] else args.argv\n+    if not argv or not re.fullmatch(r\"[A-Za-z0-9][A-Za-z0-9_.-]*\", args.label):\n+        raise RuntimeError(\"Exact argv and safe unique label required\")\n+    if root / \"runs\" not in run.parents and root / \"tmp\" not in run.parents:\n+        raise RuntimeError(\"Evidence namespace must be beneath root/runs/ or root/tmp/\")\n+    if root / \"tmp\" in run.parents:\n+        probe = run.relative_to(root).as_posix() + \"/.capture-ignore-probe\"\n+        result = subprocess.run([\"git\", \"check-ignore\", \"--quiet\", \"--\", probe],\n+                                cwd=str(root), stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n+        if result.returncode != 0:\n+            raise RuntimeError(\"tmp evidence namespace must already be ignored; no ignore rule changes permitted\")\n+    for folder in args.leaf_contract:\n+        resolved = (root / folder).resolve()\n+        if root / \"docs\" / \"contracts\" not in resolved.parents:\n+            raise RuntimeError(\"Leaf contract must be a docs/contracts subtree\")\n+        if not resolved.is_dir():\n+            raise RuntimeError(\"Leaf contract subtree missing\")\n+        args.owned_source.extend(path.relative_to(root).as_posix()\n+                                 for path in resolved.rglob(\"*\") if path.is_file())\n+    dest = run / args.label\n+    dest.mkdir(parents=True, exist_ok=False)\n+    helper = Path(__file__).resolve().read_bytes()\n+    create(dest / \"capture-helper.py.txt\", helper)\n+    record = {\"argv\": argv, \"cwd\": str(root), \"helper_sha256\": digest(helper),\n+              \"evidence_namespace_excluded\": run.relative_to(root).as_posix(),\n+              \"actual_evidence_namespace\": str(run),\n+              \"evidence_port_boundary\": \"Receipts originate here; any later exact copy into RUN requires a separate port manifest. No contemporaneous canonical RUN claim.\",\n+              \"owned_source\": args.owned_source, \"command_started\": False, \"actual_exit\": None,\n+              \"ZIP_is_whole_repository_archive\": False,\n+              \"ZIP_scope\": \"Selected active source/input trees and current leaf contracts; historical runs excluded; curated current runs/process_memory.json included\",\n+              \"full_RAW_inventory_scope\": \"Every library/Test source and enumerated current harness/site source/input tree plus current leaf contracts. Historical archives not separately RAW-hashed (curated current process memory is an active input); committed HEAD and clean Git status bind repository state.\",\n+              \"leaf_contract_roots\": args.leaf_contract}\n+    try:\n+        before = inventory(root, run, args.owned_source)\n+        record[\"pre_git\"] = state(root)\n+        if record[\"pre_git\"][\"status_porcelain_v1_z_hex\"]:\n+            raise RuntimeError(\"Clean committed candidate required before gate\")\n+        create(dest / \"pre-source-inputs.json\", before)\n+        selected = [row for row in before if selected_for_zip(row[\"path\"], args.leaf_contract)]\n+        create(dest / \"pre-selected-ZIP-inputs.json\", selected)\n+        record[\"ZIP_selected_files\"] = len(selected)\n+        record[\"full_RAW_inventory_files\"] = len(before)\n+        with zipfile.ZipFile(str(dest / \"pre-selected-source-raw.zip\"), \"x\", zipfile.ZIP_DEFLATED) as archive:\n+            for row in selected:\n+                data = (root / row[\"path\"]).read_bytes()\n+                if digest(data) != row[\"raw_sha256\"]:\n+                    raise RuntimeError(\"Source changed during snapshot: \" + row[\"path\"])\n+                archive.writestr(row[\"path\"], data)\n+        if any(digest((root / row[\"path\"]).read_bytes()) != row[\"raw_sha256\"] for row in selected):\n+            raise RuntimeError(\"Selected ZIP source changed before command\")\n+        if state(root) != record[\"pre_git\"]:\n+            raise RuntimeError(\"Git changed before command\")\n+        record[\"precommand_check\"] = \"Selected ZIP RAW hashes and Git state; no redundant second full inventory. Full pre/post manifests remain authoritative.\"\n+        record[\"start_utc\"] = utc()\n+        record[\"command_started\"] = True\n+        with (dest / \"stdout.raw\").open(\"xb\") as out, (dest / \"stderr.raw\").open(\"xb\") as err:\n+            proc = subprocess.run(argv, cwd=str(root), stdout=out, stderr=err,\n+                                  env=dict(os.environ, PYTHONDONTWRITEBYTECODE=\"1\"))\n+        record[\"end_utc\"] = utc()\n+        record[\"actual_exit\"] = proc.returncode\n+        after = inventory(root, run, args.owned_source)\n+        create(dest / \"post-source-inputs.json\", after)\n+        record[\"post_git\"] = state(root)\n+        record[\"complete_source_path_set_and_RAW_unchanged\"] = before == after\n+        record[\"HEAD_and_branch_unchanged\"] = all(record[\"pre_git\"][k] == record[\"post_git\"][k]\n+                                                 for k in (\"HEAD\", \"branch\"))\n+        record[\"git_status_unchanged\"] = record[\"pre_git\"] == record[\"post_git\"]\n+        record[\"capture_integrity_ok\"] = before == after and record[\"HEAD_and_branch_unchanged\"] and record[\"git_status_unchanged\"]\n+    except Exception as exc:\n+        record[\"capture_error\"] = repr(exc)\n+        record[\"capture_integrity_ok\"] = False\n+        record.setdefault(\"end_utc\", utc())\n+    for name in (\"stdout.raw\", \"stderr.raw\", \"pre-source-inputs.json\", \"post-source-inputs.json\",\n+                 \"pre-selected-ZIP-inputs.json\", \"pre-selected-source-raw.zip\"):\n+        path = dest / name\n+        if path.exists():\n+            record[name + \"_sha256\"] = digest(path.read_bytes())\n+    create(dest / \"receipt.json\", record)\n+    print(json.dumps({\"receipt\": str(dest / \"receipt.json\"), \"actual_exit\": record[\"actual_exit\"],\n+                      \"capture_integrity_ok\": record[\"capture_integrity_ok\"]}))\n+    if not record[\"capture_integrity_ok\"]:\n+        return 125\n+    return record[\"actual_exit\"] if record[\"actual_exit\"] is not None else 125\n+\n+\n+if __name__ == \"__main__\":\n+    sys.exit(main())"},{"sha":"2ab1d29cc30c0b1273da7d1f978022a926e05c51","filename":"runs/online-ch2-prescient-euclidean-20261011/pre