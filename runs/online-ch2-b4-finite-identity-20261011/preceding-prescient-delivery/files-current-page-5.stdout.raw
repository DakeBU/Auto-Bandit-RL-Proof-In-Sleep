line-ch2-prescient-euclidean-reader-qa-20261011\\\\capture-prescient-euclidean-reader-v3.cjs\"\n+  ],\n+  \"start_utc\": \"2026-10-11T07:24:04.867407+00:00\",\n+  \"end_utc\": \"2026-10-11T07:24:04.952546+00:00\",\n+  \"actual_exit\": 0,\n+  \"stdout_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n+  \"stderr_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n+  \"script_sha256\": \"5c4d4e055d3b2cd25d2a378ea10bddb669064f845a09bfd02816bbb3059f05ee\",\n+  \"browser_executed\": false\n+}"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"runs/online-ch2-prescient-euclidean-20261011/prepared-reader-v1/syntax-check-v3.stderr","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-reader-v1%2Fsyntax-check-v3.stderr","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-reader-v1%2Fsyntax-check-v3.stderr","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-reader-v1%2Fsyntax-check-v3.stderr?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"runs/online-ch2-prescient-euclidean-20261011/prepared-reader-v1/syntax-check-v3.stdout","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-reader-v1%2Fsyntax-check-v3.stdout","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-reader-v1%2Fsyntax-check-v3.stdout","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-reader-v1%2Fsyntax-check-v3.stdout?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8"},{"sha":"1b565e6aca95e14491ba7508da1335dfff0fe16e","filename":"runs/online-ch2-prescient-euclidean-20261011/prepared-structural-v1/check-prescient-structure-v1.py","status":"added","additions":222,"deletions":0,"changes":222,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Fcheck-prescient-structure-v1.py","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Fcheck-prescient-structure-v1.py","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Fcheck-prescient-structure-v1.py?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1,222 @@\n+\"\"\"Python 3.8; read-only checks, one create-only result. Prepared, never auto-applies.\"\"\"\n+import argparse\n+import hashlib\n+import json\n+import re\n+import subprocess\n+import zipfile\n+from pathlib import Path\n+from html.parser import HTMLParser\n+from html import unescape\n+\n+NAMES = [\"BanditRL.OnlineBregman.quadratic_geometry\", \"BanditRL.OnlinePrescientBregman.euclidean_variable_regret\", \"BanditRL.OnlinePrescientBregman.euclidean_fixed_regret\"]\n+TEST_NAMES = [\"variable_quadratic_actual_run\", \"fixed_quadratic_actual_run\"]\n+GOVERNANCE = [\"docs/proof-digestion-protocol.md\", \"docs/evidence-routed-memory-protocol.md\", \"docs/openai-math-assimilation-protocol.md\", \"research-wiki/openai-math-2026-intake.json\", \"runs/process_memory.json\"]\n+CORE_SHA = \"9b755a12d540c1039b068e4b97af90ac483a58fd1a8b40af9c806264f95d42b8\"\n+TEST_SHA = \"dbc2a2f7660e70517a6f50826944976aa9cbbba17e37f88b8bac9fbef97e0122\"\n+\n+def require(ok, message):\n+    if not ok:\n+        raise ValueError(message)\n+\n+def digest(data):\n+    return hashlib.sha256(data).hexdigest()\n+\n+def load(path):\n+    return json.loads(path.read_bytes())\n+\n+def norm(s):\n+    return re.sub(r\"\\s+\", \" \", s).strip()\n+\n+def pointer(value, path):\n+    require(path == \"\" or path.startswith(\"/\"), \"invalid JSON pointer\")\n+    for part in path.split(\"/\")[1:]:\n+        part = part.replace(\"~1\", \"/\").replace(\"~0\", \"~\")\n+        value = value[int(part)] if isinstance(value, list) else value[part]\n+    return value\n+\n+class Folds(HTMLParser):\n+    def __init__(self):\n+        HTMLParser.__init__(self)\n+        self.blocks = {}\n+        self.current = None\n+        self.depth = 0\n+        self.pre = False\n+    def handle_starttag(self, tag, attrs):\n+        a = dict(attrs)\n+        if tag == \"details\":\n+            if self.current is not None:\n+                self.depth += 1\n+            elif \"declaration\" in a.get(\"class\", \"\").split():\n+                self.current = {\"header\": [], \"links\": [], \"open\": \"open\" in a}\n+                self.blocks[a[\"id\"]] = self.current\n+                self.depth = 1\n+        if self.current is not None:\n+            if tag == \"pre\" and \"lean-code\" in a.get(\"class\", \"\").split():\n+                self.pre = True\n+            if tag == \"a\" and \"href\" in a:\n+                self.current[\"links\"].append(a[\"href\"])\n+    def handle_endtag(self, tag):\n+        if self.current is not None:\n+            if tag == \"pre\":\n+                self.pre = False\n+            if tag == \"details\":\n+                self.depth -= 1\n+                if self.depth == 0:\n+                    self.current = None\n+    def handle_data(self, text):\n+        if self.current is not None and self.pre:\n+            self.current[\"header\"].append(text)\n+\n+def main(a):\n+    root = a.root.resolve()\n+    spec = load(a.spec)\n+    require(digest(a.spec.read_bytes()) == a.spec_sha256, \"spec hash\")\n+    require(spec[\"ready_for_execution\"] is True, \"reviewed complete spec required\")\n+    evidence = {}\n+    for key, item in spec[\"bindings\"].items():\n+        path = root / item[\"path\"]\n+        require(digest(path.read_bytes()) == item[\"sha256\"], \"binding drift: \" + key)\n+        evidence[key] = path\n+    required = [\"core\", \"test\", \"production_freeze\", \"canary_freeze\", \"core_review\", \"canary_review\", \"topology\", \"topology_review\", \"values\", \"integration_review\", \"schema3_manifest\", \"normalization_receipt\"]\n+    require(all(k in evidence for k in required), \"missing required evidence binding\")\n+    require(digest(evidence[\"core\"].read_bytes()) == CORE_SHA, \"core hash\")\n+    require(digest(evidence[\"test\"].read_bytes()) == TEST_SHA, \"Test hash\")\n+    core = evidence[\"core\"].read_text(encoding=\"utf-8\")\n+    test = evidence[\"test\"].read_text(encoding=\"utf-8\")\n+    require(re.findall(r\"^theorem\\s+(\\w+)\", core, re.M) == [n.rsplit(\".\", 1)[1] for n in NAMES], \"exact 3 core theorems\")\n+    require(re.findall(r\"^theorem\\s+(\\w+)\", test, re.M) == TEST_NAMES, \"exact 2 Test theorems\")\n+    require(not re.search(r\"^(?:noncomputable\\s+)?(?:def|abbrev|lemma)\\s\", test, re.M), \"unexpected named Test helper\")\n+    require(load(evidence[\"core_review\"])[\"verdict\"] == \"accepted-candidate-core-only\", \"core BODY verdict\")\n+    require(load(evidence[\"canary_review\"])[\"verdict\"] == \"accepted-candidate-canaries-only\", \"canary BODY verdict\")\n+    require(load(evidence[\"canary_review\"])[\"production_sha256\"] == CORE_SHA, \"canary/core join\")\n+    require(load(evidence[\"canary_review\"])[\"Test_sha256\"] == TEST_SHA, \"canary/Test join\")\n+    require(spec[\"json_assertions\"], \"exact schema3/review assertions required\")\n+    for assertion in spec[\"json_assertions\"]:\n+        require(pointer(load(root / assertion[\"path\"]), assertion[\"pointer\"]) == assertion[\"equals\"], \"JSON assertion: \" + assertion[\"path\"] + assertion[\"pointer\"])\n+    gate = load(a.gate)\n+    require(digest(a.gate.read_bytes()) == a.gate_sha256, \"gate receipt hash\")\n+    require(gate[\"actual_exit\"] == 0 and gate[\"capture_integrity_ok\"] is True, \"actual gate/integrity\")\n+    require(\"tools/bandit.py\" in gate[\"argv\"] and \"check\" in gate[\"argv\"], \"combined gate argv\")\n+    for key in [\"pre_git\", \"post_git\"]:\n+        require(gate[key][\"HEAD\"] == a.head and gate[key][\"status_porcelain_v1_z_hex\"] == \"\", \"gate exact clean HEAD\")\n+    require(subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], cwd=str(root)).decode().strip() == a.head, \"current HEAD drift\")\n+    require(subprocess.check_output([\"git\", \"status\", \"--porcelain=v1\", \"--untracked-files=all\"], cwd=str(root)) == b\"\", \"current tree not clean\")\n+    artifacts = {}\n+    for name in [\"pre-source-inputs.json\", \"post-source-inputs.json\", \"pre-selected-ZIP-inputs.json\", \"pre-selected-source-raw.zip\", \"stdout.raw\", \"stderr.raw\"]:\n+        path = a.gate.parent / name\n+        require(digest(path.read_bytes()) == gate[name + \"_sha256\"], \"gate artifact hash: \" + name)\n+        artifacts[name] = path\n+    pre = load(artifacts[\"pre-source-inputs.json\"])\n+    post = load(artifacts[\"post-source-inputs.json\"])\n+    require(pre == post, \"source RAW inventory drift\")\n+    raw = {x[\"path\"]: x for x in post}\n+    require(len(raw) == len(post), \"duplicate RAW paths\")\n+    for path, row in raw.items():\n+        require(digest((root / path).read_bytes()) == row[\"raw_sha256\"], \"current RAW drift: \" + path)\n+    selected = load(artifacts[\"pre-selected-ZIP-inputs.json\"])\n+    selected_map = {x[\"path\"]: x for x in selected}\n+    require(len(selected_map) == len(selected), \"duplicate ZIP manifest paths\")\n+    with zipfile.ZipFile(str(artifacts[\"pre-selected-source-raw.zip\"])) as z:\n+        require(len(z.namelist()) == len(set(z.namelist())), \"duplicate archive entries\")\n+        require(set(z.namelist()) == set(selected_map), \"ZIP entry-set mismatch\")\n+        for path, row in selected_map.items():\n+            require(digest(z.read(path)) == row[\"raw_sha256\"], \"ZIP byte mismatch: \" + path)\n+            require(row[\"raw_sha256\"] == raw[path][\"raw_sha256\"], \"ZIP/RAW mismatch: \" + path)\n+        for path in GOVERNANCE:\n+            require(path in raw and path in selected_map, \"missing governance RAW/ZIP: \" + path)\n+            require(z.read(path) == (root / path).read_bytes(), \"governance byte mismatch: \" + path)\n+    require(digest(a.old_registry.read_bytes()) == a.old_registry_sha256, \"baseline registry pin\")\n+    oldreg = load(a.old_registry)\n+    newreg = load(a.site / \"books/registry.json\")\n+    oldnodes = {n[\"id\"]: n for n in oldreg[\"nodes\"]}\n+    newnodes = {n[\"id\"]: n for n in newreg[\"nodes\"]}\n+    require(len(oldnodes) == len(oldreg[\"nodes\"]) == 11101, \"old registry count\")\n+    require(len(newnodes) == len(newreg[\"nodes\"]) == 11104, \"new registry count\")\n+    require(all(newnodes.get(k) == v for k, v in oldnodes.items()), \"old complete registry object changed\")\n+    require(set(newnodes) - set(oldnodes) == {\"declaration:\" + n for n in NAMES}, \"exact new production IDs\")\n+    require(newreg[\"source_commit\"] == a.head and newreg[\"lean_verified\"] is True, \"site HEAD/verification\")\n+    for name in NAMES:\n+        node = newnodes[\"declaration:\" + name]\n+        require(node[\"status\"] == \"compiled\", \"new node status\")\n+        relative, anchor = node[\"url\"].split(\"#\", 1)\n+        parser = Folds()\n+        parser.feed((a.site / relative).read_text(encoding=\"utf-8\"))\n+        block = parser.blocks[anchor]\n+        require(block[\"open\"] is False, \"module Lean fold unexpectedly open\")\n+        short = name.rsplit(\".\", 1)[1]\n+        header = core[core.index(\"theorem \" + short + \" \"):].split(\":= by\", 1)[0]\n+        require(norm(\"\".join(block[\"header\"])) == norm(header), \"raw section header mismatch: \" + name)\n+        line = next(i for i, s in enumerate(core.splitlines(), 1) if s.startswith(\"theorem \" + short + \" \"))\n+        require(any(\"/blob/\" + a.head + \"/\" + spec[\"bindings\"][\"core\"][\"path\"] + \"#L\" + str(line) in u for u in block[\"links\"]), \"pinned proof link\")\n+    olddocs = {}\n+    newdocs = {}\n+    for kind in [\"chapters\", \"readings\", \"highlights\"]:\n+        path = \"website/content/\" + kind + \".json\"\n+        oldpath = a.before / path\n+        require(digest(oldpath.read_bytes()) == spec[\"before_sha256\"][path], \"historical before pin: \" + path)\n+        olddocs[kind] = load(oldpath)\n+        newdocs[kind] = load(root / path)\n+    import copy\n+    restored = copy.deepcopy(newdocs)\n+    cr = next(x for x in restored[\"chapters\"][\"chapters\"] if x[\"slug\"] == \"online-ogd\")\n+    require(cr[\"module_globs\"].pop() == spec[\"bindings\"][\"core\"][\"path\"], \"module append\")\n+    rr = next(x for x in restored[\"readings\"][\"readings\"] if x[\"slug\"] == \"online-ogd\")\n+    require(len(rr[\"source_theorems\"]) == 22, \"22 source cards\")\n+    card = rr[\"source_theorems\"].pop()\n+    require(len(rr[\"source_theorems\"]) == 21, \"21 prior source cards\")\n+    lessons = restored[\"highlights\"][\"highlights\"][-3:]\n+    require([x[\"full_name\"] for x in lessons] == NAMES, \"three ordered highlight additions\")\n+    del restored[\"highlights\"][\"highlights\"][-3:]\n+    require(restored == olddocs, \"unrelated object or other chapter changed\")\n+    html = unescape((a.site / \"chapters/online-ogd/index.html\").read_text(encoding=\"utf-8\"))\n+    require(card[\"math\"] in html, \"full grouped formula absent\")\n+    require(card[\"url\"] in html, \"source PDF link absent\")\n+    for lesson in lessons:\n+        require(lesson[\"math\"] in html and lesson[\"title\"] in html, \"lesson formula/title\")\n+    require('class=\"exact-lean\"' in html, \"chapter exact Lean folds absent\")\n+    values = {x[\"declaration\"]: x for x in load(evidence[\"values\"])[\"nodes\"]}\n+    for lesson in lessons:\n+        require(all(n in values[lesson[\"full_name\"]][\"VALUE_constants\"] for n in lesson[\"dependencies\"]), \"claimed dependency absent from VALUE\")\n+    topology = load(evidence[\"topology\"])\n+    require(any(n[\"id\"] == \"SRC-OPTIMALITY\" and n[\"justification_status\"] == \"UNRESOLVED_SOURCE_PROOF_JUSTIFICATION\" for n in topology[\"nodes\"]), \"source gap erased\")\n+    require(any(n[\"id\"] == \"SPEC-ACTUAL-RUN\" for n in topology[\"nodes\"]), \"source actual-run obligation absent\")\n+    require(evidence[\"topology\"].resolve() != evidence[\"values\"].resolve(), \"source/actual graph conflation\")\n+    for view in spec[\"rendered_view_checks\"]:\n+        content = (a.site / view[\"path\"]).read_text(encoding=\"utf-8\")\n+        for marker in view[\"required_markers\"]:\n+            require(marker in content, \"view marker missing: \" + marker)\n+    require({v[\"kind\"] for v in spec[\"rendered_view_checks\"]} == {\"source\", \"actual_VALUE\"}, \"both view semantics must be explicitly bound\")\n+    coverage = load(root / spec[\"coverage_path\"])\n+    c2 = next(x for x in coverage[\"chapters\"] if x[\"chapter\"] == 2)\n+    require(c2[\"accepted\"] is False and c2[\"mandatory_count\"] is None, \"chapter falsely complete\")\n+    require(c2[\"required_open_forward_containers\"] == 7 and c2[\"required_future_mathematical_claims_open_unenumerated\"] == 6, \"7+6 boundary\")\n+    require(spec[\"governance_status_assertions\"], \"B4/Goal exact assertions required\")\n+    for assertion in spec[\"governance_status_assertions\"]:\n+        require(pointer(load(root / assertion[\"path\"]), assertion[\"pointer\"]) == assertion[\"equals\"], \"governance status assertion\")\n+    require({x[\"meaning\"] for x in spec[\"governance_status_assertions\"]} >= {\"B4 7.47 open\", \"B4 15.31 open\", \"Goal active\", \"Chapter2 partial\"}, \"missing named open-state evidence\")\n+    normal = load(evidence[\"normalization_receipt\"])\n+    require(normal[\"pre_RAW_sha256\"].startswith(\"5515f280\") and normal[\"staged_and_post_RAW_sha256\"].startswith(\"88745d35\"), \"normalization record\")\n+    # Historical snapshots are never asserted equal to current MANIFEST after merge.\n+    return {\"status\": \"passed structural checks; visual QA separate\", \"head\": a.head, \"old_nodes_preserved\": 11101, \"new_node_ids\": [\"declaration:\" + n for n in NAMES], \"source_cards\": 22, \"core_theorems\": 3, \"Test_theorems\": 2, \"governance_RAW_and_ZIP\": GOVERNANCE, \"source_graph_distinct_from_VALUE\": True, \"chapter_accepted\": False, \"open_containers\": 7, \"future_claims\": 6, \"source_writes\": False}\n+\n+if __name__ == \"__main__\":\n+    p = argparse.ArgumentParser()\n+    for name in [\"root\", \"site\", \"gate\", \"before\", \"old-registry\", \"spec\", \"output\"]:\n+        p.add_argument(\"--\" + name, type=Path, required=True)\n+    for name in [\"head\", \"gate-sha256\", \"old-registry-sha256\", \"spec-sha256\"]:\n+        p.add_argument(\"--\" + name, required=True)\n+    args = p.parse_args()\n+    if args.output.exists():\n+        raise SystemExit(\"create-only output already exists\")\n+    try:\n+        result = main(args)\n+        code = 0\n+    except Exception as exc:\n+        result = {\"status\": \"failed\", \"error_type\": type(exc).__name__, \"error\": str(exc), \"source_writes\": False}\n+        code = 1\n+    with args.output.open(\"x\", encoding=\"utf-8\", newline=\"\\n\") as stream:\n+        json.dump(result, stream, ensure_ascii=False, indent=2)\n+        stream.write(\"\\n\")\n+    print(json.dumps(result, ensure_ascii=False))\n+    raise SystemExit(code)\r"},{"sha":"04d57f76b06e1072390e7eb3ff36b3c40dcd7064","filename":"runs/online-ch2-prescient-euclidean-20261011/prepared-structural-v1/check-prescient-structure-v2.py","status":"added","additions":231,"deletions":0,"changes":231,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Fcheck-prescient-structure-v2.py","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Fcheck-prescient-structure-v2.py","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Fcheck-prescient-structure-v2.py?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1,231 @@\n+\"\"\"Python 3.8; read-only checks, one create-only result. Prepared, never auto-applies.\"\"\"\n+import argparse\n+import hashlib\n+import json\n+import re\n+import subprocess\n+import zipfile\n+from pathlib import Path\n+from html.parser import HTMLParser\n+from html import unescape\n+\n+NAMES = [\"BanditRL.OnlineBregman.quadratic_geometry\", \"BanditRL.OnlinePrescientBregman.euclidean_variable_regret\", \"BanditRL.OnlinePrescientBregman.euclidean_fixed_regret\"]\n+TEST_NAMES = [\"variable_quadratic_actual_run\", \"fixed_quadratic_actual_run\"]\n+GOVERNANCE = [\"docs/proof-digestion-protocol.md\", \"docs/evidence-routed-memory-protocol.md\", \"docs/openai-math-assimilation-protocol.md\", \"research-wiki/openai-math-2026-intake.json\", \"runs/process_memory.json\"]\n+CORE_SHA = \"9b755a12d540c1039b068e4b97af90ac483a58fd1a8b40af9c806264f95d42b8\"\n+TEST_SHA = \"dbc2a2f7660e70517a6f50826944976aa9cbbba17e37f88b8bac9fbef97e0122\"\n+\n+def require(ok, message):\n+    if not ok:\n+        raise ValueError(message)\n+\n+def digest(data):\n+    return hashlib.sha256(data).hexdigest()\n+\n+def load(path):\n+    return json.loads(path.read_bytes())\n+\n+def norm(s):\n+    return re.sub(r\"\\s+\", \" \", s).strip()\n+\n+def pointer(value, path):\n+    require(path == \"\" or path.startswith(\"/\"), \"invalid JSON pointer\")\n+    for part in path.split(\"/\")[1:]:\n+        part = part.replace(\"~1\", \"/\").replace(\"~0\", \"~\")\n+        value = value[int(part)] if isinstance(value, list) else value[part]\n+    return value\n+\n+class Folds(HTMLParser):\n+    def __init__(self):\n+        HTMLParser.__init__(self)\n+        self.blocks = {}\n+        self.current = None\n+        self.depth = 0\n+        self.pre = False\n+    def handle_starttag(self, tag, attrs):\n+        a = dict(attrs)\n+        if tag == \"details\":\n+            if self.current is not None:\n+                self.depth += 1\n+            elif \"declaration\" in a.get(\"class\", \"\").split():\n+                self.current = {\"header\": [], \"links\": [], \"open\": \"open\" in a}\n+                self.blocks[a[\"id\"]] = self.current\n+                self.depth = 1\n+        if self.current is not None:\n+            if tag == \"pre\" and \"lean-code\" in a.get(\"class\", \"\").split():\n+                self.pre = True\n+            if tag == \"a\" and \"href\" in a:\n+                self.current[\"links\"].append(a[\"href\"])\n+    def handle_endtag(self, tag):\n+        if self.current is not None:\n+            if tag == \"pre\":\n+                self.pre = False\n+            if tag == \"details\":\n+                self.depth -= 1\n+                if self.depth == 0:\n+                    self.current = None\n+    def handle_data(self, text):\n+        if self.current is not None and self.pre:\n+            self.current[\"header\"].append(text)\n+\n+def main(a):\n+    root = a.root.resolve()\n+    spec = load(a.spec)\n+    require(digest(a.spec.read_bytes()) == a.spec_sha256, \"spec hash\")\n+    require(spec[\"ready_for_execution\"] is True, \"reviewed complete spec required\")\n+    evidence = {}\n+    for key, item in spec[\"bindings\"].items():\n+        path = root / item[\"path\"]\n+        require(digest(path.read_bytes()) == item[\"sha256\"], \"binding drift: \" + key)\n+        evidence[key] = path\n+    required = [\"core\", \"test\", \"production_freeze\", \"canary_freeze\", \"core_review\", \"canary_review\", \"topology\", \"topology_review\", \"values\", \"integration_review\", \"schema3_manifest\", \"normalization_receipt\"]\n+    require(all(k in evidence for k in required), \"missing required evidence binding\")\n+    require(digest(evidence[\"core\"].read_bytes()) == CORE_SHA, \"core hash\")\n+    require(digest(evidence[\"test\"].read_bytes()) == TEST_SHA, \"Test hash\")\n+    core = evidence[\"core\"].read_text(encoding=\"utf-8\")\n+    test = evidence[\"test\"].read_text(encoding=\"utf-8\")\n+    require(re.findall(r\"^theorem\\s+(\\w+)\", core, re.M) == [n.rsplit(\".\", 1)[1] for n in NAMES], \"exact 3 core theorems\")\n+    require(re.findall(r\"^theorem\\s+(\\w+)\", test, re.M) == TEST_NAMES, \"exact 2 Test theorems\")\n+    require(not re.search(r\"^(?:noncomputable\\s+)?(?:def|abbrev|lemma)\\s\", test, re.M), \"unexpected named Test helper\")\n+    require(load(evidence[\"core_review\"])[\"source_sha256\"] == CORE_SHA, \"core/review join\")\n+    require(load(evidence[\"core_review\"])[\"blocking_repairs\"] == [], \"core review blockers\")\n+    require(load(evidence[\"canary_review\"])[\"blocking_repairs\"] == [], \"canary review blockers\")\n+    require(load(evidence[\"core_review\"])[\"verdict\"] == \"accepted-candidate-core-only\", \"core BODY verdict\")\n+    require(load(evidence[\"canary_review\"])[\"verdict\"] == \"accepted-candidate-canaries-only\", \"canary BODY verdict\")\n+    require(load(evidence[\"canary_review\"])[\"production_sha256\"] == CORE_SHA, \"canary/core join\")\n+    require(load(evidence[\"canary_review\"])[\"Test_sha256\"] == TEST_SHA, \"canary/Test join\")\n+    require(spec[\"json_assertions\"], \"exact schema3/review assertions required\")\n+    require({x[\"meaning\"] for x in spec[\"json_assertions\"]} >= {\"schema3\", \"freeze bindings\", \"source versus VALUE nodes\", \"edge semantics\", \"single route source gap\"}, \"missing required contract assertion meanings\")\n+    for assertion in spec[\"json_assertions\"]:\n+        require(pointer(load(root / assertion[\"path\"]), assertion[\"pointer\"]) == assertion[\"equals\"], \"JSON assertion: \" + assertion[\"path\"] + assertion[\"pointer\"])\n+    gate = load(a.gate)\n+    require(digest(a.gate.read_bytes()) == a.gate_sha256, \"gate receipt hash\")\n+    require(gate[\"actual_exit\"] == 0 and gate[\"capture_integrity_ok\"] is True, \"actual gate/integrity\")\n+    require(\"tools/bandit.py\" in gate[\"argv\"] and \"check\" in gate[\"argv\"], \"combined gate argv\")\n+    for key in [\"pre_git\", \"post_git\"]:\n+        require(gate[key][\"HEAD\"] == a.head and gate[key][\"status_porcelain_v1_z_hex\"] == \"\", \"gate exact clean HEAD\")\n+    require(subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], cwd=str(root)).decode().strip() == a.head, \"current HEAD drift\")\n+    require(subprocess.check_output([\"git\", \"status\", \"--porcelain=v1\", \"--untracked-files=all\"], cwd=str(root)) == b\"\", \"current tree not clean\")\n+    artifacts = {}\n+    for name in [\"pre-source-inputs.json\", \"post-source-inputs.json\", \"pre-selected-ZIP-inputs.json\", \"pre-selected-source-raw.zip\", \"stdout.raw\", \"stderr.raw\"]:\n+        path = a.gate.parent / name\n+        require(digest(path.read_bytes()) == gate[name + \"_sha256\"], \"gate artifact hash: \" + name)\n+        artifacts[name] = path\n+    pre = load(artifacts[\"pre-source-inputs.json\"])\n+    post = load(artifacts[\"post-source-inputs.json\"])\n+    require(pre == post, \"source RAW inventory drift\")\n+    raw = {x[\"path\"]: x for x in post}\n+    require(len(raw) == len(post), \"duplicate RAW paths\")\n+    for path, row in raw.items():\n+        require(digest((root / path).read_bytes()) == row[\"raw_sha256\"], \"current RAW drift: \" + path)\n+    selected = load(artifacts[\"pre-selected-ZIP-inputs.json\"])\n+    selected_map = {x[\"path\"]: x for x in selected}\n+    require(len(selected_map) == len(selected), \"duplicate ZIP manifest paths\")\n+    with zipfile.ZipFile(str(artifacts[\"pre-selected-source-raw.zip\"])) as z:\n+        require(len(z.namelist()) == len(set(z.namelist())), \"duplicate archive entries\")\n+        require(set(z.namelist()) == set(selected_map), \"ZIP entry-set mismatch\")\n+        for path, row in selected_map.items():\n+            require(digest(z.read(path)) == row[\"raw_sha256\"], \"ZIP byte mismatch: \" + path)\n+            require(row[\"raw_sha256\"] == raw[path][\"raw_sha256\"], \"ZIP/RAW mismatch: \" + path)\n+        for path in GOVERNANCE:\n+            require(path in raw and path in selected_map, \"missing governance RAW/ZIP: \" + path)\n+            require(z.read(path) == (root / path).read_bytes(), \"governance byte mismatch: \" + path)\n+    require(digest(a.old_registry.read_bytes()) == a.old_registry_sha256, \"baseline registry pin\")\n+    oldreg = load(a.old_registry)\n+    newreg = load(a.site / \"books/registry.json\")\n+    oldnodes = {n[\"id\"]: n for n in oldreg[\"nodes\"]}\n+    newnodes = {n[\"id\"]: n for n in newreg[\"nodes\"]}\n+    require(len(oldnodes) == len(oldreg[\"nodes\"]) == 11101, \"old registry count\")\n+    require(len(newnodes) == len(newreg[\"nodes\"]) == 11104, \"new registry count\")\n+    require(all(newnodes.get(k) == v for k, v in oldnodes.items()), \"old complete registry object changed\")\n+    require(set(newnodes) - set(oldnodes) == {\"declaration:\" + n for n in NAMES}, \"exact new production IDs\")\n+    require(newreg[\"source_commit\"] == a.head and newreg[\"lean_verified\"] is True, \"site HEAD/verification\")\n+    for name in NAMES:\n+        node = newnodes[\"declaration:\" + name]\n+        require(node[\"status\"] == \"compiled\", \"new node status\")\n+        relative, anchor = node[\"url\"].split(\"#\", 1)\n+        parser = Folds()\n+        parser.feed((a.site / relative).read_text(encoding=\"utf-8\"))\n+        block = parser.blocks[anchor]\n+        require(block[\"open\"] is False, \"module Lean fold unexpectedly open\")\n+        short = name.rsplit(\".\", 1)[1]\n+        header = core[core.index(\"theorem \" + short + \" \"):].split(\":= by\", 1)[0]\n+        require(norm(\"\".join(block[\"header\"])) == norm(header), \"raw section header mismatch: \" + name)\n+        line = next(i for i, s in enumerate(core.splitlines(), 1) if s.startswith(\"theorem \" + short + \" \"))\n+        require(any(\"/blob/\" + a.head + \"/\" + spec[\"bindings\"][\"core\"][\"path\"] + \"#L\" + str(line) in u for u in block[\"links\"]), \"pinned proof link\")\n+    olddocs = {}\n+    newdocs = {}\n+    for kind in [\"chapters\", \"readings\", \"highlights\"]:\n+        path = \"website/content/\" + kind + \".json\"\n+        oldpath = a.before / path\n+        require(digest(oldpath.read_bytes()) == spec[\"before_sha256\"][path], \"historical before pin: \" + path)\n+        olddocs[kind] = load(oldpath)\n+        newdocs[kind] = load(root / path)\n+    import copy\n+    restored = copy.deepcopy(newdocs)\n+    cr = next(x for x in restored[\"chapters\"][\"chapters\"] if x[\"slug\"] == \"online-ogd\")\n+    require(cr[\"module_globs\"].pop() == spec[\"bindings\"][\"core\"][\"path\"], \"module append\")\n+    rr = next(x for x in restored[\"readings\"][\"readings\"] if x[\"slug\"] == \"online-ogd\")\n+    require(len(rr[\"source_theorems\"]) == 22, \"22 source cards\")\n+    card = rr[\"source_theorems\"].pop()\n+    require(len(rr[\"source_theorems\"]) == 21, \"21 prior source cards\")\n+    lessons = restored[\"highlights\"][\"highlights\"][-3:]\n+    require([x[\"full_name\"] for x in lessons] == NAMES, \"three ordered highlight additions\")\n+    del restored[\"highlights\"][\"highlights\"][-3:]\n+    require(restored == olddocs, \"unrelated object or other chapter changed\")\n+    html = unescape((a.site / \"chapters/online-ogd/index.html\").read_text(encoding=\"utf-8\"))\n+    require(card[\"math\"] in html, \"full grouped formula absent\")\n+    require(card[\"url\"] in html, \"source PDF link absent\")\n+    for lesson in lessons:\n+        require(lesson[\"math\"] in html and lesson[\"title\"] in html, \"lesson formula/title\")\n+    require('class=\"exact-lean\"' in html, \"chapter exact Lean folds absent\")\n+    values = {x[\"declaration\"]: x for x in load(evidence[\"values\"])[\"nodes\"]}\n+    for lesson in lessons:\n+        require(all(n in values[lesson[\"full_name\"]][\"VALUE_constants\"] for n in lesson[\"dependencies\"]), \"claimed dependency absent from VALUE\")\n+    topology = load(evidence[\"topology\"])\n+    require(any(n[\"id\"] == \"SRC-OPTIMALITY\" and n[\"justification_status\"] == \"UNRESOLVED_SOURCE_PROOF_JUSTIFICATION\" for n in topology[\"nodes\"]), \"source gap erased\")\n+    require(any(n[\"id\"] == \"SPEC-ACTUAL-RUN\" for n in topology[\"nodes\"]), \"source actual-run obligation absent\")\n+    require(evidence[\"topology\"].resolve() != evidence[\"values\"].resolve(), \"source/actual graph conflation\")\n+    manifest = load(evidence[\"schema3_manifest\"])\n+    rb = manifest[\"learning_contract\"][\"reader_backpressure\"]\n+    require(set(rb[\"source_expansion_nodes\"]) == {n[\"id\"] for n in topology[\"nodes\"]}, \"source topology expansion mismatch\")\n+    require(rb[\"lean_expansion_nodes\"] == NAMES, \"actual declaration expansion mismatch\")\n+    for view in spec[\"rendered_view_checks\"]:\n+        require(view[\"required_markers\"], \"empty rendered-view checks forbidden\")\n+        content = (a.site / view[\"path\"]).read_text(encoding=\"utf-8\")\n+        for marker in view[\"required_markers\"]:\n+            require(marker in content, \"view marker missing: \" + marker)\n+    require({v[\"kind\"] for v in spec[\"rendered_view_checks\"]} == {\"source\", \"actual_VALUE\"}, \"both view semantics must be explicitly bound\")\n+    coverage = load(root / spec[\"coverage_path\"])\n+    c2 = next(x for x in coverage[\"chapters\"] if x[\"chapter\"] == 2)\n+    require(c2[\"accepted\"] is False and c2[\"mandatory_count\"] is None, \"chapter falsely complete\")\n+    require(c2[\"required_open_forward_containers\"] == 7 and c2[\"required_future_mathematical_claims_open_unenumerated\"] == 6, \"7+6 boundary\")\n+    require(spec[\"governance_status_assertions\"], \"B4/Goal exact assertions required\")\n+    for assertion in spec[\"governance_status_assertions\"]:\n+        require(pointer(load(root / assertion[\"path\"]), assertion[\"pointer\"]) == assertion[\"equals\"], \"governance status assertion\")\n+    require({x[\"meaning\"] for x in spec[\"governance_status_assertions\"]} >= {\"B4 7.47 open\", \"B4 15.31 open\", \"Goal ACTIVE local metadata only\", \"Chapter2 partial\"}, \"missing named open-state evidence\")\n+    normal = load(evidence[\"normalization_receipt\"])\n+    require(normal[\"pre_RAW_sha256\"] == \"5515f2800132a23830d92bace395942e1546d1446870a956c5e3c0513b2007f0\" and normal[\"staged_and_post_RAW_sha256\"] == \"88745d354bbc89880245ca3c5be78a79f383412d27712064024d0a5ade4cf414\", \"normalization record\")\n+    # Historical snapshots are never asserted equal to current MANIFEST after merge.\n+    return {\"status\": \"passed structural checks; visual QA separate\", \"head\": a.head, \"old_nodes_preserved\": 11101, \"new_node_ids\": [\"declaration:\" + n for n in NAMES], \"source_cards\": 22, \"core_theorems\": 3, \"Test_theorems\": 2, \"governance_RAW_and_ZIP\": GOVERNANCE, \"source_graph_distinct_from_VALUE\": True, \"Goal_status_scope\": \"local metadata only; actual Goal tool status must be checked separately\", \"chapter_accepted\": False, \"open_containers\": 7, \"future_claims\": 6, \"source_writes\": False}\n+\n+if __name__ == \"__main__\":\n+    p = argparse.ArgumentParser()\n+    for name in [\"root\", \"site\", \"gate\", \"before\", \"old-registry\", \"spec\", \"output\"]:\n+        p.add_argument(\"--\" + name, type=Path, required=True)\n+    for name in [\"head\", \"gate-sha256\", \"old-registry-sha256\", \"spec-sha256\"]:\n+        p.add_argument(\"--\" + name, required=True)\n+    args = p.parse_args()\n+    if args.output.exists():\n+        raise SystemExit(\"create-only output already exists\")\n+    try:\n+        result = main(args)\n+        code = 0\n+    except Exception as exc:\n+        result = {\"status\": \"failed\", \"error_type\": type(exc).__name__, \"error\": str(exc), \"source_writes\": False}\n+        code = 1\n+    with args.output.open(\"x\", encoding=\"utf-8\", newline=\"\\n\") as stream:\n+        json.dump(result, stream, ensure_ascii=False, indent=2)\n+        stream.write(\"\\n\")\n+    print(json.dumps(result, ensure_ascii=False))\n+    raise SystemExit(code)"},{"sha":"63a9cee0a4b637e84e22d3990f5684ac4f5ea53d","filename":"runs/online-ch2-prescient-euclidean-20261011/prepared-structural-v1/check-prescient-structure-v3.py","status":"added","additions":236,"deletions":0,"changes":236,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Fcheck-prescient-structure-v3.py","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Fcheck-prescient-structure-v3.py","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Fcheck-prescient-structure-v3.py?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1,236 @@\n+\"\"\"Python 3.8; read-only checks, one create-only result. Prepared, never auto-applies.\"\"\"\n+import argparse\n+import hashlib\n+import json\n+import re\n+import subprocess\n+import zipfile\n+from pathlib import Path\n+from html.parser import HTMLParser\n+from html import unescape\n+\n+NAMES = [\"BanditRL.OnlineBregman.quadratic_geometry\", \"BanditRL.OnlinePrescientBregman.euclidean_variable_regret\", \"BanditRL.OnlinePrescientBregman.euclidean_fixed_regret\"]\n+TEST_NAMES = [\"variable_quadratic_actual_run\", \"fixed_quadratic_actual_run\"]\n+GOVERNANCE = [\"docs/proof-digestion-protocol.md\", \"docs/evidence-routed-memory-protocol.md\", \"docs/openai-math-assimilation-protocol.md\", \"research-wiki/openai-math-2026-intake.json\", \"runs/process_memory.json\"]\n+CORE_SHA = \"9b755a12d540c1039b068e4b97af90ac483a58fd1a8b40af9c806264f95d42b8\"\n+TEST_SHA = \"dbc2a2f7660e70517a6f50826944976aa9cbbba17e37f88b8bac9fbef97e0122\"\n+\n+def require(ok, message):\n+    if not ok:\n+        raise ValueError(message)\n+\n+def digest(data):\n+    return hashlib.sha256(data).hexdigest()\n+\n+def load(path):\n+    return json.loads(path.read_bytes())\n+\n+def norm(s):\n+    return re.sub(r\"\\s+\", \" \", s).strip()\n+\n+def pointer(value, path):\n+    require(path == \"\" or path.startswith(\"/\"), \"invalid JSON pointer\")\n+    for part in path.split(\"/\")[1:]:\n+        part = part.replace(\"~1\", \"/\").replace(\"~0\", \"~\")\n+        value = value[int(part)] if isinstance(value, list) else value[part]\n+    return value\n+\n+class Folds(HTMLParser):\n+    def __init__(self):\n+        HTMLParser.__init__(self)\n+        self.blocks = {}\n+        self.current = None\n+        self.depth = 0\n+        self.pre = False\n+    def handle_starttag(self, tag, attrs):\n+        a = dict(attrs)\n+        if tag == \"details\":\n+            if self.current is not None:\n+                self.depth += 1\n+            elif \"declaration\" in a.get(\"class\", \"\").split():\n+                self.current = {\"header\": [], \"links\": [], \"open\": \"open\" in a}\n+                self.blocks[a[\"id\"]] = self.current\n+                self.depth = 1\n+        if self.current is not None:\n+            if tag == \"pre\" and \"lean-code\" in a.get(\"class\", \"\").split():\n+                self.pre = True\n+            if tag == \"a\" and \"href\" in a:\n+                self.current[\"links\"].append(a[\"href\"])\n+    def handle_endtag(self, tag):\n+        if self.current is not None:\n+            if tag == \"pre\":\n+                self.pre = False\n+            if tag == \"details\":\n+                self.depth -= 1\n+                if self.depth == 0:\n+                    self.current = None\n+    def handle_data(self, text):\n+        if self.current is not None and self.pre:\n+            self.current[\"header\"].append(text)\n+\n+def main(a):\n+    root = a.root.resolve()\n+    spec = load(a.spec)\n+    require(digest(a.spec.read_bytes()) == a.spec_sha256, \"spec hash\")\n+    require(spec[\"ready_for_execution\"] is True, \"reviewed complete spec required\")\n+    evidence = {}\n+    for key, item in spec[\"bindings\"].items():\n+        path = root / item[\"path\"]\n+        require(digest(path.read_bytes()) == item[\"sha256\"], \"binding drift: \" + key)\n+        evidence[key] = path\n+    required = [\"core\", \"test\", \"production_freeze\", \"canary_freeze\", \"core_review\", \"canary_review\", \"topology\", \"topology_review\", \"values\", \"integration_review\", \"schema3_manifest\", \"normalization_receipt\"]\n+    require(all(k in evidence for k in required), \"missing required evidence binding\")\n+    require(digest(evidence[\"core\"].read_bytes()) == CORE_SHA, \"core hash\")\n+    require(digest(evidence[\"test\"].read_bytes()) == TEST_SHA, \"Test hash\")\n+    core = evidence[\"core\"].read_text(encoding=\"utf-8\")\n+    test = evidence[\"test\"].read_text(encoding=\"utf-8\")\n+    require(re.findall(r\"^theorem\\s+(\\w+)\", core, re.M) == [n.rsplit(\".\", 1)[1] for n in NAMES], \"exact 3 core theorems\")\n+    require(re.findall(r\"^theorem\\s+(\\w+)\", test, re.M) == TEST_NAMES, \"exact 2 Test theorems\")\n+    require(not re.search(r\"^(?:noncomputable\\s+)?(?:def|abbrev|lemma)\\s\", test, re.M), \"unexpected named Test helper\")\n+    require(load(evidence[\"core_review\"])[\"source_sha256\"] == CORE_SHA, \"core/review join\")\n+    require(load(evidence[\"core_review\"])[\"blocking_repairs\"] == [], \"core review blockers\")\n+    require(load(evidence[\"canary_review\"])[\"blocking_repairs\"] == [], \"canary review blockers\")\n+    require(load(evidence[\"core_review\"])[\"verdict\"] == \"accepted-candidate-core-only\", \"core BODY verdict\")\n+    require(load(evidence[\"canary_review\"])[\"verdict\"] == \"accepted-candidate-canaries-only\", \"canary BODY verdict\")\n+    require(load(evidence[\"canary_review\"])[\"production_sha256\"] == CORE_SHA, \"canary/core join\")\n+    require(load(evidence[\"canary_review\"])[\"Test_sha256\"] == TEST_SHA, \"canary/Test join\")\n+    require(spec[\"json_assertions\"], \"exact schema3/review assertions required\")\n+    require({x[\"meaning\"] for x in spec[\"json_assertions\"]} >= {\"schema3\", \"freeze bindings\", \"source versus VALUE nodes\", \"edge semantics\", \"single route source gap\"}, \"missing required contract assertion meanings\")\n+    for assertion in spec[\"json_assertions\"]:\n+        require(pointer(load(root / assertion[\"path\"]), assertion[\"pointer\"]) == assertion[\"equals\"], \"JSON assertion: \" + assertion[\"path\"] + assertion[\"pointer\"])\n+    gate = load(a.gate)\n+    require(digest(a.gate.read_bytes()) == a.gate_sha256, \"gate receipt hash\")\n+    require(gate[\"actual_exit\"] == 0 and gate[\"capture_integrity_ok\"] is True, \"actual gate/integrity\")\n+    require(\"tools/bandit.py\" in gate[\"argv\"] and \"check\" in gate[\"argv\"], \"combined gate argv\")\n+    for key in [\"pre_git\", \"post_git\"]:\n+        require(gate[key][\"HEAD\"] == a.head and gate[key][\"status_porcelain_v1_z_hex\"] == \"\", \"gate exact clean HEAD\")\n+    require(subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], cwd=str(root)).decode().strip() == a.head, \"current HEAD drift\")\n+    require(subprocess.check_output([\"git\", \"status\", \"--porcelain=v1\", \"--untracked-files=all\"], cwd=str(root)) == b\"\", \"current tree not clean\")\n+    artifacts = {}\n+    for name in [\"pre-source-inputs.json\", \"post-source-inputs.json\", \"pre-selected-ZIP-inputs.json\", \"pre-selected-source-raw.zip\", \"stdout.raw\", \"stderr.raw\"]:\n+        path = a.gate.parent / name\n+        require(digest(path.read_bytes()) == gate[name + \"_sha256\"], \"gate artifact hash: \" + name)\n+        artifacts[name] = path\n+    pre = load(artifacts[\"pre-source-inputs.json\"])\n+    post = load(artifacts[\"post-source-inputs.json\"])\n+    require(pre == post, \"source RAW inventory drift\")\n+    raw = {x[\"path\"]: x for x in post}\n+    require(len(raw) == len(post), \"duplicate RAW paths\")\n+    for path, row in raw.items():\n+        require(digest((root / path).read_bytes()) == row[\"raw_sha256\"], \"current RAW drift: \" + path)\n+    selected = load(artifacts[\"pre-selected-ZIP-inputs.json\"])\n+    selected_map = {x[\"path\"]: x for x in selected}\n+    require(len(selected_map) == len(selected), \"duplicate ZIP manifest paths\")\n+    with zipfile.ZipFile(str(artifacts[\"pre-selected-source-raw.zip\"])) as z:\n+        require(len(z.namelist()) == len(set(z.namelist())), \"duplicate archive entries\")\n+        require(set(z.namelist()) == set(selected_map), \"ZIP entry-set mismatch\")\n+        for path, row in selected_map.items():\n+            require(digest(z.read(path)) == row[\"raw_sha256\"], \"ZIP byte mismatch: \" + path)\n+            require(row[\"raw_sha256\"] == raw[path][\"raw_sha256\"], \"ZIP/RAW mismatch: \" + path)\n+        for path in GOVERNANCE:\n+            require(path in raw and path in selected_map, \"missing governance RAW/ZIP: \" + path)\n+            require(z.read(path) == (root / path).read_bytes(), \"governance byte mismatch: \" + path)\n+    require(digest(a.old_registry.read_bytes()) == a.old_registry_sha256, \"baseline registry pin\")\n+    oldreg = load(a.old_registry)\n+    newreg = load(a.site / \"books/registry.json\")\n+    oldnodes = {n[\"id\"]: n for n in oldreg[\"nodes\"]}\n+    newnodes = {n[\"id\"]: n for n in newreg[\"nodes\"]}\n+    require(len(oldnodes) == len(oldreg[\"nodes\"]) == 11101, \"old registry count\")\n+    require(len(newnodes) == len(newreg[\"nodes\"]) == 11104, \"new registry count\")\n+    require(all(newnodes.get(k) == v for k, v in oldnodes.items()), \"old complete registry object changed\")\n+    require(set(newnodes) - set(oldnodes) == {\"declaration:\" + n for n in NAMES}, \"exact new production IDs\")\n+    require(newreg[\"source_commit\"] == a.head and newreg[\"lean_verified\"] is True, \"site HEAD/verification\")\n+    for name in NAMES:\n+        node = newnodes[\"declaration:\" + name]\n+        require(node[\"status\"] == \"compiled\", \"new node status\")\n+        relative, anchor = node[\"url\"].split(\"#\", 1)\n+        parser = Folds()\n+        parser.feed((a.site / relative).read_text(encoding=\"utf-8\"))\n+        block = parser.blocks[anchor]\n+        require(block[\"open\"] is False, \"module Lean fold unexpectedly open\")\n+        short = name.rsplit(\".\", 1)[1]\n+        header = core[core.index(\"theorem \" + short + \" \"):].split(\":= by\", 1)[0]\n+        require(norm(\"\".join(block[\"header\"])) == norm(header), \"raw section header mismatch: \" + name)\n+        line = next(i for i, s in enumerate(core.splitlines(), 1) if s.startswith(\"theorem \" + short + \" \"))\n+        require(any(\"/blob/\" + a.head + \"/\" + spec[\"bindings\"][\"core\"][\"path\"] + \"#L\" + str(line) in u for u in block[\"links\"]), \"pinned proof link\")\n+    olddocs = {}\n+    newdocs = {}\n+    for kind in [\"chapters\", \"readings\", \"highlights\"]:\n+        path = \"website/content/\" + kind + \".json\"\n+        oldpath = a.before / path\n+        require(digest(oldpath.read_bytes()) == spec[\"before_sha256\"][path], \"historical before pin: \" + path)\n+        olddocs[kind] = load(oldpath)\n+        newdocs[kind] = load(root / path)\n+    import copy\n+    restored = copy.deepcopy(newdocs)\n+    cr = next(x for x in restored[\"chapters\"][\"chapters\"] if x[\"slug\"] == \"online-ogd\")\n+    require(cr[\"module_globs\"].pop() == spec[\"bindings\"][\"core\"][\"path\"], \"module append\")\n+    rr = next(x for x in restored[\"readings\"][\"readings\"] if x[\"slug\"] == \"online-ogd\")\n+    require(len(rr[\"source_theorems\"]) == 22, \"22 source cards\")\n+    card = rr[\"source_theorems\"].pop()\n+    require(len(rr[\"source_theorems\"]) == 21, \"21 prior source cards\")\n+    lessons = restored[\"highlights\"][\"highlights\"][-3:]\n+    require([x[\"full_name\"] for x in lessons] == NAMES, \"three ordered highlight additions\")\n+    del restored[\"highlights\"][\"highlights\"][-3:]\n+    require(restored == olddocs, \"unrelated object or other chapter changed\")\n+    html = unescape((a.site / \"chapters/online-ogd/index.html\").read_text(encoding=\"utf-8\"))\n+    require(card[\"math\"] in html, \"full grouped formula absent\")\n+    require(card[\"url\"] in html, \"source PDF link absent\")\n+    for lesson in lessons:\n+        require(lesson[\"math\"] in html and lesson[\"title\"] in html, \"lesson formula/title\")\n+    require('class=\"exact-lean\"' in html, \"chapter exact Lean folds absent\")\n+    values = {x[\"declaration\"]: x for x in load(evidence[\"values\"])[\"nodes\"]}\n+    for lesson in lessons:\n+        require(all(n in values[lesson[\"full_name\"]][\"VALUE_constants\"] for n in lesson[\"dependencies\"]), \"claimed dependency absent from VALUE\")\n+    geometry = next(x for x in lessons if x[\"full_name\"] == NAMES[0])\n+    for parent in [\"hasStrictFDerivAt_norm_sq\", \"HasGradientAt.fderiv_apply\", \"norm_sub_sq_real\"]:\n+        require(parent in values[NAMES[0]][\"VALUE_constants\"], \"actual Mathlib VALUE parent absent\")\n+        require(parent in geometry[\"lean_notes\"], \"actual Mathlib parent missing from reader notes\")\n+    # Mathlib names need not be local-registry highlight edges; preserve actual VALUE evidence.\n+    topology = load(evidence[\"topology\"])\n+    require(any(n[\"id\"] == \"SRC-OPTIMALITY\" and n[\"justification_status\"] == \"UNRESOLVED_SOURCE_PROOF_JUSTIFICATION\" for n in topology[\"nodes\"]), \"source gap erased\")\n+    require(any(n[\"id\"] == \"SPEC-ACTUAL-RUN\" for n in topology[\"nodes\"]), \"source actual-run obligation absent\")\n+    require(evidence[\"topology\"].resolve() != evidence[\"values\"].resolve(), \"source/actual graph conflation\")\n+    manifest = load(evidence[\"schema3_manifest\"])\n+    rb = manifest[\"learning_contract\"][\"reader_backpressure\"]\n+    require(set(rb[\"source_expansion_nodes\"]) == {n[\"id\"] for n in topology[\"nodes\"]}, \"source topology expansion mismatch\")\n+    require(rb[\"lean_expansion_nodes\"] == NAMES, \"actual declaration expansion mismatch\")\n+    for view in spec[\"rendered_view_checks\"]:\n+        require(view[\"required_markers\"], \"empty rendered-view checks forbidden\")\n+        content = (a.site / view[\"path\"]).read_text(encoding=\"utf-8\")\n+        for marker in view[\"required_markers\"]:\n+            require(marker in content, \"view marker missing: \" + marker)\n+    require({v[\"kind\"] for v in spec[\"rendered_view_checks\"]} == {\"source\", \"actual_VALUE\"}, \"both view semantics must be explicitly bound\")\n+    coverage = load(root / spec[\"coverage_path\"])\n+    c2 = next(x for x in coverage[\"chapters\"] if x[\"chapter\"] == 2)\n+    require(c2[\"accepted\"] is False and c2[\"mandatory_count\"] is None, \"chapter falsely complete\")\n+    require(c2[\"required_open_forward_containers\"] == 7 and c2[\"required_future_mathematical_claims_open_unenumerated\"] == 6, \"7+6 boundary\")\n+    require(spec[\"governance_status_assertions\"], \"B4/Goal exact assertions required\")\n+    for assertion in spec[\"governance_status_assertions\"]:\n+        require(pointer(load(root / assertion[\"path\"]), assertion[\"pointer\"]) == assertion[\"equals\"], \"governance status assertion\")\n+    require({x[\"meaning\"] for x in spec[\"governance_status_assertions\"]} >= {\"B4 7.47 open\", \"B4 15.31 open\", \"Goal ACTIVE local metadata only\", \"Chapter2 partial\"}, \"missing named open-state evidence\")\n+    normal = load(evidence[\"normalization_receipt\"])\n+    require(normal[\"pre_RAW_sha256\"] == \"5515f2800132a23830d92bace395942e1546d1446870a956c5e3c0513b2007f0\" and normal[\"staged_and_post_RAW_sha256\"] == \"88745d354bbc89880245ca3c5be78a79f383412d27712064024d0a5ade4cf414\", \"normalization record\")\n+    # Historical snapshots are never asserted equal to current MANIFEST after merge.\n+    return {\"status\": \"passed structural checks; visual QA separate\", \"head\": a.head, \"old_nodes_preserved\": 11101, \"new_node_ids\": [\"declaration:\" + n for n in NAMES], \"source_cards\": 22, \"core_theorems\": 3, \"Test_theorems\": 2, \"governance_RAW_and_ZIP\": GOVERNANCE, \"source_graph_distinct_from_VALUE\": True, \"Goal_status_scope\": \"local metadata only; actual Goal tool status must be checked separately\", \"chapter_accepted\": False, \"open_containers\": 7, \"future_claims\": 6, \"source_writes\": False}\n+\n+if __name__ == \"__main__\":\n+    p = argparse.ArgumentParser()\n+    for name in [\"root\", \"site\", \"gate\", \"before\", \"old-registry\", \"spec\", \"output\"]:\n+        p.add_argument(\"--\" + name, type=Path, required=True)\n+    for name in [\"head\", \"gate-sha256\", \"old-registry-sha256\", \"spec-sha256\"]:\n+        p.add_argument(\"--\" + name, required=True)\n+    args = p.parse_args()\n+    if args.output.exists():\n+        raise SystemExit(\"create-only output already exists\")\n+    try:\n+        result = main(args)\n+        code = 0\n+    except Exception as exc:\n+        result = {\"status\": \"failed\", \"error_type\": type(exc).__name__, \"error\": str(exc), \"source_writes\": False}\n+        code = 1\n+    with args.output.open(\"x\", encoding=\"utf-8\", newline=\"\\n\") as stream:\n+        json.dump(result, stream, ensure_ascii=False, indent=2)\n+        stream.write(\"\\n\")\n+    print(json.dumps(result, ensure_ascii=False))\n+    raise SystemExit(code)"},{"sha":"16e4850e99bffcec8283df2e0ad156109ba67ebf","filename":"runs/online-ch2-prescient-euclidean-20261011/prepared-structural-v1/check-prescient-structure-v4.py","status":"added","additions":254,"deletions":0,"changes":254,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Fcheck-prescient-structure-v4.py","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Fcheck-prescient-structure-v4.py","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Fcheck-prescient-structure-v4.py?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1,254 @@\n+\"\"\"Python 3.8; read-only checks, one create-only result. Prepared, never auto-applies.\"\"\"\n+import argparse\n+import hashlib\n+import json\n+import re\n+import subprocess\n+import zipfile\n+from pathlib import Path\n+from html.parser import HTMLParser\n+from html import unescape\n+\n+NAMES = [\"BanditRL.OnlineBregman.quadratic_geometry\", \"BanditRL.OnlinePrescientBregman.euclidean_variable_regret\", \"BanditRL.OnlinePrescientBregman.euclidean_fixed_regret\"]\n+TEST_NAMES = [\"variable_quadratic_actual_run\", \"fixed_quadratic_actual_run\"]\n+GOVERNANCE = [\"docs/proof-digestion-protocol.md\", \"docs/evidence-routed-memory-protocol.md\", \"docs/openai-math-assimilation-protocol.md\", \"research-wiki/openai-math-2026-intake.json\", \"runs/process_memory.json\"]\n+CORE_SHA = \"9b755a12d540c1039b068e4b97af90ac483a58fd1a8b40af9c806264f95d42b8\"\n+TEST_SHA = \"dbc2a2f7660e70517a6f50826944976aa9cbbba17e37f88b8bac9fbef97e0122\"\n+\n+def require(ok, message):\n+    if not ok:\n+        raise ValueError(message)\n+\n+def digest(data):\n+    return hashlib.sha256(data).hexdigest()\n+\n+def load(path):\n+    return json.loads(path.read_bytes())\n+\n+def norm(s):\n+    return re.sub(r\"\\s+\", \" \", s).strip()\n+\n+def pointer(value, path):\n+    require(path == \"\" or path.startswith(\"/\"), \"invalid JSON pointer\")\n+    for part in path.split(\"/\")[1:]:\n+        part = part.replace(\"~1\", \"/\").replace(\"~0\", \"~\")\n+        value = value[int(part)] if isinstance(value, list) else value[part]\n+    return value\n+\n+class Folds(HTMLParser):\n+    def __init__(self):\n+        HTMLParser.__init__(self)\n+        self.blocks = {}\n+        self.current = None\n+        self.depth = 0\n+        self.pre = False\n+    def handle_starttag(self, tag, attrs):\n+        a = dict(attrs)\n+        if tag == \"details\":\n+            if self.current is not None:\n+                self.depth += 1\n+            elif \"declaration\" in a.get(\"class\", \"\").split():\n+                self.current = {\"header\": [], \"links\": [], \"open\": \"open\" in a}\n+                self.blocks[a[\"id\"]] = self.current\n+                self.depth = 1\n+        if self.current is not None:\n+            if tag == \"pre\" and \"lean-code\" in a.get(\"class\", \"\").split():\n+                self.pre = True\n+            if tag == \"a\" and \"href\" in a:\n+                self.current[\"links\"].append(a[\"href\"])\n+    def handle_endtag(self, tag):\n+        if self.current is not None:\n+            if tag == \"pre\":\n+                self.pre = False\n+            if tag == \"details\":\n+                self.depth -= 1\n+                if self.depth == 0:\n+                    self.current = None\n+    def handle_data(self, text):\n+        if self.current is not None and self.pre:\n+            self.current[\"header\"].append(text)\n+\n+def main(a):\n+    root = a.root.resolve()\n+    spec = load(a.spec)\n+    require(digest(a.spec.read_bytes()) == a.spec_sha256, \"spec hash\")\n+    require(spec[\"ready_for_execution\"] is True, \"reviewed complete spec required\")\n+    evidence = {}\n+    for key, item in spec[\"bindings\"].items():\n+        path = root / item[\"path\"]\n+        require(digest(path.read_bytes()) == item[\"sha256\"], \"binding drift: \" + key)\n+        evidence[key] = path\n+    required = [\"core\", \"test\", \"production_freeze\", \"canary_freeze\", \"core_review\", \"canary_review\", \"topology\", \"topology_review\", \"values\", \"integration_review\", \"schema3_manifest\", \"normalization_receipt\"]\n+    require(all(k in evidence for k in required), \"missing required evidence binding\")\n+    require(digest(evidence[\"core\"].read_bytes()) == CORE_SHA, \"core hash\")\n+    require(digest(evidence[\"test\"].read_bytes()) == TEST_SHA, \"Test hash\")\n+    core = evidence[\"core\"].read_text(encoding=\"utf-8\")\n+    test = evidence[\"test\"].read_text(encoding=\"utf-8\")\n+    require(re.findall(r\"^theorem\\s+(\\w+)\", core, re.M) == [n.rsplit(\".\", 1)[1] for n in NAMES], \"exact 3 core theorems\")\n+    require(re.findall(r\"^theorem\\s+(\\w+)\", test, re.M) == TEST_NAMES, \"exact 2 Test theorems\")\n+    require(not re.search(r\"^(?:noncomputable\\s+)?(?:def|abbrev|lemma)\\s\", test, re.M), \"unexpected named Test helper\")\n+    require(load(evidence[\"core_review\"])[\"source_sha256\"] == CORE_SHA, \"core/review join\")\n+    require(load(evidence[\"core_review\"])[\"blocking_repairs\"] == [], \"core review blockers\")\n+    require(load(evidence[\"canary_review\"])[\"blocking_repairs\"] == [], \"canary review blockers\")\n+    require(load(evidence[\"core_review\"])[\"verdict\"] == \"accepted-candidate-core-only\", \"core BODY verdict\")\n+    require(load(evidence[\"canary_review\"])[\"verdict\"] == \"accepted-candidate-canaries-only\", \"canary BODY verdict\")\n+    require(load(evidence[\"canary_review\"])[\"production_sha256\"] == CORE_SHA, \"canary/core join\")\n+    require(load(evidence[\"canary_review\"])[\"Test_sha256\"] == TEST_SHA, \"canary/Test join\")\n+    require(spec[\"json_assertions\"], \"exact schema3/review assertions required\")\n+    require({x[\"meaning\"] for x in spec[\"json_assertions\"]} >= {\"schema3\", \"freeze bindings\", \"source versus VALUE nodes\", \"edge semantics\", \"single route source gap\"}, \"missing required contract assertion meanings\")\n+    for assertion in spec[\"json_assertions\"]:\n+        require(pointer(load(root / assertion[\"path\"]), assertion[\"pointer\"]) == assertion[\"equals\"], \"JSON assertion: \" + assertion[\"path\"] + assertion[\"pointer\"])\n+    gate = load(a.gate)\n+    require(digest(a.gate.read_bytes()) == a.gate_sha256, \"gate receipt hash\")\n+    require(gate[\"actual_exit\"] == 0 and gate[\"capture_integrity_ok\"] is True, \"actual gate/integrity\")\n+    require(\"tools/bandit.py\" in gate[\"argv\"] and \"check\" in gate[\"argv\"], \"combined gate argv\")\n+    for key in [\"pre_git\", \"post_git\"]:\n+        require(gate[key][\"HEAD\"] == a.head and gate[key][\"status_porcelain_v1_z_hex\"] == \"\", \"gate exact clean HEAD\")\n+    require(subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], cwd=str(root)).decode().strip() == a.head, \"current HEAD drift\")\n+    require(subprocess.check_output([\"git\", \"status\", \"--porcelain=v1\", \"--untracked-files=all\"], cwd=str(root)) == b\"\", \"current tree not clean\")\n+    artifacts = {}\n+    for name in [\"pre-source-inputs.json\", \"post-source-inputs.json\", \"pre-selected-ZIP-inputs.json\", \"pre-selected-source-raw.zip\", \"stdout.raw\", \"stderr.raw\"]:\n+        path = a.gate.parent / name\n+        require(digest(path.read_bytes()) == gate[name + \"_sha256\"], \"gate artifact hash: \" + name)\n+        artifacts[name] = path\n+    pre = load(artifacts[\"pre-source-inputs.json\"])\n+    post = load(artifacts[\"post-source-inputs.json\"])\n+    require(pre == post, \"source RAW inventory drift\")\n+    helper_path = a.gate.parent / \"capture-helper.py.txt\"\n+    helper_bytes = helper_path.read_bytes()\n+    helper_pin = \"d7d10142361f940c51712e7dd174dfae51ad768f65f87f26decd87d91faf58fc\"\n+    require(digest(helper_bytes) == helper_pin, \"captured helper pin mismatch\")\n+    require(gate[\"helper_sha256\"] == helper_pin, \"receipt helper pin mismatch\")\n+    require(Path(gate[\"cwd\"]).resolve() == root, \"gate root mismatch\")\n+    namespace = Path(gate[\"actual_evidence_namespace\"]).resolve()\n+    require(namespace == (root / gate[\"evidence_namespace_excluded\"]).resolve(), \"excluded namespace mismatch\")\n+    require(root in namespace.parents, \"evidence namespace outside root\")\n+    # Execute ONLY the already hash-pinned recorder definitions, under a non-main\n+    # module name. No import loader cache writes and no call to recorder.main.\n+    helper_scope = {\"__name__\": \"prescient_pinned_inventory_only\", \"__file__\": str(helper_path)}\n+    exec(compile(helper_bytes, str(helper_path), \"exec\"), helper_scope)\n+    current_rows = helper_scope[\"inventory\"](root, namespace, gate[\"owned_source\"])\n+    require(current_rows == pre and current_rows == post, \"current full input set/bytes differ from gate RAW inventories\")\n+    raw = {x[\"path\"]: x for x in post}\n+    require(len(raw) == len(post), \"duplicate RAW paths\")\n+    for path, row in raw.items():\n+        require(digest((root / path).read_bytes()) == row[\"raw_sha256\"], \"current RAW drift: \" + path)\n+    selected = load(artifacts[\"pre-selected-ZIP-inputs.json\"])\n+    current_selected = [row for row in current_rows\n+                        if helper_scope[\"selected_for_zip\"](row[\"path\"], gate[\"leaf_contract_roots\"])]\n+    require(current_selected == selected, \"current selected ZIP input set/bytes differ from captured manifest\")\n+    selected_map = {x[\"path\"]: x for x in selected}\n+    require(len(selected_map) == len(selected), \"duplicate ZIP manifest paths\")\n+    with zipfile.ZipFile(str(artifacts[\"pre-selected-source-raw.zip\"])) as z:\n+        require(len(z.namelist()) == len(set(z.namelist())), \"duplicate archive entries\")\n+        require(set(z.namelist()) == set(selected_map), \"ZIP entry-set mismatch\")\n+        for path, row in selected_map.items():\n+            require(digest(z.read(path)) == row[\"raw_sha256\"], \"ZIP byte mismatch: \" + path)\n+            require(row[\"raw_sha256\"] == raw[path][\"raw_sha256\"], \"ZIP/RAW mismatch: \" + path)\n+        for path in GOVERNANCE:\n+            require(path in raw and path in selected_map, \"missing governance RAW/ZIP: \" + path)\n+            require(z.read(path) == (root / path).read_bytes(), \"governance byte mismatch: \" + path)\n+    require(digest(a.old_registry.read_bytes()) == a.old_registry_sha256, \"baseline registry pin\")\n+    oldreg = load(a.old_registry)\n+    newreg = load(a.site / \"books/registry.json\")\n+    oldnodes = {n[\"id\"]: n for n in oldreg[\"nodes\"]}\n+    newnodes = {n[\"id\"]: n for n in newreg[\"nodes\"]}\n+    require(len(oldnodes) == len(oldreg[\"nodes\"]) == 11101, \"old registry count\")\n+    require(len(newnodes) == len(newreg[\"nodes\"]) == 11104, \"new registry count\")\n+    require(all(newnodes.get(k) == v for k, v in oldnodes.items()), \"old complete registry object changed\")\n+    require(set(newnodes) - set(oldnodes) == {\"declaration:\" + n for n in NAMES}, \"exact new production IDs\")\n+    require(newreg[\"source_commit\"] == a.head and newreg[\"lean_verified\"] is True, \"site HEAD/verification\")\n+    for name in NAMES:\n+        node = newnodes[\"declaration:\" + name]\n+        require(node[\"status\"] == \"compiled\", \"new node status\")\n+        relative, anchor = node[\"url\"].split(\"#\", 1)\n+        parser = Folds()\n+        parser.feed((a.site / relative).read_text(encoding=\"utf-8\"))\n+        block = parser.blocks[anchor]\n+        require(block[\"open\"] is False, \"module Lean fold unexpectedly open\")\n+        short = name.rsplit(\".\", 1)[1]\n+        header = core[core.index(\"theorem \" + short + \" \"):].split(\":= by\", 1)[0]\n+        require(norm(\"\".join(block[\"header\"])) == norm(header), \"raw section header mismatch: \" + name)\n+        line = next(i for i, s in enumerate(core.splitlines(), 1) if s.startswith(\"theorem \" + short + \" \"))\n+        require(any(\"/blob/\" + a.head + \"/\" + spec[\"bindings\"][\"core\"][\"path\"] + \"#L\" + str(line) in u for u in block[\"links\"]), \"pinned proof link\")\n+    olddocs = {}\n+    newdocs = {}\n+    for kind in [\"chapters\", \"readings\", \"highlights\"]:\n+        path = \"website/content/\" + kind + \".json\"\n+        oldpath = a.before / path\n+        require(digest(oldpath.read_bytes()) == spec[\"before_sha256\"][path], \"historical before pin: \" + path)\n+        olddocs[kind] = load(oldpath)\n+        newdocs[kind] = load(root / path)\n+    import copy\n+    restored = copy.deepcopy(newdocs)\n+    cr = next(x for x in restored[\"chapters\"][\"chapters\"] if x[\"slug\"] == \"online-ogd\")\n+    require(cr[\"module_globs\"].pop() == spec[\"bindings\"][\"core\"][\"path\"], \"module append\")\n+    rr = next(x for x in restored[\"readings\"][\"readings\"] if x[\"slug\"] == \"online-ogd\")\n+    require(len(rr[\"source_theorems\"]) == 22, \"22 source cards\")\n+    card = rr[\"source_theorems\"].pop()\n+    require(len(rr[\"source_theorems\"]) == 21, \"21 prior source cards\")\n+    lessons = restored[\"highlights\"][\"highlights\"][-3:]\n+    require([x[\"full_name\"] for x in lessons] == NAMES, \"three ordered highlight additions\")\n+    del restored[\"highlights\"][\"highlights\"][-3:]\n+    require(restored == olddocs, \"unrelated object or other chapter changed\")\n+    html = unescape((a.site / \"chapters/online-ogd/index.html\").read_text(encoding=\"utf-8\"))\n+    require(card[\"math\"] in html, \"full grouped formula absent\")\n+    require(card[\"url\"] in html, \"source PDF link absent\")\n+    for lesson in lessons:\n+        require(lesson[\"math\"] in html and lesson[\"title\"] in html, \"lesson formula/title\")\n+    require('class=\"exact-lean\"' in html, \"chapter exact Lean folds absent\")\n+    values = {x[\"declaration\"]: x for x in load(evidence[\"values\"])[\"nodes\"]}\n+    for lesson in lessons:\n+        require(all(n in values[lesson[\"full_name\"]][\"VALUE_constants\"] for n in lesson[\"dependencies\"]), \"claimed dependency absent from VALUE\")\n+    geometry = next(x for x in lessons if x[\"full_name\"] == NAMES[0])\n+    for parent in [\"hasStrictFDerivAt_norm_sq\", \"HasGradientAt.fderiv_apply\", \"norm_sub_sq_real\"]:\n+        require(parent in values[NAMES[0]][\"VALUE_constants\"], \"actual Mathlib VALUE parent absent\")\n+        require(parent in geometry[\"lean_notes\"], \"actual Mathlib parent missing from reader notes\")\n+    # Mathlib names need not be local-registry highlight edges; preserve actual VALUE evidence.\n+    topology = load(evidence[\"topology\"])\n+    require(any(n[\"id\"] == \"SRC-OPTIMALITY\" and n[\"justification_status\"] == \"UNRESOLVED_SOURCE_PROOF_JUSTIFICATION\" for n in topology[\"nodes\"]), \"source gap erased\")\n+    require(any(n[\"id\"] == \"SPEC-ACTUAL-RUN\" for n in topology[\"nodes\"]), \"source actual-run obligation absent\")\n+    require(evidence[\"topology\"].resolve() != evidence[\"values\"].resolve(), \"source/actual graph conflation\")\n+    manifest = load(evidence[\"schema3_manifest\"])\n+    rb = manifest[\"learning_contract\"][\"reader_backpressure\"]\n+    require(set(rb[\"source_expansion_nodes\"]) == {n[\"id\"] for n in topology[\"nodes\"]}, \"source topology expansion mismatch\")\n+    require(rb[\"lean_expansion_nodes\"] == NAMES, \"actual declaration expansion mismatch\")\n+    for view in spec[\"rendered_view_checks\"]:\n+        require(view[\"required_markers\"], \"empty rendered-view checks forbidden\")\n+        content = (a.site / view[\"path\"]).read_text(encoding=\"utf-8\")\n+        for marker in view[\"required_markers\"]:\n+            require(marker in content, \"view marker missing: \" + marker)\n+    require({v[\"kind\"] for v in spec[\"rendered_view_checks\"]} == {\"source\", \"actual_VALUE\"}, \"both view semantics must be explicitly bound\")\n+    coverage = load(root / spec[\"coverage_path\"])\n+    c2 = next(x for x in coverage[\"chapters\"] if x[\"chapter\"] == 2)\n+    require(c2[\"accepted\"] is False and c2[\"mandatory_count\"] is None, \"chapter falsely complete\")\n+    require(c2[\"required_open_forward_containers\"] == 7 and c2[\"required_future_mathematical_claims_open_unenumerated\"] == 6, \"7+6 boundary\")\n+    require(spec[\"governance_status_assertions\"], \"B4/Goal exact assertions required\")\n+    for assertion in spec[\"governance_status_assertions\"]:\n+        require(pointer(load(root / assertion[\"path\"]), assertion[\"pointer\"]) == assertion[\"equals\"], \"governance status assertion\")\n+    require({x[\"meaning\"] for x in spec[\"governance_status_assertions\"]} >= {\"B4 7.47 open\", \"B4 15.31 open\", \"Goal ACTIVE local metadata only\", \"Chapter2 partial\"}, \"missing named open-state evidence\")\n+    normal = load(evidence[\"normalization_receipt\"])\n+    require(normal[\"pre_RAW_sha256\"] == \"5515f2800132a23830d92bace395942e1546d1446870a956c5e3c0513b2007f0\" and normal[\"staged_and_post_RAW_sha256\"] == \"88745d354bbc89880245ca3c5be78a79f383412d27712064024d0a5ade4cf414\", \"normalization record\")\n+    # Historical snapshots are never asserted equal to current MANIFEST after merge.\n+    return {\"status\": \"passed structural checks; visual QA separate\", \"head\": a.head, \"old_nodes_preserved\": 11101, \"new_node_ids\": [\"declaration:\" + n for n in NAMES], \"source_cards\": 22, \"core_theorems\": 3, \"Test_theorems\": 2, \"governance_RAW_and_ZIP\": GOVERNANCE, \"current_full_RAW_rows_reenumerated\": True, \"current_selected_ZIP_rows_reenumerated\": True, \"capture_helper_sha256\": helper_pin, \"source_graph_distinct_from_VALUE\": True, \"Goal_status_scope\": \"local metadata only; actual Goal tool status must be checked separately\", \"chapter_accepted\": False, \"open_containers\": 7, \"future_claims\": 6, \"source_writes\": False}\n+\n+if __name__ == \"__main__\":\n+    p = argparse.ArgumentParser()\n+    for name in [\"root\", \"site\", \"gate\", \"before\", \"old-registry\", \"spec\", \"output\"]:\n+        p.add_argument(\"--\" + name, type=Path, required=True)\n+    for name in [\"head\", \"gate-sha256\", \"old-registry-sha256\", \"spec-sha256\"]:\n+        p.add_argument(\"--\" + name, required=True)\n+    args = p.parse_args()\n+    if args.output.exists():\n+        raise SystemExit(\"create-only output already exists\")\n+    try:\n+        result = main(args)\n+        code = 0\n+    except Exception as exc:\n+        result = {\"status\": \"failed\", \"error_type\": type(exc).__name__, \"error\": str(exc), \"source_writes\": False}\n+        code = 1\n+    with args.output.open(\"x\", encoding=\"utf-8\", newline=\"\\n\") as stream:\n+        json.dump(result, stream, ensure_ascii=False, indent=2)\n+        stream.write(\"\\n\")\n+    print(json.dumps(result, ensure_ascii=False))\n+    raise SystemExit(code)"},{"sha":"66feb7e1895c2e9a9ee6465f53e8276ba3387467","filename":"runs/online-ch2-prescient-euclidean-20261011/prepared-structural-v1/independent-execution-spec-review-v1.json","status":"added","additions":21,"deletions":0,"changes":21,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Findependent-execution-spec-review-v1.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Findependent-execution-spec-review-v1.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Findependent-execution-spec-review-v1.json?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1,21 @@\n+{\n+  \"utc\": \"2026-10-11T07:29:15.340922+00:00\",\n+  \"actor\": \"/root/adaptive_reviewer\",\n+  \"requested_model_effort\": \"GPT-6 Astra / medium; runtime not attested\",\n+  \"verdict\": \"accepted-conditional-execution-spec\",\n+  \"blocking_repairs\": [],\n+  \"approved_spec_sha256\": \"ed5345bddaa9ac3dd6dacaafce00d02fadf1dd2df0644417015989335d6e0c59\",\n+  \"approved_helper_sha256\": \"9972b600caf600bf36c53ecbc3208a03ee71c374ef16a9923e2fe6587a7f8d87\",\n+  \"approved_baseline_registry_sha256\": \"6bbabc167361664910ed212e11de79574a30733a94a1a32c946b792281a33d40\",\n+  \"binding_checks\": \"Every bindings path/raw SHA and every JSON/governance assertion matches current bytes. Baseline11101 nodes independently verified. All six markers occur in current geometry lesson.\",\n+  \"successor_delta\": \"Only readiness flags/prerequisites, two explicit scoped rendered-view checks, and execution_conditions changed versus prepared v1. Other bindings/assertions unchanged.\",\n+  \"execution_conditions\": [\n+    \"Independently accepted helper9972b600 and this exact successor spec required.\",\n+    \"Execution only after actual successful combined clean candidate and successful build/site checks at the same source snapshot, supplied exact receipt/HEAD/baseline pins.\",\n+    \"Site repair changes geometry dependency links only; selected actual Mathlib parent notes and VALUE export remain required.\"\n+  ],\n+  \"external_precondition_boundary\": \"Successful site-build and official site-check at the same source snapshot are parent-enforced prerequisites: helper CLI validates combined receipt/site HEAD, but does not itself parse those two site receipts. This approval does not assert those gates have finished.\",\n+  \"render_scope\": \"Two reader note views on one chapter page; not full23-node rendered topology, transitive proof graph, or second verified route. Full source topology and selected VALUE artifacts separately hash-bound.\",\n+  \"execution_performed\": false,\n+  \"canonical_writes\": false\n+}"},{"sha":"b0dcbb6747201cfc809e44164d7cecad54359ef6","filename":"runs/online-ch2-prescient-euclidean-20261011/prepared-structural-v1/independent-execution-spec-review-v1.md","status":"added","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Findependent-execution-spec-review-v1.md","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Findependent-execution-spec-review-v1.md","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Findependent-execution-spec-review-v1.md?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1 @@\n+Accepted exact execution spec conditionally. All artifact hashes and JSON assertions currently match; baseline has11101 nodes; required rendered markers occur in current lesson content. Actual rendering remains unverified. Parent must first verify successful combined/build/official-site gates at one snapshot and supply exact CLI pins. Source and VALUE checks are explicitly reader notes, not complete rendered graphs. No checker was executed."},{"sha":"6a769e2f8870f8710a4ed0e218294d7535f7a9e9","filename":"runs/online-ch2-prescient-euclidean-20261011/prepared-structural-v1/independent-prepared-helper-review-v1.json","status":"added","additions":57,"deletions":0,"changes":57,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Findependent-prepared-helper-review-v1.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Findependent-prepared-helper-review-v1.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Findependent-prepared-helper-review-v1.json?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1,57 @@\n+{\n+  \"utc\": \"2026-10-11T07:26:40.974616+00:00\",\n+  \"actor\": \"/root/adaptive_reviewer\",\n+  \"requested_model_effort\": \"GPT-6 Astra / medium; runtime not attested\",\n+  \"verdict\": \"repair-before-execution-approval\",\n+  \"inputs\": [\n+    {\n+      \"path\": \"tmp/online-ch2-prescient-euclidean-structural-20261011/check-prescient-structure-v3.py\",\n+      \"sha256\": \"5b3040e480afbc7119c359bbde06bf7c7664bd8053b0e1293969f9a1e1d3fb23\"\n+    },\n+    {\n+      \"path\": \"tmp/online-ch2-prescient-euclidean-structural-20261011/input-spec-prepared-v1.json\",\n+      \"sha256\": \"4531d771d23cc19884aa728abbce5b6da3a48e9691c4032d90d8f78eb7cd9154\"\n+    },\n+    {\n+      \"path\": \"tmp/online-ch2-prescient-euclidean-reader-qa-20261011/capture-prescient-euclidean-reader-v3.cjs\",\n+      \"sha256\": \"5c4d4e055d3b2cd25d2a378ea10bddb669064f845a09bfd02816bbb3059f05ee\"\n+    },\n+    {\n+      \"path\": \"tmp/online-ch2-prescient-euclidean-reader-qa-20261011/prepared-capture-proposal-v2.json\",\n+      \"sha256\": \"d437253f0cfd353c6e8bb7778406381aee209ab859c715e1a31142222b1747ce\"\n+    }\n+  ],\n+  \"blocking_repairs\": [\n+    {\n+      \"id\": \"Q1\",\n+      \"helper\": \"structural v3\",\n+      \"finding\": \"Existing RAW rows are byte-checked, but current full source path set is not freshly enumerated. Clean HEAD alone cannot detect incomplete captured selection.\",\n+      \"repair\": \"SHA-pin and reuse the reviewed recorder inventory selector with the captured run/owned-source inputs. Compare complete current path set and RAW hashes with post-source-inputs, retaining all five governance RAW/ZIP checks.\"\n+    },\n+    {\n+      \"id\": \"Q2\",\n+      \"helper\": \"reader v3\",\n+      \"finding\": \"A localhost URL and local registry location do not establish that HTTP content served came from that exact site directory. Current checks can accept a stale or modified page with matching checked text/source links.\",\n+      \"repair\": \"Compare original HTTP response bytes for chapter and each unique module page to exact local generated HTML files; also bind registry response/local bytes or explicit local registry hash and site HEAD to the reviewed structural/site receipt. Record these joins before DOM mutation/screenshots.\"\n+    }\n+  ],\n+  \"positive_checks\": [\n+    \"Old registry preservation is nonvacuous: exact11101 unique old nodes,11104 new, all complete objects equal and exact three full-name IDs.\",\n+    \"Three old content documents reconstructed after deleting only new card/module/three lessons; 21 old cards retained.\",\n+    \"Exact accepted core/Test hashes and three/two theorem counts plus BODY verdict joins.\",\n+    \"Five governance files required in RAW and ZIP, each archive byte and path set checked.\",\n+    \"Separate source topology and actual VALUE objects; unresolved author optimality and actual-run obligation retained. Geometry external Mathlib names checked independently even with empty project dependency links.\",\n+    \"Input spec ready=false and empty rendered-view checks correctly prevent execution. Successor reviewed execution spec must supply exact real reader-note markers, not invented graph pages.\",\n+    \"Isolated create-only Edge profile/output namespace; actual source lines and folded states; eight bounded panel screenshots and horizontal/vertical clipping checks; browser errors retained.\",\n+    \"Dependency text without links is honestly reported; no fake anchor success.\",\n+    \"No runtime gate/render success asserted; human original-pixel inspection still mandatory.\"\n+  ],\n+  \"limitations\": [\n+    \"Prepared spec normalization/manifest pins may require honest successor bindings after current normalization and one-field site repair; never rewrite old spec.\",\n+    \"Source/actual VALUE reader notes are bounded rendered representations, not independent interactive graph pages.\",\n+    \"Panel screenshots at1440px with adaptive height are desktop evidence only, not mobile/live/whole-site QA.\",\n+    \"Original independent source/body and sourcegap decisions remain unchanged; 7+6 and B4 open.\"\n+  ],\n+  \"execution_performed\": false,\n+  \"canonical_writes\": false\n+}"},{"sha":"4133fb440553a334b2bfbf6adda5d65fe7fa2f2e","filename":"runs/online-ch2-prescient-euclidean-20261011/prepared-structural-v1/independent-prepared-helper-review-v1.md","status":"added","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Findependent-prepared-helper-review-v1.md","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Findependent-prepared-helper-review-v1.md","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Findependent-prepared-helper-review-v1.md?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1 @@\n+Repair before execution approval: (Q1) re-enumerate the complete current RAW source path set through the pinned gate selector; (Q2) bind actual HTTP chapter/module response bytes to the exact local generated HTML before DOM mutation. Existing nonvacuous registry preservation, core/Test and five governance ZIP checks, isolated browser capture, source/VALUE distinction, and honest unlinked dependency reporting are sound. Prepared ready=false spec remains unexecuted. No package or chapter acceptance."},{"sha":"1c1a689d0eae8e905797dc0bb0fccafdeff0bd37","filename":"runs/online-ch2-prescient-euclidean-20261011/prepared-structural-v1/independent-prepared-structural-review-v2.json","status":"added","additions":18,"deletions":0,"changes":18,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Findependent-prepared-structural-review-v2.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Findependent-prepared-structural-review-v2.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Findependent-prepared-structural-review-v2.json?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1,18 @@\n+{\n+  \"utc\": \"2026-10-11T07:27:17.240718+00:00\",\n+  \"actor\": \"/root/adaptive_reviewer\",\n+  \"requested_model_effort\": \"GPT-6 Astra / medium; runtime not attested\",\n+  \"verdict\": \"accepted-prepared-structural-helper-only\",\n+  \"blocking_repairs\": [],\n+  \"approved_helper_sha256\": \"9972b600caf600bf36c53ecbc3208a03ee71c374ef16a9923e2fe6587a7f8d87\",\n+  \"supersedes_Q1_from\": \"independent-prepared-helper-review-v1.json\",\n+  \"Q1_resolution\": \"Exact successor diff adds pinned captured recorder hash, receipt root/excluded namespace checks, executes definitions under non-main name, freshly computes inventory with actual owned_source, requires exact current/pre/post row equality, and exact selected ZIP row equality. Reviewed recorder top level has imports/definitions and guarded main only; no run or pycache write is caused by the planned exec.\",\n+  \"execution_performed\": false,\n+  \"execution_prerequisites\": [\n+    \"Reviewed successor ready_for_execution=true spec binding final current metadata and actual rendered note markers\",\n+    \"Successful actual clean combined gate and matching site HEAD\",\n+    \"All five governance files retained explicitly in RAW and ZIP\"\n+  ],\n+  \"reader_Q2_still_open\": true,\n+  \"scope\": \"Structural helper design only; no actual output, site, pixels, package or chapter approval.\"\n+}"},{"sha":"e483cf56bcdfc8ffe8424efd30f7d626a293cd3a","filename":"runs/online-ch2-prescient-euclidean-20261011/prepared-structural-v1/independent-prepared-structural-review-v2.md","status":"added","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fprepared-structural-v1%2Findependent-prepared-structural-review-v2.md","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fon