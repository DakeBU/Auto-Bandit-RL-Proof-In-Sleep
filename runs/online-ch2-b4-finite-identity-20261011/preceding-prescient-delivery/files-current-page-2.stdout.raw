SOURCE_TOPOLOGY gate.\",\n+  \"source_join\": {\n+    \"approved_target_id_only\": \"later:lookahead/branch-03\",\n+    \"frozen_row_sha256\": \"083ed6fb0537459192d66fbecc3016621e079b8d4bf21d90a093ffb609aa4845\",\n+    \"frozen_row_unchanged\": true,\n+    \"candidate_join_sha256\": \"c59acb46bbbaf4bcae8de6b294e07f698ba421e8c90053701a7983b7a3093244\",\n+    \"meaning\": \"Explicit Euclidean specialization of conditional same actual run and both signed endpoints accepted at this bounded FINAL; parent may record separate append-only implementation reconciliation. No frozen inventory mutation.\",\n+    \"forward_container_delta\": 0,\n+    \"whole_forward_prescient_status\": \"OPEN\"\n+  },\n+  \"remaining_boundary\": {\n+    \"required_open_containers\": 7,\n+    \"future_claims_open\": 6,\n+    \"B4\": \"repair7.47/15.31 remain mandatory OPEN\",\n+    \"chapter2\": \"partial; accepted=false; denominator=null\",\n+    \"Goal\": \"ACTIVE retained boundary, no Goal tool queried\",\n+    \"publication\": \"No push/PR/main/live acceptance; isolated worktree retained\",\n+    \"purification\": \"pending\"\n+  },\n+  \"current_dirty_scope\": \"Before review, git status showed only new final-validation evidence subtree and port manifest. Source inputs remain exact candidate; review adds only this authorized create-only RUN receipt pair.\"\n+}"},{"sha":"58e0c03f9d029be09949a8515e45c26317883747","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/fresh-independent-final-review-v1.md","status":"added","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Ffresh-independent-final-review-v1.md","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Ffresh-independent-final-review-v1.md","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Ffresh-independent-final-review-v1.md?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1,7 @@\n+Accepted local-ready bounded prescient Euclidean package and local Exposition Seal; no blocking repairs.\n+\n+Candidate3b393adb009bc25a2c6e3fa3148bf9a3a2b4c376: all8gates actual0/integritytrue; root9123,Tests9305,474tests222.406s/7skips. Independently checked all91 exact port rows, re-enumerated1322RAW inputs for every gate, verified1315selected ZIP entries and all5governance files. Prior3core+2completecanary reviews remain bound to unchanged source;55+53 proof-evidence files and histories rehashed.\n+\n+Personally viewed all8original PNGs. Formula signs, half factors, endpoints, actualrun/attainment/global-support boundaries and source proof gap are clear.11101old registry objects/21old source cards/all other parsed content retained; only3nodes,1card,3lessons added. Dependency code names lack inline links; catalog context lives in adjacent lessons/whole-source links; source/VALUE notes are not full graphs. These are disclosed bounded presentation limits.\n+\n+Only later:lookahead/branch-03 is reconciled, frozen row unchanged. Whole forward prescient container remains OPEN;7containers+6futureclaims, B4, C2partial/null and GoalACTIVE unchanged. Original author optimality justification remains unresolved. Honest incremental protocol chronology preserved. PURIFIED, nativewholeloop, push/PR/main/live acceptance are not granted."},{"sha":"b163a07b37600b03094396759906047dca2b0dc6","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/combined-v2/capture-helper.py.txt","status":"added","additions":184,"deletions":0,"changes":184,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcombined-v2%2Fcapture-helper.py.txt","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcombined-v2%2Fcapture-helper.py.txt","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcombined-v2%2Fcapture-helper.py.txt?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1,184 @@\n+\"\"\"Gate recorder for prescient Euclidean and current-main governance, Python3.8 stdlib; no gate executed by preparation.\"\"\"\n+import argparse\n+import datetime\n+import hashlib\n+import json\n+import os\n+from pathlib import Path\n+import re\n+import subprocess\n+import sys\n+import zipfile\n+\n+\n+def utc():\n+    return datetime.datetime.now(datetime.timezone.utc).isoformat()\n+\n+\n+def digest(data):\n+    return hashlib.sha256(data).hexdigest()\n+\n+\n+def create(path, data):\n+    if not isinstance(data, bytes):\n+        data = (json.dumps(data, ensure_ascii=False, indent=2) + \"\\n\").encode(\"utf-8\")\n+    with path.open(\"xb\") as stream:\n+        stream.write(data)\n+\n+\n+def git(root, *args):\n+    proc = subprocess.run([\"git\"] + list(args), cwd=str(root), stdout=subprocess.PIPE,\n+                          stderr=subprocess.PIPE)\n+    if proc.returncode:\n+        raise RuntimeError(\"git failed: \" + repr(args) + \": \" + proc.stderr.decode(\"utf-8\", \"replace\"))\n+    return proc.stdout\n+\n+\n+def state(root):\n+    return {\"HEAD\": git(root, \"rev-parse\", \"HEAD\").decode().strip(),\n+            \"branch\": git(root, \"branch\", \"--show-current\").decode().strip(),\n+            \"status_porcelain_v1_z_hex\": git(root, \"status\", \"--porcelain=v1\", \"-z\").hex()}\n+\n+\n+def inventory(root, run, owned):\n+    # Start with tracked names, then explicitly filter to current source/input trees below.\n+    names = set(x.decode(\"utf-8\") for x in git(root, \"ls-files\", \"-z\", \"--cached\").split(b\"\\0\") if x)\n+    # Add new source paths, including ignored additions inside actual source trees.\n+    for folder in (\"BanditRLProof\", \"Tests\", \"tools\", \"website/scripts\", \"website/content\",\n+                   \"website/static\", \"research-wiki/contribution-contracts\"):\n+        for path in (root / folder).rglob(\"*\"):\n+            if path.is_file() and \"__pycache__\" not in path.parts:\n+                names.add(path.relative_to(root).as_posix())\n+    for name in (\"BanditRLProof.lean\", \"Tests.lean\", \"lean-toolchain\", \"lakefile.lean\",\n+                 \"lake-manifest.json\", \".gitattributes\"):\n+        names.add(name)\n+    names.update(owned)\n+    contract_roots = [name.rsplit(\"/\", 1)[0] for name in owned if name.startswith(\"docs/contracts/\")]\n+    extra = {\"README.md\", \"AGENTS.md\", \"CONTRIBUTING.md\", \"docs/contribution-contract.schema.json\", \"docs/contributor-codex-contract.md\", \"docs/theorem-publication-protocol.md\", \"docs/contracts/online-book-v1/coverage.json\", \"docs/proof-digestion-protocol.md\", \"docs/evidence-routed-memory-protocol.md\", \"docs/openai-math-assimilation-protocol.md\", \"research-wiki/openai-math-2026-intake.json\", \"runs/process_memory.json\"}\n+    names = {name for name in names if selected_for_zip(name, contract_roots) or name in extra}\n+    result = []\n+    for name in sorted(names):\n+        path = root / name\n+        resolved = path.resolve()\n+        if resolved == run or run in resolved.parents:\n+            continue\n+        if root not in resolved.parents or path.is_symlink() or not path.is_file():\n+            raise RuntimeError(\"Input must be an existing ordinary repository file: \" + name)\n+        data = path.read_bytes()\n+        result.append({\"path\": name, \"raw_sha256\": digest(data), \"bytes\": len(data)})\n+    return result\n+\n+\n+def selected_for_zip(name, contract_roots):\n+    # Historical runs are excluded from both selected RAW inventory and ZIP; clean HEAD binds them.\n+    if name == \"runs/process_memory.json\":\n+        return True\n+    if name.startswith(\"runs/\"):\n+        return False\n+    prefixes = (\"BanditRLProof/\", \"Tests/\", \"tools/\", \"website/scripts/\",\n+                \"website/content/\", \"website/static/\", \"research-wiki/contribution-contracts/\")\n+    exact = {\"BanditRLProof.lean\", \"Tests.lean\", \"lean-toolchain\", \"lakefile.lean\",\n+             \"lake-manifest.json\", \".gitattributes\", \"docs/proof-digestion-protocol.md\", \"docs/evidence-routed-memory-protocol.md\", \"docs/openai-math-assimilation-protocol.md\", \"research-wiki/openai-math-2026-intake.json\"}\n+    return (name in exact or name.startswith(prefixes) or\n+            any(name.startswith(folder.rstrip(\"/\") + \"/\") for folder in contract_roots))\n+\n+\n+def main():\n+    parser = argparse.ArgumentParser()\n+    parser.add_argument(\"--root\", required=True)\n+    parser.add_argument(\"--run\", required=True, help=\"New evidence namespace beneath runs/ or an already ignored tmp/ namespace\")\n+    parser.add_argument(\"--label\", required=True)\n+    parser.add_argument(\"--owned-source\", action=\"append\", default=[])\n+    parser.add_argument(\"--leaf-contract\", action=\"append\", required=True,\n+                        help=\"Current leaf docs/contracts subtree to include in ZIP\")\n+    parser.add_argument(\"argv\", nargs=argparse.REMAINDER)\n+    args = parser.parse_args()\n+    root = Path(args.root).resolve()\n+    run = (root / args.run).resolve()\n+    argv = args.argv[1:] if args.argv[:1] == [\"--\"] else args.argv\n+    if not argv or not re.fullmatch(r\"[A-Za-z0-9][A-Za-z0-9_.-]*\", args.label):\n+        raise RuntimeError(\"Exact argv and safe unique label required\")\n+    if root / \"runs\" not in run.parents and root / \"tmp\" not in run.parents:\n+        raise RuntimeError(\"Evidence namespace must be beneath root/runs/ or root/tmp/\")\n+    if root / \"tmp\" in run.parents:\n+        probe = run.relative_to(root).as_posix() + \"/.capture-ignore-probe\"\n+        result = subprocess.run([\"git\", \"check-ignore\", \"--quiet\", \"--\", probe],\n+                                cwd=str(root), stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n+        if result.returncode != 0:\n+            raise RuntimeError(\"tmp evidence namespace must already be ignored; no ignore rule changes permitted\")\n+    for folder in args.leaf_contract:\n+        resolved = (root / folder).resolve()\n+        if root / \"docs\" / \"contracts\" not in resolved.parents:\n+            raise RuntimeError(\"Leaf contract must be a docs/contracts subtree\")\n+        if not resolved.is_dir():\n+            raise RuntimeError(\"Leaf contract subtree missing\")\n+        args.owned_source.extend(path.relative_to(root).as_posix()\n+                                 for path in resolved.rglob(\"*\") if path.is_file())\n+    dest = run / args.label\n+    dest.mkdir(parents=True, exist_ok=False)\n+    helper = Path(__file__).resolve().read_bytes()\n+    create(dest / \"capture-helper.py.txt\", helper)\n+    record = {\"argv\": argv, \"cwd\": str(root), \"helper_sha256\": digest(helper),\n+              \"evidence_namespace_excluded\": run.relative_to(root).as_posix(),\n+              \"actual_evidence_namespace\": str(run),\n+              \"evidence_port_boundary\": \"Receipts originate here; any later exact copy into RUN requires a separate port manifest. No contemporaneous canonical RUN claim.\",\n+              \"owned_source\": args.owned_source, \"command_started\": False, \"actual_exit\": None,\n+              \"ZIP_is_whole_repository_archive\": False,\n+              \"ZIP_scope\": \"Selected active source/input trees and current leaf contracts; historical runs excluded; curated current runs/process_memory.json included\",\n+              \"full_RAW_inventory_scope\": \"Every library/Test source and enumerated current harness/site source/input tree plus current leaf contracts. Historical archives not separately RAW-hashed (curated current process memory is an active input); committed HEAD and clean Git status bind repository state.\",\n+              \"leaf_contract_roots\": args.leaf_contract}\n+    try:\n+        before = inventory(root, run, args.owned_source)\n+        record[\"pre_git\"] = state(root)\n+        if record[\"pre_git\"][\"status_porcelain_v1_z_hex\"]:\n+            raise RuntimeError(\"Clean committed candidate required before gate\")\n+        create(dest / \"pre-source-inputs.json\", before)\n+        selected = [row for row in before if selected_for_zip(row[\"path\"], args.leaf_contract)]\n+        create(dest / \"pre-selected-ZIP-inputs.json\", selected)\n+        record[\"ZIP_selected_files\"] = len(selected)\n+        record[\"full_RAW_inventory_files\"] = len(before)\n+        with zipfile.ZipFile(str(dest / \"pre-selected-source-raw.zip\"), \"x\", zipfile.ZIP_DEFLATED) as archive:\n+            for row in selected:\n+                data = (root / row[\"path\"]).read_bytes()\n+                if digest(data) != row[\"raw_sha256\"]:\n+                    raise RuntimeError(\"Source changed during snapshot: \" + row[\"path\"])\n+                archive.writestr(row[\"path\"], data)\n+        if any(digest((root / row[\"path\"]).read_bytes()) != row[\"raw_sha256\"] for row in selected):\n+            raise RuntimeError(\"Selected ZIP source changed before command\")\n+        if state(root) != record[\"pre_git\"]:\n+            raise RuntimeError(\"Git changed before command\")\n+        record[\"precommand_check\"] = \"Selected ZIP RAW hashes and Git state; no redundant second full inventory. Full pre/post manifests remain authoritative.\"\n+        record[\"start_utc\"] = utc()\n+        record[\"command_started\"] = True\n+        with (dest / \"stdout.raw\").open(\"xb\") as out, (dest / \"stderr.raw\").open(\"xb\") as err:\n+            proc = subprocess.run(argv, cwd=str(root), stdout=out, stderr=err,\n+                                  env=dict(os.environ, PYTHONDONTWRITEBYTECODE=\"1\"))\n+        record[\"end_utc\"] = utc()\n+        record[\"actual_exit\"] = proc.returncode\n+        after = inventory(root, run, args.owned_source)\n+        create(dest / \"post-source-inputs.json\", after)\n+        record[\"post_git\"] = state(root)\n+        record[\"complete_source_path_set_and_RAW_unchanged\"] = before == after\n+        record[\"HEAD_and_branch_unchanged\"] = all(record[\"pre_git\"][k] == record[\"post_git\"][k]\n+                                                 for k in (\"HEAD\", \"branch\"))\n+        record[\"git_status_unchanged\"] = record[\"pre_git\"] == record[\"post_git\"]\n+        record[\"capture_integrity_ok\"] = before == after and record[\"HEAD_and_branch_unchanged\"] and record[\"git_status_unchanged\"]\n+    except Exception as exc:\n+        record[\"capture_error\"] = repr(exc)\n+        record[\"capture_integrity_ok\"] = False\n+        record.setdefault(\"end_utc\", utc())\n+    for name in (\"stdout.raw\", \"stderr.raw\", \"pre-source-inputs.json\", \"post-source-inputs.json\",\n+                 \"pre-selected-ZIP-inputs.json\", \"pre-selected-source-raw.zip\"):\n+        path = dest / name\n+        if path.exists():\n+            record[name + \"_sha256\"] = digest(path.read_bytes())\n+    create(dest / \"receipt.json\", record)\n+    print(json.dumps({\"receipt\": str(dest / \"receipt.json\"), \"actual_exit\": record[\"actual_exit\"],\n+                      \"capture_integrity_ok\": record[\"capture_integrity_ok\"]}))\n+    if not record[\"capture_integrity_ok\"]:\n+        return 125\n+    return record[\"actual_exit\"] if record[\"actual_exit\"] is not None else 125\n+\n+\n+if __name__ == \"__main__\":\n+    sys.exit(main())"},{"sha":"74d390b9b1749b364d771643ff9d558adb6c7868","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/combined-v2/post-source-inputs.json","status":"added","additions":6612,"deletions":0,"changes":6612,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcombined-v2%2Fpost-source-inputs.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcombined-v2%2Fpost-source-inputs.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcombined-v2%2Fpost-source-inputs.json?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8"},{"sha":"034253c0b79ee0196f2eb8fefaf8a171bd4d2c22","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/combined-v2/pre-selected-ZIP-inputs.json","status":"added","additions":6577,"deletions":0,"changes":6577,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcombined-v2%2Fpre-selected-ZIP-inputs.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcombined-v2%2Fpre-selected-ZIP-inputs.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcombined-v2%2Fpre-selected-ZIP-inputs.json?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8"},{"sha":"1b2c96e9a2f72b6f9a8dc97794db9becbab0223b","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/combined-v2/pre-selected-source-raw.zip","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcombined-v2%2Fpre-selected-source-raw.zip","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcombined-v2%2Fpre-selected-source-raw.zip","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcombined-v2%2Fpre-selected-source-raw.zip?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8"},{"sha":"74d390b9b1749b364d771643ff9d558adb6c7868","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/combined-v2/pre-source-inputs.json","status":"added","additions":6612,"deletions":0,"changes":6612,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcombined-v2%2Fpre-source-inputs.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcombined-v2%2Fpre-source-inputs.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcombined-v2%2Fpre-source-inputs.json?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8"},{"sha":"ff563f9e02e5739d038a1e95956bac964f124899","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/combined-v2/receipt.json","status":"added","additions":67,"deletions":0,"changes":67,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcombined-v2%2Freceipt.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcombined-v2%2Freceipt.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcombined-v2%2Freceipt.json?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1,67 @@\n+{\n+  \"argv\": [\n+    \"python\",\n+    \"-X\",\n+    \"utf8\",\n+    \"tools/bandit.py\",\n+    \"check\"\n+  ],\n+  \"cwd\": \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\",\n+  \"helper_sha256\": \"d7d10142361f940c51712e7dd174dfae51ad768f65f87f26decd87d91faf58fc\",\n+  \"evidence_namespace_excluded\": \"tmp/online-ch2-prescient-euclidean-gates-20261011/actual-evidence-v2\",\n+  \"actual_evidence_namespace\": \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\\\\tmp\\\\online-ch2-prescient-euclidean-gates-20261011\\\\actual-evidence-v2\",\n+  \"evidence_port_boundary\": \"Receipts originate here; any later exact copy into RUN requires a separate port manifest. No contemporaneous canonical RUN claim.\",\n+  \"owned_source\": [\n+    \"docs/proof-digestion-protocol.md\",\n+    \"docs/evidence-routed-memory-protocol.md\",\n+    \"docs/openai-math-assimilation-protocol.md\",\n+    \"research-wiki/openai-math-2026-intake.json\",\n+    \"runs/process_memory.json\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/.gitattributes\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/canary-freeze-receipt-v1.json\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/independent-source-header-review-v1.json\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/leaf-freeze-receipt-v1.json\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-canary-additional-definitions-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-canary-imported-definitions-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-canary-standard-definitions-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-complete-canary-headers-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-headers-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-imported-definitions-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-standard-definitions-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/proof-digestion-record-v1.json\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/source-contract-proposal-v1.json\"\n+  ],\n+  \"command_started\": true,\n+  \"actual_exit\": 0,\n+  \"ZIP_is_whole_repository_archive\": false,\n+  \"ZIP_scope\": \"Selected active source/input trees and current leaf contracts; historical runs excluded; curated current runs/process_memory.json included\",\n+  \"full_RAW_inventory_scope\": \"Every library/Test source and enumerated current harness/site source/input tree plus current leaf contracts. Historical archives not separately RAW-hashed (curated current process memory is an active input); committed HEAD and clean Git status bind repository state.\",\n+  \"leaf_contract_roots\": [\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1\"\n+  ],\n+  \"pre_git\": {\n+    \"HEAD\": \"3b393adb009bc25a2c6e3fa3148bf9a3a2b4c376\",\n+    \"branch\": \"codex/research-online-ch2-prescient-euclidean\",\n+    \"status_porcelain_v1_z_hex\": \"\"\n+  },\n+  \"ZIP_selected_files\": 1315,\n+  \"full_RAW_inventory_files\": 1322,\n+  \"precommand_check\": \"Selected ZIP RAW hashes and Git state; no redundant second full inventory. Full pre/post manifests remain authoritative.\",\n+  \"start_utc\": \"2026-10-11T07:31:59.120790+00:00\",\n+  \"end_utc\": \"2026-10-11T07:36:39.529401+00:00\",\n+  \"post_git\": {\n+    \"HEAD\": \"3b393adb009bc25a2c6e3fa3148bf9a3a2b4c376\",\n+    \"branch\": \"codex/research-online-ch2-prescient-euclidean\",\n+    \"status_porcelain_v1_z_hex\": \"\"\n+  },\n+  \"complete_source_path_set_and_RAW_unchanged\": true,\n+  \"HEAD_and_branch_unchanged\": true,\n+  \"git_status_unchanged\": true,\n+  \"capture_integrity_ok\": true,\n+  \"stdout.raw_sha256\": \"3d4a4ab365b6c83a3f59d43459cf317d050b26b7f5eede6ab03df6e91f80ab51\",\n+  \"stderr.raw_sha256\": \"af59fe711ebdb264ec4eedb79c7f7bdd579c8f6f08d75426f286ba1eb6d5e324\",\n+  \"pre-source-inputs.json_sha256\": \"828ce3ae140230c56886f454f1b1f5d3c9bcda8d8dac36df67a3557c289b36c8\",\n+  \"post-source-inputs.json_sha256\": \"828ce3ae140230c56886f454f1b1f5d3c9bcda8d8dac36df67a3557c289b36c8\",\n+  \"pre-selected-ZIP-inputs.json_sha256\": \"6c8a331d600f505a29311729c4c9b44dcde803552709724cb433bc30e2045e5e\",\n+  \"pre-selected-source-raw.zip_sha256\": \"e8cfc81dbdd9c53d0d838ce9e5f471d9832c43c9c3f88de3369512e623f6962a\"\n+}"},{"sha":"f9acc1f9bee9660cc01d4c0c02906553417442d2","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/combined-v2/stderr.raw","status":"added","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcombined-v2%2Fstderr.raw","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcombined-v2%2Fstderr.raw","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcombined-v2%2Fstderr.raw?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1,5 @@\n+.......................................s..............................................................................................................................................................................................................................s.......s...............................................................................s.....................................................ss..........................s.........................................\r\n+----------------------------------------------------------------------\r\n+Ran 474 tests in 222.406s\r\n+\r\n+OK (skipped=7)\r"},{"sha":"1def828a5feef2d4a5b236b192d9dcabc59cfa7b","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/combined-v2/stdout.raw","status":"added","additions":39124,"deletions":0,"changes":39124,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcombined-v2%2Fstdout.raw","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcombined-v2%2Fstdout.raw","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcombined-v2%2Fstdout.raw?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8"},{"sha":"b163a07b37600b03094396759906047dca2b0dc6","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/contributor-v2/capture-helper.py.txt","status":"added","additions":184,"deletions":0,"changes":184,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcontributor-v2%2Fcapture-helper.py.txt","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcontributor-v2%2Fcapture-helper.py.txt","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcontributor-v2%2Fcapture-helper.py.txt?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1,184 @@\n+\"\"\"Gate recorder for prescient Euclidean and current-main governance, Python3.8 stdlib; no gate executed by preparation.\"\"\"\n+import argparse\n+import datetime\n+import hashlib\n+import json\n+import os\n+from pathlib import Path\n+import re\n+import subprocess\n+import sys\n+import zipfile\n+\n+\n+def utc():\n+    return datetime.datetime.now(datetime.timezone.utc).isoformat()\n+\n+\n+def digest(data):\n+    return hashlib.sha256(data).hexdigest()\n+\n+\n+def create(path, data):\n+    if not isinstance(data, bytes):\n+        data = (json.dumps(data, ensure_ascii=False, indent=2) + \"\\n\").encode(\"utf-8\")\n+    with path.open(\"xb\") as stream:\n+        stream.write(data)\n+\n+\n+def git(root, *args):\n+    proc = subprocess.run([\"git\"] + list(args), cwd=str(root), stdout=subprocess.PIPE,\n+                          stderr=subprocess.PIPE)\n+    if proc.returncode:\n+        raise RuntimeError(\"git failed: \" + repr(args) + \": \" + proc.stderr.decode(\"utf-8\", \"replace\"))\n+    return proc.stdout\n+\n+\n+def state(root):\n+    return {\"HEAD\": git(root, \"rev-parse\", \"HEAD\").decode().strip(),\n+            \"branch\": git(root, \"branch\", \"--show-current\").decode().strip(),\n+            \"status_porcelain_v1_z_hex\": git(root, \"status\", \"--porcelain=v1\", \"-z\").hex()}\n+\n+\n+def inventory(root, run, owned):\n+    # Start with tracked names, then explicitly filter to current source/input trees below.\n+    names = set(x.decode(\"utf-8\") for x in git(root, \"ls-files\", \"-z\", \"--cached\").split(b\"\\0\") if x)\n+    # Add new source paths, including ignored additions inside actual source trees.\n+    for folder in (\"BanditRLProof\", \"Tests\", \"tools\", \"website/scripts\", \"website/content\",\n+                   \"website/static\", \"research-wiki/contribution-contracts\"):\n+        for path in (root / folder).rglob(\"*\"):\n+            if path.is_file() and \"__pycache__\" not in path.parts:\n+                names.add(path.relative_to(root).as_posix())\n+    for name in (\"BanditRLProof.lean\", \"Tests.lean\", \"lean-toolchain\", \"lakefile.lean\",\n+                 \"lake-manifest.json\", \".gitattributes\"):\n+        names.add(name)\n+    names.update(owned)\n+    contract_roots = [name.rsplit(\"/\", 1)[0] for name in owned if name.startswith(\"docs/contracts/\")]\n+    extra = {\"README.md\", \"AGENTS.md\", \"CONTRIBUTING.md\", \"docs/contribution-contract.schema.json\", \"docs/contributor-codex-contract.md\", \"docs/theorem-publication-protocol.md\", \"docs/contracts/online-book-v1/coverage.json\", \"docs/proof-digestion-protocol.md\", \"docs/evidence-routed-memory-protocol.md\", \"docs/openai-math-assimilation-protocol.md\", \"research-wiki/openai-math-2026-intake.json\", \"runs/process_memory.json\"}\n+    names = {name for name in names if selected_for_zip(name, contract_roots) or name in extra}\n+    result = []\n+    for name in sorted(names):\n+        path = root / name\n+        resolved = path.resolve()\n+        if resolved == run or run in resolved.parents:\n+            continue\n+        if root not in resolved.parents or path.is_symlink() or not path.is_file():\n+            raise RuntimeError(\"Input must be an existing ordinary repository file: \" + name)\n+        data = path.read_bytes()\n+        result.append({\"path\": name, \"raw_sha256\": digest(data), \"bytes\": len(data)})\n+    return result\n+\n+\n+def selected_for_zip(name, contract_roots):\n+    # Historical runs are excluded from both selected RAW inventory and ZIP; clean HEAD binds them.\n+    if name == \"runs/process_memory.json\":\n+        return True\n+    if name.startswith(\"runs/\"):\n+        return False\n+    prefixes = (\"BanditRLProof/\", \"Tests/\", \"tools/\", \"website/scripts/\",\n+                \"website/content/\", \"website/static/\", \"research-wiki/contribution-contracts/\")\n+    exact = {\"BanditRLProof.lean\", \"Tests.lean\", \"lean-toolchain\", \"lakefile.lean\",\n+             \"lake-manifest.json\", \".gitattributes\", \"docs/proof-digestion-protocol.md\", \"docs/evidence-routed-memory-protocol.md\", \"docs/openai-math-assimilation-protocol.md\", \"research-wiki/openai-math-2026-intake.json\"}\n+    return (name in exact or name.startswith(prefixes) or\n+            any(name.startswith(folder.rstrip(\"/\") + \"/\") for folder in contract_roots))\n+\n+\n+def main():\n+    parser = argparse.ArgumentParser()\n+    parser.add_argument(\"--root\", required=True)\n+    parser.add_argument(\"--run\", required=True, help=\"New evidence namespace beneath runs/ or an already ignored tmp/ namespace\")\n+    parser.add_argument(\"--label\", required=True)\n+    parser.add_argument(\"--owned-source\", action=\"append\", default=[])\n+    parser.add_argument(\"--leaf-contract\", action=\"append\", required=True,\n+                        help=\"Current leaf docs/contracts subtree to include in ZIP\")\n+    parser.add_argument(\"argv\", nargs=argparse.REMAINDER)\n+    args = parser.parse_args()\n+    root = Path(args.root).resolve()\n+    run = (root / args.run).resolve()\n+    argv = args.argv[1:] if args.argv[:1] == [\"--\"] else args.argv\n+    if not argv or not re.fullmatch(r\"[A-Za-z0-9][A-Za-z0-9_.-]*\", args.label):\n+        raise RuntimeError(\"Exact argv and safe unique label required\")\n+    if root / \"runs\" not in run.parents and root / \"tmp\" not in run.parents:\n+        raise RuntimeError(\"Evidence namespace must be beneath root/runs/ or root/tmp/\")\n+    if root / \"tmp\" in run.parents:\n+        probe = run.relative_to(root).as_posix() + \"/.capture-ignore-probe\"\n+        result = subprocess.run([\"git\", \"check-ignore\", \"--quiet\", \"--\", probe],\n+                                cwd=str(root), stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n+        if result.returncode != 0:\n+            raise RuntimeError(\"tmp evidence namespace must already be ignored; no ignore rule changes permitted\")\n+    for folder in args.leaf_contract:\n+        resolved = (root / folder).resolve()\n+        if root / \"docs\" / \"contracts\" not in resolved.parents:\n+            raise RuntimeError(\"Leaf contract must be a docs/contracts subtree\")\n+        if not resolved.is_dir():\n+            raise RuntimeError(\"Leaf contract subtree missing\")\n+        args.owned_source.extend(path.relative_to(root).as_posix()\n+                                 for path in resolved.rglob(\"*\") if path.is_file())\n+    dest = run / args.label\n+    dest.mkdir(parents=True, exist_ok=False)\n+    helper = Path(__file__).resolve().read_bytes()\n+    create(dest / \"capture-helper.py.txt\", helper)\n+    record = {\"argv\": argv, \"cwd\": str(root), \"helper_sha256\": digest(helper),\n+              \"evidence_namespace_excluded\": run.relative_to(root).as_posix(),\n+              \"actual_evidence_namespace\": str(run),\n+              \"evidence_port_boundary\": \"Receipts originate here; any later exact copy into RUN requires a separate port manifest. No contemporaneous canonical RUN claim.\",\n+              \"owned_source\": args.owned_source, \"command_started\": False, \"actual_exit\": None,\n+              \"ZIP_is_whole_repository_archive\": False,\n+              \"ZIP_scope\": \"Selected active source/input trees and current leaf contracts; historical runs excluded; curated current runs/process_memory.json included\",\n+              \"full_RAW_inventory_scope\": \"Every library/Test source and enumerated current harness/site source/input tree plus current leaf contracts. Historical archives not separately RAW-hashed (curated current process memory is an active input); committed HEAD and clean Git status bind repository state.\",\n+              \"leaf_contract_roots\": args.leaf_contract}\n+    try:\n+        before = inventory(root, run, args.owned_source)\n+        record[\"pre_git\"] = state(root)\n+        if record[\"pre_git\"][\"status_porcelain_v1_z_hex\"]:\n+            raise RuntimeError(\"Clean committed candidate required before gate\")\n+        create(dest / \"pre-source-inputs.json\", before)\n+        selected = [row for row in before if selected_for_zip(row[\"path\"], args.leaf_contract)]\n+        create(dest / \"pre-selected-ZIP-inputs.json\", selected)\n+        record[\"ZIP_selected_files\"] = len(selected)\n+        record[\"full_RAW_inventory_files\"] = len(before)\n+        with zipfile.ZipFile(str(dest / \"pre-selected-source-raw.zip\"), \"x\", zipfile.ZIP_DEFLATED) as archive:\n+            for row in selected:\n+                data = (root / row[\"path\"]).read_bytes()\n+                if digest(data) != row[\"raw_sha256\"]:\n+                    raise RuntimeError(\"Source changed during snapshot: \" + row[\"path\"])\n+                archive.writestr(row[\"path\"], data)\n+        if any(digest((root / row[\"path\"]).read_bytes()) != row[\"raw_sha256\"] for row in selected):\n+            raise RuntimeError(\"Selected ZIP source changed before command\")\n+        if state(root) != record[\"pre_git\"]:\n+            raise RuntimeError(\"Git changed before command\")\n+        record[\"precommand_check\"] = \"Selected ZIP RAW hashes and Git state; no redundant second full inventory. Full pre/post manifests remain authoritative.\"\n+        record[\"start_utc\"] = utc()\n+        record[\"command_started\"] = True\n+        with (dest / \"stdout.raw\").open(\"xb\") as out, (dest / \"stderr.raw\").open(\"xb\") as err:\n+            proc = subprocess.run(argv, cwd=str(root), stdout=out, stderr=err,\n+                                  env=dict(os.environ, PYTHONDONTWRITEBYTECODE=\"1\"))\n+        record[\"end_utc\"] = utc()\n+        record[\"actual_exit\"] = proc.returncode\n+        after = inventory(root, run, args.owned_source)\n+        create(dest / \"post-source-inputs.json\", after)\n+        record[\"post_git\"] = state(root)\n+        record[\"complete_source_path_set_and_RAW_unchanged\"] = before == after\n+        record[\"HEAD_and_branch_unchanged\"] = all(record[\"pre_git\"][k] == record[\"post_git\"][k]\n+                                                 for k in (\"HEAD\", \"branch\"))\n+        record[\"git_status_unchanged\"] = record[\"pre_git\"] == record[\"post_git\"]\n+        record[\"capture_integrity_ok\"] = before == after and record[\"HEAD_and_branch_unchanged\"] and record[\"git_status_unchanged\"]\n+    except Exception as exc:\n+        record[\"capture_error\"] = repr(exc)\n+        record[\"capture_integrity_ok\"] = False\n+        record.setdefault(\"end_utc\", utc())\n+    for name in (\"stdout.raw\", \"stderr.raw\", \"pre-source-inputs.json\", \"post-source-inputs.json\",\n+                 \"pre-selected-ZIP-inputs.json\", \"pre-selected-source-raw.zip\"):\n+        path = dest / name\n+        if path.exists():\n+            record[name + \"_sha256\"] = digest(path.read_bytes())\n+    create(dest / \"receipt.json\", record)\n+    print(json.dumps({\"receipt\": str(dest / \"receipt.json\"), \"actual_exit\": record[\"actual_exit\"],\n+                      \"capture_integrity_ok\": record[\"capture_integrity_ok\"]}))\n+    if not record[\"capture_integrity_ok\"]:\n+        return 125\n+    return record[\"actual_exit\"] if record[\"actual_exit\"] is not None else 125\n+\n+\n+if __name__ == \"__main__\":\n+    sys.exit(main())"},{"sha":"74d390b9b1749b364d771643ff9d558adb6c7868","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/contributor-v2/post-source-inputs.json","status":"added","additions":6612,"deletions":0,"changes":6612,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcontributor-v2%2Fpost-source-inputs.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcontributor-v2%2Fpost-source-inputs.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcontributor-v2%2Fpost-source-inputs.json?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8"},{"sha":"034253c0b79ee0196f2eb8fefaf8a171bd4d2c22","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/contributor-v2/pre-selected-ZIP-inputs.json","status":"added","additions":6577,"deletions":0,"changes":6577,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcontributor-v2%2Fpre-selected-ZIP-inputs.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcontributor-v2%2Fpre-selected-ZIP-inputs.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcontributor-v2%2Fpre-selected-ZIP-inputs.json?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8"},{"sha":"184f7eeb3cf799456aa8e8c8782ae3e63183990c","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/contributor-v2/pre-selected-source-raw.zip","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcontributor-v2%2Fpre-selected-source-raw.zip","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcontributor-v2%2Fpre-selected-source-raw.zip","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcontributor-v2%2Fpre-selected-source-raw.zip?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8"},{"sha":"74d390b9b1749b364d771643ff9d558adb6c7868","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/contributor-v2/pre-source-inputs.json","status":"added","additions":6612,"deletions":0,"changes":6612,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcontributor-v2%2Fpre-source-inputs.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcontributor-v2%2Fpre-source-inputs.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcontributor-v2%2Fpre-source-inputs.json?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8"},{"sha":"48c3f88333c47dcca64e113cd9236457dee054c2","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/contributor-v2/receipt.json","status":"added","additions":68,"deletions":0,"changes":68,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcontributor-v2%2Freceipt.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcontributor-v2%2Freceipt.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcontributor-v2%2Freceipt.json?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1,68 @@\n+{\n+  \"argv\": [\n+    \"C:\\\\Users\\\\admin\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\python\\\\python.exe\",\n+    \"-X\",\n+    \"utf8\",\n+    \"tools/check_contributor_contract.py\",\n+    \"--base\",\n+    \"8045070bf1ee53c83778d04eb168f8ad6f728b59\"\n+  ],\n+  \"cwd\": \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\",\n+  \"helper_sha256\": \"d7d10142361f940c51712e7dd174dfae51ad768f65f87f26decd87d91faf58fc\",\n+  \"evidence_namespace_excluded\": \"tmp/online-ch2-prescient-euclidean-gates-20261011/actual-evidence-v2\",\n+  \"actual_evidence_namespace\": \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\\\\tmp\\\\online-ch2-prescient-euclidean-gates-20261011\\\\actual-evidence-v2\",\n+  \"evidence_port_boundary\": \"Receipts originate here; any later exact copy into RUN requires a separate port manifest. No contemporaneous canonical RUN claim.\",\n+  \"owned_source\": [\n+    \"docs/proof-digestion-protocol.md\",\n+    \"docs/evidence-routed-memory-protocol.md\",\n+    \"docs/openai-math-assimilation-protocol.md\",\n+    \"research-wiki/openai-math-2026-intake.json\",\n+    \"runs/process_memory.json\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/.gitattributes\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/canary-freeze-receipt-v1.json\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/independent-source-header-review-v1.json\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/leaf-freeze-receipt-v1.json\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-canary-additional-definitions-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-canary-imported-definitions-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-canary-standard-definitions-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-complete-canary-headers-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-headers-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-imported-definitions-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-standard-definitions-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/proof-digestion-record-v1.json\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/source-contract-proposal-v1.json\"\n+  ],\n+  \"command_started\": true,\n+  \"actual_exit\": 0,\n+  \"ZIP_is_whole_repository_archive\": false,\n+  \"ZIP_scope\": \"Selected active source/input trees and current leaf contracts; historical runs excluded; curated current runs/process_memory.json included\",\n+  \"full_RAW_inventory_scope\": \"Every library/Test source and enumerated current harness/site source/input tree plus current leaf contracts. Historical archives not separately RAW-hashed (curated current process memory is an active input); committed HEAD and clean Git status bind repository state.\",\n+  \"leaf_contract_roots\": [\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1\"\n+  ],\n+  \"pre_git\": {\n+    \"HEAD\": \"3b393adb009bc25a2c6e3fa3148bf9a3a2b4c376\",\n+    \"branch\": \"codex/research-online-ch2-prescient-euclidean\",\n+    \"status_porcelain_v1_z_hex\": \"\"\n+  },\n+  \"ZIP_selected_files\": 1315,\n+  \"full_RAW_inventory_files\": 1322,\n+  \"precommand_check\": \"Selected ZIP RAW hashes and Git state; no redundant second full inventory. Full pre/post manifests remain authoritative.\",\n+  \"start_utc\": \"2026-10-11T07:32:14.643341+00:00\",\n+  \"end_utc\": \"2026-10-11T07:32:14.865737+00:00\",\n+  \"post_git\": {\n+    \"HEAD\": \"3b393adb009bc25a2c6e3fa3148bf9a3a2b4c376\",\n+    \"branch\": \"codex/research-online-ch2-prescient-euclidean\",\n+    \"status_porcelain_v1_z_hex\": \"\"\n+  },\n+  \"complete_source_path_set_and_RAW_unchanged\": true,\n+  \"HEAD_and_branch_unchanged\": true,\n+  \"git_status_unchanged\": true,\n+  \"capture_integrity_ok\": true,\n+  \"stdout.raw_sha256\": \"35b4e257cd71ed2ca5546844253cffa2ba54a96f25e23122ea077d9fc0075977\",\n+  \"stderr.raw_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n+  \"pre-source-inputs.json_sha256\": \"828ce3ae140230c56886f454f1b1f5d3c9bcda8d8dac36df67a3557c289b36c8\",\n+  \"post-source-inputs.json_sha256\": \"828ce3ae140230c56886f454f1b1f5d3c9bcda8d8dac36df67a3557c289b36c8\",\n+  \"pre-selected-ZIP-inputs.json_sha256\": \"6c8a331d600f505a29311729c4c9b44dcde803552709724cb433bc30e2045e5e\",\n+  \"pre-selected-source-raw.zip_sha256\": \"11ca3d744daa0f5e9539832b9c15d5f6ef4bfc28197a0a7ae140417a28007933\"\n+}"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/contributor-v2/stderr.raw","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcontributor-v2%2Fstderr.raw","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcontributor-v2%2Fstderr.raw","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcontributor-v2%2Fstderr.raw?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8"},{"sha":"f3605c126a49312cc8b1c3705bf41c1be40b9a42","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/contributor-v2/stdout.raw","status":"added","additions":24,"deletions":0,"changes":24,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcontributor-v2%2Fstdout.raw","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcontributor-v2%2Fstdout.raw","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fcontributor-v2%2Fstdout.raw?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1,24 @@\n+contributor base: 8045070bf1ee53c83778d04eb168f8ad6f728b59\r\n+changed paths: 441\r\n+affected production paths: 19\r\n+changed contribution contracts: 3\r\n+Contributor contract passed.\r\n+ - covered: .agents/skills/bandit-substantive-advance/SKILL.md\r\n+ - covered: .github/workflows/contributor-contract.yml\r\n+ - covered: .github/workflows/documentation.yml\r\n+ - covered: AGENTS.md\r\n+ - covered: BanditRLProof.lean\r\n+ - covered: BanditRLProof/OnlinePrescientEuclidean.lean\r\n+ - covered: CONTRIBUTING.md\r\n+ - covered: docs/contribution-contract.schema.json\r\n+ - covered: docs/contributor-codex-contract.md\r\n+ - covered: docs/evidence-routed-memory-protocol.md\r\n+ - covered: docs/proof-digestion-protocol.md\r\n+ - covered: docs/theorem-publication-protocol.md\r\n+ - covered: runs/process_memory.json\r\n+ - covered: tools/check_contributor_contract.py\r\n+ - covered: tools/check_process_memory.py\r\n+ - covered: tools/test_process_memory.py\r\n+ - covered: website/content/chapters.json\r\n+ - covered: website/content/highlights.json\r\n+ - covered: website/content/readings.json\r"},{"sha":"b163a07b37600b03094396759906047dca2b0dc6","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/process-memory-v2/capture-helper.py.txt","status":"added","additions":184,"deletions":0,"changes":184,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fprocess-memory-v2%2Fcapture-helper.py.txt","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fprocess-memory-v2%2Fcapture-helper.py.txt","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fprocess-memory-v2%2Fcapture-helper.py.txt?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1,184 @@\n+\"\"\"Gate recorder for prescient Euclidean and current-main governance, Python3.8 stdlib; no gate executed by preparation.\"\"\"\n+import argparse\n+import datetime\n+import hashlib\n+import json\n+import os\n+from pathlib import Path\n+import re\n+import subprocess\n+import sys\n+import zipfile\n+\n+\n+def utc():\n+    return datetime.datetime.now(datetime.timezone.utc).isoformat()\n+\n+\n+def digest(data):\n+    return hashlib.sha256(data).hexdigest()\n+\n+\n+def create(path, data):\n+    if not isinstance(data, bytes):\n+        data = (json.dumps(data, ensure_ascii=False, indent=2) + \"\\n\").encode(\"utf-8\")\n+    with path.open(\"xb\") as stream:\n+        stream.write(data)\n+\n+\n+def git(root, *args):\n+    proc = subprocess.run([\"git\"] + list(args), cwd=str(root), stdout=subprocess.PIPE,\n+                          stderr=subprocess.PIPE)\n+    if proc.returncode:\n+        raise RuntimeError(\"git failed: \" + repr(args) + \": \" + proc.stderr.decode(\"utf-8\", \"replace\"))\n+    return proc.stdout\n+\n+\n+def state(root):\n+    return {\"HEAD\": git(root, \"rev-parse\", \"HEAD\").decode().strip(),\n+            \"branch\": git(root, \"branch\", \"--show-current\").decode().strip(),\n+            \"status_porcelain_v1_z_hex\": git(root, \"status\", \"--porcelain=v1\", \"-z\").hex()}\n+\n+\n+def inventory(root, run, owned):\n+    # Start with tracked names, then explicitly filter to current source/input trees below.\n+    names = set(x.decode(\"utf-8\") for x in git(root, \"ls-files\", \"-z\", \"--cached\").split(b\"\\0\") if x)\n+    # Add new source paths, including ignored additions inside actual source trees.\n+    for folder in (\"BanditRLProof\", \"Tests\", \"tools\", \"website/scripts\", \"website/content\",\n+                   \"website/static\", \"research-wiki/contribution-contracts\"):\n+        for path in (root / folder).rglob(\"*\"):\n+            if path.is_file() and \"__pycache__\" not in path.parts:\n+                names.add(path.relative_to(root).as_posix())\n+    for name in (\"BanditRLProof.lean\", \"Tests.lean\", \"lean-toolchain\", \"lakefile.lean\",\n+                 \"lake-manifest.json\", \".gitattributes\"):\n+        names.add(name)\n+    names.update(owned)\n+    contract_roots = [name.rsplit(\"/\", 1)[0] for name in owned if name.startswith(\"docs/contracts/\")]\n+    extra = {\"README.md\", \"AGENTS.md\", \"CONTRIBUTING.md\", \"docs/contribution-contract.schema.json\", \"docs/contributor-codex-contract.md\", \"docs/theorem-publication-protocol.md\", \"docs/contracts/online-book-v1/coverage.json\", \"docs/proof-digestion-protocol.md\", \"docs/evidence-routed-memory-protocol.md\", \"docs/openai-math-assimilation-protocol.md\", \"research-wiki/openai-math-2026-intake.json\", \"runs/process_memory.json\"}\n+    names = {name for name in names if selected_for_zip(name, contract_roots) or name in extra}\n+    result = []\n+    for name in sorted(names):\n+        path = root / name\n+        resolved = path.resolve()\n+        if resolved == run or run in resolved.parents:\n+            continue\n+        if root not in resolved.parents or path.is_symlink() or not path.is_file():\n+            raise RuntimeError(\"Input must be an existing ordinary repository file: \" + name)\n+        data = path.read_bytes()\n+        result.append({\"path\": name, \"raw_sha256\": digest(data), \"bytes\": len(data)})\n+    return result\n+\n+\n+def selected_for_zip(name, contract_roots):\n+    # Historical runs are excluded from both selected RAW inventory and ZIP; clean HEAD binds them.\n+    if name == \"runs/process_memory.json\":\n+        return True\n+    if name.startswith(\"runs/\"):\n+        return False\n+    prefixes = (\"BanditRLProof/\", \"Tests/\", \"tools/\", \"website/scripts/\",\n+                \"website/content/\", \"website/static/\", \"research-wiki/contribution-contracts/\")\n+    exact = {\"BanditRLProof.lean\", \"Tests.lean\", \"lean-toolchain\", \"lakefile.lean\",\n+             \"lake-manifest.json\", \".gitattributes\", \"docs/proof-digestion-protocol.md\", \"docs/evidence-routed-memory-protocol.md\", \"docs/openai-math-assimilation-protocol.md\", \"research-wiki/openai-math-2026-intake.json\"}\n+    return (name in exact or name.startswith(prefixes) or\n+            any(name.startswith(folder.rstrip(\"/\") + \"/\") for folder in contract_roots))\n+\n+\n+def main():\n+    parser = argparse.ArgumentParser()\n+    parser.add_argument(\"--root\", required=True)\n+    parser.add_argument(\"--run\", required=True, help=\"New evidence namespace beneath runs/ or an already ignored tmp/ namespace\")\n+    parser.add_argument(\"--label\", required=True)\n+    parser.add_argument(\"--owned-source\", action=\"append\", default=[])\n+    parser.add_argument(\"--leaf-contract\", action=\"append\", required=True,\n+                        help=\"Current leaf docs/contracts subtree to include in ZIP\")\n+    parser.add_argument(\"argv\", nargs=argparse.REMAINDER)\n+    args = parser.parse_args()\n+    root = Path(args.root).resolve()\n+    run = (root / args.run).resolve()\n+    argv = args.argv[1:] if args.argv[:1] == [\"--\"] else args.argv\n+    if not argv or not re.fullmatch(r\"[A-Za-z0-9][A-Za-z0-9_.-]*\", args.label):\n+        raise RuntimeError(\"Exact argv and safe unique label required\")\n+    if root / \"runs\" not in run.parents and root / \"tmp\" not in run.parents:\n+        raise RuntimeError(\"Evidence namespace must be beneath root/runs/ or root/tmp/\")\n+    if root / \"tmp\" in run.parents:\n+        probe = run.relative_to(root).as_posix() + \"/.capture-ignore-probe\"\n+        result = subprocess.run([\"git\", \"check-ignore\", \"--quiet\", \"--\", probe],\n+                                cwd=str(root), stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n+        if result.returncode != 0:\n+            raise RuntimeError(\"tmp evidence namespace must already be ignored; no ignore rule changes permitted\")\n+    for folder in args.leaf_contract:\n+        resolved = (root / folder).resolve()\n+        if root / \"docs\" / \"contracts\" not in resolved.parents:\n+            raise RuntimeError(\"Leaf contract must be a docs/contracts subtree\")\n+        if not resolved.is_dir():\n+            raise RuntimeError(\"Leaf contract subtree missing\")\n+        args.owned_source.extend(path.relative_to(root).as_posix()\n+                                 for path in resolved.rglob(\"*\") if path.is_file())\n+    dest = run / args.label\n+    dest.mkdir(parents=True, exist_ok=False)\n+    helper = Path(__file__).resolve().read_bytes()\n+    create(dest / \"capture-helper.py.txt\", helper)\n+    record = {\"argv\": argv, \"cwd\": str(root), \"helper_sha256\": digest(helper),\n+              \"evidence_namespace_excluded\": run.relative_to(root).as_posix(),\n+              \"actual_evidence_namespace\": str(run),\n+              \"evidence_port_boundary\": \"Receipts originate here; any later exact copy into RUN requires a separate port manifest. No contemporaneous canonical RUN claim.\",\n+              \"owned_source\": args.owned_source, \"command_started\": False, \"actual_exit\": None,\n+              \"ZIP_is_whole_repository_archive\": False,\n+              \"ZIP_scope\": \"Selected active source/input trees and current leaf contracts; historical runs excluded; curated current runs/process_memory.json included\",\n+              \"full_RAW_inventory_scope\": \"Every library/Test source and enumerated current harness/site source/input tree plus current leaf contracts. Historical archives not separately RAW-hashed (curated current process memory is an active input); committed HEAD and clean Git status bind repository state.\",\n+              \"leaf_contract_roots\": args.leaf_contract}\n+    try:\n+        before = inventory(root, run, args.owned_source)\n+        record[\"pre_git\"] = state(root)\n+        if record[\"pre_git\"][\"status_porcelain_v1_z_hex\"]:\n+            raise RuntimeError(\"Clean committed candidate required before gate\")\n+        create(dest / \"pre-source-inputs.json\", before)\n+        selected = [row for row in before if selected_for_zip(row[\"path\"], args.leaf_contract)]\n+        create(dest / \"pre-selected-ZIP-inputs.json\", selected)\n+        record[\"ZIP_selected_files\"] = len(selected)\n+        record[\"full_RAW_inventory_files\"] = len(before)\n+        with zipfile.ZipFile(str(dest / \"pre-selected-source-raw.zip\"), \"x\", zipfile.ZIP_DEFLATED) as archive:\n+            for row in selected:\n+                data = (root / row[\"path\"]).read_bytes()\n+                if digest(data) != row[\"raw_sha256\"]:\n+                    raise RuntimeError(\"Source changed during snapshot: \" + row[\"path\"])\n+                archive.writestr(row[\"path\"], data)\n+        if any(digest((root / row[\"path\"]).read_bytes()) != row[\"raw_sha256\"] for row in selected):\n+            raise RuntimeError(\"Selected ZIP source changed before command\")\n+        if state(root) != record[\"pre_git\"]:\n+            raise RuntimeError(\"Git changed before command\")\n+        record[\"precommand_check\"] = \"Selected ZIP RAW hashes and Git state; no redundant second full inventory. Full pre/post manifests remain authoritative.\"\n+        record[\"start_utc\"] = utc()\n+        record[\"command_started\"] = True\n+        with (dest / \"stdout.raw\").open(\"xb\") as out, (dest / \"stderr.raw\").open(\"xb\") as err:\n+            proc = subprocess.run(argv, cwd=str(root), stdout=out, stderr=err,\n+                                  env=dict(os.environ, PYTHONDONTWRITEBYTECODE=\"1\"))\n+        record[\"end_utc\"] = utc()\n+        record[\"actual_exit\"] = proc.returncode\n+        after = inventory(root, run, args.owned_source)\n+        create(dest / \"post-source-inputs.json\", after)\n+        record[\"post_git\"] = state(root)\n+        record[\"complete_source_path_set_and_RAW_unchanged\"] = before == after\n+        record[\"HEAD_and_branch_unchanged\"] = all(record[\"pre_git\"][k] == record[\"post_git\"][k]\n+                                                 for k in (\"HEAD\", \"branch\"))\n+        record[\"git_status_unchanged\"] = record[\"pre_git\"] == record[\"post_git\"]\n+        record[\"capture_integrity_ok\"] = before == after and record[\"HEAD_and_branch_unchanged\"] and record[\"git_status_unchanged\"]\n+    except Exception as exc:\n+        record[\"capture_error\"] = repr(exc)\n+        record[\"capture_integrity_ok\"] = False\n+        record.setdefault(\"end_utc\", utc())\n+    for name in (\"stdout.raw\", \"stderr.raw\", \"pre-source-inputs.json\", \"post-source-inputs.json\",\n+                 \"pre-selected-ZIP-inputs.json\", \"pre-selected-source-raw.zip\"):\n+        path = dest / name\n+        if path.exists():\n+            record[name + \"_sha256\"] = digest(path.read_bytes())\n+    create(dest / \"receipt.json\", record)\n+    print(json.dumps({\"receipt\": str(dest / \"receipt.json\"), \"actual_exit\": record[\"actual_exit\"],\n+                      \"capture_integrity_ok\": record[\"capture_integrity_ok\"]}))\n+    if not record[\"capture_integrity_ok\"]:\n+        return 125\n+    return record[\"actual_exit\"] if record[\"actual_exit\"] is not None else 125\n+\n+\n+if __name__ == \"__main__\":\n+    sys.exit(main())"},{"sha":"74d390b9b1749b364d771643ff9d558adb6c7868","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/process-memory-v2/post-source-inputs.json","status":"added","additions":6612,"deletions":0,"changes":6612,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fprocess-memory-v2%2Fpost-source-inputs.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fprocess-memory-v2%2Fpost-source-inputs.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fprocess-memory-v2%2Fpost-source-inputs.json?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8"},{"sha":"034253c0b79ee0196f2eb8fefaf8a171bd4d2c22","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/process-memory-v2/pre-selected-ZIP-inputs.json","status":"added","additions":6577,"deletions":0,"changes":6577,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fprocess-memory-v2%2Fpre-selected-ZIP-inputs.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fprocess-memory-v2%2Fpre-selected-ZIP-inputs.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fprocess-memory-v2%2Fpre-selected-ZIP-inputs.json?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8"},{"sha":"27c0e79e1321a2f84f064d95d4dfe0585aa45dfd","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/process-memory-v2/pre-selected-source-raw.zip","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fprocess-memory-v2%2Fpre-selected-source-raw.zip","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fprocess-memory-v2%2Fpre-selected-source-raw.zip","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fprocess-memory-v2%2Fpre-selected-source-raw.zip?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8"},{"sha":"74d390b9b1749b364d771643ff9d558adb6c7868","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/process-memory-v2/pre-source-inputs.json","status":"added","additions":6612,"deletions":0,"changes":6612,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fprocess-memory-v2%2Fpre-source-inputs.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fprocess-memory-v2%2Fpre-source-inputs.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fprocess-memory-v2%2Fpre-source-inputs.json?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8"},{"sha":"650fbb10785a49fd46061c147f1556ab2bd65edf","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/process-memory-v2/receipt.json","status":"added","additions":67,"deletions":0,"changes":67,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fprocess-memory-v2%2Freceipt.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fprocess-memory-v2%2Freceipt.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fprocess-memory-v2%2Freceipt.json?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1,67 @@\n+{\n+  \"argv\": [\n+    \"C:\\\\Users\\\\admin\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\python\\\\python.exe\",\n+    \"-X\",\n+    \"utf8\",\n+    \"tools/check_process_memory.py\",\n+    \"check\"\n+  ],\n+  \"cwd\": \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\",\n+  \"helper_sha256\": \"d7d10142361f940c51712e7dd174dfae51ad768f65f87f26decd87d91faf58fc\",\n+  \"evidence_namespace_excluded\": \"tmp/online-ch2-prescient-euclidean-gates-20261011/actual-evidence-v2\",\n+  \"actual_evidence_namespace\": \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\\\\tmp\\\\online-ch2-prescient-euclidean-gates-20261011\\\\actual-evidence-v2\",\n+  \"evidence_port_boundary\": \"Receipts originate here; any later exact copy into RUN requires a separate port manifest. No contemporaneous canonical RUN claim.\",\n+  \"owned_source\": [\n+    \"docs/proof-digestion-protocol.md\",\n+    \"docs/evidence-routed-memory-protocol.md\",\n+    \"docs/openai-math-assimilation-protocol.md\",\n+    \"research-wiki/openai-math-2026-intake.json\",\n+    \"runs/process_memory.json\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/.gitattributes\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/canary-freeze-receipt-v1.json\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/independent-source-header-review-v1.json\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/leaf-freeze-receipt-v1.json\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-canary-additional-definitions-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-canary-imported-definitions-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-canary-standard-definitions-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-complete-canary-headers-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-headers-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-imported-definitions-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-standard-definitions-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/proof-digestion-record-v1.json\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/source-contract-proposal-v1.json\"\n+  ],\n+  \"command_started\": true,\n+  \"actual_exit\": 0,\n+  \"ZIP_is_whole_repository_archive\": false,\n+  \"ZIP_scope\": \"Selected active source/input trees and current leaf contracts; historical runs excluded; curated current runs/process_memory.json included\",\n+  \"full_RAW_inventory_scope\": \"Every library/Test source and enumerated current harness/site source/input tree plus current leaf contracts. Historical archives not separately RAW-hashed (curated current process memory is an active input); committed HEAD and clean Git status bind repository state.\",\n+  \"leaf_contract_roots\": [\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1\"\n+  ],\n+  \"pre_git\": {\n+    \"HEAD\": \"3b393adb009bc25a2c6e3fa3148bf9a3a2b4c376\",\n+    \"branch\": \"codex/research-online-ch2-prescient-euclidean\",\n+    \"status_porcelain_v1_z_hex\": \"\"\n+  },\n+  \"ZIP_selected_files\": 1315,\n+  \"full_RAW_inventory_files\": 1322,\n+  \"precommand_check\": \"Selected ZIP RAW hashes and Git state; no redundant second full inventory. Full pre/post manifests remain authoritative.\",\n+  \"start_utc\": \"2026-10-11T07:32:14.932363+00:00\",\n+  \"end_utc\": \"2026-10-11T07:32:14.998222+00:00\",\n+  \"post_git\": {\n+    \"HEAD\": \"3b393adb009bc25a2c6e3fa3148bf9a3a2b4c376\",\n+    \"branch\": \"codex/research-online-ch2-prescient-euclidean\",\n+    \"status_porcelain_v1_z_hex\": \"\"\n+  },\n+  \"complete_source_path_set_and_RAW_unchanged\": true,\n+  \"HEAD_and_branch_unchanged\": true,\n+  \"git_status_unchanged\": true,\n+  \"capture_integrity_ok\": true,\n+  \"stdout.raw_sha256\": \"9eaf787390c5f1bf4dea8a4f7b1cf06937163fda2f17afdffafddbb4672c10bb\",\n+  \"stderr.raw_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n+  \"pre-source-inputs.json_sha256\": \"828ce3ae140230c56886f454f1b1f5d3c9bcda8d8dac36df67a3557c289b36c8\",\n+  \"post-source-inputs.json_sha256\": \"828ce3ae140230c56886f454f1b1f5d3c9bcda8d8dac36df67a3557c289b36c8\",\n+  \"pre-selected-ZIP-inputs.json_sha256\": \"6c8a331d600f505a29311729c4c9b44dcde803552709724cb433bc30e2045e5e\",\n+  \"pre-selected-source-raw.zip_sha256\": \"9c0e719fbf603ddeea5226a23476f4f9390ea8e42fa072bd60d180c0aa0e92b5\"\n+}"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/process-memory-v2/stderr.raw","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fprocess-memory-v2%2Fstderr.raw","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fprocess-memory-v2%2Fstderr.raw","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fprocess-memory-v2%2Fstderr.raw?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8"},{"sha":"4de0e2ffd6bbf9f721bcbcf29fc62cc08edf6eba","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/process-memory-v2/stdout.raw","status":"added","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fprocess-memory-v2%2Fstdout.raw","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fprocess-memory-v2%2Fstdout.raw","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fprocess-memory-v2%2Fstdout.raw?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1 @@\n+BanditRLlib process-memory check passed\r"},{"sha":"b163a07b37600b03094396759906047dca2b0dc6","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/render-v1/capture-helper.py.txt","status":"added","additions":184,"deletions":0,"changes":184,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Frender-v1%2Fcapture-helper.py.txt","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Frender-v1%2Fcapture-helper.py.txt","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Frender-v1%2Fcapture-helper.py.txt?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1,184 @@\n+\"\"\"Gate recorder for prescient Euclidean and current-main governance, Python3.8 stdlib; no gate executed by preparation.\"\"\"\n+import argparse\n+import datetime\n+import hashlib\n+import json\n+import os\n+from pathlib import Path\n+import re\n+import subprocess\n+import sys\n+import zipfile\n+\n+\n+def utc():\n+    return datetime.datetime.now(datetime.timezone.utc).isoformat()\n+\n+\n+def digest(data):\n+    return hashlib.sha256(data).hexdigest()\n+\n+\n+def create(path, data):\n+    if not isinstance(data, bytes):\n+        data = (json.dumps(data, ensure_ascii=False, indent=2) + \"\\n\").encode(\"utf-8\")\n+    with path.open(\"xb\") as stream:\n+        stream.write(data)\n+\n+\n+def git(root, *args):\n+    proc = subprocess.run([\"git\"] + list(args), cwd=str(root), stdout=subprocess.PIPE,\n+                          stderr=subprocess.PIPE)\n+    if proc.returncode:\n+        raise RuntimeError(\"git failed: \" + repr(args) + \": \" + proc.stderr.decode(\"utf-8\", \"replace\"))\n+    return proc.stdout\n+\n+\n+def state(root):\n+    return {\"HEAD\": git(root, \"rev-parse\", \"HEAD\").decode().strip(),\n+            \"branch\": git(root, \"branch\", \"--show-current\").decode().strip(),\n+            \"status_porcelain_v1_z_hex\": git(root, \"status\", \"--porcelain=v1\", \"-z\").hex()}\n+\n+\n+def inventory(root, run, owned):\n+    # Start with tracked names, then explicitly filter to current source/input trees below.\n+    names = set(x.decode(\"utf-8\") for x in git(root, \"ls-files\", \"-z\", \"--cached\").split(b\"\\0\") if x)\n+    # Add new source paths, including ignored additions inside actual source trees.\n+    for folder in (\"BanditRLProof\", \"Tests\", \"tools\", \"website/scripts\", \"website/content\",\n+                   \"website/static\", \"research-wiki/contribution-contracts\"):\n+        for path in (root / folder).rglob(\"*\"):\n+            if path.is_file() and \"__pycache__\" not in path.parts:\n+                names.add(path.relative_to(root).as_posix())\n+    for name in (\"BanditRLProof.lean\", \"Tests.lean\", \"lean-toolchain\", \"lakefile.lean\",\n+                 \"lake-manifest.json\", \".gitattributes\"):\n+        names.add(name)\n+    names.update(owned)\n+    contract_roots = [name.rsplit(\"/\", 1)[0] for name in owned if name.startswith(\"docs/contracts/\")]\n+    extra = {\"README.md\", \"AGENTS.md\", \"CONTRIBUTING.md\", \"docs/contribution-contract.schema.json\", \"docs/contributor-codex-contract.md\", \"docs/theorem-publication-protocol.md\", \"docs/contracts/online-book-v1/coverage.json\", \"docs/proof-digestion-protocol.md\", \"docs/evidence-routed-memory-protocol.md\", \"docs/openai-math-assimilation-protocol.md\", \"research-wiki/openai-math-2026-intake.json\", \"runs/process_memory.json\"}\n+    names = {name for name in names if selected_for_zip(name, contract_roots) or name in extra}\n+    result = []\n+    for name in sorted(names):\n+        path = root / name\n+        resolved = path.resolve()\n+        if resolved == run or run in resolved.parents:\n+            continue\n+        if root not in resolved.parents or path.is_symlink() or not path.is_file():\n+            raise RuntimeError(\"Input must be an existing ordinary repository file: \" + name)\n+        data = path.read_bytes()\n+        result.append({\"path\": name, \"raw_sha256\": digest(data), \"bytes\": len(data)})\n+    return result\n+\n+\n+def selected_for_zip(name, contract_roots):\n+    # Historical runs are excluded from both selected RAW inventory and ZIP; clean HEAD binds them.\n+    if name == \"runs/process_memory.json\":\n+        return True\n+    if name.startswith(\"runs/\"):\n+        return False\n+    prefixes = (\"BanditRLProof/\", \"Tests/\", \"tools/\", \"website/scripts/\",\n+                \"website/content/\", \"website/static/\", \"research-wiki/contribution-contracts/\")\n+    exact = {\"BanditRLProof.lean\", \"Tests.lean\", \"lean-toolchain\", \"lakefile.lean\",\n+             \"lake-manifest.json\", \".gitattributes\", \"docs/proof-digestion-protocol.md\", \"docs/evidence-routed-memory-protocol.md\", \"docs/openai-math-assimilation-protocol.md\", \"research-wiki/openai-math-2026-intake.json\"}\n+    return (name in exact or name.startswith(prefixes) or\n+            any(name.startswith(folder.rstrip(\"/\") + \"/\") for folder in contract_roots))\n+\n+\n+def main():\n+    parser = argparse.ArgumentParser()\n+    parser.add_argument(\"--root\", required=True)\n+    parser.add_argument(\"--run\", required=True, help=\"New evidence namespace beneath runs/ or an already ignored tmp/ namespace\")\n+    parser.add_argument(\"--label\", required=True)\n+    parser.add_argument(\"--owned-source\", action=\"append\", default=[])\n+    parser.add_argument(\"--leaf-contract\", action=\"append\", required=True,\n+                        help=\"Current leaf docs/contracts subtree to include in ZIP\")\n+    parser.add_argument(\"argv\", nargs=argparse.REMAINDER)\n+    args = parser.parse_args()\n+    root = Path(args.root).resolve()\n+    run = (root / args.run).resolve()\n+    argv = args.argv[1:] if args.argv[:1] == [\"--\"] else args.argv\n+    if not argv or not re.fullmatch(r\"[A-Za-z0-9][A-Za-z0-9_.-]*\", args.label):\n+        raise RuntimeError(\"Exact argv and safe unique label required\")\n+    if root / \"runs\" not in run.parents and root / \"tmp\" not in run.parents:\n+        raise RuntimeError(\"Evidence namespace must be beneath root/runs/ or root/tmp/\")\n+    if root / \"tmp\" in run.parents:\n+        probe = run.relative_to(root).as_posix() + \"/.capture-ignore-probe\"\n+        result = subprocess.run([\"git\", \"check-ignore\", \"--quiet\", \"--\", probe],\n+                                cwd=str(root), stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n+        if result.returncode != 0:\n+            raise RuntimeError(\"tmp evidence namespace must already be ignored; no ignore rule changes permitted\")\n+    for folder in args.leaf_contract:\n+        resolved = (root / folder).resolve()\n+        if root / \"docs\" / \"contracts\" not in resolved.parents:\n+            raise RuntimeError(\"Leaf contract must be a docs/contracts subtree\")\n+        if not resolved.is_dir():\n+            raise RuntimeError(\"Leaf contract subtree missing\")\n+        args.owned_source.extend(path.relative_to(root).as_posix()\n+                                 for path in resolved.rglob(\"*\") if path.is_file())\n+    dest = run / args.label\n+    dest.mkdir(parents=True, exist_ok=False)\n+    helper = Path(__file__).resolve().read_bytes()\n+    create(dest / \"capture-helper.py.txt\", helper)\n+    record = {\"argv\": argv, \"cwd\": str(root), \"helper_sha256\": digest(helper),\n+              \"evidence_namespace_excluded\": run.relative_to(root).as_posix(),\n+              \"actual_evidence_namespace\": str(run),\n+              \"evidence_port_boundary\": \"Receipts originate here; any later exact copy into RUN requires a separate port manifest. No contemporaneous canonical RUN claim.\",\n+              \"owned_source\": args.owned_source, \"command_started\": False, \"actual_exit\": None,\n+              \"ZIP_is_whole_repository_archive\": False,\n+              \"ZIP_scope\": \"Selected active source/input trees and current leaf contracts; historical runs excluded; curated current runs/process_memory.json included\",\n+              \"full_RAW_inventory_scope\": \"Every library/Test source and enumerated current harness/site source/input tree plus current leaf contracts. Historical archives not separately RAW-hashed (curated current process memory is an active input); committed HEAD and clean Git status bind repository state.\",\n+              \"leaf_contract_roots\": args.leaf_contract}\n+    try:\n+        before = inventory(root, run, args.owned_source)\n+        record[\"pre_git\"] = state(root)\n+        if record[\"pre_git\"][\"status_porcelain_v1_z_hex\"]:\n+            raise RuntimeError(\"Clean committed candidate required before gate\")\n+        create(dest / \"pre-source-inputs.json\", before)\n+        selected = [row for row in before if selected_for_zip(row[\"path\"], args.leaf_contract)]\n+        create(dest / \"pre-selected-ZIP-inputs.json\", selected)\n+        record[\"ZIP_selected_files\"] = len(selected)\n+        record[\"full_RAW_inventory_files\"] = len(before)\n+        with zipfile.ZipFile(str(dest / \"pre-selected-source-raw.zip\"), \"x\", zipfile.ZIP_DEFLATED) as archive:\n+            for row in selected:\n+                data = (root / row[\"path\"]).read_bytes()\n+                if digest(data) != row[\"raw_sha256\"]:\n+                    raise RuntimeError(\"Source changed during snapshot: \" + row[\"path\"])\n+                archive.writestr(row[\"path\"], data)\n+        if any(digest((root / row[\"path\"]).read_bytes()) != row[\"raw_sha256\"] for row in selected):\n+            raise RuntimeError(\"Selected ZIP source changed before command\")\n+        if state(root) != record[\"pre_git\"]:\n+            raise RuntimeError(\"Git changed before command\")\n+        record[\"precommand_check\"] = \"Selected ZIP RAW hashes and Git state; no redundant second full inventory. Full pre/post manifests remain authoritative.\"\n+        record[\"start_utc\"] = utc()\n+        record[\"command_started\"] = True\n+        with (dest / \"stdout.raw\").open(\"xb\") as out, (dest / \"stderr.raw\").open(\"xb\") as err:\n+            proc = subprocess.run(argv, cwd=str(root), stdout=out, stderr=err,\n+                                  env=dict(os.environ, PYTHONDONTWRITEBYTECODE=\"1\"))\n+        record[\"end_utc\"] = utc()\n+        record[\"actual_exit\"] = proc.returncode\n+        after = inventory(root, run, args.owned_source)\n+        create(dest / \"post-source-inputs.json\", after)\n+        record[\"post_git\"] = state(root)\n+        record[\"complete_source_path_set_and_RAW_unchanged\"] = before == after\n+        record[\"HEAD_and_branch_unchanged\"] = all(record[\"pre_git\"][k] == record[\"post_git\"][k]\n+                                                 for k in (\"HEAD\", \"branch\"))\n+        record[\"git_status_unchanged\"] = record[\"pre_git\"] == record[\"post_git\"]\n+        record[\"capture_integrity_ok\"] = before == after and record[\"HEAD_and_branch_unchanged\"] and record[\"git_status_unchanged\"]\n+    except Exception as exc:\n+        record[\"capture_error\"] = repr(exc)\n+        record[\"capture_integrity_ok\"] = False\n+        record.setdefault(\"end_utc\", utc())\n+    for name in (\"stdout.raw\", \"stderr.raw\", \"pre-source-inputs.json\", \"post-source-inputs.json\",\n+                 \"pre-selected-ZIP-inputs.json\", \"pre-selected-source-raw.zip\"):\n+        path = dest / name\n+        if path.exists():\n+            record[name + \"_sha256\"] = digest(path.read_bytes())\n+    create(dest / \"receipt.json\", record)\n+    print(json.dumps({\"receipt\": str(dest / \"receipt.json\"), \"actual_exit\": record[\"actual_exit\"],\n+                      \"capture_integrity_ok\": record[\"capture_integrity_ok\"]}))\n+    if not record[\"capture_integrity_ok\"]:\n+        return 125\n+    return record[\"actual_exit\"] if record[\"actual_exit\"] is not None else 125\n+\n+\n+if __name__ == \"__main__\":\n+    sys.exit(main())"},{"sha":"74d390b9b1749b364d771643ff9d558adb6c7868","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/render-v1/post-source-inputs.json","status":"added","additions":6612,"deletions":0,"changes":6612,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Frender-v1%2Fpost-source-inputs.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Frender-v1%2Fpost-source-inputs.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Frender-v1%2Fpost-source-inputs.json?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8"},{"sha":"034253c0b79ee0196f2eb8fefaf8a171bd4d2c22","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/render-v1/pre-selected-ZIP-inputs.json","status":"added","additions":6577,"deletions":0,"changes":6577,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Frender-v1%2Fpre-selected-ZIP-inputs.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Frender-v1%2Fpre-selected-ZIP-inputs.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Frender-v1%2Fpre-selected-ZIP-inputs.json?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8"},{"sha":"38de62397a4227e6f99507b82ab2392cd47f0e24","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/render-v1/pre-selected-source-raw.zip","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Frender-v1%2Fpre-selected-source-raw.zip","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Frender-v1%2Fpre-selected-source-raw.zip","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Frender-v1%2Fpre-selected-source-raw.zip?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8"},{"sha":"74d390b9b1749b364d771643ff9d558adb6c7868","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/render-v1/pre-source-inputs.json","status":"added","additions":6612,"deletions":0,"changes":6612,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Frender-v1%2Fpre-source-inputs.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Frender-v1%2Fpre-source-inputs.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Frender-v1%2Fpre-source-inputs.json?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8"},{"sha":"bac913c25b26b7e11dd62b2d9c3ebecad2931121","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/render-v1/receipt.json","status":"added","additions":73,"deletions":0,"changes":73,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Frender-v1%2Freceipt.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Frender-v1%2Freceipt.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Frender-v1%2Freceipt.json?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1,73 @@\n+{\n+  \"argv\": [\n+    \"C:/Program Files/nodejs/node.exe\",\n+    \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\\\\tmp\\\\online-ch2-prescient-euclidean-reader-qa-20261011\\\\capture-prescient-euclidean-reader-v4.cjs\",\n+    \"http://127.0.0.1:8890/chapters/online-ogd/\",\n+    \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\\\\tmp\\\\online-ch2-prescient-euclidean-reader-qa-20261011\\\\capture-v1\",\n+    \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\\\\tmp\\\\online-ch2-prescient-euclidean-reader-qa-20261011\\\\edge-profile-v1\",\n+    \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\\\\tmp\\\\online-ch2-prescient-euclidean-site-20261011-v1\\\\books\\\\registry.json\",\n+    \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\",\n+    \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\\\\tmp\\\\online-ch2-prescient-euclidean-site-20261011-v1\",\n+    \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\\\\tmp\\\\online-ch2-prescient-euclidean-gates-20261011\\\\actual-evidence-v2\\\\combined-v2\\\\receipt.json\",\n+    \"7bc4eca86b7d4d7c130d9af9a4f849fa6f80410f3f885c4d352bce33090cd347\",\n+    \"3b393adb009bc25a2c6e3fa3148bf9a3a2b4c376\"\n+  ],\n+  \"cwd\": \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\",\n+  \"helper_sha256\": \"d7d10142361f940c51712e7dd174dfae51ad768f65f87f26decd87d91faf58fc\",\n+  \"evidence_namespace_excluded\": \"tmp/online-ch2-prescient-euclidean-gates-20261011/actual-evidence-v2\",\n+  \"actual_evidence_namespace\": \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\\\\tmp\\\\online-ch2-prescient-euclidean-gates-20261011\\\\actual-evidence-v2\",\n+  \"evidence_port_boundary\": \"Receipts originate here; any later exact copy into RUN requires a separate port manifest. No contemporaneous canonical RUN claim.\",\n+  \"owned_source\": [\n+    \"docs/proof-digestion-protocol.md\",\n+    \"docs/evidence-routed-memory-protocol.md\",\n+    \"docs/openai-math-assimilation-protocol.md\",\n+    \"research-wiki/openai-math-2026-intake.json\",\n+    \"runs/process_memory.json\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/.gitattributes\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/canary-freeze-receipt-v1.json\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/independent-source-header-review-v1.json\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/leaf-freeze-receipt-v1.json\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-canary-additional-definitions-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-canary-imported-definitions-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-canary-standard-definitions-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-complete-canary-headers-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-headers-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-imported-definitions-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-standard-definitions-v1.txt\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/proof-digestion-record-v1.json\",\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1/source-contract-proposal-v1.json\"\n+  ],\n+  \"command_started\": true,\n+  \"actual_exit\": 0,\n+  \"ZIP_is_whole_repository_archive\": false,\n+  \"ZIP_scope\": \"Selected active source/input trees and current leaf contracts; historical runs excluded; curated current runs/process_memory.json included\",\n+  \"full_RAW_inventory_scope\": \"Every library/Test source and enumerated current harness/site source/input tree plus current leaf contracts. Historical archives not separately RAW-hashed (curated current process memory is an active input); committed HEAD and clean Git status bind repository state.\",\n+  \"leaf_contract_roots\": [\n+    \"docs/contracts/online-ch2-prescient-euclidean-v1\"\n+  ],\n+  \"pre_git\": {\n+    \"HEAD\": \"3b393adb009bc25a2c6e3fa3148bf9a3a2b4c376\",\n+    \"branch\": \"codex/research-online-ch2-prescient-euclidean\",\n+    \"status_porcelain_v1_z_hex\": \"\"\n+  },\n+  \"ZIP_selected_files\": 1315,\n+  \"full_RAW_inventory_files\": 1322,\n+  \"precommand_check\": \"Selected ZIP RAW hashes and Git state; no redundant second full inventory. Full pre/post manifests remain authoritative.\",\n+  \"start_utc\": \"2026-10-11T07:40:40.369210+00:00\",\n+  \"end_utc\": \"2026-10-11T07:41:02.417560+00:00\",\n+  \"post_git\": {\n+    \"HEAD\": \"3b393adb009bc25a2c6e3fa3148bf9a3a2b4c376\",\n+    \"branch\": \"codex/research-online-ch2-prescient-euclidean\",\n+    \"status_porcelain_v1_z_hex\": \"\"\n+  },\n+  \"complete_source_path_set_and_RAW_unchanged\": true,\n+  \"HEAD_and_branch_unchanged\": true,\n+  \"git_status_unchanged\": true,\n+  \"capture_integrity_ok\": true,\n+  \"stdout.raw_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n+  \"stderr.raw_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n+  \"pre-source-inputs.json_sha256\": \"828ce3ae140230c56886f454f1b1f5d3c9bcda8d8dac36df67a3557c289b36c8\",\n+  \"post-source-inputs.json_sha256\": \"828ce3ae140230c56886f454f1b1f5d3c9bcda8d8dac36df67a3557c289b36c8\",\n+  \"pre-selected-ZIP-inputs.json_sha256\": \"6c8a331d600f505a29311729c4c9b44dcde803552709724cb433bc30e2045e5e\",\n+  \"pre-selected-source-raw.zip_sha256\": \"72ee87c25e3ce7eff4414d3c34c766d9dfb3a07cea433f69a36fc06fb0a98099\"\n+}"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/render-v1/stderr.raw","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Frender-v1%2Fstderr.raw","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Frender-v1%2Fstderr.raw","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Frender-v1%2Fstderr.raw?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/render-v1/stdout.raw","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Frender-v1%2Fstdout.raw","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Frender-v1%2Fstdout.raw","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Frender-v1%2Fstdout.raw?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8"},{"sha":"b163a07b37600b03094396759906047dca2b0dc6","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/site-build-v2/capture-helper.py.txt","status":"added","additions":184,"deletions":0,"changes":184,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fsite-build-v2%2Fcapture-helper.py.txt","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fsite-build-v2%2Fcapture-helper.py.txt","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fsite-build-v2%2Fcapture-helper.py.txt?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8","patch":"@@ -0,0 +1,184 @@\n+\"\"\"Gate recorder for prescient Euclidean and current-main governance, Python3.8 stdlib; no gate executed by preparation.\"\"\"\n+import argparse\n+import datetime\n+import hashlib\n+import json\n+import os\n+from pathlib import Path\n+import re\n+import subprocess\n+import sys\n+import zipfile\n+\n+\n+def utc():\n+    return datetime.datetime.now(datetime.timezone.utc).isoformat()\n+\n+\n+def digest(data):\n+    return hashlib.sha256(data).hexdigest()\n+\n+\n+def create(path, data):\n+    if not isinstance(data, bytes):\n+        data = (json.dumps(data, ensure_ascii=False, indent=2) + \"\\n\").encode(\"utf-8\")\n+    with path.open(\"xb\") as stream:\n+        stream.write(data)\n+\n+\n+def git(root, *args):\n+    proc = subprocess.run([\"git\"] + list(args), cwd=str(root), stdout=subprocess.PIPE,\n+                          stderr=subprocess.PIPE)\n+    if proc.returncode:\n+        raise RuntimeError(\"git failed: \" + repr(args) + \": \" + proc.stderr.decode(\"utf-8\", \"replace\"))\n+    return proc.stdout\n+\n+\n+def state(root):\n+    return {\"HEAD\": git(root, \"rev-parse\", \"HEAD\").decode().strip(),\n+            \"branch\": git(root, \"branch\", \"--show-current\").decode().strip(),\n+            \"status_porcelain_v1_z_hex\": git(root, \"status\", \"--porcelain=v1\", \"-z\").hex()}\n+\n+\n+def inventory(root, run, owned):\n+    # Start with tracked names, then explicitly filter to current source/input trees below.\n+    names = set(x.decode(\"utf-8\") for x in git(root, \"ls-files\", \"-z\", \"--cached\").split(b\"\\0\") if x)\n+    # Add new source paths, including ignored additions inside actual source trees.\n+    for folder in (\"BanditRLProof\", \"Tests\", \"tools\", \"website/scripts\", \"website/content\",\n+                   \"website/static\", \"research-wiki/contribution-contracts\"):\n+        for path in (root / folder).rglob(\"*\"):\n+            if path.is_file() and \"__pycache__\" not in path.parts:\n+                names.add(path.relative_to(root).as_posix())\n+    for name in (\"BanditRLProof.lean\", \"Tests.lean\", \"lean-toolchain\", \"lakefile.lean\",\n+                 \"lake-manifest.json\", \".gitattributes\"):\n+        names.add(name)\n+    names.update(owned)\n+    contract_roots = [name.rsplit(\"/\", 1)[0] for name in owned if name.startswith(\"docs/contracts/\")]\n+    extra = {\"README.md\", \"AGENTS.md\", \"CONTRIBUTING.md\", \"docs/contribution-contract.schema.json\", \"docs/contributor-codex-contract.md\", \"docs/theorem-publication-protocol.md\", \"docs/contracts/online-book-v1/coverage.json\", \"docs/proof-digestion-protocol.md\", \"docs/evidence-routed-memory-protocol.md\", \"docs/openai-math-assimilation-protocol.md\", \"research-wiki/openai-math-2026-intake.json\", \"runs/process_memory.json\"}\n+    names = {name for name in names if selected_for_zip(name, contract_roots) or name in extra}\n+    result = []\n+    for name in sorted(names):\n+        path = root / name\n+        resolved = path.resolve()\n+        if resolved == run or run in resolved.parents:\n+            continue\n+        if root not in resolved.parents or path.is_symlink() or not path.is_file():\n+            raise RuntimeError(\"Input must be an existing ordinary repository file: \" + name)\n+        data = path.read_bytes()\n+        result.append({\"path\": name, \"raw_sha256\": digest(data), \"bytes\": len(data)})\n+    return result\n+\n+\n+def selected_for_zip(name, contract_roots):\n+    # Historical runs are excluded from both selected RAW inventory and ZIP; clean HEAD binds them.\n+    if name == \"runs/process_memory.json\":\n+        return True\n+    if name.startswith(\"runs/\"):\n+        return False\n+    prefixes = (\"BanditRLProof/\", \"Tests/\", \"tools/\", \"website/scripts/\",\n+                \"website/content/\", \"website/static/\", \"research-wiki/contribution-contracts/\")\n+    exact = {\"BanditRLProof.lean\", \"Tests.lean\", \"lean-toolchain\", \"lakefile.lean\",\n+             \"lake-manifest.json\", \".gitattributes\", \"docs/proof-digestion-protocol.md\", \"docs/evidence-routed-memory-protocol.md\", \"docs/openai-math-assimilation-protocol.md\", \"research-wiki/openai-math-2026-intake.json\"}\n+    return (name in exact or name.startswith(prefixes) or\n+            any(name.startswith(folder.rstrip(\"/\") + \"/\") for folder in contract_roots))\n+\n+\n+def main():\n+    parser = argparse.ArgumentParser()\n+    parser.add_argument(\"--root\", required=True)\n+    parser.add_argument(\"--run\", required=True, help=\"New evidence namespace beneath runs/ or an already ignored tmp/ namespace\")\n+    parser.add_argument(\"--label\", required=True)\n+    parser.add_argument(\"--owned-source\", action=\"append\", default=[])\n+    parser.add_argument(\"--leaf-contract\", action=\"append\", required=True,\n+                        help=\"Current leaf docs/contracts subtree to include in ZIP\")\n+    parser.add_argument(\"argv\", nargs=argparse.REMAINDER)\n+    args = parser.parse_args()\n+    root = Path(args.root).resolve()\n+    run = (root / args.run).resolve()\n+    argv = args.argv[1:] if args.argv[:1] == [\"--\"] else args.argv\n+    if not argv or not re.fullmatch(r\"[A-Za-z0-9][A-Za-z0-9_.-]*\", args.label):\n+        raise RuntimeError(\"Exact argv and safe unique label required\")\n+    if root / \"runs\" not in run.parents and root / \"tmp\" not in run.parents:\n+        raise RuntimeError(\"Evidence namespace must be beneath root/runs/ or root/tmp/\")\n+    if root / \"tmp\" in run.parents:\n+        probe = run.relative_to(root).as_posix() + \"/.capture-ignore-probe\"\n+        result = subprocess.run([\"git\", \"check-ignore\", \"--quiet\", \"--\", probe],\n+                                cwd=str(root), stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n+        if result.returncode != 0:\n+            raise RuntimeError(\"tmp evidence namespace must already be ignored; no ignore rule changes permitted\")\n+    for folder in args.leaf_contract:\n+        resolved = (root / folder).resolve()\n+        if root / \"docs\" / \"contracts\" not in resolved.parents:\n+            raise RuntimeError(\"Leaf contract must be a docs/contracts subtree\")\n+        if not resolved.is_dir():\n+            raise RuntimeError(\"Leaf contract subtree missing\")\n+        args.owned_source.extend(path.relative_to(root).as_posix()\n+                                 for path in resolved.rglob(\"*\") if path.is_file())\n+    dest = run / args.label\n+    dest.mkdir(parents=True, exist_ok=False)\n+    helper = Path(__file__).resolve().read_bytes()\n+    create(dest / \"capture-helper.py.txt\", helper)\n+    record = {\"argv\": argv, \"cwd\": str(root), \"helper_sha256\": digest(helper),\n+              \"evidence_namespace_excluded\": run.relative_to(root).as_posix(),\n+              \"actual_evidence_namespace\": str(run),\n+              \"evidence_port_boundary\": \"Receipts originate here; any later exact copy into RUN requires a separate port manifest. No contemporaneous canonical RUN claim.\",\n+              \"owned_source\": args.owned_source, \"command_started\": False, \"actual_exit\": None,\n+              \"ZIP_is_whole_repository_archive\": False,\n+              \"ZIP_scope\": \"Selected active source/input trees and current leaf contracts; historical runs excluded; curated current runs/process_memory.json included\",\n+              \"full_RAW_inventory_scope\": \"Every library/Test source and enumerated current harness/site source/input tree plus current leaf contracts. Historical archives not separately RAW-hashed (curated current process memory is an active input); committed HEAD and clean Git status bind repository state.\",\n+              \"leaf_contract_roots\": args.leaf_contract}\n+    try:\n+        before = inventory(root, run, args.owned_source)\n+        record[\"pre_git\"] = state(root)\n+        if record[\"pre_git\"][\"status_porcelain_v1_z_hex\"]:\n+            raise RuntimeError(\"Clean committed candidate required before gate\")\n+        create(dest / \"pre-source-inputs.json\", before)\n+        selected = [row for row in before if selected_for_zip(row[\"path\"], args.leaf_contract)]\n+        create(dest / \"pre-selected-ZIP-inputs.json\", selected)\n+        record[\"ZIP_selected_files\"] = len(selected)\n+        record[\"full_RAW_inventory_files\"] = len(before)\n+        with zipfile.ZipFile(str(dest / \"pre-selected-source-raw.zip\"), \"x\", zipfile.ZIP_DEFLATED) as archive:\n+            for row in selected:\n+                data = (root / row[\"path\"]).read_bytes()\n+                if digest(data) != row[\"raw_sha256\"]:\n+                    raise RuntimeError(\"Source changed during snapshot: \" + row[\"path\"])\n+                archive.writestr(row[\"path\"], data)\n+        if any(digest((root / row[\"path\"]).read_bytes()) != row[\"raw_sha256\"] for row in selected):\n+            raise RuntimeError(\"Selected ZIP source changed before command\")\n+        if state(root) != record[\"pre_git\"]:\n+            raise RuntimeError(\"Git changed before command\")\n+        record[\"precommand_check\"] = \"Selected ZIP RAW hashes and Git state; no redundant second full inventory. Full pre/post manifests remain authoritative.\"\n+        record[\"start_utc\"] = utc()\n+        record[\"command_started\"] = True\n+        with (dest / \"stdout.raw\").open(\"xb\") as out, (dest / \"stderr.raw\").open(\"xb\") as err:\n+            proc = subprocess.run(argv, cwd=str(root), stdout=out, stderr=err,\n+                                  env=dict(os.environ, PYTHONDONTWRITEBYTECODE=\"1\"))\n+        record[\"end_utc\"] = utc()\n+        record[\"actual_exit\"] = proc.returncode\n+        after = inventory(root, run, args.owned_source)\n+        create(dest / \"post-source-inputs.json\", after)\n+        record[\"post_git\"] = state(root)\n+        record[\"complete_source_path_set_and_RAW_unchanged\"] = before == after\n+        record[\"HEAD_and_branch_unchanged\"] = all(record[\"pre_git\"][k] == record[\"post_git\"][k]\n+                                                 for k in (\"HEAD\", \"branch\"))\n+        record[\"git_status_unchanged\"] = record[\"pre_git\"] == record[\"post_git\"]\n+        record[\"capture_integrity_ok\"] = before == after and record[\"HEAD_and_branch_unchanged\"] and record[\"git_status_unchanged\"]\n+    except Exception as exc:\n+        record[\"capture_error\"] = repr(exc)\n+        record[\"capture_integrity_ok\"] = False\n+        record.setdefault(\"end_utc\", utc())\n+    for name in (\"stdout.raw\", \"stderr.raw\", \"pre-source-inputs.json\", \"post-source-inputs.json\",\n+                 \"pre-selected-ZIP-inputs.json\", \"pre-selected-source-raw.zip\"):\n+        path = dest / name\n+        if path.exists():\n+            record[name + \"_sha256\"] = digest(path.read_bytes())\n+    create(dest / \"receipt.json\", record)\n+    print(json.dumps({\"receipt\": str(dest / \"receipt.json\"), \"actual_exit\": record[\"actual_exit\"],\n+                      \"capture_integrity_ok\": record[\"capture_integrity_ok\"]}))\n+    if not record[\"capture_integrity_ok\"]:\n+        return 125\n+    return record[\"actual_exit\"] if record[\"actual_exit\"] is not None else 125\n+\n+\n+if __name__ == \"__main__\":\n+    sys.exit(main())"},{"sha":"74d390b9b1749b364d771643ff9d558adb6c7868","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/site-build-v2/post-source-inputs.json","status":"added","additions":6612,"deletions":0,"changes":6612,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fsite-build-v2%2Fpost-source-inputs.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fsite-build-v2%2Fpost-source-inputs.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fsite-build-v2%2Fpost-source-inputs.json?ref=b8a4b13ca96709b1adff0d1907814dc3d3d76cc8"},{"sha":"034253c0b79ee0196f2eb8fefaf8a171bd4d2c22","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/site-build-v2/pre-selected-ZIP-inputs.json","status":"added","additions":6577,"deletions":0,"changes":6577,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fsite-build-v2%2Fpre-selected-ZIP-inputs.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fsite-build-v2%2Fpre-selected-ZIP-inputs.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fsite-build-v2%2Fpre-selected-ZIP-inputs.json?