dean-20261011/source-topology-proposal-v2/topology.json\": \"f317dce023cae552746ad8ef38163e646d3b77712feffc73468ceac41efee448\",\n+    \"runs/online-ch2-prescient-euclidean-20261011/fresh-source-topology-review-v2.json\": \"c97719bbe8264c8d953b311d78355a1ee2d337381a5eb7c3ba1859cf26bb9fe0\",\n+    \"runs/online-ch2-prescient-euclidean-20261011/formalizer-core-v1/type-value-constants-v1.json\": \"32855356493f3e7048ba9eccce9d8186f2dbf48b601061f200ff5c2722929f4c\",\n+    \"runs/online-ch2-prescient-euclidean-20261011/formalizer-core-v1/compiled-candidate-summary-v1.json\": \"f2d0af705dd30a75bcd06a2c67a753a6a4c0164ab88b9256c7ad52001c2813b9\",\n+    \"website/scripts/build_site.py\": \"4fe18b8b9a543ff5256a278f49d160424b30ba2185c946f3d6081ad5460ccaff\",\n+    \"website/scripts/book_registry.py\": \"2557e84c4a60bbd659d1067843cedbe329a4c0c922244614299ae93d347dce03\",\n+    \"runs/online-ch2-prescient-euclidean-20261011/fresh-production-body-review-v1.json\": \"8b3cc4fea0b8a6988908cc7370ab67907815f1d04637f75f01241c19e052d8f4\"\n+  },\n+  \"core_binding_from_compiled_receipt\": {\n+    \"path\": \"BanditRLProof/OnlinePrescientEuclidean.lean\",\n+    \"raw_sha256\": \"9b755a12d540c1039b068e4b97af90ac483a58fd1a8b40af9c806264f95d42b8\",\n+    \"public_declarations\": [\n+      \"BanditRL.OnlineBregman.quadratic_geometry\",\n+      \"BanditRL.OnlinePrescientBregman.euclidean_variable_regret\",\n+      \"BanditRL.OnlinePrescientBregman.euclidean_fixed_regret\"\n+    ],\n+    \"new_public_helpers\": 0\n+  },\n+  \"core_BODY_read\": false,\n+  \"selected_actual_VALUE_parents\": {\n+    \"BanditRL.OnlineBregman.quadratic_geometry\": [\n+      \"hasStrictFDerivAt_norm_sq\",\n+      \"HasGradientAt.fderiv_apply\",\n+      \"norm_sub_sq_real\"\n+    ],\n+    \"BanditRL.OnlinePrescientBregman.euclidean_variable_regret\": [\n+      \"BanditRL.OnlineBregman.quadratic_geometry\",\n+      \"BanditRL.OnlineConvex.sourceProper_of_domain\",\n+      \"BanditRL.OnlinePrescientBregman.iterate_eq_of_source_updates\",\n+      \"BanditRL.OnlinePrescientBregman.source_variable_regret\"\n+    ],\n+    \"BanditRL.OnlinePrescientBregman.euclidean_fixed_regret\": [\n+      \"BanditRL.OnlineBregman.quadratic_geometry\",\n+      \"BanditRL.OnlineConvex.sourceProper_of_domain\",\n+      \"BanditRL.OnlinePrescientBregman.iterate_eq_of_source_updates\",\n+      \"BanditRL.OnlinePrescientBregman.source_fixed_regret\"\n+    ]\n+  },\n+  \"json_patches\": [\n+    {\n+      \"file\": \"website/content/chapters.json\",\n+      \"operations\": [\n+        {\n+          \"op\": \"add\",\n+          \"path\": \"/chapters/10/module_globs/-\",\n+          \"value\": \"BanditRLProof/OnlinePrescientEuclidean.lean\"\n+        }\n+      ]\n+    },\n+    {\n+      \"file\": \"website/content/readings.json\",\n+      \"operations\": [\n+        {\n+          \"op\": \"add\",\n+          \"path\": \"/readings/10/source_theorems/-\",\n+          \"value\": {\n+            \"label\": \"Prescient Euclidean updates: quadratic geometry and both Theorem15.30 bounds\",\n+            \"pages\": \"printed14,265–266 / PDF26,277–278\",\n+            \"pdf_page\": 277,\n+            \"url\": \"https://arxiv.org/pdf/1912.13213v10#page=277\",\n+            \"math\": \"\\\\begin{gathered}\\\\psi(z)=\\\\frac12\\\\|z\\\\|^2,\\\\qquad\\\\nabla\\\\psi(y)=y,\\\\qquad B_\\\\psi(x;y)=\\\\frac12\\\\|x-y\\\\|^2.\\\\\\\\R_T(u)\\\\le\\\\frac{\\\\max_{0\\\\le s<T}\\\\frac12\\\\|u-x_s\\\\|^2}{\\\\eta_{T-1}}-\\\\sum_{t=0}^{T-1}\\\\frac{\\\\|x_{t+1}-x_t\\\\|^2}{2\\\\eta_t}.\\\\\\\\R_T(u)\\\\le\\\\frac{\\\\|u-x_0\\\\|^2}{2\\\\eta}-\\\\frac1{2\\\\eta}\\\\sum_{t=0}^{T-1}\\\\|x_{t+1}-x_t\\\\|^2.\\\\end{gathered}\",\n+            \"plain\": \"Knowing the current loss before output removes the positive gradient-energy term and retains negative squared movement. The initial comparator potential can still make the total bound positive. Finite-dimensional real inner-product E with NormedAddCommGroup E, InnerProductSpace ℝ E and FiniteDimensional ℝ E. V is closed, nonempty and convex. Played EReal losses have no bottom anywhere, are finite on V, and have ambient global supports at every point of V. Each supplied x(t+1) actually attains the squared-distance-penalized minimum on V; initialization x(0)=x0 is fixed. x0 need not belong to V. There is no affine, smooth-loss, globally finite-loss, bounded-gradient or bounded-domain restriction.\",\n+            \"fallback\": \"Quadratic Bregman divergence is half squared distance. Variable steps use the maximum previous-state potential divided by the last used step; fixed steps use initial potential. Both subtract exact half-weighted squared movements.\",\n+            \"relationship\": \"Chapter2 PDF26 points to Algorithm15.8 and Theorem15.30 on PDF277–278. Both branches are mandatory, including the fixed proof left as an exercise on PDF278. Specialize X=univ and psi=norm²/2; interior, derivative, strict-convexity and closedness facts are derived rather than added as user premises. The author’s constrained optimality/global-support step on PDF277 retains an unresolved source-proof justification. The alternative proximal-comparison route does not certify or erase that claim. Compiled local prescient Euclidean specialization; package validation and source-target reconciliation are recorded separately. Chapter2 remains partial and the Chapters1–16 Goal active. This is unmerged and unpublished.\",\n+            \"contract\": {\n+              \"model\": \"Receive the entire current loss before choosing the new point and pay that loss at the new point. Lean loss t and eta t are source round t+1: center x(t), output/paid point x(t+1). This differs from ordinary OGD, which scores loss t at x(t). The conclusion identifies the SAME partial Option iterate at every prefix; it is conditional on attained updates and does not assert universal existence.\",\n+              \"assumptions\": \"Finite-dimensional real inner-product E with NormedAddCommGroup E, InnerProductSpace ℝ E and FiniteDimensional ℝ E. V is closed, nonempty and convex. Played EReal losses have no bottom anywhere, are finite on V, and have ambient global supports at every point of V. Each supplied x(t+1) actually attains the squared-distance-penalized minimum on V; initialization x(0)=x0 is fixed. x0 need not belong to V. There is no affine, smooth-loss, globally finite-loss, bounded-gradient or bounded-domain restriction.\",\n+              \"parameters\": \"Variable: T>0, every used step positive, adjacent played steps nonincreasing, max indices0..T-1, last eta(T-1). Fixed: eta>0 and any T including0.\",\n+              \"regret\": \"R_T(u)=sum_{t<T}((loss t (x(t+1))).toReal-(loss t u).toReal), for every u in V; scoring is finite on V.\",\n+              \"guarantee\": \"Each endpoint concludes canonical Option-run equality AND its full signed bound. The shared geometry theorem computes the actual derivative and exact ordered divergence; on complete real Hilbert space it is an explicit generalization of source Euclidean geometry.\"\n+            },\n+            \"local_status\": {\n+              \"status\": \"compiled\",\n+              \"label\": \"Compiled prescient Euclidean specialization\",\n+              \"boundary\": \"Compiled local prescient Euclidean specialization; package validation and source-target reconciliation are recorded separately. Chapter2 remains partial and the Chapters1–16 Goal active. This is unmerged and unpublished.\"\n+            }\n+          }\n+        }\n+      ]\n+    },\n+    {\n+      \"file\": \"website/content/highlights.json\",\n+      \"operations\": [\n+        {\n+          \"op\": \"add\",\n+          \"path\": \"/highlights/-\",\n+          \"value\": {\n+            \"full_name\": \"BanditRL.OnlineBregman.quadratic_geometry\",\n+            \"title\": \"Prescient Euclidean geometry: the quadratic derivative and divergence\",\n+            \"chapter\": \"online-ogd\",\n+            \"featured\": false,\n+            \"teaching_order\": 330,\n+            \"source_match\": \"closest-source\",\n+            \"plain\": \"Complete real Hilbert E: NormedAddCommGroup E, InnerProductSpace ℝ E, CompleteSpace E; arbitrary x,y. Actual gradient y and exact divergence identity form one conjunction.\",\n+            \"math\": \"\\\\psi(z)=\\\\frac12\\\\|z\\\\|^2,\\\\qquad\\\\nabla\\\\psi(y)=y,\\\\qquad B_\\\\psi(x;y)=\\\\frac12\\\\|x-y\\\\|^2.\",\n+            \"intuition\": \"The tangent plane of the quadratic leaves exactly half the squared distance between the two points.\",\n+            \"why\": \"One of three declaration-bound parts of the same prescient Euclidean lesson.\",\n+            \"position\": \"Algorithm15.8/Theorem15.30, PDF277–278; C2 pointer PDF26. Quadratic X=univ specialization; fixed proof exercise remains mandatory. The author’s constrained optimality/global-support step on PDF277 retains an unresolved source-proof justification. The alternative proximal-comparison route does not certify or erase that claim.\",\n+            \"proof_idea\": \"Differentiate psi(z)=||z||²/2 to obtain the actual gradient y at y. Substitute the resulting derivative into the shared divergence and expand the squared norm to get Bpsi(x;y)=||x-y||²/2. This geometry theorem makes no algorithm-run conclusion.\",\n+            \"lean_notes\": \"The complete real Hilbert-space assumptions above belong to this theorem. The full-proof source link exposes its section declarations. Selected actual compiled VALUE occurrences: hasStrictFDerivAt_norm_sq, HasGradientAt.fderiv_apply, norm_sub_sq_real. Occurrence is not necessity or a complete transitive graph. Compiled local prescient Euclidean specialization; package validation and source-target reconciliation are recorded separately. Chapter2 remains partial and the Chapters1–16 Goal active. This is unmerged and unpublished.\",\n+            \"dependencies\": [\n+              \"hasStrictFDerivAt_norm_sq\",\n+              \"HasGradientAt.fderiv_apply\",\n+              \"norm_sub_sq_real\"\n+            ]\n+          }\n+        },\n+        {\n+          \"op\": \"add\",\n+          \"path\": \"/highlights/-\",\n+          \"value\": {\n+            \"full_name\": \"BanditRL.OnlinePrescientBregman.euclidean_variable_regret\",\n+            \"title\": \"Prescient Euclidean bound with decreasing steps\",\n+            \"chapter\": \"online-ogd\",\n+            \"featured\": false,\n+            \"teaching_order\": 331,\n+            \"source_match\": \"closest-source\",\n+            \"plain\": \"Finite-dimensional real inner-product E with NormedAddCommGroup E, InnerProductSpace ℝ E and FiniteDimensional ℝ E. V is closed, nonempty and convex. Played EReal losses have no bottom anywhere, are finite on V, and have ambient global supports at every point of V. Each supplied x(t+1) actually attains the squared-distance-penalized minimum on V; initialization x(0)=x0 is fixed. x0 need not belong to V. There is no affine, smooth-loss, globally finite-loss, bounded-gradient or bounded-domain restriction. T>0; positive nonincreasing used steps. Previous-state maximum excludes x(T).\",\n+            \"math\": \"R_T(u)\\\\le\\\\frac{\\\\max_{0\\\\le s<T}\\\\frac12\\\\|u-x_s\\\\|^2}{\\\\eta_{T-1}}-\\\\sum_{t=0}^{T-1}\\\\frac{\\\\|x_{t+1}-x_t\\\\|^2}{2\\\\eta_t}.\",\n+            \"intuition\": \"Current-loss access changes the paid point. Movement contributes negatively, while the comparator potential remains.\",\n+            \"why\": \"One of three declaration-bound parts of the same prescient Euclidean lesson.\",\n+            \"position\": \"Algorithm15.8/Theorem15.30, PDF277–278; C2 pointer PDF26. Quadratic X=univ specialization; fixed proof exercise remains mandatory. The author’s constrained optimality/global-support step on PDF277 retains an unresolved source-proof justification. The alternative proximal-comparison route does not certify or erase that claim.\",\n+            \"proof_idea\": \"Rewrite the actual quadratic penalized objective using the shared divergence identity. Strict convexity identifies each supplied feasible minimizer with the canonical choice, and induction identifies the same Option run. Apply the corresponding general source regret theorem and substitute the quadratic identity, retaining every negative movement term. The comparator u is arbitrary in V, so the theorem applies to every feasible comparator.\",\n+            \"lean_notes\": \"Receive the entire current loss before choosing the new point and pay that loss at the new point. Lean loss t and eta t are source round t+1: center x(t), output/paid point x(t+1). This differs from ordinary OGD, which scores loss t at x(t). The conclusion identifies the SAME partial Option iterate at every prefix; it is conditional on attained updates and does not assert universal existence. The ambient assumptions above belong to the theorem; the full-proof source link exposes its section context. Selected actual compiled VALUE occurrences: BanditRL.OnlineBregman.quadratic_geometry, BanditRL.OnlineConvex.sourceProper_of_domain, BanditRL.OnlinePrescientBregman.iterate_eq_of_source_updates, BanditRL.OnlinePrescientBregman.source_variable_regret. Occurrence is not necessity or a complete transitive graph. Compiled local prescient Euclidean specialization; package validation and source-target reconciliation are recorded separately. Chapter2 remains partial and the Chapters1–16 Goal active. This is unmerged and unpublished.\",\n+            \"dependencies\": [\n+              \"BanditRL.OnlineBregman.quadratic_geometry\",\n+              \"BanditRL.OnlineConvex.sourceProper_of_domain\",\n+              \"BanditRL.OnlinePrescientBregman.iterate_eq_of_source_updates\",\n+              \"BanditRL.OnlinePrescientBregman.source_variable_regret\"\n+            ]\n+          }\n+        },\n+        {\n+          \"op\": \"add\",\n+          \"path\": \"/highlights/-\",\n+          \"value\": {\n+            \"full_name\": \"BanditRL.OnlinePrescientBregman.euclidean_fixed_regret\",\n+            \"title\": \"Prescient Euclidean bound with a fixed step\",\n+            \"chapter\": \"online-ogd\",\n+            \"featured\": false,\n+            \"teaching_order\": 332,\n+            \"source_match\": \"closest-source\",\n+            \"plain\": \"Finite-dimensional real inner-product E with NormedAddCommGroup E, InnerProductSpace ℝ E and FiniteDimensional ℝ E. V is closed, nonempty and convex. Played EReal losses have no bottom anywhere, are finite on V, and have ambient global supports at every point of V. Each supplied x(t+1) actually attains the squared-distance-penalized minimum on V; initialization x(0)=x0 is fixed. x0 need not belong to V. There is no affine, smooth-loss, globally finite-loss, bounded-gradient or bounded-domain restriction. eta>0; T=0 allowed, giving0<=||u-x0||²/(2eta). No empty maximum is needed.\",\n+            \"math\": \"R_T(u)\\\\le\\\\frac{\\\\|u-x_0\\\\|^2}{2\\\\eta}-\\\\frac1{2\\\\eta}\\\\sum_{t=0}^{T-1}\\\\|x_{t+1}-x_t\\\\|^2.\",\n+            \"intuition\": \"Current-loss access changes the paid point. Movement contributes negatively, while the comparator potential remains.\",\n+            \"why\": \"One of three declaration-bound parts of the same prescient Euclidean lesson.\",\n+            \"position\": \"Algorithm15.8/Theorem15.30, PDF277–278; C2 pointer PDF26. Quadratic X=univ specialization; fixed proof exercise remains mandatory. The author’s constrained optimality/global-support step on PDF277 retains an unresolved source-proof justification. The alternative proximal-comparison route does not certify or erase that claim.\",\n+            \"proof_idea\": \"Rewrite the actual quadratic penalized objective using the shared divergence identity. Strict convexity identifies each supplied feasible minimizer with the canonical choice, and induction identifies the same Option run. Apply the corresponding general source regret theorem and substitute the quadratic identity, retaining every negative movement term. The comparator u is arbitrary in V, so the theorem applies to every feasible comparator.\",\n+            \"lean_notes\": \"Receive the entire current loss before choosing the new point and pay that loss at the new point. Lean loss t and eta t are source round t+1: center x(t), output/paid point x(t+1). This differs from ordinary OGD, which scores loss t at x(t). The conclusion identifies the SAME partial Option iterate at every prefix; it is conditional on attained updates and does not assert universal existence. The ambient assumptions above belong to the theorem; the full-proof source link exposes its section context. Selected actual compiled VALUE occurrences: BanditRL.OnlineBregman.quadratic_geometry, BanditRL.OnlineConvex.sourceProper_of_domain, BanditRL.OnlinePrescientBregman.iterate_eq_of_source_updates, BanditRL.OnlinePrescientBregman.source_fixed_regret. Occurrence is not necessity or a complete transitive graph. Compiled local prescient Euclidean specialization; package validation and source-target reconciliation are recorded separately. Chapter2 remains partial and the Chapters1–16 Goal active. This is unmerged and unpublished.\",\n+            \"dependencies\": [\n+              \"BanditRL.OnlineBregman.quadratic_geometry\",\n+              \"BanditRL.OnlineConvex.sourceProper_of_domain\",\n+              \"BanditRL.OnlinePrescientBregman.iterate_eq_of_source_updates\",\n+              \"BanditRL.OnlinePrescientBregman.source_fixed_regret\"\n+            ]\n+          }\n+        }\n+      ]\n+    }\n+  ],\n+  \"root_import_proposals\": [\n+    {\n+      \"file\": \"BanditRLProof.lean\",\n+      \"append\": \"import BanditRLProof.OnlinePrescientEuclidean\",\n+      \"condition\": \"after independent integration approval; production BODY review bound separately\"\n+    },\n+    {\n+      \"file\": \"Tests.lean\",\n+      \"append\": \"import Tests.OnlinePrescientEuclideanCanary\",\n+      \"condition\": \"Exact eventual path Tests/OnlinePrescientEuclideanCanary.lean confirmed; apply only after complete canary BODY acceptance and integration approval.\"\n+    }\n+  ],\n+  \"atomic_binder_audit\": [\n+    {\n+      \"declaration\": \"BanditRL.OnlineBregman.quadratic_geometry\",\n+      \"binders\": [\n+        {\n+          \"binder\": \"E : Type*\",\n+          \"classification\": \"TYPING\",\n+          \"meaning\": \"Ambient type.\"\n+        },\n+        {\n+          \"binder\": \"[NormedAddCommGroup E]\",\n+          \"classification\": \"STANDING\",\n+          \"meaning\": \"Normed additive group structure.\"\n+        },\n+        {\n+          \"binder\": \"[InnerProductSpace ℝ E]\",\n+          \"classification\": \"STANDING\",\n+          \"meaning\": \"Real inner-product structure.\"\n+        },\n+        {\n+          \"binder\": \"[CompleteSpace E]\",\n+          \"classification\": \"STANDING\",\n+          \"meaning\": \"Completeness for actual gradient API; Hilbert generalization.\"\n+        },\n+        {\n+          \"binder\": \"x : E\",\n+          \"classification\": \"TYPING\",\n+          \"meaning\": \"Arbitrary first divergence argument.\"\n+        },\n+        {\n+          \"binder\": \"y : E\",\n+          \"classification\": \"TYPING\",\n+          \"meaning\": \"Arbitrary derivative point and divergence base.\"\n+        }\n+      ],\n+      \"conclusion_atoms\": [\n+        \"actual HasGradientAt psi y y\",\n+        \"ordered divergence half-square identity\"\n+      ]\n+    },\n+    {\n+      \"declaration\": \"BanditRL.OnlinePrescientBregman.euclidean_variable_regret\",\n+      \"binders\": [\n+        {\n+          \"binder\": \"E : Type*\",\n+          \"classification\": \"TYPING\",\n+          \"meaning\": \"Ambient type.\"\n+        },\n+        {\n+          \"binder\": \"[NormedAddCommGroup E]\",\n+          \"classification\": \"STANDING\",\n+          \"meaning\": \"Normed additive group structure.\"\n+        },\n+        {\n+          \"binder\": \"[InnerProductSpace ℝ E]\",\n+          \"classification\": \"STANDING\",\n+          \"meaning\": \"Real inner-product structure.\"\n+        },\n+        {\n+          \"binder\": \"[FiniteDimensional ℝ E]\",\n+          \"classification\": \"STANDING\",\n+          \"meaning\": \"Finite-dimensional source Euclidean setting.\"\n+        },\n+        {\n+          \"binder\": \"V : Set E\",\n+          \"classification\": \"TYPING\",\n+          \"meaning\": \"Feasible set.\"\n+        },\n+        {\n+          \"binder\": \"hV : Convex ℝ V\",\n+          \"classification\": \"SOURCE\",\n+          \"meaning\": \"Convexity of V.\"\n+        },\n+        {\n+          \"binder\": \"hVn : V.Nonempty\",\n+          \"classification\": \"SOURCE\",\n+          \"meaning\": \"Nonempty V.\"\n+        },\n+        {\n+          \"binder\": \"hVc : IsClosed V\",\n+          \"classification\": \"SOURCE\",\n+          \"meaning\": \"Closed V.\"\n+        },\n+        {\n+          \"binder\": \"η : ℕ → ℝ\",\n+          \"classification\": \"TYPING\",\n+          \"meaning\": \"Step schedule.\"\n+        },\n+        {\n+          \"binder\": \"loss : ℕ → E → EReal\",\n+          \"classification\": \"TYPING\",\n+          \"meaning\": \"Time-indexed extended-real losses.\"\n+        },\n+        {\n+          \"binder\": \"x0 : E\",\n+          \"classification\": \"TYPING\",\n+          \"meaning\": \"Initial point; need not be feasible.\"\n+        },\n+        {\n+          \"binder\": \"x : ℕ → E\",\n+          \"classification\": \"TYPING\",\n+          \"meaning\": \"Supplied sequence to identify with the canonical run.\"\n+        },\n+        {\n+          \"binder\": \"T : ℕ\",\n+          \"classification\": \"TYPING\",\n+          \"meaning\": \"Finite horizon; fixed endpoint permits zero.\"\n+        },\n+        {\n+          \"binder\": \"hT : 0 < T\",\n+          \"classification\": \"SOURCE\",\n+          \"meaning\": \"Nonempty horizon for previous-state maximum.\"\n+        },\n+        {\n+          \"binder\": \"hη : ∀ t < T, 0 < η t\",\n+          \"classification\": \"SOURCE\",\n+          \"meaning\": \"Positive played steps.\"\n+        },\n+        {\n+          \"binder\": \"hinit : x 0 = x0\",\n+          \"classification\": \"SOURCE\",\n+          \"meaning\": \"Initialization agreement.\"\n+        },\n+        {\n+          \"binder\": \"hmono : ∀ t, t+1<T → η(t+1)≤η t\",\n+          \"classification\": \"SOURCE\",\n+          \"meaning\": \"Nonincrease between consecutive played steps.\"\n+        },\n+        {\n+          \"binder\": \"hbot : ∀ t<T, ∀ z, loss t z ≠ ⊥\",\n+          \"classification\": \"SOURCE\",\n+          \"meaning\": \"Global no-bottom source codomain at each played round.\"\n+        },\n+        {\n+          \"binder\": \"hdom : ∀ t<T, V ⊆ effectiveDomain(loss t)\",\n+          \"classification\": \"SOURCE\",\n+          \"meaning\": \"Finite on V, together with hbot.\"\n+        },\n+        {\n+          \"binder\": \"hs : ∀ t<T, ∀ z∈V, (SourceSubdifferential (loss t) z).Nonempty\",\n+          \"classification\": \"SOURCE\",\n+          \"meaning\": \"Ambient global supporting vectors at every feasible point.\"\n+        },\n+        {\n+          \"binder\": \"hmin : ∀ t<T, x(t+1)∈V ∧ IsMinOn actual_quadratic_objective V (x(t+1))\",\n+          \"classification\": \"SOURCE\",\n+          \"meaning\": \"Actual feasible attained update; one conjunction binder in the frozen header, with membership and minimum audited separately below.\"\n+        },\n+        {\n+          \"binder\": \"u : E\",\n+          \"classification\": \"TYPING\",\n+          \"meaning\": \"Universally quantified comparator parameter, not a single fixed numerical fixture.\"\n+        },\n+        {\n+          \"binder\": \"hu : u∈V\",\n+          \"classification\": \"SOURCE\",\n+          \"meaning\": \"Feasibility of the arbitrary comparator.\"\n+        }\n+      ],\n+      \"hmin_conjunct_audit\": [\n+        \"x(t+1)∈V\",\n+        \"IsMinOn of the actual same-round quadratic penalized objective at x(t+1)\"\n+      ],\n+      \"conclusion_atoms\": [\n+        \"all t<=T canonical Option iterate=some x(t)\",\n+        \"signed variable regret inequality for universally quantified u with hu\"\n+      ]\n+    },\n+    {\n+      \"declaration\": \"BanditRL.OnlinePrescientBregman.euclidean_fixed_regret\",\n+      \"binders\": [\n+        {\n+          \"binder\": \"E : Type*\",\n+          \"classification\": \"TYPING\",\n+          \"meaning\": \"Ambient type.\"\n+        },\n+        {\n+          \"binder\": \"[NormedAddCommGroup E]\",\n+          \"classification\": \"STANDING\",\n+          \"meaning\": \"Normed additive group structure.\"\n+        },\n+        {\n+          \"binder\": \"[InnerProductSpace ℝ E]\",\n+          \"classification\": \"STANDING\",\n+          \"meaning\": \"Real inner-product structure.\"\n+        },\n+        {\n+          \"binder\": \"[FiniteDimensional ℝ E]\",\n+          \"classification\": \"STANDING\",\n+          \"meaning\": \"Finite-dimensional source Euclidean setting.\"\n+        },\n+        {\n+          \"binder\": \"V : Set E\",\n+          \"classification\": \"TYPING\",\n+          \"meaning\": \"Feasible set.\"\n+        },\n+        {\n+          \"binder\": \"hV : Convex ℝ V\",\n+          \"classification\": \"SOURCE\",\n+          \"meaning\": \"Convexity of V.\"\n+        },\n+        {\n+          \"binder\": \"hVn : V.Nonempty\",\n+          \"classification\": \"SOURCE\",\n+          \"meaning\": \"Nonempty V.\"\n+        },\n+        {\n+          \"binder\": \"hVc : IsClosed V\",\n+          \"classification\": \"SOURCE\",\n+          \"meaning\": \"Closed V.\"\n+        },\n+        {\n+          \"binder\": \"η : ℝ\",\n+          \"classification\": \"TYPING\",\n+          \"meaning\": \"Constant step.\"\n+        },\n+        {\n+          \"binder\": \"hη : 0 < η\",\n+          \"classification\": \"SOURCE\",\n+          \"meaning\": \"Positive constant step.\"\n+        },\n+        {\n+          \"binder\": \"loss : ℕ → E → EReal\",\n+          \"classification\": \"TYPING\",\n+          \"meaning\": \"Time-indexed extended-real losses.\"\n+        },\n+        {\n+          \"binder\": \"x0 : E\",\n+          \"classification\": \"TYPING\",\n+          \"meaning\": \"Initial point; need not be feasible.\"\n+        },\n+        {\n+          \"binder\": \"x : ℕ → E\",\n+          \"classification\": \"TYPING\",\n+          \"meaning\": \"Supplied sequence to identify with the canonical run.\"\n+        },\n+        {\n+          \"binder\": \"T : ℕ\",\n+          \"classification\": \"TYPING\",\n+          \"meaning\": \"Finite horizon; fixed endpoint permits zero.\"\n+        },\n+        {\n+          \"binder\": \"hinit : x 0 = x0\",\n+          \"classification\": \"SOURCE\",\n+          \"meaning\": \"Initialization agreement.\"\n+        },\n+        {\n+          \"binder\": \"hbot : ∀ t<T, ∀ z, loss t z ≠ ⊥\",\n+          \"classification\": \"SOURCE\",\n+          \"meaning\": \"Global no-bottom source codomain at each played round.\"\n+        },\n+        {\n+          \"binder\": \"hdom : ∀ t<T, V ⊆ effectiveDomain(loss t)\",\n+          \"classification\": \"SOURCE\",\n+          \"meaning\": \"Finite on V, together with hbot.\"\n+        },\n+        {\n+          \"binder\": \"hs : ∀ t<T, ∀ z∈V, (SourceSubdifferential (loss t) z).Nonempty\",\n+          \"classification\": \"SOURCE\",\n+          \"meaning\": \"Ambient global supporting vectors at every feasible point.\"\n+        },\n+        {\n+          \"binder\": \"hmin : ∀ t<T, x(t+1)∈V ∧ IsMinOn actual_quadratic_objective V (x(t+1))\",\n+          \"classification\": \"SOURCE\",\n+          \"meaning\": \"Actual feasible attained update; one conjunction binder in the frozen header, with membership and minimum audited separately below.\"\n+        },\n+        {\n+          \"binder\": \"u : E\",\n+          \"classification\": \"TYPING\",\n+          \"meaning\": \"Universally quantified comparator parameter, not a single fixed numerical fixture.\"\n+        },\n+        {\n+          \"binder\": \"hu : u∈V\",\n+          \"classification\": \"SOURCE\",\n+          \"meaning\": \"Feasibility of the arbitrary comparator.\"\n+        }\n+      ],\n+      \"hmin_conjunct_audit\": [\n+        \"x(t+1)∈V\",\n+        \"IsMinOn of the actual same-round quadratic penalized objective at x(t+1)\"\n+      ],\n+      \"conclusion_atoms\": [\n+        \"all t<=T canonical Option iterate=some x(t)\",\n+        \"signed fixed regret inequality for universally quantified u with hu\"\n+      ]\n+    }\n+  ],\n+  \"in_memory_preservation_checks\": [\n+    {\n+      \"file\": \"website/content/chapters.json\",\n+      \"preservation_pre_RAW_sha256\": \"74792b4767d6669e867c9034fc8eb09949360f1a1aaadcdd048ef92cb64eca81\",\n+      \"all_old_parsed_objects_preserved\": true,\n+      \"proposed_after_serialization_sha256\": \"17fe0e096447259511e706179a8ebe5eae4d19a6b26764ccd073d02e287db795\"\n+    },\n+    {\n+      \"file\": \"website/content/readings.json\",\n+      \"preservation_pre_RAW_sha256\": \"cd71475748324e9cab13ff3c0c08cd980a099e7c6ad77431185a367d2fcedde8\",\n+      \"all_old_parsed_objects_preserved\": true,\n+      \"proposed_after_serialization_sha256\": \"fa35944998387cf579ca9b88c71bcf1d73e2b0400335c17cb6938d54a8fa26f2\"\n+    },\n+    {\n+      \"file\": \"website/content/highlights.json\",\n+      \"preservation_pre_RAW_sha256\": \"1c8c3697a21f24c416848938aaf54fdf9cc5566b9277a65fcaa70783bf4c7a5f\",\n+      \"all_old_parsed_objects_preserved\": true,\n+      \"proposed_after_serialization_sha256\": \"671cc9950ce54efeca34a768003d3a20fcdb89915050964d1a5f4ef72cc60916\"\n+    }\n+  ],\n+  \"old_source_card_count\": 21,\n+  \"proposed_source_card_count\": 22,\n+  \"canonical_new_node_ids\": [\n+    \"decla