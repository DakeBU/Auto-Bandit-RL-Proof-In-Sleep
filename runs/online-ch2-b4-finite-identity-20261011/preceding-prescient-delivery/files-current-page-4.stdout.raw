raw_sha256\": \"777826797a512b541d001a488899c6918f9d1404c1ba2f97811a11220648f3fc\",\n+      \"snapshot\": \"type-value-export-v1-OnlinePrescientBregman.lean.snapshot\"\n+    },\n+    {\n+      \"path\": \"BanditRLProof/OnlineBregmanProximal.lean\",\n+      \"raw_sha256\": \"8708aa5e15ff334ce8070cc976634ebaf8dc63314d3da95b502640f68350288f\",\n+      \"snapshot\": \"type-value-export-v1-OnlineBregmanProximal.lean.snapshot\"\n+    },\n+    {\n+      \"path\": \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-headers-v1.txt\",\n+      \"raw_sha256\": \"1d6cda54b46476323dccaeae6fc3b33e8d1494bb655b99045ea2cde569b8e20a\",\n+      \"snapshot\": \"type-value-export-v1-neutral-frozen-headers-v1.txt.snapshot\"\n+    },\n+    {\n+      \"path\": \"runs/online-ch2-prescient-euclidean-20261011/formalizer-core-v1/ExportValuesV1.lean\",\n+      \"raw_sha256\": \"29f6f7399fc97f155ecd92269f546c7822f50188e61d487a29864812d6c782b9\",\n+      \"snapshot\": \"type-value-export-v1-ExportValuesV1.lean.snapshot\"\n+    }\n+  ],\n+  \"inputs_unchanged\": true,\n+  \"stdout_file\": \"type-value-export-v1.stdout\",\n+  \"stderr_file\": \"type-value-export-v1.stderr\",\n+  \"stdout_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n+  \"stderr_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n+  \"helper_sha256\": \"070637efb55c8414d3544c6a7281b235695c91cec2266c1215aa62454a3edc70\",\n+  \"failure_kind\": null,\n+  \"requested_model\": \"GPT-6 Astra\",\n+  \"requested_effort\": \"medium\",\n+  \"runtime_attestation\": false\n+}"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"runs/online-ch2-prescient-euclidean-20261011/formalizer-core-v1/type-value-export-v1.stderr","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/b8a4b13ca96709b1adff0d1907814dc3d3d76cc8/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-core-v1%2Fty