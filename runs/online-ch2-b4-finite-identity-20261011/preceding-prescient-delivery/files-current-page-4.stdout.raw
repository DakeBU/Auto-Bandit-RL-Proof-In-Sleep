regmanRegret.lean.snapshot\": \"415c4c9d3e8b262afd6f849b97afad2b372a7e17233e1ac22dc8f74cc56d038d\",\n+  \"focused-v2-OnlinePrescientBregmanSource.lean.snapshot\": \"57832c9dfb4e915f9a0578ffb122792b0aac2b3404da4f6c00f2aa9fcd36bc02\",\n+  \"focused-v2-OnlinePrescientEuclidean.lean.snapshot\": \"ee487b84aa16057fb1c8b860c4d5d3adc123c7d9ef7d15c8a9bb5f1441c01c19\",\n+  \"focused-v2.json\": \"c4c66242818d597bb96b3deb7bb4e4128d8b7fb6d832758fe0342a668e7f899a\",\n+  \"focused-v2.stderr\": \"c4a27db198c4d8632369ee6102944ef46e83c20d685f7c17a6aaff9cfcfc710f\",\n+  \"focused-v2.stdout\": \"8f4ce2b6ca5457099b23847e479e12c09efe2ccc68c6ffcce5acceb4d860a942\",\n+  \"focused-v3-neutral-frozen-headers-v1.txt.snapshot\": \"1d6cda54b46476323dccaeae6fc3b33e8d1494bb655b99045ea2cde569b8e20a\",\n+  \"focused-v3-OnlineBregmanProximal.lean.snapshot\": \"8708aa5e15ff334ce8070cc976634ebaf8dc63314d3da95b502640f68350288f\",\n+  \"focused-v3-OnlinePrescientBregman.lean.snapshot\": \"777826797a512b541d001a488899c6918f9d1404c1ba2f97811a11220648f3fc\",\n+  \"focused-v3-OnlinePrescientBregmanRegret.lean.snapshot\": \"415c4c9d3e8b262afd6f849b97afad2b372a7e17233e1ac22dc8f74cc56d038d\",\n+  \"focused-v3-OnlinePrescientBregmanSource.lean.snapshot\": \"57832c9dfb4e915f9a0578ffb122792b0aac2b3404da4f6c00f2aa9fcd36bc02\",\n+  \"focused-v3-OnlinePrescientEuclidean.lean.snapshot\": \"9b755a12d540c1039b068e4b97af90ac483a58fd1a8b40af9c806264f95d42b8\",\n+  \"focused-v3.json\": \"1248f42b74020f79189ee50c030d343f2096c4503944de113bb25001e47b74dc\",\n+  \"focused-v3.stderr\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n+  \"focused-v3.stdout\": \"78ccc516daaac787845d0acf0d8122c5b60b89230bda6997826d467b390cd28c\",\n+  \"header-fences-safe-verify-v1.json\": \"3e31cb22e6356b6decfff7837cbfa97b9da96a0436591f1ff58f9546e035d05e\",\n+  \"packaging-correction-v1.json\": \"bd9dae8b7f3bc756f051dadfbfcff6011279fa1c3a8fe78ad5833d9ee0e023c4\",\n+  \"public-probe-v1-neutral-frozen-headers-v1.txt.snapshot\"