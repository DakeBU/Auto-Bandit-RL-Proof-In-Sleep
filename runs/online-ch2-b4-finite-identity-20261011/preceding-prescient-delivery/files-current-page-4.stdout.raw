     \"source_assumptions\": [],\n+        \"created_at\": \"2026-10-11T06:48:52+00:00\"\n+      },\n+      \"safe_verify\": {\n+        \"ok\": true,\n+        \"declaration\": \"quadratic_geometry\",\n+        \"expected_statement_hash\": \"8978b045cdcd1f94ea75d0ab201e4fd29a731c3f9f04b1cbe8dbdc03f16fb38c\",\n+        \"actual_statement_hash\": \"8978b045cdcd1f94ea75d0ab201e4fd29a731c3f9f04b1cbe8dbdc03f16fb38c\",\n+        \"source_assumptions_preserved\": true,\n+        \"findings\": []\n+      }\n+    },\n+    {\n+      \"fence\": {\n+        \"schema_version\": 1,\n+        \"declaration\": \"euclidean_variable_regret\",\n+        \"file\": \"BanditRLProof/OnlinePrescientEuclidean.lean\",\n+        \"statement\": \"theorem euclidean_variable_regret (V : Set E) (hV : Convex ℝ V) (hVn : V.Nonempty) (hVc : IsClosed V) (η : ℕ → ℝ) (loss : ℕ → E → EReal) (x0 : E) (x : ℕ → E) (T : ℕ) (hT : 0 < T) (hη : ∀ t < T, 0 < η t) (hinit : x 0 = x0) (hmono : ∀ t, t + 1 < T → η (t + 1) ≤ η t) (hbot : ∀ t < T, ∀ z, loss t z ≠ ⊥) (hdom : ∀ t < T, V ⊆ BanditRL.OnlineConvex.effectiveDomain (loss t)) (hs : ∀ t < T, ∀ z ∈ V, (BanditRL.OnlineConvex.SourceSubdifferential (loss t) z).Nonempty) (hmin : ∀ t < T, x (t + 1) ∈ V ∧ IsMinOn (fun z => loss t z + ((‖z - x t‖ ^ 2 / (2 * η t) : ℝ) : EReal)) V (x (t + 1))) (u : E) (hu : u ∈ V) : (∀ t ≤ T, iterate V (fun z : E => ‖z‖ ^ 2 / 2) η loss x0 t = some (x t)) ∧ (∑ t ∈ range T, ((loss t (x (t + 1))).toReal - (loss t u).toReal)) ≤ ((range T).sup' (nonempty_range_iff.mpr (Nat.ne_of_gt hT)) (fun t => ‖u - x t‖ ^ 2 / 2)) / η (T - 1) - ∑ t ∈ range T, ‖x (t + 1) - x t‖ ^ 2 / (2 * η t)\",\n+        \"statement_hash\": \"37e429836cbaa1fcf1ade62990d9967b0acfa60188009b7737ed2dcf94878b16\",\n+        \"source_assumptions\": [],\n+        \"created_at\": \"2026-10-11T06:48:52+00:00\"\n+      },\n+      \"safe_verify\": {\n+        \"ok\": true,\n+        \"declaration\": \"euclidean_variable_regret\",\n+        \"expected_statement_hash\": \"37e429836cbaa1fcf1ade62990d9967b0acfa60188009b7737ed2dcf94878b16\",\n+        \"actual_statement_hash\": \"37e429836cbaa1fcf1ade62990d9967b0acfa60188009b7737ed2dcf94878b16\",\n+        \"source_assumptions_preserved\": true,\n+        \"findings\": []\n+      }\n+    },\n+    {\n+      \"fence\": {\n+        \"schema_version\": 1,\n+        \"declaration\": \"euclidean_fixed_regret\",\n+        \"file\": \"BanditRLProof/OnlinePrescientEuclidean.lean\",\n+        \"statement\": \"theorem euclidean_fixed_regret (V : Set E) (hV : Convex ℝ V) (hVn : V.Nonempty) (hVc : IsClosed V) (η : ℝ) (hη : 0 < η) (loss : ℕ → E → EReal) (x0 : E) (x : ℕ → E) (T : ℕ) (hinit : x 0 = x0) (hbot : ∀ t < T, ∀ z, loss t z ≠ ⊥) (hdom : ∀ t < T, V ⊆ BanditRL.OnlineConvex.effectiveDomain (loss t)) (hs : ∀ t < T, ∀ z ∈ V, (BanditRL.OnlineConvex.SourceSubdifferential (loss t) z).Nonempty) (hmin : ∀ t < T, x (t + 1) ∈ V ∧ IsMinOn (fun z => loss t z + ((‖z - x t‖ ^ 2 / (2 * η) : ℝ) : EReal)) V (x (t + 1))) (u : E) (hu : u ∈ V) : (∀ t ≤ T, iterate V (fun z : E => ‖z‖ ^ 2 / 2) (fun _ => η) loss x0 t = some (x t)) ∧ (∑ t ∈ range T, ((loss t (x (t + 1))).toReal - (loss t u).toReal)) ≤ ‖u - x0‖ ^ 2 / (2 * η) - (∑ t ∈ range T, ‖x (t + 1) - x t‖ ^ 2) / (2 * η)\",\n+        \"statement_hash\": \"764b100bc1346eaea8ee843a85e8e0ad37634e7a5588b27224aef70e1d74c464\",\n+        \"source_assumptions\": [],\n+        \"created_at\": \"2026-10-11T06:48:52+00:00\"\n+      },\n+      \"safe_verify\": {\n+        \"ok\": true,\n+        \"declaration\": \"euclidean_fixed_regret\",\n+        \"expected_statement_hash\": \"764b100bc1346eaea8ee843a85e8e0ad37634e7a5588b27224aef70e1d74c464\",\n+        \"actual_statement_hash\": \"764b100bc1346eaea8ee843a85e8e0ad37634e7a5588b27224aef70e1d74c464\",\n+        \"source_assumptions_preserved\": true,\n+        \"findings\": []\n+      }\n+    }\n+  ]\n+}"},{"sha":"aa881e0c9c4b6bf93ec18751a3378a6d5e2d034c","filename":"runs/online-ch2-prescient-euclidean-20261011/formalizer-core-v1/manifest