  GuessingLogLowerProbe.seededPolicy true [] = 1 ∧
    GuessingLogLowerProbe.seededPolicy false [] = 0 ∧
      GuessingLogLowerProbe.coinMeasure {true} = 1 / 2 ∧ GuessingLogLowerProbe.coinMeasure {false} = 1 / 2
