  (loss : Exp3.PredictableLossVector Env Action) {best : Action} (hbest : best ∈ arms) (horizon : ℕ)
  (heta : ∀ t ≤ horizon, 0 < eta t) (heta_le : ∀ t ≤ horizon, eta t ≤ 1 / 2)
  (hetaMono : ∀ t < horizon, eta (t + 1) ≤ eta t) (gap : Action → ℝ) (corruption lambda : ℝ)
  (hlambda : lambda ∈ Set.Icc 0 1)
