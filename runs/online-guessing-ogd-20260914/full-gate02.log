  (source : Exp3.MeasurableFiniteActionDistribution arms prob)
  (hprob : ∀ (history : History), ∀ action ∈ arms, 0 < prob history action) (comparator : Action)
  (hcomparator : comparator ∈ arms)
  (hscore : Measurable fun z => Exp3.importanceWeightedLoss (prob z.1) (loss z.1) z.2 comparator)
  (hIntegrable :
    MeasureTheory.Integrable (fun z => Exp3.importanceWeightedLoss (prob z.1) (loss z.1) z.2 comparator)
      (historyMu.compProd (Exp3.finiteActionKernel arms prob source))) :
