  (rewardSource : mdp.MeanCompatibleRewardKernel) (initialTable : DeterministicMarkovPolicyTable mdp)
  (defaultState : State) (varianceProxy : NNReal) (baseVisitFloor : ℝ) :
  let episodes := fun n => selfConsistentScheduledEpisodes mdp varianceProxy baseVisitFloor n;
  have source :=
    selfConsistentScheduledCausalSource mdp initialState rewardSource initialTable defaultState varianceProxy
      baseVisitFloor;
  Measure.map (Function.eval 0) source.trajectoryMeasure =
      rewardSource.iidStochasticTrajectoryFamilyMeasure
