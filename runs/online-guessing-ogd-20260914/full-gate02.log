  (hvalue : Measurable fun input => value input.1 input.2)
  (hvalue_nonneg : ∀ (state : LossState) (action : Action), 0 ≤ value state action)
  (hvalue_le_one : ∀ (state : LossState) (action : Action), value state action ≤ 1) (arms : Finset Action)
  (harms : arms.Nonempty) {best : Action} (hbest : best ∈ arms) (horizon : ℕ)
