  {Env : Type u} {Action : Type v} [MeasurableSpace Env] [MeasurableSpace Action] [MeasurableSingletonClass Action]
  [DecidableEq Action] (mu : Measure (Env × (ℕ → Action × ℝ))) [IsProbabilityMeasure mu] (arms : Finset Action)
  (harms : arms.Nonempty) (eta : ℕ → ℝ) (actualLoss referenceLoss : Exp3.PredictableLossVector Env Action)
  {best : Action} (hbest : best ∈ arms) (baseGap : Action → ℝ) (deviation : ℕ → Env × (ℕ → Action × ℝ) → Action → ℝ)
  (horizon : ℕ)
  (hreferenceGapLaw : Tsallis.HasScheduledExpectedGapLaw mu arms harms eta referenceLoss best baseGap horizon)
  (hdeviation_integrable :
    ∀ t ≤ horizon,
      ∀ action ∈ arms.erase best,
        Integrable
          (fun sample =>
            Tsallis.sampledScheduledHalfTsallisProbabilityAtTime arms harms eta t sample action *
              deviation t sample action)
          mu)
  (hdeviation :
    ∀ t ≤ horizon,
      ∀ (sample : Env × (ℕ → Action × ℝ)),
        ∀ action ∈ arms.erase best,
          |Exp3.predictableLossAt actualLoss t sample action - Exp3.predictableLossAt actualLoss t sample best -
                (Exp3.predictableLossAt referenceLoss t sample action -
                  Exp3.predictableLossAt referenceLoss t sample best)| ≤
            deviation t sample action) :
  ∑ t ∈ Finset.range (horizon + 1),
        ∑ action ∈ arms.erase best,
          baseGap action * Tsallis.sampledScheduledHalfTsallisExpectedProbabilityAt mu arms harms eta t action -
