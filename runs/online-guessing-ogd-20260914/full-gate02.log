info: Tests/Basic.lean:30594:0: BanditRLProof.Exp3.sampledPredictableObservedSuccessor_first_second_moment.{u, v} {Env : Type u} {Action : Type v}
  [MeasurableSpace Env] [StandardBorelSpace Env] [MeasurableSpace Action] [MeasurableSingletonClass Action]
  [StandardBorelSpace Action] [Nonempty Action] [DecidableEq Action] (prior : MeasureTheory.Measure Env)
  [MeasureTheory.IsFiniteMeasure prior] (arms : Finset Action) (harms : arms.Nonempty) (eta gamma : ℝ)
  (hgamma_pos : 0 < gamma) (hgamma_le_one : gamma ≤ 1) (loss : Exp3.PredictableLossVector Env Action) (n : ℕ)
  (comparator : Action) (hcomparator : comparator ∈ arms) :
  have mu :=
    prior.compProd
      (Exp3.sampledImportanceWeightedTrajectoryKernel arms harms eta gamma ⋯ hgamma_le_one loss.environment);
  have history := fun sample => (sample.1, Preorder.frestrictLe n sample.2);
  have prob := fun input => Exp3.sampledHistoryDistribution arms eta gamma n input.2;
  have roundLoss := fun input => loss.successor n input.1 input.2;
  ∫ (sample : Env × (ℕ → Action × ℝ)),
        Exp3.importanceWeightedLoss (prob (history sample)) (fun x => (sample.2 (n + 1)).2) (sample.2 (n + 1)).1
          comparator ∂mu =
      ∫ (input : Env × (↥(Finset.Iic n) → Action × ℝ)),
        roundLoss input comparator ∂MeasureTheory.Measure.map history mu ∧
    ∫ (sample : Env × (ℕ → Action × ℝ)),
        Exp3.mixedSquaredImportanceWeightedLoss arms (prob (history sample)) (fun x => (sample.2 (n + 1)).2)
          (sample.2 (n + 1)).1 ∂mu =
      ∫ (input : Env × (↥(Finset.Iic n) → Action × ℝ)),
        ∑ action ∈ arms, roundLoss input action ^ 2 ∂MeasureTheory.Measure.map history mu
