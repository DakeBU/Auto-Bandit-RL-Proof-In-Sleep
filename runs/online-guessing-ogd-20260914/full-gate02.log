          rewardSource.iidStochasticTrajectoryFamilyMeasure
            ((heterogeneousSuccessorTable defaultState
                  (fun k => selfConsistentScheduledRewardBudget mdp varianceProxy baseVisitFloor k)
                  (fun k => selfConsistentScheduledTransitionBudget mdp varianceProxy baseVisitFloor k) n
                  history).exploratoryPolicy
              (AdaptiveEpisodeBatchSource.decayingExplorationRate (n + 1)) ⋯)
            initialState (episodes (n + 1))) ∧
      (∀ (n : ℕ),
          ⇑(condDistrib (fun trajectory => trajectory (n + 1)) (Preorder.frestrictLe n)
                source.trajectoryMeasure) =ᶠ[ae (Measure.map (Preorder.frestrictLe n) source.trajectoryMeasure)]
            ⇑(source.batchKernel n)) ∧
        (∀ (n : ℕ),
            Measure.map (Preorder.frestrictLe n) source.trajectoryMeasure ⊗ₘ source.batchKernel n =
              Measure.map (fun trajectory => (Preorder.frestrictLe n trajectory, trajectory (n + 1)))
                source.trajectoryMeasure) ∧
          ∀ (m n : ℕ) (hmn : m ≤ n),
            Measure.map (Preorder.frestrictLe₂ hmn) (Measure.map (Preorder.frestrictLe n) source.trajectoryMeasure) =
              Measure.map (Preorder.frestrictLe m) source.trajectoryMeasure
