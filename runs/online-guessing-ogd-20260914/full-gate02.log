  {K : ℕ} (model : FiniteBanditModel K) (armLaw : ℕ → Fin K → Measure ℚ)
  (hprob : ∀ (t : ℕ) (arm : Fin K), IsProbabilityMeasure (armLaw t arm))
  (hbound : ∀ (t : ℕ) (arm : Fin K), ∀ᵐ (reward : ℚ) ∂armLaw t arm, ↑reward ∈ Set.Icc 0 1)
  (meanDeviation : ℕ → Fin K → ℝ)
  (hmeanDeviation :
    ∀ (t : ℕ) (arm : Fin K),
      |Tsallis.finiteArmIndependentRewardMean armLaw t arm - ↑(model.mean arm)| ≤ meanDeviation t arm)
  (hsuboptimal : (Finset.univ.erase model.bestArm).Nonempty)
  (hgapPos : ∀ (arm : Fin K), arm ≠ model.bestArm → 0 < ↑(model.gap arm))
  (hgapLeOne : ∀ (arm : Fin K), arm ≠ model.bestArm → ↑(model.gap arm) ≤ 1) (horizon : ℕ)
  (hwindow : Tsallis.finiteArmIndependentDriftingMeanRefinedCorruptionWindow model horizon meanDeviation) :
  have law := Tsallis.finiteArmIndependentRewardVectorLaw armLaw;
  let value := fun x => Tsallis.finiteArmIIDRewardVectorLoss;
  have loss := Tsallis.iidTimeVaryingLossStatePredictableLossVector value ⋯ ⋯ ⋯;
  have selector := ⋯;
  have prior := Measure.infinitePi law;
  have mu :=
    prior ⊗ₘ
      Tsallis.sampledScheduledHalfTsallisTrajectoryKernel Finset.univ ⋯ Tsallis.sampledScheduledHalfTsallisSqrtSchedule
        ⋯ loss.environment;
  have reciprocalGap := ∑ arm ∈ Finset.univ.erase model.bestArm, 1 / ↑(model.gap arm);
  have horizonMass := ↑(horizon + 1);
  have scale := 2 * ↑(Finset.univ.erase model.bestArm).card * horizonMass;
  have corruption := Tsallis.finiteArmIndependentMeanDeviationBudget model horizon meanDeviation;
  integral mu
      (Tsallis.sampledScheduledHalfTsallisPredictableEnvironmentRegret Finset.univ ⋯
        Tsallis.sampledScheduledHalfTsallisSqrtSchedule loss (Tsallis.pointMass model.bestArm) horizon) ≤
    1 + Real.log horizonMass +
      10 * √(corruption * reciprocalGap) * (2 + √(Real.log (scale / (corruption * reciprocalGap)) + 1))
