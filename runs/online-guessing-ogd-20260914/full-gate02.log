  (hstate : ∀ (n : ℕ), Measurable (state n)) (mean : Context → Action → ℚ) (varianceProxy : Context → Action → NNReal)
  (law : RewardKernel.CenteredRewardKernelLaw rewardKernel mean varianceProxy)
