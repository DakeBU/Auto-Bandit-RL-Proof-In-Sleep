usage: bandit.py trial-log [-h] --task TASK --role ROLE --kind KIND --status
                           STATUS [--notes NOTES] [--lean LEAN]
                           [--source SOURCE] [--run-id RUN_ID]
                           [--changed-file CHANGED_FILE]
                           [--statement-hash STATEMENT_HASH]
                           [--parent-id PARENT_ID]
                           [--route-fingerprint ROUTE_FINGERPRINT]
                           [--verifier-evidence VERIFIER_EVIDENCE]
                           [--harness {hierarchical,master-worker}]
                           [--experiment-id EXPERIMENT_ID]
                           [--target-fingerprint TARGET_FINGERPRINT]
                           [--route-packet-hash ROUTE_PACKET_HASH]
                           [--attempt-id ATTEMPT_ID] [--worker-id WORKER_ID]
                           [--progress-class {unreviewed,no-progress,diagnostic,retrieval-reuse,statement-repair,compiled-leaf,closed-frontier,terminal}]
                           [--reviewer-validated]
                           [--obligations-before OBLIGATIONS_BEFORE]
                           [--obligations-after OBLIGATIONS_AFTER]
                           [--new-declaration NEW_DECLARATION]
                           [--reused-declaration REUSED_DECLARATION]
                           [--dag-nodes DAG_NODES] [--dag-depth DAG_DEPTH]
                           [--elapsed-seconds ELAPSED_SECONDS]
                           [--lean-check-seconds LEAN_CHECK_SECONDS]
                           [--prompt-chars PROMPT_CHARS]
                           [--input-tokens INPUT_TOKENS]
                           [--output-tokens OUTPUT_TOKENS]
                           [--error-signature ERROR_SIGNATURE]

