, ((loss t (x (t + 1))).toReal - (loss t u).toReal)) ≤\n+      ((range T).sup' (nonempty_range_iff.mpr (Nat.ne_of_gt hT))\n+        (fun t => ‖u - x t‖ ^ 2 / 2)) / η (T - 1) -\n+      ∑ t ∈ range T, ‖x (t + 1) - x t‖ ^ 2 / (2 * η t)\n+\n+theorem euclidean_fixed_regret (V : Set E) (hV : Convex ℝ V)\n+    (hVn : V.Nonempty) (hVc : IsClosed V)\n+    (η : ℝ) (hη : 0 < η) (loss : ℕ → E → EReal)\n+    (x0 : E) (x : ℕ → E) (T : ℕ) (hinit : x 0 = x0)\n+    (hbot : ∀ t < T, ∀ z, loss t z ≠ ⊥)\n+    (hdom : ∀ t < T, V ⊆ BanditRL.OnlineConvex.effectiveDomain (loss t))\n+    (hs : ∀ t < T, ∀ z ∈ V,\n+      (BanditRL.OnlineConvex.SourceSubdifferential (loss t) z).Nonempty)\n+    (hmin : ∀ t < T, x (t + 1) ∈ V ∧\n+      IsMinOn (fun z => loss t z + ((‖z - x t‖ ^ 2 / (2 * η) : ℝ) : EReal))\n+        V (x (t + 1))) (u : E) (hu : u ∈ V) :\n+    (∀ t ≤ T, iterate V (fun z : E => ‖z‖ ^ 2 / 2) (fun _ => η) loss x0 t = some (x t)) ∧\n+    (∑ t ∈ range T, ((loss t (x (t + 1))).toReal - (loss t u).toReal)) ≤\n+      ‖u - x0‖ ^ 2 / (2 * η) -\n+      (∑ t ∈ range T, ‖x (t + 1) - x t‖ ^ 2) / (2 * η)\n+\n+end BanditRL.OnlinePrescientBregman"},{"sha":"909e9d342b82039a887523898cff62ceb786f1b8","filename":"runs/online-ch2-prescient-euclidean-20261011/formalizer-core-v1/focused-v1.json","status":"added","additions":53,"deletions":0,"changes":53,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-core-v1%2Ffocused-v1.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-core-v1%2Ffocused-v1.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-core-v1%2Ffocused-v1.json?ref=2615db818eaca2e88b68d94f3b8a58519b65f5c6","patch":"@@ -0,0 +1,53 @@\n+{\n+  \"argv\