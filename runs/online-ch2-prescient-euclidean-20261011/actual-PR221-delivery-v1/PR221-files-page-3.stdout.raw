type-value-export-v1-OnlinePrescientBregmanSource.lean.snapshot\"\n+    },\n+    {\n+      \"path\": \"BanditRLProof/OnlinePrescientBregmanRegret.lean\",\n+      \"raw_sha256\": \"415c4c9d3e8b262afd6f849b97afad2b372a7e17233e1ac22dc8f74cc56d038d\",\n+      \"snapshot\": \"type-value-export-v1-OnlinePrescientBregmanRegret.lean.snapshot\"\n+    },\n+    {\n+      \"path\": \"BanditRLProof/OnlinePrescientBregman.lean\",\n+      \"raw_sha256\": \"777826797a512b541d001a488899c6918f9d1404c1ba2f97811a11220648f3fc\",\n+      \"snapshot\": \"type-value-export-v1-OnlinePrescientBregman.lean.snapshot\"\n+    },\n+    {\n+      \"path\": \"BanditRLProof/OnlineBregmanProximal.lean\",\n+      \"raw_sha256\": \"8708aa5e15ff334ce8070cc976634ebaf8dc63314d3da95b502640f68350288f\",\n+      \"snapshot\": \"type-value-export-v1-OnlineBregmanProximal.lean.snapshot\"\n+    },\n+    {\n+      \"path\": \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-complete-canary-headers-v1.txt\",\n+      \"raw_sha256\": \"06b896bedf5883f7aea542035a8c8f99de48c79bc9d9972ca57a82226fc0e6df\",\n+      \"snapshot\": \"type-value-export-v1-neutral-frozen-complete-canary-headers-v1.txt.snapshot\"\n+    },\n+    {\n+      \"path\": \"runs/online-ch2-prescient-euclidean-20261011/formalizer-canary-v1/ExportValuesV1.lean\",\n+      \"raw_sha256\": \"8add35553e9e421bfb95b10d873024fcffc1f26697e47305be42405549f4ff79\",\n+      \"snapshot\": \"type-value-export-v1-ExportValuesV1.lean.snapshot\"\n+    }\n+  ],\n+  \"inputs_unchanged\": true,\n+  \"stdout_file\": \"type-value-export-v1.stdout\",\n+  \"stderr_file\": \"type-value-export-v1.stderr\",\n+  \"stdout_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n+  \"stderr_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n+  \"helper_sha256\": \"7dc6bb10e947d5a344930baa2de493cef0e1dee444a97c5c576236bd6125ee4d\",\n+  \"failure_kind\": null,\n+  \"requested_model\": \"GPT-6 Astra\",\n+  \"requested_effort\": \"medium\",\n+  \"runtime_attestation\": false\n+}"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"runs/online-ch2-prescient-euclidean-20261011/formalizer-canary-v1/type-value-export-v1.stderr","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-canary-v1%2Ftype-value-export-v1.stderr","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-canary-v1%2Ftype-value-export-v1.stderr","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-canary-v1%2Ftype-value-export-v1.stderr?ref=2615db818eaca2e88b68d94f3b8a58519b65f5c6"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"runs/online-ch2-prescient-euclidean-20261011/formalizer-canary-v1/type-value-export-v1.stdout","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-canary-v1%2Ftype-value-export-v1.stdout","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-canary-v1%2Ftype-value-export-v1.stdout","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-canary-v1%2Ftype-value-export-v1.stdout?ref=2615db818eaca2e88b68d94f3b8a58519b65f5c6"},{"sha":"33724b34a175c3711b64c51f8cf62ae1ee849c49","filename":"runs/online-ch2-prescient-euclidean-20261011/formalizer-core-v1/ExportValuesV1.lean","status":"added","additions":29,"deletions":0,"changes":29,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-core-v1%2FExportValuesV1.lean","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-core-v1%2FExportValuesV1.lean","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-core-v1%2FExportValuesV1.lean?ref=2615db818eaca2e88b68d94f3b8a58519b65f5c6","patch":"@@ -0,0 +1,29 @@\n+import BanditRLProof.OnlinePrescientEuclidean\n+import Lean\n+import Lean.Util.FoldConsts\n+open Lean\n+\n+def constants (e : Expr) : Array Name :=\n+  e.getUsedConstantsAsSet.toArray.qsort (fun a b => a.toString < b.toString)\n+\n+unsafe def main (args : List String) : IO UInt32 := do\n+  let [output] := args | throw <| IO.userError \"expected one create-only output path\"\n+  if ← System.FilePath.pathExists output then throw <| IO.userError \"output already exists\"\n+  Lean.initSearchPath (← Lean.findSysroot)\n+  Lean.enableInitializersExecution\n+  let env ← Lean.importModules #[{module := `BanditRLProof.OnlinePrescientEuclidean}] {}\n+    (loadExts := true)\n+  let mut nodes : Array Json := #[]\n+  for n in #[`BanditRL.OnlineBregman.quadratic_geometry, `BanditRL.OnlinePrescientBregman.euclidean_variable_regret, `BanditRL.OnlinePrescientBregman.euclidean_fixed_regret] do\n+    let some info := env.find? n | throw <| IO.userError s!\"missing {n}\"\n+    let some value := info.value? (allowOpaque := true) | throw <| IO.userError s!\"no VALUE {n}\"\n+    nodes := nodes.push <| Json.mkObj [\n+      (\"declaration\",toJson n.toString), (\"has_value\",toJson true),\n+      (\"TYPE_constants\",toJson <| (constants info.type).map Name.toString),\n+      (\"VALUE_constants\",toJson <| (constants value).map Name.toString)]\n+  IO.FS.writeFile output ((Json.mkObj [\n+    (\"source\",toJson \"actual compiled environment\"),\n+    (\"lean_version\",toJson Lean.versionString),\n+    (\"nodes\",Json.arr nodes),\n+    (\"boundary\",toJson \"Three complete compiled production declarations TYPE/VALUE constant sets. Occurrence is not necessity, a complete transitive dependency graph, source acceptance or library utility. Imported-module membership is not a theorem implication.\")]).pretty ++ \"\\n\")\n+  return 0"},{"sha":"0eb434a027b0a89e345d2b2dc34e24617be5b1be","filename":"runs/online-ch2-prescient-euclidean-20261011/formalizer-core-v1/PublicProbeV1.lean","status":"added","additions":11,"deletions":0,"changes":11,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-core-v1%2FPublicProbeV1.lean","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-core-v1%2FPublicProbeV1.lean","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-core-v1%2FPublicProbeV1.lean?ref=2615db818eaca2e88b68d94f3b8a58519b65f5c6","patch":"@@ -0,0 +1,11 @@\n+import BanditRLProof.OnlinePrescientEuclidean\n+set_option pp.universes true\n+#check BanditRL.OnlineBregman.quadratic_geometry\n+#print BanditRL.OnlineBregman.quadratic_geometry\n+#print axioms BanditRL.OnlineBregman.quadratic_geometry\n+#check BanditRL.OnlinePrescientBregman.euclidean_variable_regret\n+#print BanditRL.OnlinePrescientBregman.euclidean_variable_regret\n+#print axioms BanditRL.OnlinePrescientBregman.euclidean_variable_regret\n+#check BanditRL.OnlinePrescientBregman.euclidean_fixed_regret\n+#print BanditRL.OnlinePrescientBregman.euclidean_fixed_regret\n+#print axioms BanditRL.OnlinePrescientBregman.euclidean_fixed_regret"},{"sha":"d8fbf77e24e4a39cc0fd4eaf0f3c211e0fbf4c37","filename":"runs/online-ch2-prescient-euclidean-20261011/formalizer-core-v1/capture-v1.py","status":"added","additions":19,"deletions":0,"changes":19,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-core-v1%2Fcapture-v1.py","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-core-v1%2Fcapture-v1.py","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-core-v1%2Fcapture-v1.py?ref=2615db818eaca2e88b68d94f3b8a58519b65f5c6","patch":"@@ -0,0 +1,19 @@\n+from pathlib import Path\n+import subprocess,json,hashlib,datetime,sys,os\n+ROOT=Path(__file__).resolve().parents[3]\n+OUT=Path(__file__).resolve().parent\n+label=sys.argv[1]; argv=sys.argv[2:]\n+assert label and not (OUT/(label+'.json')).exists()\n+inputs=[]\n+for rel in ['BanditRLProof/OnlinePrescientEuclidean.lean','BanditRLProof/OnlinePrescientBregmanSource.lean','BanditRLProof/OnlinePrescientBregmanRegret.lean','BanditRLProof/OnlinePrescientBregman.lean','BanditRLProof/OnlineBregmanProximal.lean','docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-headers-v1.txt']:\n+ p=ROOT/rel; b=p.read_bytes();snap=OUT/(label+'-'+p.name+'.snapshot')\n+ with snap.open('xb') as f:f.write(b)\n+ inputs.append(dict(path=rel,raw_sha256=hashlib.sha256(b).hexdigest(),snapshot=snap.name))\n+start=datetime.datetime.now(datetime.timezone.utc).isoformat()\n+p=subprocess.run(argv,cwd=str(ROOT),stdout=subprocess.PIPE,stderr=subprocess.PIPE,env=dict(os.environ,PYTHONDONTWRITEBYTECODE='1',PYTHONIOENCODING='utf-8'))\n+end=datetime.datetime.now(datetime.timezone.utc).isoformat()\n+for key,b in [('stdout',p.stdout),('stderr',p.stderr)]:\n+ with (OUT/(label+'.'+key)).open('xb') as f:f.write(b)\n+row=dict(argv=argv,cwd=str(ROOT),start_utc=start,end_utc=end,actual_exit=p.returncode,inputs=inputs,inputs_unchanged=all(hashlib.sha256((ROOT/x['path']).read_bytes()).hexdigest()==x['raw_sha256'] for x in inputs),stdout_file=label+'.stdout',stderr_file=label+'.stderr',stdout_sha256=hashlib.sha256(p.stdout).hexdigest(),stderr_sha256=hashlib.sha256(p.stderr).hexdigest(),helper_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),failure_kind='IMPLEMENTATION_FAILED' if p.returncode else None,requested_model='GPT-6 Astra',requested_effort='medium',runtime_attestation=False)\n+with (OUT/(label+'.json')).open('xb') as f:f.write((json.dumps(row,indent=2)+'\\n').encode('utf-8'))\n+print(json.dumps(row))"},{"sha":"b0a267f37d00ca431fdc965aa23e0f5ad1cecb2e","filename":"runs/online-ch2-prescient-euclidean-20261011/formalizer-core-v1/capture-v2.py","status":"added","additions":19,"deletions":0,"changes":19,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-core-v1%2Fcapture-v2.py","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-core-v1%2Fcapture-v2.py","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-core-v1%2Fcapture-v2.py?ref=2615db818eaca2e88b68d94f3b8a58519b65f5c6","patch":"@@ -0,0 +1,19 @@\n+from pathlib import Path\n+import subprocess,json,hashlib,datetime,sys,os\n+ROOT=Path(__file__).resolve().parents[3]\n+OUT=Path(__file__).resolve().parent\n+label=sys.argv[1]; argv=sys.argv[2:]\n+assert label and not (OUT/(label+'.json')).exists()\n+inputs=[]\n+for rel in ['BanditRLProof/OnlinePrescientEuclidean.lean','BanditRLProof/OnlinePrescientBregmanSource.lean','BanditRLProof/OnlinePrescientBregmanRegret.lean','BanditRLProof/OnlinePrescientBregman.lean','BanditRLProof/OnlineBregmanProximal.lean','docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-headers-v1.txt'] + [a for a in argv if a.endswith('.lean') and (ROOT/a).is_file()]:\n+ p=ROOT/rel; b=p.read_bytes();snap=OUT/(label+'-'+p.name+'.snapshot')\n+ with snap.open('xb') as f:f.write(b)\n+ inputs.append(dict(path=rel,raw_sha256=hashlib.sha256(b).hexdigest(),snapshot=snap.name))\n+start=datetime.datetime.now(datetime.timezone.utc).isoformat()\n+p=subprocess.run(argv,cwd=str(ROOT),stdout=subprocess.PIPE,stderr=subprocess.PIPE,env=dict(os.environ,PYTHONDONTWRITEBYTECODE='1',PYTHONIOENCODING='utf-8'))\n+end=datetime.datetime.now(datetime.timezone.utc).isoformat()\n+for key,b in [('stdout',p.stdout),('stderr',p.stderr)]:\n+ with (OUT/(label+'.'+key)).open('xb') as f:f.write(b)\n+row=dict(argv=argv,cwd=str(ROOT),start_utc=start,end_utc=end,actual_exit=p.returncode,inputs=inputs,inputs_unchanged=all(hashlib.sha256((ROOT/x['path']).read_bytes()).hexdigest()==x['raw_sha256'] for x in inputs),stdout_file=label+'.stdout',stderr_file=label+'.stderr',stdout_sha256=hashlib.sha256(p.stdout).hexdigest(),stderr_sha256=hashlib.sha256(p.stderr).hexdigest(),helper_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),failure_kind='IMPLEMENTATION_FAILED' if p.returncode else None,requested_model='GPT-6 Astra',requested_effort='medium',runtime_attestation=False)\n+with (OUT/(label+'.json')).open('xb') as f:f.write((json.dumps(row,indent=2)+'\\n').encode('utf-8'))\n+print(json.dumps(row))"},{"sha":"20b65dcccf4f02cfea7cac25e148d22f90f8a186","filename":"runs/online-ch2-prescient-euclidean-20261011/formalizer-core-v1/compiled-candidate-summary-v1.json","status":"added","additions":159,"deletions":0,"changes":159,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-core-v1%2Fcompiled-candidate-summary-v1.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-core-v1%2Fcompiled-candidate-summary-v1.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-core-v1%2Fcompiled-candidate-summary-v1.json?ref=2615db818eaca2e88b68d94f3b8a58519b65f5c6","patch":"@@ -0,0 +1,159 @@\n+{\n+  \"status\": \"focused compiled candidate only; independent BODY/canaries/combined gates not accepted here\",\n+  \"requested_model\": \"GPT-6 Astra\",\n+  \"requested_effort\": \"medium\",\n+  \"runtime_attestation\": false,\n+  \"created_utc\": \"2026-10-11T06:50:13.091799+00:00\",\n+  \"source\": {\n+    \"path\": \"BanditRLProof/OnlinePrescientEuclidean.lean\",\n+    \"raw_sha256\": \"9b755a12d540c1039b068e4b97af90ac483a58fd1a8b40af9c806264f95d42b8\",\n+    \"public_declarations\": [\n+      \"BanditRL.OnlineBregman.quadratic_geometry\",\n+      \"BanditRL.OnlinePrescientBregman.euclidean_variable_regret\",\n+      \"BanditRL.OnlinePrescientBregman.euclidean_fixed_regret\"\n+    ],\n+    \"new_public_helpers\": 0\n+  },\n+  \"frozen_headers\": {\n+    \"path\": \"docs/contracts/online-ch2-prescient-euclidean-v1/neutral-frozen-headers-v1.txt\",\n+    \"sha256\": \"1d6cda54b46476323dccaeae6fc3b33e8d1494bb655b99045ea2cde569b8e20a\",\n+    \"full_context_and_statements_equal_after_body_erasure\": true\n+  },\n+  \"preproof_context\": {\n+    \"path\": \"runs/online-ch2-prescient-euclidean-20261011/production-preproof-context-v1/receipt.json\",\n+    \"sha256\": \"a5449e386520464aabed4a3b60b77e05671e798e479f09656e38e58a49a70e87\"\n+  },\n+  \"attempts\": [\n+    {\n+      \"receipt\": \"focused-v1.json\",\n+      \"sha256\": \"492c7eb834a4112d70d1dc3b567e52bb86ddd83cfca4b0f9afbe95a6543437a0\",\n+      \"actual_exit