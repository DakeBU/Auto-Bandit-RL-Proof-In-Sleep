 two canaries only; no global MANIFEST mutation or whole-loop acceptance\",\n+  \"rows\": [\n+    {\n+      \"fence\": {\n+        \"schema_version\": 1,\n+        \"declaration\": \"variable_quadratic_actual_run\",\n+        \"file\": \"Tests/OnlinePrescientEuclideanCanary.lean\",\n+        \"statement\": \"theorem variable_quadratic_actual_run : let V : Set ℝ := Icc 0 2 let loss : ℕ → ℝ → EReal := fun _ z => if z ∈ V then ((z ^ 2 / 2 : ℝ) : EReal) else ⊤ let η : ℕ → ℝ := fun t => if t = 0 then 1 else 1 / 2 let x : ℕ → ℝ := fun t => if t = 0 then 2 else if t = 1 then 1 else 2 / 3 Convex ℝ V ∧ V.Nonempty ∧ IsClosed V ∧ (∀ t, SourceProper (loss t) ∧ IsConvexExtended (loss t) ∧ effectiveDomain (loss t) = V) ∧ (∀ t, ∀ z ∈ V, z ∈ SourceSubdifferential (loss t) z) ∧ loss 0 3 = ⊤ ∧ (loss 0 0).toReal + (loss 0 2).toReal ≠ 2 * (loss 0 1).toReal ∧ (∀ t, 0 < η t) ∧ (∀ t, η (t + 1) ≤ η t) ∧ η 0 = 1 ∧ η 1 = 1 / 2 ∧ x 0 = 2 ∧ x 1 = 1 ∧ x 2 = 2 / 3 ∧ (∀ t < 2, x (t + 1) ∈ V ∧ IsMinOn (fun z => loss t z + ((‖z - x t‖ ^ 2 / (2 * η t) : ℝ) : EReal)) V (x (t + 1))) ∧ (∀ t ≤ 2, iterate V (fun z : ℝ => ‖z‖ ^ 2 / 2) η loss 2 t = some (x t)) ∧ (∑ t ∈ range 2, ((loss t (x (t + 1))).toReal - (loss t 0).toReal)) = 13 / 18 ∧ (∑ t ∈ range 2, ((loss t (x t)).toReal - (loss t 0).toReal)) = 5 / 2 ∧ ‖x 1 - x 0‖ ^ 2 / (2 * η 0) = 1 / 2 ∧ ‖x 2 - x 1‖ ^ 2 / (2 * η 1) = 1 / 9 ∧ (∑ t ∈ range 2, ‖x (t + 1) - x t‖ ^ 2 / (2 * η t)) = 11 / 18 ∧ (∀ u ∈ V, (∑ t ∈ range 2, ((loss t (x (t + 1))).toReal - (loss t u).toReal)) ≤ ((range 2).sup' (nonempty_range_iff.mpr (by decide : (2 : ℕ) ≠ 0)) (fun t => ‖u - x t‖ ^ 2 / 2)) / η 1 - ∑ t ∈ range 2, ‖x (t + 1) - x t‖ ^ 2 / (2 * η t)) ∧ (13 / 18 : ℝ) ≤ 61 / 18\",\n+        \"statement_hash\": \"b9fda01edcd3f6ae53f9366585301f1f1588f3daf27d72f3855c7f8a7ce038db\",\n+        \"source_assumptions\": [],\n+        \"created_at\": \"2026-10-11T07:01:11+00:00\"\n+      },\n+      \"safe_verify\": {\n+        \"ok\": true,\n+        \"declaration\": \"variable_quadratic_actual_run\",\n+        \"expected_statement_hash\": \"b9fda01edcd3f6ae53f9366585301f1f1588f3daf27d72f3855c7f8a7ce038db\",\n+        \"actual_statement_hash\": \"b9fda01edcd3f6ae53f9366585301f1f1588f3daf27d72f3855c7f8a7ce038db\",\n+        \"source_assumptions_preserved\": true,\n+        \"findings\": []\n+      }\n+    },\n+    {\n+      \"fence\": {\n+        \"schema_version\": 1,\n+        \"declaration\": \"fixed_quadratic_actual_run\",\n+        \"file\": \"Tests/OnlinePrescientEuclideanCanary.lean\",\n+        \"statement\": \"theorem fixed_quadratic_actual_run : let V : Set ℝ := Icc 0 2 let loss : ℕ → ℝ → EReal := fun _ z => if z ∈ V then ((z ^ 2 / 2 : ℝ) : EReal) else ⊤ let η : ℕ → ℝ := fun _ => 1 let x : ℕ → ℝ := fun t => if t = 0 then 2 else if t = 1 then 1 else 1 / 2 Convex ℝ V ∧ V.Nonempty ∧ IsClosed V ∧ (∀ t, SourceProper (loss t) ∧ IsConvexExtended (loss t) ∧ effectiveDomain (loss t) = V) ∧ (∀ t, ∀ z ∈ V, z ∈ SourceSubdifferential (loss t) z) ∧ loss 0 3 = ⊤ ∧ (loss 0 0).toReal + (loss 0 2).toReal ≠ 2 * (loss 0 1).toReal ∧ (∀ t, 0 < η t) ∧ (∀ t, η (t + 1) ≤ η t) ∧ η 0 = 1 ∧ η 1 = 1 ∧ x 0 = 2 ∧ x 1 = 1 ∧ x 2 = 1 / 2 ∧ (∀ t < 2, x (t + 1) ∈ V ∧ IsMinOn (fun z => loss t z + ((‖z - x t‖ ^ 2 / (2 * η t) : ℝ) : EReal)) V (x (t + 1))) ∧ (∀ t ≤ 2, iterate V (fun z : ℝ => ‖z‖ ^ 2 / 2) η loss 2 t = some (x t)) ∧ (∑ t ∈ range 2, ((loss t (x (t + 1))).toReal - (loss t 0).toReal)) = 5 / 8 ∧ (∑ t ∈ range 2, ((loss t (x t)).toReal - (loss t 0).toReal)) = 5 / 2 ∧ ‖x 1 - x 0‖ ^ 2 / (2 * η 0) = 1 / 2 ∧ ‖x 2 - x 1‖ ^ 2 / (2 * η 1) = 1 / 8 ∧ (∑ t ∈ range 2, ‖x (t + 1) - x t‖ ^ 2 / (2 * η t)) = 5 / 8 ∧ (∀ u ∈ V, (∑ t ∈ range 2, ((loss t (x (t + 1))).toReal - (loss t u).toReal)) ≤ ‖u - (2 : ℝ)‖ ^ 2 / (2 * 1) - (∑ t ∈ range 2, ‖x (t + 1) - x t‖ ^ 2) / (2 * 1)) ∧ (5 / 8 : ℝ) ≤ 11 / 8\",\n+        \"statement_hash\": \"95ce8c0d1d6b7a37f0a309bedbfb23357db18004ec96a10bbe0cebc38a5bde20\",\n+        \"source_assumptions\": [],\n+        \"created_at\": \"2026-10-11T07:01:11+00:00\"\n+      },\n+      \"safe_verify\": {\n+        \"ok\": true,\n+        \"declaration\": \"fixed_quadratic_actual_run\",\n+        \"expected_statement_hash\": \"95ce8c0d1d6b7a37f0a309bedbfb23357db18004ec96a10bbe0cebc38a5bde20\",\n+        \"actual_statement_hash\": \"95ce8c0d1d6b7a37f0a309bedbfb23357db18004ec96a10bbe0cebc38a5bde20\",\n+        \"source_assumptions_preserved\": true,\n+        \"findings\": []\n+      }\n+    }\n+  ]\n+}"},{"sha":"5641bd807a19f5e197b3bd93008d478b07108159","filename":"runs/online-ch2-prescient-euclidean-20261011/formalizer-canary-v1/manifest-v1.json","status":"added","additions":55,"deletions":0,"changes":55,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-canary-v1%2Fmanifest-v1.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-canary-v1%2Fmanifest-v1.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fformalizer-canary-v1%2Fmanifest-v1.json?ref=2615db818eaca2e88b68d94f3b8a58519b65f5c6","patch":"@@ -0,0 +1,55 @@\n+{\n+  \"capture-v1.py\": \"7dc6bb10e947d5a344930baa2de493cef0e1dee444a97c5c576236bd6125ee4d\",\n+  \"compiled-candidate-summary-v1.json\": \"653a299ab15a4989747aaf20b4fa1beb600e024a94d77f7db60857a6d640210e\",\n+  \"exporter-preparation-encoding-failure-v1.json\": \"a70ec28841d9fcba3882f22bb75d2940997278b07542b2788bb71e03cc1cece4\",\n+  \"ExportValuesV1.lean\": \"8add35553e9e421bfb95b10d873024fcffc1f26697e47305be42405549f4ff79\",\n+  \"focused-v1-neutral-frozen-complete-canary-headers-v1.txt.snapshot\": \"06b896bedf5883f7aea542035a8c8f99de48c79bc9d9972ca57a82226fc0e6df\",\n+  \"focused-v1-OnlineBregmanProximal.lean.snapshot\": \"8708aa5e15ff334ce8070cc976634ebaf8dc63314d3da95b502640f6