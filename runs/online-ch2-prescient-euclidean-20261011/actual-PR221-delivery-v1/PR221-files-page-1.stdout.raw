uctSpace ℝ F] [FiniteDimensional ℝ F] (f : F → EReal) (hf : SourceProper f) (hc : IsConvexExtended f) (x : F) (hx : x ∈ intrinsicInterior ℝ (effectiveDomain f)) : (SourceSubdifferential f x).Nonempty\r\n+lean: BanditRL.OnlineConvex.active_subgradient_support_max [theorem] BanditRLProof/OnlineSubgradientMax.lean:49\r\n+  theorem active_subgradient_support_max {ι : Type*} [Fintype ι] [Nonempty ι] (f : ι → E → EReal) (x : E) : SourceActiveSubgradientUnion f x ⊆ SourceSubdifferential (SourceFiniteMax f) x\r\n+lean: BanditRL.OnlineConvex.subgradient_iff_real_support [theorem] BanditRLProof/OnlineSubgradientMax.lean:74\r\n+  theorem subgradient_iff_real_support (f : E → EReal) (hbot : ∀ y, f y ≠ ⊥) (x : E) (hx : x ∈ effectiveDomain f) (g : E) : g ∈ SourceSubdifferential f x ↔ ∀ y, f y ≠ ⊤ → (f x).toReal + inner ℝ g (y - x) ≤ (f y).toReal\r\n+lean: BanditRL.OnlineConvex.convex_sourceSubdifferential [theorem] BanditRLProof/OnlineSubgradientMax.lean:94\r\n+  theorem convex_sourceSubdifferential (f : E → EReal) (hbot : ∀ y, f y ≠ ⊥) (x : E) (hx : x ∈ effectiveDomain f) : Convex ℝ (SourceSubdifferential f x)\r\n+lean: BanditRL.OnlineConvex.convexHull_active_support_max [theorem] BanditRLProof/OnlineSubgradientMax.lean:123\r\n+  theorem convexHull_active_support_max {ι : Type*} [Fintype ι] [Nonempty ι] (f : ι → E → EReal) (hp : ∀ i, SourceProper (f i)) (x : E) (hx : ∀ i, x ∈ effectiveDomain (f i)) : convexHull ℝ (SourceActiveSubgradientUnion f x) ⊆ SourceSubdifferential (SourceFiniteMax f) x\r\n+lean: BanditRL.OnlineConvex.isClosed_sourceSubdifferential [theorem] BanditRLProof/OnlineSubgradientMax.lean:136\r\n+  theorem isClosed_sourceSubdifferential (f : E → EReal) (hbot : ∀ y, f y ≠ ⊥) (x : E) (hx : x ∈ effectiveDomain f) : IsClosed (SourceSubdifferential f x)\r\n+lean: BanditRL.OnlineConvex.isCompact_sourceSubdifferential [theorem] BanditRLProof/OnlineSubgradientMax.lean:149\r\n+  theorem isCompact_sourceSubdifferential [FiniteDimensional ℝ E] (f : E → EReal) (hp : SourceProper f) (hf : IsConvexExtended f) (x : E) (hx : x ∈ interior (effectiveDomain f)) : IsCompact (SourceSubdifferential f x)\r\n+lean: BanditRL.OnlineConvex.max_support_displacement_compare [theorem] BanditRLProof/OnlineSubgradientMax.lean:250\r\n+  theorem max_support_displacement_compare {ι : Type*} [Fintype ι] [Nonempty ι] (f : ι → E → EReal) (hp : ∀ i, SourceProper (f i)) (x : E) (hx : ∀ i, x ∈ effectiveDomain (f i)) (y : E) (i : ι) (hy : y ∈ effectiveDomain (f i)) (hi : SourceFiniteMax f y = f i y) (g k : E) (hg : g ∈ SourceSubdifferential (SourceFiniteMax f) x) (hk : k ∈ SourceSubdifferential (f i) y) : inner ℝ g (y - x) ≤ inner ℝ k (y - x)\r\n+lean: BanditRL.OnlineConvex.max_subgradient_direction_witness [theorem] BanditRLProof/OnlineSubgradientMax.lean:276\r\n+  theorem max_subgradient_direction_witness [FiniteDimensional ℝ E] {ι : Type*} [Fintype ι] [Nonempty ι] (f : ι → E → EReal) (hp : ∀ i, SourceProper (f i)) (hc : ∀ i, IsConvexExtended (f i)) (x : E) (hx : ∀ i, x ∈ effectiveDomain (f i)) (hcont : ∀ i, ContinuousAt (f i) x) (g d : E) (hg : g ∈ SourceSubdifferential (SourceFiniteMax f) x) : ∃ k ∈ SourceActiveSubgradientUnion f x, inner ℝ g d ≤ inner ℝ k d\r\n+lean: BanditRL.OnlineConvex.theorem_2_26 [theorem] BanditRLProof/OnlineSubgradientMax.lean:369\r\n+  theorem theorem_2_26 [FiniteDimensional ℝ E] {ι : Type*} [Fintype ι] [Nonempty ι] (f : ι → E → EReal) (hp : ∀ i, SourceProper (f i)) (hc : ∀ i, IsConvexExtended (f i)) (x : E) (hx : ∀ i, x ∈ effectiveDomain (f i)) (hcont : ∀ i, ContinuousAt (f i) x) : SourceSubdifferential (SourceFiniteMax f) x = convexHull ℝ (SourceActiveSubgradientUnion f x)\r\n+lean: BanditRL.OnlineSubgradientPolicy.one_step_chain [theorem] BanditRLProof/OnlineSubgradientPolicy.lean:135\r\n+  theorem one_step_chain (V : Domain (E := E)) (η : ℕ → ℝ) (loss : ℕ → E → EReal) (x₁ : E) (p : SupportPolicy (E := E)) (t : ℕ) (hη : 0 < η t) (hloss : BanditRL.OnlineSubgradientDescent.SubdifferentiableOn V (loss t)) (hg : selected V η loss x₁ p t ∈ SourceSubdifferential (loss t) (output V η loss x₁ p t)) (u : E) (hu : u ∈ V.carrier) : η t * ((loss t (output V η loss x₁ p t)).toReal - (loss t u).toReal) ≤ η t * inner ℝ (selected V η loss x₁ p t) (output V η loss x₁ p t - u) ∧ η t * inner ℝ (selected V η loss x₁ p t) (output V η loss x₁ p t - u) ≤ ‖output V η loss x₁ p t - u‖ ^ 2 / 2 - ‖output V η loss x₁ p (t + 1) - u‖ ^ 2 / 2 + (η t) ^ 2 / 2 * ‖selected V η loss x₁ p t‖ ^ 2\r\n+lean: BanditRL.OnlineSubgradientPolicy.one_step [theorem] BanditRLProof/OnlineSubgradientPolicy.lean:150\r\n+  theorem one_step (V : Domain (E := E)) (η : ℕ → ℝ) (loss : ℕ → E → EReal) (x₁ : E) (p : SupportPolicy (E := E)) (t : ℕ) (hη : 0 < η t) (hloss : BanditRL.OnlineSubgradientDescent.SubdifferentiableOn V (loss t)) (hg : selected V η loss x₁ p t ∈ SourceSubdifferential (loss t) (output V η loss x₁ p t)) (u : E) (hu : u ∈ V.carrier) : (loss t (output V η loss x₁ p t)).toReal - (loss t u).toReal ≤ (‖output V η loss x₁ p t - u‖ ^ 2 - ‖output V η loss x₁ p (t + 1) - u‖ ^ 2) / (2 * η t) + η t / 2 * ‖selected V η loss x₁ p t‖ ^ 2\r\n+lean: BanditRL.OnlineConvex.binary_subgradient_decomposition [theorem] BanditRLProof/OnlineSubgradientSum.lean:140\r\n+  theorem binary_subgradient_decomposition (f h : E → EReal) (hpf : SourceProper f) (hph : SourceProper h) (hcf : IsConvexExtended f) (hch : IsConvexExtended h) (x : E) (hfx : ∃ a : ℝ, f x = (a : EReal)) (hhx : ∃ b : ℝ, h x = (b : EReal)) (g : E) (hgs : g ∈ SourceSubdifferential (fun y => f y + h y) x) (hqual : ∃ z : E, z ∈ interior (effectiveDomain f) ∧ z ∈ effectiveDomain h) : ∃ p : E, p ∈ SourceSubdifferential f x ∧ g - p ∈ SourceSubdifferential h x\r\n+lean: BanditRL.OnlineConvex.theorem_2_23_inclusion [theorem] BanditRLProof/OnlineSubgradientSum.lean:278\r\n+  theorem theorem_2_23_inclusion {ι : Type*} [Fintype ι] (f : ι → E → EReal) (hp : ∀ i, SourceProper (f i)) (x : E) : SourceSubgradientSum f x ⊆ SourceSubdifferential (fun y => ∑ i, f i y) x\r\n+lean: BanditRL.OnlineConvex.theorem_2_23_equality [theorem] BanditRLProof/OnlineSubgradientSum.lean:294\r\n+  theorem theorem_2_23_equality (n : ℕ) (f : Fin (n + 1) → E → EReal) (hp : ∀ i, SourceProper (f i)) (hc : ∀ i, IsConvexExtended (f i)) (hclosed : ∀ i, SourceClosed (f i)) (hqual : ∃ z : E, z ∈ effectiveDomain (f (Fin.last n)) ∧ ∀ i : Fin (n + 1), i ≠ Fin.last n → z ∈ interior (effectiveDomain (f i))) (x : E) : SourceSubdifferential (fun y => ∑ i, f i y) x = SourceSubgradientSum f x\r\n+lean: BanditRL.OnlineUnitScaling.subgradient_scaled [theorem] BanditRLProof/OnlineUnitScaling.lean:46\r\n+  theorem subgradient_scaled (c : ℝ) (hc : 0 < c) (f : E → EReal) (hf : SourceProper f) (y g : E) (hg : g ∈ SourceSubdifferential f (c • y)) : c • g ∈ SourceSubdifferential (scaledLoss c f) y\r"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"runs/online-ch2-prescient-euclidean-20261011/canary-header-preparation/retrieval-04-v1.stderr","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fcanary-header-preparation%2Fretrieval-04-v1.stderr","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fcanary-header-preparation%2Fretrieval-04-v1.stderr","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fcanary-header-preparation%2Fretrieval-04-v1.stderr?ref=2615db818eaca2e88b68d94f3b8a58519b65f5c6"},{"sha":"2ddf7d1e009a026f8be6a05da2bb6f0e4d85ac2e","filename":"runs/online-ch2-prescient-euclidean-20261011/canary-header-preparation/retrieval-04-v1.stdout","status":"added","additions":42,"deletions":0,"changes":42,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fcanary-header-preparation%2Fretrieval-04-v1.stdout","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fcanary-header-preparation%2Fretrieval-04-v1.stdout","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fcanary-header-preparation%2Fretrieval-04-v1.stdout?ref=2615db818eaca2e88b68d94f3b8a58519b65f5c6","patch":"@@ -0,0 +1,42 @@\n+BanditRL.OnlineBregman.divergence_extension_eq [theorem] BanditRLProof/OnlinePrescientBregman.lean:11\r\n+  theorem divergence_extension_eq (X : Set E) (ψ φ : E → ℝ) (hEq : EqOn ψ φ X) (a b : E) (ha : a ∈ X) (hb : b ∈ interior X) : divergence ψ a b = divergence φ a b\r\n+BanditRL.OnlinePrescientBregman.advance [def] BanditRLProof/OnlinePrescientBregman.lean:27\r\n+  def advance (V : Set E) (ψ : E → ℝ) (η : ℝ) (f : E → EReal) (x : E) : Option E\r\n+BanditRL.OnlinePrescientBregman.iterate [def] BanditRLProof/OnlinePrescientBregman.lean:33\r\n+  def iterate (V : Set E) (ψ : E → ℝ) (η : ℕ → ℝ) (loss : ℕ → E → EReal) (x0 : E) : ℕ → Option E | 0 => some x0 | t + 1 => (iterate V ψ η loss x0 t).bind (advance V ψ (η t) (loss t))\r\n+BanditRL.OnlinePrescientBregman.advance_some_spec [theorem] BanditRLProof/OnlinePrescientBregman.lean:38\r\n+  theorem advance_some_spec (V : Set E) (ψ : E → ℝ) (η : ℝ) (f : E → EReal) (x p : E) (h : advance V ψ η f x = some p) : p ∈ V ∧ IsMinOn (fun z => f z + ((η⁻¹ * divergence ψ z x : ℝ) : EReal)) V p\r\n+BanditRL.OnlinePrescientBregman.advance_none_iff [theorem] BanditRLProof/OnlinePrescientBregman.lean:47\r\n+  theorem advance_none_iff (V : Set E) (ψ : E → ℝ) (η : ℝ) (f : E → EReal) (x : E) : advance V ψ η f x = none ↔ ¬ ∃ p, p ∈ V ∧ IsMinOn (fun z => f z + ((η⁻¹ * divergence ψ z x : ℝ) : EReal)) V p\r\n+BanditRL.OnlinePrescientBregman.iterate_prefix [theorem] BanditRLProof/OnlinePrescientBregman.lean:61\r\n+  theorem iterate_prefix (V : Set E) (ψ : E → ℝ) (η η' : ℕ → ℝ) (loss loss' : ℕ → E → EReal) (x0 : E) (t : ℕ) (hη : ∀ s < t, η s = η' s) (hloss : ∀ s < t, loss s = loss' s) : iterate V ψ η loss x0 t = iterate V ψ η' loss' x0 t\r\n+BanditRL.OnlinePrescientBregman.iterate_succ_some_spec [theorem] BanditRLProof/OnlinePrescientBregman.lean:73\r\n+  theorem iterate_succ_some_spec (V : Set E) (ψ : E → ℝ) (η : ℕ → ℝ) (loss : ℕ → E → EReal) (x0 p : E) (t : ℕ) (h : iterate V ψ η loss x0 (t + 1) = some p) : ∃ x, iterate V ψ η loss x0 t = some x ∧ p ∈ V ∧ IsMinOn (fun z => loss t z + (((η t)⁻¹ * divergence ψ z x : ℝ) : EReal)) V p\r\n+BanditRL.OnlinePrescientBregman.iterate_no_recovery [theorem] BanditRLProof/OnlinePrescientBregman.lean:82\r\n+  theorem iterate_no_recovery (V : Set E) (ψ : E → ℝ) (η : ℕ → ℝ) (loss : ℕ → E → EReal) (x0 : E) (t k : ℕ) (h : iterate V ψ η loss x0 t = none) : iterate V ψ η loss x0 (t + k) = none\r\n+BanditRL.OnlinePrescientBregman.iterate_complete_of_step_attained [theorem] BanditRLProof/OnlinePrescientBregman.lean:94\r\n+  theorem iterate_complete_of_step_attained (V : Set E) (ψ : E → ℝ) (η : ℕ → ℝ) (loss : ℕ → E → EReal) (x0 : E) (T : ℕ) (hatt : ∀ t < T, ∀ x, iterate V ψ η loss x0 t = some x → ∃ p, p ∈ V ∧ IsMinOn (fun z => loss t z + (((η t)⁻¹ * divergence ψ z x : ℝ) : EReal)) V p) : ∃ p, iterate V ψ η loss x0 T = some p\r\n+BanditRL.OnlinePrescientBregman.iterate_one_step [theorem] BanditRLProof/OnlinePrescientBregman.lean:124\r\n+  theorem iterate_one_step (V : Set E) (hV : Convex ℝ V) (ψ : E → ℝ) (η : ℕ → ℝ) (loss : ℕ → E → EReal) (x0 x p : E) (t : ℕ) (hx : iterate V ψ η loss x0 t = some x) (hp : iterate V ψ η loss x0 (t + 1) = some p) (hη : 0 < η t) (hf : BanditRL.OnlineConvex.SourceProper (loss t)) (hs : ∀ z ∈ V, (BanditRL.OnlineConvex.SourceSubdifferential (loss t) z).Nonempty) (hdx : DifferentiableAt ℝ ψ x) (hdp : DifferentiableAt ℝ ψ p) : ∀ u ∈ V, η t * ((loss t p).toReal - (loss t u).toReal) ≤ divergence ψ u x - divergence ψ u