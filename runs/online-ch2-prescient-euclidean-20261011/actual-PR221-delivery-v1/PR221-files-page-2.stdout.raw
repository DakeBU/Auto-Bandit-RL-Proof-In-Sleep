nt-interior\": 3,\r\n+    \"online-subgradient-max\": 19,\r\n+    \"online-subgradient-sum\": 10,\r\n+    \"online-unit-scaling\": 26,\r\n+    \"probability\": 807,\r\n+    \"thompson\": 297,\r\n+    \"tsallis\": 896,\r\n+    \"ucb\": 586\r\n+  },\r\n+  \"author_count\": 6,\r\n+  \"community_contributor_count\": 0,\r\n+  \"contributor_count\": 6,\r\n+  \"highlight_count\": 500,\r\n+  \"ide_mapping_count\": 500,\r\n+  \"milestone_count\": 97,\r\n+  \"milestone_status_counts\": {\r\n+    \"blocked\": 2,\r\n+    \"compiled\": 86,\r\n+    \"partial\": 8,\r\n+    \"planned\": 1\r\n+  },\r\n+  \"community_entry_count\": 0,\r\n+  \"reading_count\": 40,\r\n+  \"source_theorem_count\": 117,\r\n+  \"textbook_spine_chapter_count\": 5,\r\n+  \"textbook_spine_status_counts\": {\r\n+    \"compiled\": 5\r\n+  },\r\n+  \"banditrlwiki_family_count\": 7,\r\n+  \"banditrlwiki_case_count\": 13,\r\n+  \"banditrlwiki_paper_count\": 19,\r\n+  \"banditrlwiki_theorem_surface_count\": 27,\r\n+  \"banditrlwiki_paper_case_link_count\": 19,\r\n+  \"banditrlwiki_exact_source_audit_count\": 12,\r\n+  \"banditrlwiki_literature_open_count\": 0,\r\n+  \"banditrlwiki_formalization_open_case_count\": 13,\r\n+  \"banditrlwiki_formalization_leaf_count\": 36,\r\n+  \"banditrlwiki_active_source_audit_count\": 2,\r\n+  \"banditrlwiki_literature_status_counts\": {\r\n+    \"asymptotic-matched\": 2,\r\n+    \"minimax-matched\": 2,\r\n+    \"near-minimax\": 8,\r\n+    \"source-audit-pending\": 1\r\n+  },\r\n+  \"banditrlwiki_lean_status_counts\": {\r\n+    \"partial\": 10,\r\n+    \"planned\": 3\r\n+  },\r\n+  \"max_module_slug_length\": 96,\r\n+  \"public_snapshot\": false,\r\n+  \"public_base_url\": \"\",\r\n+  \"source_commit\": \"3b393adb009bc25a2c6e3fa3148bf9a3a2b4c376\",\r\n+  \"source_dirty\": false,\r\n+  \"lean_graph_node_count\": 12126,\r\n+  \"lean_graph_edge_count\": 16268,\r\n+  \"lean_graph_shard_count\": 901,\r\n+  \"lean_graph_max_shard_bytes\": 1182855,\r\n+  \"lean_graph_search_index_bytes\": 1328219,\r\n+  \"proof_graph_benchmark_status\": \"prototype\",\r\n+  \"proof_graph_root_count\": 3,\r\n+  \"cng_candidate_status\": \"partial\",\r\n+  \"cng_structural_discovery_established\": false\r\n+}\r"},{"sha":"b163a07b37600b03094396759906047dca2b0dc6","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/structural-v1/capture-helper.py.txt","status":"added","additions":184,"deletions":0,"changes":184,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fstructural-v1%2Fcapture-helper.py.txt","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fstructural-v1%2Fcapture-helper.py.txt","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fstructural-v1%2Fcapture-helper.py.txt?ref=2615db818eaca2e88b68d94f3b8a58519b65f5c6","patch":"@@ -0,0 +1,184 @@\n+\"\"\"Gate recorder for prescient Euclidean and current-main governance, Python3.8 stdlib; no gate executed by preparation.\"\"\"\n+import argparse\n+import datetime\n+import hashlib\n+import json\n+import os\n+from pathlib import Path\n+import re\n+import subprocess\n+import sys\n+import zipfile\n+\n+\n+def utc():\n+    return datetime.datetime.now(datetime.timezone.utc).isoformat()\n+\n+\n+def digest(data):\n+    return hashlib.sha256(data).hexdigest()\n+\n+\n+def create(path, data):\n+    if not isinstance(data, bytes):\n+        data = (json.dumps(data, ensure_ascii=False, indent=2) + \"\\n\").encode(\"utf-8\")\n+    with path.open(\"xb\") as stream:\n+        stream.write(data)\n+\n+\n+def git(root, *args):\n+    proc = subprocess.run([\"git\"] + list(args), cwd=str(root), stdout=subprocess.PIPE,\n+                          stderr=subprocess.PIPE)\n+    if proc.returncode:\n+        raise RuntimeError(\"git failed: \" + repr(args) + \": \" + proc.stderr.decode(\"utf-8\", \"replace\"))\n+    return proc.stdout\n+\n+\n+def state(root):\n+    return {\"HEAD\": git(root, \"rev-parse\", \"HEAD\").decode().strip(),\n+            \"branch\": git(root, \"branch\", \"--show-current\").decode().strip(),\n+            \"status_porcelain_v1_z_hex\": git(root, \"status\", \"--porcelain=v1\", \"-z\").hex()}\n+\n+\n+def inventory(root, run, owned):\n+    # Start with tracked names, then explicitly filter to current source/input trees below.\n+    names = set(x.decode(\"utf-8\") for x in git(root, \"ls-files\", \"-z\", \"--cached\").split(b\"\\0\") if x)\n+    # Add new source paths, including ignored additions inside actual source trees.\n+    for folder in (\"BanditRLProof\", \"Tests\", \"tools\", \"website/scripts\", \"website/content\",\n+                   \"website/static\", \"research-wiki/contribution-contracts\"):\n+        for path in (root / folder).rglob(\"*\"):\n+            if path.is_file() and \"__pycache__\" not in path.parts:\n+                names.add(path.relative_to(root).as_posix())\n+    for name in (\"BanditRLProof.lean\", \"Tests.lean\", \"lean-toolchain\", \"lakefile.lean\",\n+                 \"lake-manifest.json\", \".gitattributes\"):\n+        names.add(name)\n+    names.update(owned)\n+    contract_roots = [name.rsplit(\"/\", 1)[0] for name in owned if name.startswith(\"docs/contracts/\")]\n+    extra = {\"README.md\", \"AGENTS.md\", \"CONTRIBUTING.md\", \"docs/contribution-contract.schema.json\", \"docs/contributor-codex-contract.md\", \"docs/theorem-publication-protocol.md\", \"docs/contracts/online-book-v1/coverage.json\", \"docs/proof-digestion-protocol.md\", \"docs/evidence-routed-memory-protocol.md\", \"docs/openai-math-assimilation-protocol.md\", \"research-wiki/openai-math-2026-intake.json\", \"runs/process_memory.json\"}\n+    names = {name for name in names if selected_for_zip(name, contract_roots) or name in extra}\n+    result = []\n+    for name in sorted(names):\n+        path = root / name\n+        resolved = path.resolve()\n+        if resolved == run or run in resolved.parents:\n+            continue\n+        if root not in resolved.parents or path.is_symlink() or not path.is_file():\n+            raise RuntimeError(\"Input must be an existing ordinary repository file: \" + name)\n+        data = path.read_bytes()\n+        result.append({\"path\": name, \"raw_sha256\": digest(data), \"bytes\": len(data)})\n+    return result\n+\n+\n+def selected_for_zip(name, contract_roots):\n+    # Historical runs are excluded from both selected RAW inventory and ZIP; clean HEAD binds them.\n+    if name == \"runs/process_memory.json\":\n+        return True\n+    if name.startswith(\"runs/\"):\n+        return False\n+    prefixes = (\"BanditRLProof/\", \"Tests/\", \"tools/\", \"website/scripts/\",\n+                \"website/content/\", \"website/static/\", \"research-wiki/contribution-contracts/\")\n+    exact = {\"BanditRLProof.lean\", \"Tests.lean\", \"lean-toolchain\", \"lakefile.lean\",\n+             \"lake-manifest.json\", \".gitattributes\", \"docs/proof-digestion-protocol.md\", \"docs/evidence-routed-memory-protocol.md\", \"docs/openai-math-assimilation-protocol.md\", \"research-wiki/openai-math-2026-intake.json\"}\n+    return (name in exact or name.startswith(prefixes) or\n+            any(name.startswith(folder.rstrip(\"/\") + \"/\") for folder in contract_roots))\n+\n+\n+def main():\n+    parser = argparse.ArgumentParser()\n+    parser.add_argument(\"--root\", required=True)\n+    parser.add_argument(\"--run\", required=True, help=\"New evidence namespace beneath runs/ or an already ignored tmp/ namespace\")\n+    parser.add_argument(\"--label\", required=True)\n+    parser.add_argument(\"--owned-source\", action=\"append\", default=[])\n+    parser.add_argument(\"--leaf-contract\", action=\"append\", required=True,\n+                        help=\"Current leaf docs/contracts subtree to include in ZIP\")\n+    parser.add_argument(\"argv\", nargs=argparse.REMAINDER)\n+    args = parser.parse_args()\n+    root = Path(args.root).resolve()\n+    run = (root / args.run).resolve()\n+    argv = args.argv[1:] if args.argv[:1] == [\"--\"] else args.argv\n+    if not argv or not re.fullmatch(r\"[A-Za-z0-9][A-Za-z0-9_.-]*\", args.label):\n+        raise RuntimeError(\"Exact argv and safe unique label required\")\n+    if root / \"runs\" not in run.parents and root / \"tmp\" not in run.parents:\n+        raise RuntimeError(\"Evidence namespace must be beneath root/runs/ or root/tmp/\")\n+    if root / \"tmp\" in run.parents:\n+        probe = run.relative_to(root).as_posix() + \"/.capture-ignore-probe\"\n+        result = subprocess.run([\"git\", \"check-ignore\", \"--quiet\", \"--\", probe],\n+                                cwd=str(root), stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n+        if result.returncode != 0:\n+            raise RuntimeError(\"tmp evidence namespace must already be ignored; no ignore rule changes permitted\")\n+    for folder in args.leaf_contract:\n+        resolved = (root / folder).resolve()\n+        if root / \"docs\" / \"contracts\" not in resolved.parents:\n+            raise RuntimeError(\"Leaf contract must be a docs/contracts subtree\")\n+        if not resolved.is_dir():\n+            raise RuntimeError(\"Leaf contract subtree missing\")\n+        args.owned_source.extend(path.relative_to(root).as_posix()\n+                                 for path in resolved.rglob(\"*\") if path.is_file())\n+    dest = run / args.label\n+    dest.mkdir(parents=True, exist_ok=False)\n+    helper = Path(__file__).resolve().read_bytes()\n+    create(dest / \"capture-helper.py.txt\", helper)\n+    record = {\"argv\": argv, \"cwd\": str(root), \"helper_sha256\": digest(helper),\n+              \"evidence_namespace_excluded\": run.relative_to(root).as_posix(),\n+              \"actual_evidence_namespace\": str(run),\n+              \"evidence_port_boundary\": \"Receipts originate here; any later exact copy into RUN requires a separate port manifest. No contemporaneous canonical RUN claim.\",\n+              \"owned_source\": args.owned_source, \"command_started\": False, \"actual_exit\": None,\n+              \"ZIP_is_whole_repository_archive\": False,\n+              \"ZIP_scope\": \"Selected active source/input trees and current leaf contracts; historical runs excluded; curated current runs/process_memory.json included\",\n+              \"full_RAW_inventory_scope\": \"Every library/Test source and enumerated current harness/site source/input tree plus current leaf contracts. Historical archives not separately RAW-hashed (curated current process memory is an active input); committed HEAD and clean Git status bind repository state.\",\n+              \"leaf_contract_roots\": args.leaf_contract}\n+    try:\n+        before = inventory(root, run, args.owned_source)\n+        record[\"pre_git\"] = state(root)\n+        if record[\"pre_git\"][\"status_porcelain_v1_z_hex\"]:\n+            raise RuntimeError(\"Clean committed candidate required before gate\")\n+        create(dest / \"pre-source-inputs.json\", before)\n+        selected = [row for row in before if selected_for_zip(row[\"path\"], args.leaf_contract)]\n+        create(dest / \"pre-selected-ZIP-inputs.json\", selected)\n+        record[\"ZIP_selected_files\"] = len(selected)\n+        record[\"full_RAW_inventory_files\"] = len(before)\n+        with zipfile.ZipFile(str(dest / \"pre-selected-source-raw.zip\"), \"x\", zipfile.ZIP_DEFLATED) as archive:\n+            for row in selected:\n+                data = (root / row[\"path\"]).read_bytes()\n+                if digest(data) != row[\"raw_sha256\"]:\n+                    raise RuntimeError(\"Source changed during snapshot: \" + row[\"path\"])\n+                archive.writestr(row[\"path\"], data)\n+        if any(digest((root / row[\"path\"]).read_bytes()) != row[\"raw_sha256\"] for row in selected):\n+            raise RuntimeError(\"Selected ZIP source changed before command\")\n+        if state(root) != record[\"pre_git\"]:\n+            raise RuntimeError(\"Git changed before command\")\n+        record[\"precommand_check\"] = \"Selected ZIP RAW hashes and Git state; no redundant second full inventory. Full pre/post manifests remain authoritative.\"\n+        record[\"start_utc\"] = utc()\n+        record[\"command_started\"] = True\n+        with (dest / \"stdout.raw\").open(\"xb\") as out, (dest / \"stderr.raw\").open(\"xb\") as err:\n+            proc = subprocess.run(argv, cwd=str(root), stdout=out, stderr=err,\n+                                  env=dict(os.environ, PYTHONDONTWRITEBYTECODE=\"1\"))\n+        record[\"end_utc\"] = utc()\n+        record[\"actual_exit\"] = proc.returncode\n+        after = inventory(root, run, args.owned_source)\n+        create(dest / \"post-source-inputs.json\", after)\n+        record[\"post_git\"] = state(root)\n+        record[\"complete_source_path_set_and_RAW_unchanged\"] = before == after\n+        record[\"HEAD_and_branch_unchanged\"] = all(record[\"pre_git\"][k] == record[\"post_git\"][k]\n+                                                 for k in (\"HEAD\", \"branch\"))\n+        record[\"git_status_unchanged\"] = record[\"pre_git\"] == record[\"post_git\"]\n+        record[\"capture_integrity_ok\"] = before == after and record[\"HEAD_and_branch_unchanged\"] and record[\"git_status_unchanged\"]\n+    except Exception as exc:\n+        record[\"capture_error\"] = repr(exc)\n+        record[\"capture_integrity_ok\"] = False\n+        record.setdefault(\"end_utc\", utc())\n+    for name in (\"stdout.raw\", \"stderr.raw\", \"pre-source-inputs.json\", \"post-source-inputs.json\",\n+                 \"pre-selected-ZIP-inputs.json\", \"pre-selected-source-raw.zip\"):\n+        path = dest / name\n+        if path.exists():\n+            record[name + \"_sha256\"] = digest(path.read_bytes())\n+    create(dest / \"receipt.json\", record)\n+    print(json.dumps({\"receipt\": str(dest / \"receipt.json\"), \"actual_exit\": record[\"actual_exit\"],\n+                      \"capture_integrity_ok\": record[\"capture_integrity_ok\"]}))\n+    if not record[\"capture_integrity_ok\"]:\n+        return 125\n+    return record[\"actual_exit\"] if record[\"actual_exit\"] is not None else 125\n+\n+\n+if __name__ == \"__main__\":\n+    sys.exit(main())"},{"sha":"74d390b9b1749b364d771643ff9d558adb6c7868","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/structural-v1/post-source-inputs.json","status":"added","additions":6612,"deletions":0,"changes":6612,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fstructural-v1%2Fpost-source-inputs.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fstructural-v1%2Fpost-source-inputs.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fstructural-v1%2Fpost-source-inputs.json?ref=2615db818eaca2e88b68d94f3b8a58519b65f5c6"},{"sha":"034253c0b79ee0196f2eb8fefaf8a171bd4d2c22","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/structural-v1/pre-selected-ZIP-inputs.json","status":"added","additions":6577,"deletions":0,"changes":6577,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fstructural-v1%2Fpre-selected-ZIP-inputs.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fstructural-v1%2Fpre-selected-ZIP-inputs.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fstructural-v1%2Fpre-selected-ZIP-inputs.json?ref=2615db818eaca2e88b68d94f3b8a58519b65f5c6"},{"sha":"9bdf9f7adeb339f77491edfa7b202057a67a5f42","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/structural-v1/pre-selected-source-raw.zip","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fstructural-v1%2Fpre-selected-source-raw.zip","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fstructural-v1%2Fpre-selected-source-raw.zip","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fstructural-v1%2Fpre-selected-source-raw.zip?ref=2615db818eaca2e88b68d94f3b8a58519b65f5c6"},{"sha":"74d390b9b1749b364d771643ff9d558adb6c7868","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/structural-v1/pre-source-inputs.json","status":"added","additions":6612,"deletions":0,"changes":6612,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fstructural-v1%2Fpre-source-inputs.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fstructural-v1%2Fpre-source-inputs.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fstructural-v1%2Fpre-source-inputs.json?ref=2615db818eaca2e88b68d94f3b8a58519b65f5c6"},{"sha":"29317fa898d6f29bf643006b87c72e62a3947206","filename":"runs/online-ch2-prescient-euclidean-20261011/final-validation-evidence-v1/gates/structural-v1/receipt.json","status":"added","additions":88,"deletions":0,"changes":88,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fstructural-v1%2Freceipt.json","raw_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/raw/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fstructural-v1%2Freceipt.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Ffinal-validation-evidence-v1%2Fgates%2Fstructural-v1%2Freceipt.json?ref=2615db818eaca2e88b68d94f3b8a58519b65f5c6","patch":"@@ -0,0 +1,88 @@\n+{\n+  \"argv\": [\n+    \"python\",\n+    \"-X\",\n+    \"utf8\",\n+    \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\\\\tmp\\\\online-ch2-prescient-euclidean-structural-20261011\\\\check-prescient-structure-v4.py\",\n+    \"--root\",\n+    \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\",\n+    \"--site\",\n+    \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\\\\tmp\\\\online-ch2-prescient-euclidean-site-20261011-v1\",\n+    \