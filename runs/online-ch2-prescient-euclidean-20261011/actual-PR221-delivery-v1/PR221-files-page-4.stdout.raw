nt-euclidean-20261011%2Fparent-core-integrity-failure-v1%2Freceipt.json","contents_url":"https://api.github.com/repos/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/contents/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fparent-core-integrity-failure-v1%2Freceipt.json?ref=2615db818eaca2e88b68d94f3b8a58519b65f5c6","patch":"@@ -0,0 +1,21 @@\n+{\r\n+  \"utc\": \"2026-10-11T06:51:53.155703+00:00\",\r\n+  \"argv\": [\r\n+    \"python\",\r\n+    \"-X\",\r\n+    \"utf8\",\r\n+    \"-c\",\r\n+    \"from pathlib import Path; import json,hashlib; p=Path('runs/online-ch2-prescient-euclidean-20261011/formalizer-core-v1/manifest-v1.json'); m=json.loads(p.read_bytes()); actual=hashlib.sha256(p.read_bytes()).hexdigest(); assert m['manifest-v1.json']==actual, 'manifest self hash mismatch: listed='+m['manifest-v1.json']+' actual='+actual\"\r\n+  ],\r\n+  \"cwd\": \"E:\\\\ABRL\\\\worktrees\\\\research-online-book\",\r\n+  \"actual_exit\": 1,\r\n+  \"stdout_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\r\n+  \"stderr_sha256\": \"9b68cecb204eb3dfc740961af4ec8454ebc4d5befdbca56cbe0b3a5baaf3f73b\",\r\n+  \"original_observation\": {\r\n+    \"tool_chunk\": \"fc7f7b\",\r\n+    \"actual_exit\": 1,\r\n+    \"diagnostic\": \"AssertionError: manifest-v1.json\",\r\n+    \"original_full_raw_not_saved\": true\r\n+  },\r\n+  \"boundary\": \"Authoritative captured rerun of same integrity mismatch, not original fullraw. IMPLEMENTATION_FAILED packaging issue; source unchanged; v1 retained; successor manifest repair requested. No mathematical route retired.\"\r\n+}\r"},{"sha":"b655c4c5b6740998c901b417eb702eada0e1b71b","filename":"runs/online-ch2-prescient-euclidean-20261011/parent-core-integrity-failure-v1/stderr.raw","status":"added","additions":3,"deletions":0,"changes":3,"blob_url":"https://github.com/DakeBU/Auto-Bandit-RL-Proof-In-Sleep/blob/2615db818eaca2e88b68d94f3b8a58519b65f5c6/runs%2Fonline-ch2-prescient-euclidean-20261011%2Fparent-core-integrity-failure-v1%2Fstderr.