474: /-- The Bochner integral of a real-valued function `f : α → ℝ` is the difference between the
475:   integral of the positive part of `f` and the integral of the negative part of `f`. -/
476: theorem integral_eq_lintegral_pos_part_sub_lintegral_neg_part {f : α → ℝ} (hf : Integrable f μ) :
477:     ∫ a, f a ∂μ =
478:       ENNReal.toReal (∫⁻ a, .ofReal (f a) ∂μ) - ENNReal.toReal (∫⁻ a, .ofReal (-f a) ∂μ) := by
479:   let f₁ := hf.toL1 f
480:   -- Go to the `L¹` space
481:   have eq₁ : ENNReal.toReal (∫⁻ a, ENNReal.ofReal (f a) ∂μ) = ‖Lp.posPart f₁‖ := by
482:     rw [L1.norm_def]
483:     congr 1
484:     apply lintegral_congr_ae
485:     filter_upwards [Lp.coeFn_posPart f₁, hf.coeFn_toL1] with _ h₁ h₂
486:     rw [h₁, h₂, ENNReal.ofReal]
487:     congr 1
488:     apply NNReal.eq
489:     rw [Real.nnnorm_of_nonneg (le_max_right _ _)]
490:     rw [Real.coe_toNNReal', NNReal.coe_mk]
491:   -- Go to the `L¹` space
