684: /-! ### toENNReal -/
685: 
686: /-- `x.toENNReal` returns `x` if it is nonnegative, `0` otherwise. -/
687: noncomputable def toENNReal (x : EReal) : ℝ≥0∞ :=
688:   if x = ⊤ then ⊤
689:   else ENNReal.ofReal x.toReal
690: 
691: @[simp] lemma toENNReal_top : (⊤ : EReal).toENNReal = ⊤ := rfl
692: 
693: @[simp]
694: lemma toENNReal_of_ne_top {x : EReal} (hx : x ≠ ⊤) : x.toENNReal = ENNReal.ofReal x.toReal :=
695:   if_neg hx
696: 
697: @[simp]
698: lemma toENNReal_eq_top_iff {x : EReal} : x.toENNReal = ⊤ ↔ x = ⊤ := by
699:   by_cases h : x = ⊤
700:   · simp [h]
701:   · simp [h, toENNReal]
702: 
703: lemma toENNReal_ne_top_iff {x : EReal} : x.toENNReal ≠ ⊤ ↔ x ≠ ⊤ := toENNReal_eq_top_iff.not
704: 
705: @[simp]
706: lemma toENNReal_of_nonpos {x : EReal} (hx : x ≤ 0) : x.toENNReal = 0 := by
707:   rw [toENNReal, if_neg (fun h ↦ ?_)]
708:   · exact ENNReal.ofReal_of_nonpos (toReal_nonpos hx)
709:   · exact zero_ne_top <| top_le_iff.mp <| h ▸ hx
710: 
711: lemma toENNReal_bot : (⊥ : EReal).toENNReal = 0 := toENNReal_of_nonpos bot_le
712: lemma toENNReal_zero : (0 : EReal).toENNReal = 0 := toENNReal_of_nonpos le_rfl
713: 
714: lemma toENNReal_eq_zero_iff {x : EReal} : x.toENNReal = 0 ↔ x ≤ 0 := by
715:   induction x <;> simp [toENNReal]
716: 
717: lemma toENNReal_ne_zero_iff {x : EReal} : x.toENNReal ≠ 0 ↔ 0 < x := by
718:   simp [toENNReal_eq_zero_iff.not]
719: 
720: @[simp]
721: lemma toENNReal_pos_iff {x : EReal} : 0 < x.toENNReal ↔ 0 < x := by
722:   rw [pos_iff_ne_zero, toENNReal_ne_zero_iff]
723: 
724: @[simp]
725: lemma coe_toENNReal {x : EReal} (hx : 0 ≤ x) : (x.toENNReal : EReal) = x := by
726:   rw [toENNReal]
727:   by_cases h_top : x = ⊤
728:   · rw [if_pos h_top, h_top]
729:     rfl
730:   rw [if_neg h_top]
731:   simp only [coe_ennreal_ofReal, hx, toReal_nonneg, max_eq_left]
732:   exact coe_toReal h_top fun _ ↦ by simp_all only [le_bot_iff, zero_ne_bot]
733: 
734: lemma coe_toENNReal_eq_max {x : EReal} : x.toENNReal = max 0 x := by
735:   rcases le_total 0 x with (hx | hx)
736:   · rw [coe_toENNReal hx, max_eq_right hx]
737:   · rw [toENNReal_of_nonpos hx, max_eq_left hx, coe_ennreal_zero]
738: 
739: @[simp]
740: lemma toENNReal_coe {x : ℝ≥0∞} : (x : EReal).toENNReal = x := by
