330: /-!
331: ### Subtraction
332: 
333: Subtraction on `EReal` is defined by `x - y = x + (-y)`. Since addition is badly behaved at some
334: points, so is subtraction. There is no standard algebraic typeclass involving subtraction that is
335: registered on `EReal`, beyond `SubNegZeroMonoid`, because of this bad behavior.
336: -/
337: 
338: @[simp]
339: theorem bot_sub (x : EReal) : ⊥ - x = ⊥ :=
340:   bot_add x
341: 
342: @[simp]
343: theorem sub_top (x : EReal) : x - ⊤ = ⊥ :=
344:   add_bot x
345: 
346: @[simp]
347: theorem top_sub_bot : (⊤ : EReal) - ⊥ = ⊤ :=
348:   rfl
349: 
350: @[simp]
351: theorem top_sub_coe (x : ℝ) : (⊤ : EReal) - x = ⊤ :=
352:   rfl
353: 
354: @[simp]
355: theorem coe_sub_bot (x : ℝ) : (x : EReal) - ⊥ = ⊤ :=
356:   rfl
357: 
358: @[simp]
359: lemma sub_bot {x : EReal} (h : x ≠ ⊥) : x - ⊥ = ⊤ := by
360:   cases x <;> tauto
361: 
362: @[simp]
363: lemma top_sub {x : EReal} (hx : x ≠ ⊤) : ⊤ - x = ⊤ := by
