936: /-! ### Lemmas used for defining the positive part of an `L¹` function -/
937: 
938: 
939: @[fun_prop]
940: theorem Integrable.pos_part {f : α → ℝ} (hf : Integrable f μ) :
941:     Integrable (fun a => max (f a) 0) μ := by
942:   constructor <;> fun_prop
943: 
944: @[fun_prop]
945: theorem Integrable.neg_part {f : α → ℝ} (hf : Integrable f μ) :
946:     Integrable (fun a => max (-f a) 0) μ :=
947:   hf.neg.pos_part
948: 
949: end PosPart
