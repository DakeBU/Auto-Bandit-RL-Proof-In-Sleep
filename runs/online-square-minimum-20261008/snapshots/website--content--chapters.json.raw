      "slug": "foundations",
      "title": "1. Finite bandits, traces, and regret",
      "short_title": "Foundations",
      "status": "compiled",
      "summary": "The deterministic language shared by the entire project: finite models, action and reward traces, pull counts, gaps, reward sums, pseudo-regret, and count-to-regret decompositions.",
      "audience": "Start here if you know basic probability or machine learning but are new to this Lean library.",
      "completion_definition": "Complete when the deterministic finite-bandit vocabulary, traces, counts, reward sums, gap facts, and regret decompositions compile through the public root and external tests. Probabilistic algorithm laws belong to downstream chapters.",
      "completion_blockers": [
        "No remaining blocker inside the user-approved deterministic scope; probabilistic laws are downstream obligations rather than missing Chapter 1 results."
      ],
      "learning_goals": [
        "Distinguish a deterministic action trace from a probability law over generated traces.",
        "Use pull counts as the bookkeeping interface shared by ETC, UCB, EXP3, and Tsallis routes.",
        "Read the finite-sum identity that regroups time-indexed regret by arm."
      ],
      "module_globs": [
        "BanditRLProof/Core.lean",
        "BanditRLProof/LeafLemmas.lean",
        "BanditRLProof/MathlibWrappers.lean",
