BanditRL.OnlineLearning.lemma_1_2.{u_1} {X : Type u_1} (V : Set X) (loss : ℕ → X → ℝ) (leader : ℕ → X) (T : ℕ)
  (hmem : ∀ (n : ℕ), 0 < n → n ≤ T → leader n ∈ V)
  (hmin :
    ∀ (n : ℕ), 0 < n → n ≤ T → ∀ u ∈ V, ∑ t ∈ Finset.range n, loss t (leader n) ≤ ∑ t ∈ Finset.range n, loss t u) :
