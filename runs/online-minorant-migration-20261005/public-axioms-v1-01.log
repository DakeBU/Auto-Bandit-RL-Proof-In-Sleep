Tests.OnlineConvexMinorant.loss_convex : BanditRL.OnlineConvex.IsConvexExtended Tests.OnlineConvexMinorant.loss
'Tests.OnlineConvexMinorant.loss_convex' depends on axioms: [propext, Classical.choice, Quot.sound]
Tests.OnlineConvexMinorant.loss_domain : BanditRL.OnlineConvex.effectiveDomain Tests.OnlineConvexMinorant.loss =
  Tests.OnlineConvexBarycenter.ray
'Tests.OnlineConvexMinorant.loss_domain' depends on axioms: [propext, Classical.choice, Quot.sound]
Tests.OnlineConvexMinorant.global_minorant : ∃ a b, ∀ (p : ℝ × ℝ), ↑(a p + b) ≤ Tests.OnlineConvexMinorant.loss p
