'BanditRL.OnlineConvex.affine_minorant_of_domain_interior' depends on axioms: [propext, Classical.choice, Quot.sound]
@BanditRL.OnlineConvex.convex_affine_minorant : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : NormedSpace ℝ E] [FiniteDimensional ℝ E] (f : E → EReal),
  (∀ (x : E), f x ≠ ⊥) →
    BanditRL.OnlineConvex.IsConvexExtended f →
      (BanditRL.OnlineConvex.effectiveDomain f).Nonempty → ∃ a b, ∀ (x : E), ↑(a x + b) ≤ f x
'BanditRL.OnlineConvex.convex_affine_minorant' depends on axioms: [propext, Classical.choice, Quot.sound]
Tests.OnlineConvexMinorant.loss : ℝ × ℝ → EReal
'Tests.OnlineConvexMinorant.loss' depends on axioms: [propext, Classical.choice, Quot.sound]
Tests.OnlineConvexMinorant.loss_formula : ∀ (p : ℝ × ℝ),
  Tests.OnlineConvexMinorant.loss p = if p ∈ Tests.OnlineConvexBarycenter.ray then ↑p.1 else ⊤
'Tests.OnlineConvexMinorant.loss_formula' depends on axioms: [propext, Classical.choice, Quot.sound]
Tests.OnlineConvexMinorant.loss_noBot : ∀ (p : ℝ × ℝ), Tests.OnlineConvexMinorant.loss p ≠ ⊥
