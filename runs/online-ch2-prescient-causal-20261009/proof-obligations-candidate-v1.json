  "definitions": [
    {
      "declaration": "BanditRL.OnlinePrescientBregman.advance",
      "exact_definition": "def advance (V : Set E) (ψ : E → ℝ) (η : ℝ) (f : E → EReal) (x : E) : Option E := by\n  classical\n  exact if h : ∃ p, p ∈ V ∧\n      IsMinOn (fun z => f z + ((η⁻¹ * divergence ψ z x : ℝ) : EReal)) V p\n    then some (Classical.choose h) else none",
      "exact_definition_UTF8_sha256": "77e7c82a0b4f2fef253b605c7c201e79267438f80c8edb00d84d03a79c98dcf7"
    },
    {
      "declaration": "BanditRL.OnlinePrescientBregman.iterate",
      "exact_definition": "def iterate (V : Set E) (ψ : E → ℝ) (η : ℕ → ℝ)\n    (loss : ℕ → E → EReal) (x0 : E) : ℕ → Option E\n  | 0 => some x0\n  | t + 1 => (iterate V ψ η loss x0 t).bind (advance V ψ (η t) (loss t))",
      "exact_definition_UTF8_sha256": "c5f4a473a26961efb119e68482c517c3856332bfe21ff10932821ce1967cc6a2"
    }
  ],
