BanditRL.OnlineSubgradientPolicy.regret_fixed.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] (V : Domain) (η : ℝ) (hη : 0 < η) (loss : ℕ → E → EReal) (x₁ : E) (p : SupportPolicy)
  (hx₁ : x₁ ∈ V.carrier) (T : ℕ) (hloss : ∀ t < T, OnlineSubgradientDescent.SubdifferentiableOn V (loss t))
  (hlegal : LegalFeedback V (fun x => η) loss x₁ p T) (u : E) (hu : u ∈ V.carrier) :
  regret V (fun x => η) loss x₁ p u T ≤
    ‖x₁ - u‖ ^ 2 / (2 * η) + η / 2 * ∑ t ∈ Finset.range T, ‖selected V (fun x => η) loss x₁ p t‖ ^ 2 -
      ‖output V (fun x => η) loss x₁ p T - u‖ ^ 2 / (2 * η)
