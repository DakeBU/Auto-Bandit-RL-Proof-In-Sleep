GuessingPolicyProbe.labelsA : ℕ → ℝ
GuessingPolicyProbe.labelsB : ℕ → ℝ
GuessingPolicyProbe.eta : ℕ → ℝ
GuessingPolicyProbe.futureLabels : ℕ → ℝ
GuessingPolicyProbe.futureEta : ℕ → ℝ
GuessingPolicyProbe.V : BanditRL.OnlineGradientDescent.Domain ℝ
GuessingPolicyProbe.a : ℕ → ℝ
