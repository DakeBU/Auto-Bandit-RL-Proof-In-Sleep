@stronglyConvex_support_growth_headerType : {E : Type u_1} →
  [inst : NormedAddCommGroup E] →
    [inst_1 : NormedSpace ℝ E] →
      (f : E → EReal) →
        (V : Set E) →
          (lam : ℝ) →
            SourceProper f →
              Convex ℝ V →
                V ⊆ effectiveDomain f →
                  0 ≤ lam →
                    (∀ x ∈ V,
                        ∀ y ∈ V,
                          ∀ (a : ℝ),
                            0 < a →
                              a < 1 →
                                f (a • x + (1 - a) • y) ≤
                                  ↑a * f x + ↑(1 - a) * f y - ↑(lam / 2 * a * (1 - a) * ‖x - y‖ ^ 2)) →
                      (p : E) → p ∈ V → (g : E →L[ℝ] ℝ) → (∀ z ∈ V, f p + ↑(g (z - p)) ≤ f z) → (q : E) → q ∈ V → Prop
