  have feedbackEnvironment := Thompson.latentArmStreamMeasurableHistoryEnvironment;
  let augmentedBestAction := fun envStream => bestAction envStream.1;
  have augmentedMean := fun envStream arm => mean envStream.1 arm;
  have algorithm := Thompson.uniformReferenceThompsonAlgorithm augmentedPrior feedbackEnvironment augmentedBestAction ⋯;
