  [Nonempty Reward] (prior : Measure Env) [IsProbabilityMeasure prior]
  (environment : Thompson.MeasurableHistoryEnvironment Env Action Reward) (bestAction : Env → Action)
  (hbestAction : Measurable bestAction) (mean : Env → Action → ℝ) (score : Thompson.HistoryActionScore Action Reward)
  (horizon : ℕ)
  (hmeanBest :
    Integrable (fun sample => mean sample.1 (bestAction sample.1))
      (prior ⊗ₘ
        Thompson.canonicalMeasurableEnvironmentTrajectoryKernel
          (Thompson.uniformReferenceThompsonAlgorithm prior environment bestAction hbestAction) environment))
  (hmeanAction :
    ∀ t < horizon,
      Integrable (fun sample => mean sample.1 (Thompson.environmentTrajectoryAction sample t))
        (prior ⊗ₘ
          Thompson.canonicalMeasurableEnvironmentTrajectoryKernel
            (Thompson.uniformReferenceThompsonAlgorithm prior environment bestAction hbestAction) environment))
  (hscoreAction :
    ∀ t < horizon,
      Integrable (fun sample => Thompson.trajectoryHistoryScore score sample t)
        (prior ⊗ₘ
          Thompson.canonicalMeasurableEnvironmentTrajectoryKernel
            (Thompson.uniformReferenceThompsonAlgorithm prior environment bestAction hbestAction) environment))
  (hscoreBest :
    ∀ t < horizon,
      Integrable (fun sample => Thompson.trajectoryBestHistoryScore score bestAction sample t)
        (prior ⊗ₘ
          Thompson.canonicalMeasurableEnvironmentTrajectoryKernel
            (Thompson.uniformReferenceThompsonAlgorithm prior environment bestAction hbestAction) environment)) :
  have algorithm := Thompson.uniformReferenceThompsonAlgorithm prior environment bestAction hbestAction;
  have actualMeasure := prior ⊗ₘ Thompson.canonicalMeasurableEnvironmentTrajectoryKernel algorithm environment;
  ∫ (sample : Env × (ℕ → Action × Reward)),
      Thompson.trajectoryBayesMeanRegret mean bestAction sample horizon ∂actualMeasure =
    ∫ (sample : Env × (ℕ → Action × Reward)),
