  have mu := prior ⊗ₘ Tsallis.sampledScheduledHalfTsallisTrajectoryKernel arms harms eta ⋯ loss.environment;
  integral mu
      (Tsallis.sampledScheduledHalfTsallisPredictableEnvironmentRegret arms harms eta loss (Tsallis.pointMass best)
        horizon) ≤
    ∫ (sample : Env × (ℕ → Action × ℝ)),
          ∑ t ∈ Finset.range (horizon + 1),
            Tsallis.sampledScheduledHalfTsallisAllRatePotentialStabilityBoundAtTime arms harms eta sample t ∂mu +
        Tsallis.halfTsallisPotentialMass arms (Tsallis.initialHalfTsallisDistribution arms harms (eta 0)) /
          eta horizon -
      1 / eta horizon
info: Tests/BookMapChaptersSevenAndEightCanary.lean:193:0: BanditRLProof.Tsallis.integral_sampledScheduledHalfTsallisPredictableEnvironmentRegret_hasSelfBounding_of_fixedGap.{u,
    v}
  {Env : Type u} {Action : Type v} [MeasurableSpace Env] [StandardBorelSpace Env] [MeasurableSpace Action]
  [MeasurableSingletonClass Action] [StandardBorelSpace Action] [Nonempty Action] [DecidableEq Action]
  (prior : Measure Env) [IsProbabilityMeasure prior] (arms : Finset Action) (harms : arms.Nonempty) (eta : ℕ → ℝ)
  (loss : Exp3.PredictableLossVector Env Action) {best : Action} (hbest : best ∈ arms) (gap : Action → ℝ) (horizon : ℕ)
  (hgapLaw :
    ∀ (t : ℕ) (sample : Env × (ℕ → Action × ℝ)),
      ∀ action ∈ arms,
        Exp3.predictableLossAt loss t sample action - Exp3.predictableLossAt loss t sample best = gap action)
  (corruption : ℝ) (hcorruption : 0 ≤ corruption) :
  have selector := ⋯;
  have mu := prior ⊗ₘ Tsallis.sampledScheduledHalfTsallisTrajectoryKernel arms harms eta ⋯ loss.environment;
  ∑ t ∈ Finset.range (horizon + 1),
        ∑ action ∈ arms.erase best,
          gap action * Tsallis.sampledScheduledHalfTsallisExpectedProbabilityAt mu arms harms eta t action -
      corruption ≤
    integral mu
      (Tsallis.sampledScheduledHalfTsallisPredictableEnvironmentRegret arms harms eta loss (Tsallis.pointMass best)
        horizon)
