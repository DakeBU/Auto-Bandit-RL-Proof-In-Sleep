info: Tests/BookMapChaptersFiveAndSixCanary.lean:310:0: BanditRLProof.Thompson.stationaryLatentArmStreamCanonicalTrajectoryMeasure_integral_trajectoryBayesMeanRegret_le.{u}
  {Env : Type u} {K : ℕ} [MeasurableSpace Env] [StandardBorelSpace Env] [Nonempty Env] [NeZero K] (prior : Measure Env)
