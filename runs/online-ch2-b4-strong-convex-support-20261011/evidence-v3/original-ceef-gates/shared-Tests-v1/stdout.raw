  (hbound : ∀ (arm : Fin K), ∀ᵐ (reward : ℚ) ∂armLaw arm, ↑reward ∈ Set.Icc 0 1)
  (hmean : ∀ (arm : Fin K), ∫ (reward : ℚ), ↑reward ∂armLaw arm = ↑(model.mean arm)) (arm : Fin K) :
  Tsallis.iidLossStateMeanGap (Tsallis.finiteArmIIDRewardVectorLaw armLaw) Tsallis.finiteArmIIDRewardVectorLoss
