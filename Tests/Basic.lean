    twoStepSymmetricSource.UniformSubgaussianRewardLaw
      (Concentration.intervalVarianceProxy (-1) 1) :=
  twoStepSymmetricSource.uniformSubgaussianRewardLaw_of_mem_Icc
    (-1) 1 (by
      intro state action
      simpa [twoStepSymmetricSource] using
        symmetricSource_reward_mem_Icc state action)

