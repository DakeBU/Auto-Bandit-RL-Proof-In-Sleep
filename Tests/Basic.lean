      Tsallis.canonicalHalfTsallisScheduleGeneratedSelectorMeasurability
        (Finset.univ : Finset (Fin 2)) Finset.univ_nonempty
        Tsallis.sampledScheduledHalfTsallisSqrtSchedule loss
    let prior := Measure.infinitePi law
    let mu := prior.compProd
      (Tsallis.sampledScheduledHalfTsallisTrajectoryKernel
        (Finset.univ : Finset (Fin 2)) Finset.univ_nonempty
        Tsallis.sampledScheduledHalfTsallisSqrtSchedule
        selector.finiteHistory loss.environment)
    integral mu
        (Tsallis.sampledScheduledHalfTsallisPredictableMovingComparatorEnvironmentRegret
          (Finset.univ : Finset (Fin 2)) Finset.univ_nonempty
          Tsallis.sampledScheduledHalfTsallisSqrtSchedule loss
          (Tsallis.finiteArmIndependentBestArmAt
            driftingTwoArmModelCanary switchingTwoArmLawCanary)
          horizon) <=
      Tsallis.finiteArmIndependentGlobalMeanSwitchCountHorizonCompressedLogDynamicBound
        driftingTwoArmModelCanary switchingTwoArmLawCanary horizon := by
  exact
    Tsallis.integral_sampledScheduledHalfTsallisFiniteArmIndependentGlobalMeanSwitchCountHorizonCompressedDynamicRegret_le_log
      driftingTwoArmModelCanary switchingTwoArmLawCanary
      (fun t arm => by
        simp only [switchingTwoArmLawCanary]
        split_ifs <;> infer_instance)
      (fun t arm => by
        fin_cases arm <;>
          by_cases ht : Even t <;>
          simp [switchingTwoArmLawCanary, ht] <;> norm_num)
      (fun arm => by
        fin_cases arm <;>
          simp [Tsallis.finiteArmIndependentRewardMean,
            switchingTwoArmLawCanary, driftingTwoArmModelCanary] <;>
          norm_num)
      (fun arm harm => by
