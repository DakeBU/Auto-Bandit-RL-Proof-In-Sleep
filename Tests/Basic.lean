noncomputable def distinctMDP : FiniteHorizonRL.MDP Unit Bool where
  horizon := 1
  transition := ProbabilityTheory.Kernel.const _ (Measure.dirac ())
  transition_isMarkov := by infer_instance
  reward _state action := if action then 1 else 0
  measurable_reward := measurable_of_finite _

def distinctStage : Fin distinctMDP.horizon := ⟨0, by simp [distinctMDP]⟩

def falseTable : FiniteHorizonRL.DeterministicMarkovPolicyTable distinctMDP :=
  fun _stage _state => false

def trueTable : FiniteHorizonRL.DeterministicMarkovPolicyTable distinctMDP :=
  fun _stage _state => true

