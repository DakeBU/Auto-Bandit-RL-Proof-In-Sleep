    letI : Nonempty (Fin 2) := ⟨driftingTwoArmModelCanary.bestArm⟩
    let law :=
      Tsallis.finiteArmIndependentRewardVectorLaw switchingTwoArmLawCanary
    let value := fun _ : Nat => Tsallis.finiteArmIIDRewardVectorLoss
    let loss := Tsallis.iidTimeVaryingLossStatePredictableLossVector value
      (fun _ => Tsallis.measurable_finiteArmIIDRewardVectorLoss)
      (fun _ => Tsallis.finiteArmIIDRewardVectorLoss_nonneg)
      (fun _ => Tsallis.finiteArmIIDRewardVectorLoss_le_one)
