theorem symmetricSource_generated_reward_one_mass_eq_half :
    (symmetricSource.stochasticTrajectoryKernelRemaining policy
      mdp.horizon le_rfl ())
        {trace | (trace ⟨0, by simp [mdp]⟩).2.1 = 1} = 1 / 2 := by
  change
    (symmetricSource.stochasticTrajectoryKernelRemaining policy 1 (by simp [mdp]) ())
        {trace : FiniteHorizonRL.RewardStepTrace Unit Unit 1 |
          (trace 0).2.1 = 1} = 1 / 2
  rw [FiniteHorizonRL.MDP.MeanCompatibleRewardKernel.stochasticTrajectoryKernelRemaining]
  have hre : MeasurableSet
      {trace : FiniteHorizonRL.RewardStepTrace Unit Unit 1 |
        (trace 0).2.1 = 1} :=
    (measurableSet_singleton 1).preimage
      ((measurable_snd.fst).comp (measurable_pi_apply 0))
  rw [ProbabilityTheory.Kernel.map_apply'
    _ (FiniteHorizonRL.RewardStepTrace.measurable_cons 0) _ hre]
  have hpreimage :
      (fun p : (Unit × (Real × Unit)) ×
          FiniteHorizonRL.RewardStepTrace Unit Unit 0 => Fin.cons p.1 p.2) ⁻¹'
          {trace : FiniteHorizonRL.RewardStepTrace Unit Unit 1 |
            (trace 0).2.1 = 1} =
        {head : Unit × (Real × Unit) | head.2.1 = 1} ×ˢ Set.univ := by
    ext p
    simp
  rw [hpreimage]
  have hhead : MeasurableSet
      {head : Unit × (Real × Unit) | head.2.1 = 1} :=
    (measurableSet_singleton 1).preimage measurable_snd.fst
  rw [ProbabilityTheory.Kernel.compProd_apply_prod
    hhead MeasurableSet.univ]
  simp
  rw [FiniteHorizonRL.MDP.MeanCompatibleRewardKernel.actionRewardStateKernel]
  have hactionEvent :
      {head : Unit × (Real × Unit) | head.2.1 = 1} =
        Set.univ ×ˢ {rewardState : Real × Unit | rewardState.1 = 1} := by
    ext head
    simp
  rw [hactionEvent]
  have hrewardState : MeasurableSet
      {rewardState : Real × Unit | rewardState.1 = 1} :=
    (measurableSet_singleton 1).preimage measurable_fst
  rw [ProbabilityTheory.Kernel.compProd_apply_prod
    MeasurableSet.univ hrewardState]
  simp [FiniteHorizonIIDEligibleVisitCountPositivityCanary.policy,
    ProbabilityTheory.Kernel.deterministic_apply]
  rw [FiniteHorizonRL.MDP.MeanCompatibleRewardKernel.rewardNextStateKernel]
  have hrewardStateEvent :
      {rewardState : Real × Unit | rewardState.1 = 1} =
        {reward : Real | reward = 1} ×ˢ Set.univ := by
    ext rewardState
    simp
  rw [hrewardStateEvent, ProbabilityTheory.Kernel.prod_apply_prod]
  simp
  rw [symmetricSource]
  simp only [RewardKernel.const]
  change
    (ProbabilityTheory.Kernel.const (Unit × Unit) symmetricRewardMeasure ((), ()))
        {1} = 2⁻¹
  rw [ProbabilityTheory.Kernel.const_apply, symmetricRewardMeasure,
    Measure.map_apply (measurable_of_finite symmetricReward)
      (measurableSet_singleton 1)]
  have hsymmetricPreimage : symmetricReward ⁻¹' ({1} : Set Real) = {true} := by
    ext sample
    cases sample <;> norm_num [symmetricReward]
  rw [hsymmetricPreimage,
    (PMF.uniformOfFintype Bool).toMeasure_apply_singleton true
      (measurableSet_singleton true)]
  norm_num [PMF.uniformOfFintype_apply]

