def trace (action : Bool) : FiniteHorizonRL.RewardStepTrace Bool Unit 1 :=
  fun _stage => (action, if action then 1 else 0, ())

def batch (action : Bool) : FiniteHorizonRL.StochasticEpisodeBatch mdp 1 :=
  fun _episode => ((), trace action)

def constantPrefix (n : Nat) (action : Bool) :
    FiniteHorizonRL.StochasticEpisodeBatchPrefix mdp 1 n :=
  fun _index => batch action

theorem successorPolicy_true_branch (n : Nat) :
    source.successorPolicy n (constantPrefix n true) = truePolicy := by
  simp [source, successorPolicy, firstActionTrue, constantPrefix, batch, trace,
    FiniteHorizonRL.RewardStepTrace.headAction]

theorem successorPolicy_false_branch (n : Nat) :
    source.successorPolicy n (constantPrefix n false) = falsePolicy := by
  simp [source, successorPolicy, firstActionTrue, constantPrefix, batch, trace,
    FiniteHorizonRL.RewardStepTrace.headAction]

theorem batchKernel_true_branch (n : Nat) :
    source.batchKernel n (constantPrefix n true) =
      rewardSource.iidStochasticTrajectoryFamilyMeasure
        truePolicy (Measure.dirac ()) 1 := by
  rw [source.batchKernel_eq_iidStochasticTrajectoryFamilyMeasure,
    successorPolicy_true_branch]
  rfl

theorem batchKernel_false_branch (n : Nat) :
    source.batchKernel n (constantPrefix n false) =
      rewardSource.iidStochasticTrajectoryFamilyMeasure
        falsePolicy (Measure.dirac ()) 1 := by
  rw [source.batchKernel_eq_iidStochasticTrajectoryFamilyMeasure,
    successorPolicy_false_branch]
  rfl

def fullTrajectoryFirstAction
    (trajectory : Unit × FiniteHorizonRL.RewardStepTrace Bool Unit mdp.horizon) :
    Bool :=
  FiniteHorizonRL.RewardStepTrace.headAction
    (Action := Bool) (State := Unit) 0 trajectory.2

theorem stochasticTrajectoryMeasure_map_fullTrajectoryFirstAction
    (policy : FiniteHorizonRL.MarkovPolicy mdp) :
    (rewardSource.stochasticTrajectoryMeasure policy (Measure.dirac ())).map
        fullTrajectoryFirstAction =
      policy.actionKernel ⟨0, by simp [mdp]⟩ () := by
  unfold FiniteHorizonRL.MDP.MeanCompatibleRewardKernel.stochasticTrajectoryMeasure
  rw [Measure.dirac_unit_compProd]
  calc
    Measure.map fullTrajectoryFirstAction
          (Measure.map (Prod.mk ())
            (rewardSource.stochasticTrajectoryKernelRemaining
              policy mdp.horizon le_rfl ())) =
        Measure.map (fullTrajectoryFirstAction ∘ Prod.mk ())
          (rewardSource.stochasticTrajectoryKernelRemaining
            policy mdp.horizon le_rfl ()) :=
      Measure.map_map
        ((FiniteHorizonRL.RewardStepTrace.measurable_headAction 0).comp
          measurable_snd)
        measurable_prodMk_left
    _ = (rewardSource.stochasticTrajectoryKernelRemaining
          policy 1 (by simp [mdp]) ()).map
            (FiniteHorizonRL.RewardStepTrace.headAction
              (Action := Bool) (State := Unit) 0) := by
      rfl
    _ = policy.actionKernel ⟨0, by simp [mdp]⟩ () := by
      simpa [mdp] using
        (rewardSource.stochasticTrajectoryKernelRemaining_map_headAction
          policy 0 (by simp [mdp]) ())

def batchFirstAction
    (trajectories : FiniteHorizonRL.StochasticEpisodeBatch mdp 1) : Bool :=
  fullTrajectoryFirstAction (trajectories 0)

theorem iidStochasticTrajectoryFamilyMeasure_map_batchFirstAction
    (policy : FiniteHorizonRL.MarkovPolicy mdp) :
    (rewardSource.iidStochasticTrajectoryFamilyMeasure
        policy (Measure.dirac ()) 1).map batchFirstAction =
      policy.actionKernel ⟨0, by simp [mdp]⟩ () := by
  calc
    _ = ((rewardSource.iidStochasticTrajectoryFamilyMeasure
          policy (Measure.dirac ()) 1).map (Function.eval (0 : Fin 1))).map
            fullTrajectoryFirstAction := by
      symm
      simpa [batchFirstAction, Function.comp_def] using
        (Measure.map_map
          (μ := rewardSource.iidStochasticTrajectoryFamilyMeasure
            policy (Measure.dirac ()) 1)
          (g := fullTrajectoryFirstAction)
          (f := Function.eval (0 : Fin 1))
          ((FiniteHorizonRL.RewardStepTrace.measurable_headAction 0).comp
            measurable_snd)
          (measurable_pi_apply (0 : Fin 1)))
    _ = (rewardSource.stochasticTrajectoryMeasure
          policy (Measure.dirac ())).map fullTrajectoryFirstAction := by
      rw [rewardSource.iidStochasticTrajectoryFamilyMeasure_map_eval]
    _ = policy.actionKernel ⟨0, by simp [mdp]⟩ () :=
      stochasticTrajectoryMeasure_map_fullTrajectoryFirstAction policy

theorem iidStochasticTrajectoryFamilyMeasure_true_ne_false :
    rewardSource.iidStochasticTrajectoryFamilyMeasure
        truePolicy (Measure.dirac ()) 1 ≠
      rewardSource.iidStochasticTrajectoryFamilyMeasure
        falsePolicy (Measure.dirac ()) 1 := by
  intro heq
  have hmap := congrArg (fun mu => mu.map batchFirstAction) heq
  change (rewardSource.iidStochasticTrajectoryFamilyMeasure
      truePolicy (Measure.dirac ()) 1).map batchFirstAction =
    (rewardSource.iidStochasticTrajectoryFamilyMeasure
      falsePolicy (Measure.dirac ()) 1).map batchFirstAction at hmap
  rw [iidStochasticTrajectoryFamilyMeasure_map_batchFirstAction,
    iidStochasticTrajectoryFamilyMeasure_map_batchFirstAction] at hmap
  have hmass := congrArg (fun mu : Measure Bool => mu ({true} : Set Bool)) hmap
  simpa [truePolicy, falsePolicy,
    ProbabilityTheory.Kernel.deterministic_apply] using hmass

theorem batchKernel_true_ne_false (n : Nat) :
    source.batchKernel n (constantPrefix n true) ≠
      source.batchKernel n (constantPrefix n false) := by
  rw [batchKernel_true_branch, batchKernel_false_branch]
  exact iidStochasticTrajectoryFamilyMeasure_true_ne_false

