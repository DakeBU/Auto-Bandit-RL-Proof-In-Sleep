theorem simultaneousCountConfidenceRadius_lt_one_thousand_twenty_four :
    FiniteHorizonRL.simultaneousCountConfidenceRadius mdp 16384 (1 / 4) <
      1024 := by
  have hsquare := Concentration.subGaussianSumConfidenceRadius_sq
    (FiniteHorizonRL.MarkovPolicy.iidBernoulliVarianceProxy 16384)
    (FiniteHorizonRL.simultaneousCountDelta mdp (1 / 4))
    (by rw [simultaneousCountDelta_eq_one_div_forty_eight]; norm_num)
    (by rw [simultaneousCountDelta_eq_one_div_forty_eight]; norm_num)
  rw [FiniteHorizonRL.MarkovPolicy.iidBernoulliVarianceProxy_eq,
    simultaneousCountDelta_eq_one_div_forty_eight] at hsquare
  norm_num at hsquare
  have hlog : Real.log 96 < 95 := by
    have h := Real.log_lt_sub_one_of_pos (x := (96 : Real))
      (by norm_num) (by norm_num)
    norm_num at h
    exact h
  have hradius_nonneg :
      0 <= FiniteHorizonRL.simultaneousCountConfidenceRadius
        mdp 16384 (1 / 4) :=
    Concentration.subGaussianSumConfidenceRadius_nonneg _ _
  have hradius_eq :
