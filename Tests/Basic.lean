theorem bothRewardsOne_mass_eq_quarter :
    (twoStepSymmetricSource.stochasticTrajectoryKernelRemaining
      twoStepPolicy 2 (by simp [twoStepMDP]) ())
      {trace | (trace 0).2.1 = 1 ∧ (trace 1).2.1 = 1} = 1 / 4 := by
  rw [FiniteHorizonRL.MDP.MeanCompatibleRewardKernel.stochasticTrajectoryKernelRemaining]
  have hevent : MeasurableSet
      {trace : FiniteHorizonRL.RewardStepTrace Unit Unit 2 |
        (trace 0).2.1 = 1 ∧ (trace 1).2.1 = 1} :=
    ((measurableSet_singleton 1).preimage
        ((measurable_snd.fst).comp (measurable_pi_apply 0))).inter
      ((measurableSet_singleton 1).preimage
        ((measurable_snd.fst).comp (measurable_pi_apply 1)))
  rw [ProbabilityTheory.Kernel.map_apply'
    _ (FiniteHorizonRL.RewardStepTrace.measurable_cons 1) _ hevent]
  have hpreimage :
      (fun p : (Unit × (Real × Unit)) ×
          FiniteHorizonRL.RewardStepTrace Unit Unit 1 => Fin.cons p.1 p.2) ⁻¹'
          {trace : FiniteHorizonRL.RewardStepTrace Unit Unit 2 |
            (trace 0).2.1 = 1 ∧ (trace 1).2.1 = 1} =
        {head : Unit × (Real × Unit) | head.2.1 = 1} ×ˢ
          {tail : FiniteHorizonRL.RewardStepTrace Unit Unit 1 |
            (tail 0).2.1 = 1} := by
    ext p
    simp
  rw [hpreimage]
  have hhead : MeasurableSet
      {head : Unit × (Real × Unit) | head.2.1 = 1} :=
    (measurableSet_singleton 1).preimage measurable_snd.fst
  have htail : MeasurableSet
      {tail : FiniteHorizonRL.RewardStepTrace Unit Unit 1 |
        (tail 0).2.1 = 1} :=
    (measurableSet_singleton 1).preimage
      ((measurable_snd.fst).comp (measurable_pi_apply 0))
  rw [ProbabilityTheory.Kernel.compProd_apply_prod hhead htail]
  simp_rw [ProbabilityTheory.Kernel.comap_apply]
  have htailHalf :
      (twoStepSymmetricSource.stochasticTrajectoryKernelRemaining
        twoStepPolicy 1 (by simp [twoStepMDP]) ())
          {tail : FiniteHorizonRL.RewardStepTrace Unit Unit 1 |
            (tail 0).2.1 = 1} = 1 / 2 := by
    simpa [twoStepSymmetricSource, twoStepPolicy, twoStepMDP] using
      FiniteHorizonStochasticRewardTrajectoryCanary.symmetricSource_generated_reward_one_mass_eq_half
  simp_rw [show ∀ head : Unit × (Real × Unit),
      (twoStepSymmetricSource.stochasticTrajectoryKernelRemaining
        twoStepPolicy 1 (by simp [twoStepMDP]) head.2.2)
          {tail : FiniteHorizonRL.RewardStepTrace Unit Unit 1 |
            (tail 0).2.1 = 1} = 1 / 2 by
      intro head
      simpa using htailHalf]
  have hheadHalf :
      (twoStepSymmetricSource.actionRewardStateKernel twoStepPolicy
        ⟨twoStepMDP.horizon - (1 + 1), by simp [twoStepMDP]⟩ ())
          {head : Unit × (Real × Unit) | head.2.1 = 1} = 1 / 2 := by
    calc
      _ = (twoStepSymmetricSource.actionRewardStateKernel twoStepPolicy
          ⟨twoStepMDP.horizon - (0 + 1), by simp [twoStepMDP]⟩ ())
          {head : Unit × (Real × Unit) | head.2.1 = 1} := by
            simp [FiniteHorizonRL.MDP.MeanCompatibleRewardKernel.actionRewardStateKernel,
              twoStepPolicy]
      _ = ((twoStepSymmetricSource.stochasticTrajectoryKernelRemaining
          twoStepPolicy 1 (by simp [twoStepMDP]) ()).map
            (FiniteHorizonRL.RewardStepTrace.head
              (Action := Unit) (State := Unit) 0))
          {head : Unit × (Real × Unit) | head.2.1 = 1} := by
            rw [twoStepSymmetricSource.stochasticTrajectoryKernelRemaining_map_head
              twoStepPolicy 0 (by simp [twoStepMDP]) ()]
      _ = (twoStepSymmetricSource.stochasticTrajectoryKernelRemaining
          twoStepPolicy 1 (by simp [twoStepMDP]) ())
          {tail : FiniteHorizonRL.RewardStepTrace Unit Unit 1 |
            (tail 0).2.1 = 1} := by
            rw [Measure.map_apply
              (FiniteHorizonRL.RewardStepTrace.measurable_head 0) hhead]
            rfl
      _ = 1 / 2 := htailHalf
  simp [hheadHalf]
  calc
    (2 : ENNReal)⁻¹ * 2⁻¹ = (2 * 2 : ENNReal)⁻¹ :=
      (ENNReal.mul_inv (a := 2) (b := 2) (by norm_num) (by norm_num)).symm
    _ = 4⁻¹ := by norm_num

