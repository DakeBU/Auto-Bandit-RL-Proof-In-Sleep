example {K : Nat} [NeZero K]
    (hK : 0 < K)
    (armLaw : Fin K -> MeasureTheory.Measure Real)
    (hprob : forall arm,
      MeasureTheory.IsProbabilityMeasure (armLaw arm))
    (lo hi : Fin K -> Real)
    (hbound : forall arm,
      Filter.Eventually
        (fun x : Real => Set.Icc (lo arm) (hi arm) x)
        (MeasureTheory.ae (armLaw arm)))
    (n : Nat) :
    let sigma2 := Concentration.finiteArmPositiveVarianceProxy
      (fun arm => Concentration.intervalVarianceProxy (lo arm) (hi arm))
    0 <= UCB.realStationaryArmwiseBoundedFiniteArmExpectedRegret
        (UCB.finiteArmCanonicalKernelTrajectoryMeasure
          hK 4 sigma2 armLaw hprob) armLaw
        UCB.canonicalKernelTrajectoryAction n /\
      UCB.realStationaryArmwiseBoundedFiniteArmExpectedRegret
          (UCB.finiteArmCanonicalKernelTrajectoryMeasure
            hK 4 sigma2 armLaw hprob) armLaw
          UCB.canonicalKernelTrajectoryAction n <=
        UCB.realStationaryArmwiseBoundedFiniteArmModelCoefficient
            armLaw hprob lo hi *
          (1 + Real.log ((n + 1 : Nat) : Real)) := by
  exact
    UCB.canonicalKernelTrajectoryArmwiseBoundedFiniteArmExpectedRegret_nonneg_and_le
      hK armLaw hprob lo hi hbound n

example {K : Nat} [NeZero K]
    (hK : 0 < K)
