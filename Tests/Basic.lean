namespace FiniteHorizonAdaptiveCumulativeInverseSqrtCalibrationCanary

local instance : MeasurableSpace Unit := ⊤

open FiniteHorizonRL
open FiniteHorizonRL.AdaptiveEpisodeBatchSource
open FiniteHorizonRL.AdaptiveCumulativeEmpiricalOptimisticSource
open FiniteHorizonAdaptiveCumulativeEmpiricalOptimisticRegretCanary

example :
    (TransitionCountRadius.cappedInverseSqrt 1 3 (by norm_num)
      (by norm_num)).radius 0 = 1 := by
  norm_num [TransitionCountRadius.cappedInverseSqrt]

example :
    (TransitionCountRadius.cappedInverseSqrt 1 3 (by norm_num)
      (by norm_num)).radius 16 = 3 / 4 := by
  rw [TransitionCountRadius.cappedInverseSqrt_radius_of_pos 1 3
    (by norm_num) (by norm_num) (by norm_num)]
  have hsqrt : Real.sqrt ((16 : Nat) : Real) = 4 := by
    rw [show (((16 : Nat) : Real)) = 4 ^ 2 by norm_num,
      Real.sqrt_sq (by norm_num)]
  rw [hsqrt]
  rw [min_eq_right (by norm_num : (3 : Real) / 4 <= 1)]

noncomputable def support :
    ExploratoryPathSupport mdp (MeasureTheory.Measure.dirac ()) where
  initialFloor := fun _state => 1
  predecessorState := fun _stage _state => ()
  predecessorAction := fun _stage _state => ()
  transitionFloor := fun _stage _state => 1
  initialFloor_nonneg := by norm_num
  initialFloor_le := by
    intro state
    have hstate : state = () := Subsingleton.elim _ _
    subst state
    rw [MeasureTheory.Measure.real,
      MeasureTheory.Measure.dirac_apply' _ (MeasurableSet.singleton ())]
    norm_num
  transitionFloor_nonneg := by
    intro stage hstage state
    simp [mdp] at hstage
  transitionFloor_le := by
    intro stage hstage state
    simp [mdp] at hstage

theorem uniformVisitFloor : ExploratoryPathUniformVisitFloor support 1 1 := by
  intro stage state
  have hstage : stage.val = 0 := by
    have hlt := stage.isLt
    change stage.val < 1 at hlt
    omega
  have heq : stage = (⟨0, by simp [mdp]⟩ : Fin mdp.horizon) := Fin.ext hstage
  subst stage
  norm_num [exploratoryPathStateLower, exploratoryPathStateLowerNat,
    exploratoryActionProbabilityFloor, support, mdp]

theorem localDelta : cumulativeCountLocalDelta mdp 1 1 = 1 / 2 := by
  rw [cumulativeCountLocalDelta, Fintype.card_prod, Fintype.card_fin]
  have hcard : Fintype.card (CountCoordinate mdp) = 2 := by
    rw [← countCoordinateCard, countCoordinateCard_eq]
    norm_num [mdp]
  rw [hcard]
  norm_num

theorem varianceProxy : cumulativeCoordinateVarianceProxy 100 1 = 25 := by
  norm_num [cumulativeCoordinateVarianceProxy,
    MarkovPolicy.iidBernoulliVarianceProxy_eq]

theorem radius_lt_ten :
    cumulativeCoordinateConfidenceRadius 100 1
        (cumulativeCountLocalDelta mdp 1 1) < 10 := by
  have hsquare := Concentration.subGaussianSumConfidenceRadius_sq
    (25 : NNReal) (1 / 2) (by norm_num) (by norm_num)
  have hlog2 : Real.log 2 < 1 := by
    have h :=
      Real.log_lt_sub_one_of_pos (x := (2 : Real)) (by norm_num) (by norm_num)
    norm_num at h
    exact h
  have hlog : Real.log 4 < 2 := by
    rw [show (4 : Real) = 2 * 2 by norm_num,
      Real.log_mul (by norm_num) (by norm_num)]
    linarith
  change Concentration.subGaussianSumConfidenceRadius
    (cumulativeCoordinateVarianceProxy 100 1)
      (cumulativeCountLocalDelta mdp 1 1) < 10
  rw [localDelta, varianceProxy]
  have hradiusNonneg :
      0 <= Concentration.subGaussianSumConfidenceRadius (25 : NNReal) (1 / 2) :=
    Concentration.subGaussianSumConfidenceRadius_nonneg _ _
  norm_num at hsquare
  nlinarith [hlog, sq_nonneg
    (Concentration.subGaussianSumConfidenceRadius (25 : NNReal) (1 / 2) - 10)]

theorem logFactor_lt_two :
    cumulativeInverseSqrtLogFactor mdp 1 1 < 2 := by
  rw [cumulativeInverseSqrtLogFactor, localDelta]
  have hlog2 : Real.log 2 < 1 := by
    have h :=
      Real.log_lt_sub_one_of_pos (x := (2 : Real)) (by norm_num) (by norm_num)
    norm_num at h
    exact h
  rw [show (2 / (1 / 2) : Real) = 2 * 2 by norm_num,
    Real.log_mul (by norm_num) (by norm_num)]
  linarith

theorem explicitScaleCover :
    (cumulativeInverseSqrtCoverCoefficient mdp 0 1) ^ 2 *
        cumulativeInverseSqrtLogFactor mdp 1 1 <=
      (3 : Real) ^ 2 * 1 := by
  have hlog := logFactor_lt_two
  norm_num [cumulativeInverseSqrtCoverCoefficient, mdp]
  norm_num [cumulativeInverseSqrtCoverCoefficient, mdp] at hlog ⊢
  linarith

theorem explicitEpisodeThreshold :
    cumulativeInverseSqrtCalibrationEpisodeThreshold mdp 1 1 1 0 1 < 100 := by
  have hlog := logFactor_lt_two
  rw [cumulativeInverseSqrtCalibrationEpisodeThreshold, max_lt_iff]
  constructor
  · norm_num
    linarith
  · have hcoefficient : cumulativeInverseSqrtCoverCoefficient mdp 0 1 = 2 := by
      norm_num [cumulativeInverseSqrtCoverCoefficient, mdp]
    rw [hcoefficient]
    norm_num
    linarith

theorem explicitCalibration :
    CumulativeInverseSqrtPathCalibration mdp 100 1 1 1 0 1 3 := by
  exact cumulativeInverseSqrtPathCalibration_of_episodeThreshold
    mdp (by simp [mdp]) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    explicitScaleCover explicitEpisodeThreshold

example :
    (∑ round : Fin 1,
        cumulativeInverseSqrtRadiusEnvelope mdp 100 1 1 1 1 3 round) <=
      cumulativeInverseSqrtEnvelopeSumBound 100 1 1 1 3 := by
  exact sum_cumulativeInverseSqrtRadiusEnvelope_le_explicit
    mdp (by simp [mdp]) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) explicitEpisodeThreshold

example :
    (∑ round : Fin 3,
        1 / Real.sqrt (((round.val + 1 : Nat) : Real))) =
      1 + 1 / Real.sqrt 2 + 1 / Real.sqrt 3 := by
  norm_num [Fin.sum_univ_succ]
  ring

theorem calibration :
    CumulativeInverseSqrtPathCalibration mdp 100 1 1 1 0 1 3 := by
  let radius := cumulativeCoordinateConfidenceRadius 100 1
    (cumulativeCountLocalDelta mdp 1 1)
  have hradius : radius < 10 := radius_lt_ten
  have hradiusNonneg : 0 <= radius :=
    Concentration.subGaussianSumConfidenceRadius_nonneg _ _
  have hmarginZero :
      cumulativePathVisitLowerMargin mdp 100 1 1 1 (0 : Fin 1) =
        100 - radius := by
    simp [cumulativePathVisitLowerMargin, cumulativePathVisitExpectedFloor, radius]
  constructor
  · norm_num
  · norm_num
  · norm_num
