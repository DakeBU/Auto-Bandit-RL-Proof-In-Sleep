example {K : Nat} [NeZero K]
    (hK : 0 < K)
    (armLaw : Fin K -> MeasureTheory.Measure Real)
    (hprob : forall arm,
      MeasureTheory.IsProbabilityMeasure (armLaw arm))
    (lo hi : Fin K -> Real)
    (hbound : forall arm,
      Filter.Eventually
        (fun x : Real => Set.Icc (lo arm) (hi arm) x)
        (MeasureTheory.ae (armLaw arm))) :
    let sigma2 := Concentration.finiteArmPositiveVarianceProxy
      (fun arm => Concentration.intervalVarianceProxy (lo arm) (hi arm))
    Filter.Tendsto
        (UCB.realStationaryArmwiseBoundedFiniteArmExpectedAverageRegret
          (UCB.finiteArmCanonicalKernelTrajectoryMeasure
            hK 4 sigma2 armLaw hprob) armLaw
          UCB.canonicalKernelTrajectoryAction)
        Filter.atTop (nhds 0) /\
      Filter.Eventually
        (fun trajectory =>
          UCB.canonicalKernelTrajectoryAction trajectory 0 =
              UCB.initializationArm hK 0 /\
            forall n : Nat,
              UCB.canonicalKernelTrajectoryAction trajectory (n + 1) =
                UCB.realHistoryNextArm hK (4 * (sigma2 : Real)) n
                  (History.finitePairHistoryOfTrace
                    (UCB.canonicalKernelTrajectoryAction trajectory)
                    (UCB.canonicalKernelTrajectoryReward trajectory) n))
        (MeasureTheory.ae (UCB.finiteArmCanonicalKernelTrajectoryMeasure
          hK 4 sigma2 armLaw hprob)) := by
  exact
    UCB.canonicalKernelTrajectoryArmwiseBoundedFiniteArmExpectedAverageRegret_tendsto_zero_and_explicitPolicy
      hK armLaw hprob lo hi hbound

