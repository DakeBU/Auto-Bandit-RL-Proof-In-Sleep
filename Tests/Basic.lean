example {K : Nat} [NeZero K]
    (hK : 0 < K) (c : Real) (sigma2 : NNReal)
    (nu : ProbabilityTheory.Kernel (Fin K) Real)
    [ProbabilityTheory.IsMarkovKernel nu] :
    UCB.RealStationaryUCBSequence
      (UCB.canonicalKernelTrajectoryMeasure hK c sigma2 nu)
      hK c sigma2 nu UCB.canonicalKernelTrajectoryAction
      UCB.canonicalKernelTrajectoryReward := by
  exact UCB.realStationaryUCBSequence_canonicalKernelTrajectory
    hK c sigma2 nu

example {K : Nat} [NeZero K]
    (hK : 0 < K) (c : Real) (sigma2 : NNReal)
    (nu : ProbabilityTheory.Kernel (Fin K) Real)
    [ProbabilityTheory.IsMarkovKernel nu] :
    let mu := UCB.canonicalKernelTrajectoryMeasure hK c sigma2 nu
    ProbabilityTheory.condDistrib
        (fun trajectory => UCB.canonicalKernelTrajectoryReward trajectory 0)
        (fun trajectory => UCB.canonicalKernelTrajectoryAction trajectory 0)
        mu =ᵐ[mu.map (fun trajectory =>
          UCB.canonicalKernelTrajectoryAction trajectory 0)]
      ProbabilityTheory.condDistrib
        (fun stream : UCB.ArmRewardStream K =>
          UCB.armStreamReward hK (c * (sigma2 : Real)) stream 0)
        (fun stream : UCB.ArmRewardStream K =>
          UCB.armStreamAction hK (c * (sigma2 : Real)) stream 0)
        (UCB.armStreamMeasure nu) := by
  dsimp only
  exact
    (UCB.realStationaryUCBSequence_canonicalKernelTrajectory
      hK c sigma2 nu).hasCondDistrib_feedback_zero

