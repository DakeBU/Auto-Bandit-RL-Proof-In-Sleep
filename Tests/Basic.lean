example {Action : Type u} [DecidableEq Action]
    (arms : Finset Action) (harms : arms.Nonempty)
    (eta : Nat -> Real) (loss : Nat -> Action -> Real)
    (q : Action -> Real) (n : Nat)
    (heta : forall t, t <= n -> 0 < eta t)
    (hetaMono : forall t, t < n -> eta (t + 1) <= eta t)
    (hq : FTRL.finiteSimplex arms q) :
    (Finset.range (n + 1)).sum (fun t =>
        Tsallis.halfTsallisPotentialValue arms (eta t)
            (FTRL.cumulativeLoss loss t)
            (Tsallis.halfTsallisScheduledMinimizer arms harms eta loss t) -
          Tsallis.halfTsallisPotentialValue arms (eta t)
            (FTRL.cumulativeLoss loss (t + 1))
            (Tsallis.halfTsallisScheduledSameRateNext arms harms eta loss t) -
