example {Action : Type} [DecidableEq Action]
    (arms : Finset Action) (alpha : Real)
    (prob loss : Action -> Real)
    (hprob : forall action, action ∈ arms -> 0 < prob action)
    (hloss : forall action, action ∈ arms ->
      0 <= loss action ∧ loss action <= 1) :
    arms.sum (fun chosen =>
        prob chosen *
          Tsallis.powerWeightedSquaredImportanceWeightedLoss
            arms alpha prob loss chosen) <=
      Tsallis.powerSum arms (1 - alpha) prob := by
  exact
    Tsallis.sum_prob_mul_powerWeightedSquaredImportanceWeightedLoss_le_powerSum
      arms alpha prob loss hprob hloss

example {Action : Type} [DecidableEq Action]
    (arms : Finset Action) (eta : Real)
    (score prob loss : Action -> Real)
    (next : Action -> Action -> Real)
    (multiplier : Real) (nextMultiplier : Action -> Real)
    (heta : 0 < eta)
    (hprobSimplex : FTRL.finiteSimplex arms prob)
    (hprobPos : forall action, action ∈ arms -> 0 < prob action)
    (hnextSimplex : forall chosen, chosen ∈ arms ->
      FTRL.finiteSimplex arms (next chosen))
    (hnextPos : forall chosen, chosen ∈ arms ->
      forall action, action ∈ arms -> 0 < next chosen action)
    (hloss : forall action, action ∈ arms ->
      0 <= loss action ∧ loss action <= 1)
    (hprobStationary : Tsallis.HalfTsallisInteriorStationary
      arms eta score prob multiplier)
    (hnextStationary : forall chosen, chosen ∈ arms ->
      Tsallis.HalfTsallisInteriorStationary
        arms eta
          (fun action => score action +
            Exp3.importanceWeightedLoss prob loss chosen action)
          (next chosen) (nextMultiplier chosen)) :
    arms.sum (fun chosen =>
        prob chosen *
          (FTRL.linearLoss arms prob
              (Exp3.importanceWeightedLoss prob loss chosen) -
            FTRL.linearLoss arms (next chosen)
              (Exp3.importanceWeightedLoss prob loss chosen))) <=
      2 * eta * Tsallis.powerSum arms (1 / 2 : Real) prob := by
  exact
    Tsallis.sum_prob_mul_linearLoss_sub_next_importanceWeightedLoss_le_powerSum_half
      arms eta score prob loss next multiplier nextMultiplier heta
      hprobSimplex hprobPos hnextSimplex hnextPos hloss
      hprobStationary hnextStationary

example :
    (Finset.univ : Finset (Fin 1)).sum (fun chosen =>
        (1 : Real) *
          (FTRL.linearLoss Finset.univ (fun _ : Fin 1 => (1 : Real))
              (Exp3.importanceWeightedLoss (fun _ : Fin 1 => (1 : Real))
                (fun _ : Fin 1 => (1 : Real)) chosen) -
            FTRL.linearLoss Finset.univ (fun _ : Fin 1 => (1 : Real))
              (Exp3.importanceWeightedLoss (fun _ : Fin 1 => (1 : Real))
                (fun _ : Fin 1 => (1 : Real)) chosen))) <=
      2 * (1 : Real) *
        Tsallis.powerSum Finset.univ (1 / 2 : Real)
          (fun _ : Fin 1 => (1 : Real)) := by
  apply
    Tsallis.sum_prob_mul_linearLoss_sub_next_importanceWeightedLoss_le_powerSum_half
      (arms := Finset.univ) (eta := 1)
      (score := fun _ : Fin 1 => (0 : Real))
      (prob := fun _ : Fin 1 => (1 : Real))
      (loss := fun _ : Fin 1 => (1 : Real))
      (next := fun _ _ : Fin 1 => (1 : Real))
      (multiplier := -1) (nextMultiplier := fun _ => 0)
  · norm_num
  · simp [FTRL.finiteSimplex]
  · simp
  · intro chosen _hchosen
    simp [FTRL.finiteSimplex]
  · simp
  · simp
  · simp [Tsallis.HalfTsallisInteriorStationary]
  · intro chosen _hchosen
    have hchosenZero : chosen = 0 := Subsingleton.elim _ _
    simp [Tsallis.HalfTsallisInteriorStationary,
      Exp3.importanceWeightedLoss, hchosenZero]

example {Action : Type} [DecidableEq Action]
    (arms : Finset Action) (eta : Real) (score p : Action -> Real)
    (hp : FTRL.finiteSimplex arms p)
    (hpPos : forall action, action ∈ arms -> 0 < p action) :
    FTRL.IsRegularizedMinimizer (FTRL.finiteSimplex arms)
          arms eta (Tsallis.negEntropyRegularizer arms (1 / 2 : Real)) score p ↔
      exists multiplier,
        Tsallis.HalfTsallisInteriorStationary arms eta score p multiplier := by
  exact Tsallis.isRegularizedMinimizer_iff_exists_halfTsallisInteriorStationary
    arms eta score p hp hpPos

example {Action : Type} [DecidableEq Action]
    (arms : Finset Action) (eta : Real) (score p : Action -> Real)
    (hpMin : FTRL.IsRegularizedMinimizer (FTRL.finiteSimplex arms)
      arms eta (Tsallis.negEntropyRegularizer arms (1 / 2 : Real)) score p) :
    forall action, action ∈ arms -> 0 < p action := by
  exact Tsallis.isRegularizedMinimizer_pos arms eta score p hpMin

example :
    exists (p score : Fin 2 -> Real),
      (1 : Real) * score 0 - (p 0) ^ (-(1 / 2 : Real)) =
        (1 : Real) * score 1 - (p 1) ^ (-(1 / 2 : Real)) := by
  let p : Fin 2 -> Real := fun action =>
    if action = 0 then (1 / 4 : Real) else 3 / 4
  let score : Fin 2 -> Real := fun action =>
    (p action) ^ (-(1 / 2 : Real))
  have hp : FTRL.finiteSimplex (Finset.univ : Finset (Fin 2)) p := by
    constructor
    · intro action _haction
      fin_cases action <;> norm_num [p]
    · rw [Fin.sum_univ_two]
      norm_num [p]
  have hpPos : forall action : Fin 2, action ∈ Finset.univ -> 0 < p action := by
    intro action _haction
    fin_cases action <;> norm_num [p]
  have hstationary :
      Tsallis.HalfTsallisInteriorStationary
        (Finset.univ : Finset (Fin 2)) 1 score p 0 := by
    intro action _haction
    simp [score]
  have hpMin :=
    Tsallis.isRegularizedMinimizer_of_halfTsallisInteriorStationary
      (Finset.univ : Finset (Fin 2)) 1 score p 0 hp hpPos hstationary
  refine ⟨p, score, ?_⟩
  exact Tsallis.halfTsallis_pairwise_stationary_of_isRegularizedMinimizer
    (Finset.univ : Finset (Fin 2)) 1 score p hpMin hpPos
    (by simp) (by simp)

example :
    (Finset.univ : Finset (Fin 1)).sum (fun chosen =>
        (1 : Real) *
          (FTRL.linearLoss Finset.univ (fun _ : Fin 1 => (1 : Real))
              (Exp3.importanceWeightedLoss (fun _ : Fin 1 => (1 : Real))
                (fun _ : Fin 1 => (1 : Real)) chosen) -
            FTRL.linearLoss Finset.univ (fun _ : Fin 1 => (1 : Real))
              (Exp3.importanceWeightedLoss (fun _ : Fin 1 => (1 : Real))
                (fun _ : Fin 1 => (1 : Real)) chosen))) <=
      2 * (1 : Real) *
        Tsallis.powerSum Finset.univ (1 / 2 : Real)
          (fun _ : Fin 1 => (1 : Real)) := by
  have hsimplex :
      FTRL.finiteSimplex (Finset.univ : Finset (Fin 1))
        (fun _ : Fin 1 => (1 : Real)) := by
    simp [FTRL.finiteSimplex]
  have hpos : forall action : Fin 1, action ∈ Finset.univ ->
      0 < (fun _ : Fin 1 => (1 : Real)) action := by
    simp
  have hcurrentStationary :
      Tsallis.HalfTsallisInteriorStationary
        (Finset.univ : Finset (Fin 1)) 1
        (fun _ : Fin 1 => (0 : Real))
        (fun _ : Fin 1 => (1 : Real)) (-1) := by
    simp [Tsallis.HalfTsallisInteriorStationary]
  have hcurrentMin :=
    Tsallis.isRegularizedMinimizer_of_halfTsallisInteriorStationary
      (Finset.univ : Finset (Fin 1)) 1
      (fun _ : Fin 1 => (0 : Real))
      (fun _ : Fin 1 => (1 : Real)) (-1)
      hsimplex hpos hcurrentStationary
  have hnextMin : forall chosen : Fin 1, chosen ∈ Finset.univ ->
      FTRL.IsRegularizedMinimizer (FTRL.finiteSimplex Finset.univ)
        Finset.univ 1
        (Tsallis.negEntropyRegularizer Finset.univ (1 / 2 : Real))
        (fun action => (0 : Real) +
          Exp3.importanceWeightedLoss (fun _ : Fin 1 => (1 : Real))
            (fun _ : Fin 1 => (1 : Real)) chosen action)
        (fun _ : Fin 1 => (1 : Real)) := by
    intro chosen _hchosen
    have hchosenZero : chosen = 0 := Subsingleton.elim _ _
    apply Tsallis.isRegularizedMinimizer_of_halfTsallisInteriorStationary
      (multiplier := 0) (hp := hsimplex) (hpPos := hpos)
    simp [Tsallis.HalfTsallisInteriorStationary,
      Exp3.importanceWeightedLoss, hchosenZero]
  exact
    Tsallis.sum_prob_mul_linearLoss_sub_next_importanceWeightedLoss_le_powerSum_half_of_minimizers
      (Finset.univ : Finset (Fin 1)) 1
      (fun _ : Fin 1 => (0 : Real))
      (fun _ : Fin 1 => (1 : Real))
      (fun _ : Fin 1 => (1 : Real))
      (fun _ _ : Fin 1 => (1 : Real)) (by norm_num)
      hcurrentMin hnextMin (by simp)

