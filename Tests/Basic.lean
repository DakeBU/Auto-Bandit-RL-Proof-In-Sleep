            Tsallis.powerSum arms (1 / 2 : Real) q) /
          (1 - (1 / 2 : Real))) / eta := by
  exact
    Tsallis.integral_sampledHalfTsallisPredictableEnvironmentRegret_le
      prior arms harms eta heta loss q hq horizon

