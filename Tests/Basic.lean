-- Lock the fixed-action initial pair pushforward definition.
example {K : Nat}
    (armLaw : Fin K -> MeasureTheory.Measure Rat)
    (defaultAction : Fin K) :
    UCB.finiteArmSubgaussianInitialActionRewardMeasure armLaw defaultAction =
      MeasureTheory.Measure.map (Prod.mk defaultAction)
        (armLaw defaultAction) := rfl

-- Lock the sampled successor coordinate charged by the practical route.
example {K : Nat} (trajectory : Nat -> Prod (Fin K) Rat) (t : Nat) :
    UCB.actionRewardTrajectorySuccessorAction trajectory t =
      (trajectory (t + 1)).1 := rfl

-- Lock the practical family to the exact generic sampled-pair surface.
example {K : Nat}
    (model : FiniteBanditModel K)
    (armLaw : Fin K -> MeasureTheory.Measure Rat)
    (hprob : forall arm, MeasureTheory.IsProbabilityMeasure (armLaw arm))
    (varianceProxy : Fin K -> NNReal)
    (defaultAction : Fin K)
    (T : Nat) :
    UCB.selectedPolicySuccessorFiniteArmSubgaussianExpectedPseudoRegret
        model armLaw hprob varianceProxy defaultAction T =
      let mu0 :=
        UCB.finiteArmSubgaussianInitialActionRewardMeasure
          armLaw defaultAction
      letI : MeasureTheory.IsProbabilityMeasure mu0 :=
        UCB.finiteArmSubgaussianInitialActionRewardMeasure_isProbabilityMeasure
          armLaw hprob defaultAction
      let rewardKernel := RewardKernel.contextIndependentOfActionLaws
        (Context := Unit) armLaw hprob
      let context :
          (n : Nat) -> ((j : Finset.Iic n) -> Rat) -> Unit := fun _ _ => ()
      let sigma2 :=
        Concentration.finiteArmPositiveVarianceProxy varianceProxy
      UCB.selectedPolicySuccessorActionRewardTrajMeasureExpectedPseudoRegret
        model mu0 rewardKernel context defaultAction sigma2
          (fun _ => measurable_const) T := rfl

