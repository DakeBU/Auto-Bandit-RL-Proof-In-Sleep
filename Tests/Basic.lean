    rw [FiniteHorizonRL.countCoordinateCard_eq]
    norm_num [mdp]
  norm_num [FiniteHorizonRL.simultaneousCountDelta, hcard]

theorem simultaneousCountConfidenceRadius_lt_four :
    FiniteHorizonRL.simultaneousCountConfidenceRadius mdp 4 (1 / 2) < 4 := by
  have hsquare := Concentration.subGaussianSumConfidenceRadius_sq
    (FiniteHorizonRL.MarkovPolicy.iidBernoulliVarianceProxy 4)
    (FiniteHorizonRL.simultaneousCountDelta mdp (1 / 2))
    (by rw [simultaneousCountDelta_eq_quarter]; norm_num)
    (by rw [simultaneousCountDelta_eq_quarter]; norm_num)
  rw [FiniteHorizonRL.MarkovPolicy.iidBernoulliVarianceProxy_eq,
    simultaneousCountDelta_eq_quarter] at hsquare
  norm_num at hsquare
  have hradius_eq :
      FiniteHorizonRL.simultaneousCountConfidenceRadius mdp 4 (1 / 2) =
        Concentration.subGaussianSumConfidenceRadius 1 (1 / 4) := by
    rw [FiniteHorizonRL.simultaneousCountConfidenceRadius,
      FiniteHorizonRL.MarkovPolicy.iidBernoulliVarianceProxy_eq,
      simultaneousCountDelta_eq_quarter]
    norm_num
  have hlog : Real.log 8 < 7 := by
    have h := Real.log_lt_sub_one_of_pos (x := (8 : Real))
      (by norm_num) (by norm_num)
    norm_num at h ⊢
    exact h
  have hradius_nonneg :
      0 ≤ FiniteHorizonRL.simultaneousCountConfidenceRadius mdp 4 (1 / 2) :=
    Concentration.subGaussianSumConfidenceRadius_nonneg _ _
  rw [hradius_eq] at hradius_nonneg ⊢
  nlinarith

