      (Tsallis.halfTsallisPotentialMass arms
          (Tsallis.halfTsallisScheduledMinimizer arms harms eta loss 0) -
        Tsallis.halfTsallisPotentialMass arms q) / eta n := by
  exact Tsallis.sum_halfTsallisCanonicalScheduledPotentialPenalty_le
    arms harms eta loss q n heta hetaMono hq

