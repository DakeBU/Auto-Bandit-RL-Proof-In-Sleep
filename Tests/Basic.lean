def trace (action : Bool) (reward : Real) :
    RewardStepTrace Bool Unit mdp.horizon :=
  fun _stage => (action, (reward, ()))

def stochasticBatch (falseReward trueReward : Real) :
    StochasticEpisodeBatch mdp 2 :=
  fun episode =>
    if episode = (0 : Fin 2) then
      ((), trace false falseReward)
    else
      ((), trace true trueReward)

noncomputable def sampledBatch (falseReward trueReward : Real) : EpisodeBatch mdp 2 :=
  mdp.sampledEpisodeBatchOfStochasticTrajectories 2
    (stochasticBatch falseReward trueReward)

noncomputable def plan (falseReward trueReward : Real) :
    mdp.EstimatedModelPlan :=
  (mdp.stochasticAllCoordinateEmpiricalFiniteBatchModel 2
    (sampledBatch falseReward trueReward) () 0 0).plan

def stageZero : Fin mdp.horizon := ⟨0, by simp [mdp]⟩

theorem sampledBatch_state
    (falseReward trueReward : Real) (episode : Fin 2) :
    ((sampledBatch falseReward trueReward) episode stageZero).state = () := by
  by_cases hepisode : episode = (0 : Fin 2) <;>
    simp [sampledBatch, stochasticBatch, trace, stageZero,
      MDP.sampledEpisodeBatchOfStochasticTrajectories,
      MDP.sampledEpisodeStepOfStochasticTrajectory, hepisode]

theorem sampledBatch_action
    (falseReward trueReward : Real) (episode : Fin 2) :
    ((sampledBatch falseReward trueReward) episode stageZero).action =
      if episode = (0 : Fin 2) then false else true := by
  by_cases hepisode : episode = (0 : Fin 2) <;>
    simp [sampledBatch, stochasticBatch, trace, stageZero,
      MDP.sampledEpisodeBatchOfStochasticTrajectories,
      MDP.sampledEpisodeStepOfStochasticTrajectory, hepisode]

theorem sampledBatch_reward
    (falseReward trueReward : Real) (episode : Fin 2) :
    ((sampledBatch falseReward trueReward) episode stageZero).reward =
      if episode = (0 : Fin 2) then falseReward else trueReward := by
  by_cases hepisode : episode = (0 : Fin 2) <;>
    simp [sampledBatch, stochasticBatch, trace, stageZero,
      MDP.sampledEpisodeBatchOfStochasticTrajectories,
      MDP.sampledEpisodeStepOfStochasticTrajectory, hepisode]

theorem sampledBatch_visitCount_eq_one
    (falseReward trueReward : Real) (action : Bool) :
    (sampledBatch falseReward trueReward).visitCount stageZero () action = 1 := by
  change (∑ episode : Fin 2,
    if ((sampledBatch falseReward trueReward) episode stageZero).state = () /\
        ((sampledBatch falseReward trueReward) episode stageZero).action = action
      then 1 else 0) = 1
  rw [Finset.univ_fin2]
  cases action <;>
    simp [sampledBatch_state, sampledBatch_action]

theorem sampledBatch_empiricalReward
    (falseReward trueReward : Real) (action : Bool) :
    (sampledBatch falseReward trueReward).empiricalReward
        stageZero () action =
      if action then trueReward else falseReward := by
  rw [EpisodeBatch.empiricalReward,
    sampledBatch_visitCount_eq_one]
  unfold EpisodeBatch.rewardSum
  rw [Finset.univ_fin2]
  cases action <;>
    simp [sampledBatch_state, sampledBatch_action, sampledBatch_reward]

theorem optimisticQ_eq_sampledReward
    (falseReward trueReward : Real) (action : Bool) :
    (plan falseReward trueReward).optimisticQ stageZero (fun _ => 0) () action =
      if action then trueReward else falseReward := by
  change
    (sampledBatch falseReward trueReward).empiricalReward
          stageZero () action +
        (∫ _nextState, 0 ∂
          (sampledBatch falseReward trueReward).empiricalTransitionKernel
            () stageZero ((), action)) + 0 + 0 = _
  rw [sampledBatch_empiricalReward]
  simp

theorem falseRewardHigh_selectedFalse :
    (plan 1 (-1)).optimisticActionAt stageZero () = false := by
  by_contra hnot
  have hchosen : (plan 1 (-1)).optimisticActionAt stageZero () = true :=
    Bool.eq_true_of_not_eq_false hnot
  have hmax := (plan 1 (-1)).optimisticQ_le_optimisticAction
    stageZero (fun _ => 0) () false
  rw [show (plan 1 (-1)).optimisticAction stageZero (fun _ => 0) () =
      (plan 1 (-1)).optimisticActionAt stageZero () by rfl,
    hchosen] at hmax
  rw [optimisticQ_eq_sampledReward 1 (-1) false,
    optimisticQ_eq_sampledReward 1 (-1) true] at hmax
  norm_num at hmax

theorem trueRewardHigh_selectedTrue :
    (plan (-1) 1).optimisticActionAt stageZero () = true := by
  by_contra hnot
  have hchosen : (plan (-1) 1).optimisticActionAt stageZero () = false :=
    Bool.eq_false_of_not_eq_true hnot
  have hmax := (plan (-1) 1).optimisticQ_le_optimisticAction
    stageZero (fun _ => 0) () true
  rw [show (plan (-1) 1).optimisticAction stageZero (fun _ => 0) () =
      (plan (-1) 1).optimisticActionAt stageZero () by rfl,
    hchosen] at hmax
  rw [optimisticQ_eq_sampledReward (-1) 1 true,
    optimisticQ_eq_sampledReward (-1) 1 false] at hmax
  norm_num at hmax

theorem sampledRewardTables_ne :
    (stochasticBatch 1 (-1)).sampledEmpiricalOptimisticPolicyTable () 0 0 ≠
      (stochasticBatch (-1) 1).sampledEmpiricalOptimisticPolicyTable () 0 0 := by
  intro heq
  have hcoordinate := congrFun (congrFun heq stageZero) ()
  change (plan 1 (-1)).optimisticActionAt stageZero () =
    (plan (-1) 1).optimisticActionAt stageZero () at hcoordinate
  rw [falseRewardHigh_selectedFalse, trueRewardHigh_selectedTrue] at hcoordinate
  contradiction

