namespace FiniteHorizonEstimatedModelNonzeroCanary

abbrev State := Bool
abbrev Action := Unit

local instance : MeasurableSpace State := ⊤
local instance : MeasurableSpace Action := ⊤

noncomputable def trueMDP : FiniteHorizonRL.MDP State Action where
  horizon := 2
  transition := ProbabilityTheory.Kernel.deterministic
    (fun _ => false) measurable_const
  transition_isMarkov := by infer_instance
  reward := fun _ _ => 0
  measurable_reward := measurable_const

noncomputable def plan :
    FiniteHorizonRL.MDP.EstimatedModelPlan trueMDP where
  estimatedReward stage state _ :=
    if stage.val = 1 /\ state = true then 1 else 0
  measurable_estimatedReward _ := measurable_of_finite _
  estimatedTransition stage := ProbabilityTheory.Kernel.deterministic
    (fun _ => if stage.val = 0 then true else false) measurable_const
  estimatedTransition_isMarkov _ := by infer_instance
  rewardRadius stage state _ :=
    if stage.val = 1 /\ state = true then 1 else 0
  measurable_rewardRadius _ := measurable_of_finite _
  transitionRadius stage _ _ := if stage.val = 0 then 2 else 0
  measurable_transitionRadius _ := measurable_of_finite _

theorem confidence : plan.Confidence := by
  constructor
  · intro stage state action
    fin_cases stage <;> fin_cases state <;> cases action <;>
      norm_num [plan, trueMDP]
  · intro remaining hremaining state action
    change remaining + 1 <= 2 at hremaining
    have hle : remaining <= 1 := by omega
    interval_cases remaining <;> fin_cases state <;> cases action <;>
      norm_num [plan, trueMDP,
        FiniteHorizonRL.MDP.EstimatedModelPlan.transitionValue,
        FiniteHorizonRL.MDP.transitionValue,
        FiniteHorizonRL.MDP.EstimatedModelPlan.upperValueRemaining,
        FiniteHorizonRL.MDP.EstimatedModelPlan.optimisticBellman,
        FiniteHorizonRL.MDP.EstimatedModelPlan.optimisticQ,
        FiniteHorizonRL.MDP.EstimatedModelPlan.bellmanQ,
        FiniteHorizonRL.MDP.decisionStageRemaining,
        ProbabilityTheory.Kernel.deterministic_apply, integral_dirac']

noncomputable def coordinatePlan :
    FiniteHorizonRL.MDP.EstimatedModelPlan trueMDP where
  estimatedReward := plan.estimatedReward
  measurable_estimatedReward := plan.measurable_estimatedReward
  estimatedTransition := plan.estimatedTransition
  estimatedTransition_isMarkov := plan.estimatedTransition_isMarkov
  rewardRadius := plan.rewardRadius
  measurable_rewardRadius := plan.measurable_rewardRadius
  transitionRadius stage _ _ := if stage.val = 0 then 4 else 0
  measurable_transitionRadius _ := measurable_of_finite _

noncomputable def coordinateConfidence :
    coordinatePlan.CoordinateConfidence where
  transitionCoordinateRadius stage _ _ _ :=
    if stage.val = 0 then 1 else 0
  valueEnvelope remaining := if remaining = 1 then 2 else 0
  rewardError_le_radius := by
    intro stage state action
    fin_cases stage <;> fin_cases state <;> cases action <;>
      norm_num [coordinatePlan, plan, trueMDP]
  transitionCoordinateError_le_radius := by
    intro remaining hremaining state action nextState
    change remaining + 1 <= 2 at hremaining
    have hle : remaining <= 1 := by omega
    interval_cases remaining <;> fin_cases state <;> cases action <;>
      fin_cases nextState <;>
      norm_num [coordinatePlan, plan, trueMDP,
        FiniteHorizonRL.MDP.decisionStageRemaining,
        ProbabilityTheory.Kernel.deterministic_apply, measureReal_def]
  upperValue_abs_le_envelope := by
    intro remaining hremaining state
    change remaining + 1 <= 2 at hremaining
    have hle : remaining <= 1 := by omega
    interval_cases remaining <;> fin_cases state <;>
      norm_num [coordinatePlan, plan, trueMDP,
        FiniteHorizonRL.MDP.EstimatedModelPlan.upperValueRemaining,
        FiniteHorizonRL.MDP.EstimatedModelPlan.optimisticBellman,
        FiniteHorizonRL.MDP.EstimatedModelPlan.optimisticQ,
        FiniteHorizonRL.MDP.EstimatedModelPlan.bellmanQ,
        FiniteHorizonRL.MDP.EstimatedModelPlan.transitionValue,
        FiniteHorizonRL.MDP.EstimatedModelPlan.optimisticAction,
        FiniteHorizonRL.MDP.decisionStageRemaining,
        ProbabilityTheory.Kernel.deterministic_apply, integral_dirac']
  transitionRadius_cover := by
    intro remaining hremaining state action
    change remaining + 1 <= 2 at hremaining
    have hle : remaining <= 1 := by omega
    interval_cases remaining <;> fin_cases state <;> cases action <;>
      norm_num [coordinatePlan, trueMDP,
        FiniteHorizonRL.MDP.decisionStageRemaining]

noncomputable example : coordinatePlan.Confidence :=
  coordinateConfidence.toConfidence

noncomputable example :
    |coordinatePlan.transitionValue
          (trueMDP.decisionStageRemaining 1 (by norm_num [trueMDP]))
          (coordinatePlan.upperValueRemaining 1 (by norm_num [trueMDP]))
          false () -
        trueMDP.transitionValue
          (coordinatePlan.upperValueRemaining 1 (by norm_num [trueMDP]))
          false ()| <= 4 := by
  exact coordinateConfidence.transitionError_le_radius
    1 (by norm_num [trueMDP]) false ()

noncomputable example :
    coordinatePlan.optimisticPolicy.expectedRegret (Measure.dirac false) <=
      coordinatePlan.optimisticPolicy.occupancySumRemaining
        (fun remaining hremaining state =>
          2 * coordinatePlan.selectedRadiusRemaining
            remaining hremaining state)
        trueMDP.horizon le_rfl (Measure.dirac false) :=
  (coordinateConfidence
    |>.optimism_and_expectedRegret_le_two_occupancySelectedRadiusRemaining
      (Measure.dirac false)).2

noncomputable example :
    plan.selectedRadiusRemaining 1 (by norm_num [trueMDP]) false = 2 := by
  norm_num [FiniteHorizonRL.MDP.EstimatedModelPlan.selectedRadiusRemaining,
    plan, trueMDP,
    FiniteHorizonRL.MDP.EstimatedModelPlan.upperValueRemaining,
    FiniteHorizonRL.MDP.EstimatedModelPlan.optimisticAction,
    FiniteHorizonRL.MDP.decisionStageRemaining]

noncomputable example :
    (plan.certificate confidence).policyBellmanResidual
        plan.optimisticPolicy 1 (by norm_num [trueMDP]) false <= 4 := by
  have h := confidence.policyBellmanResidual_le_two_selectedRadiusRemaining
    1 (by norm_num [trueMDP]) false
  norm_num [FiniteHorizonRL.MDP.EstimatedModelPlan.selectedRadiusRemaining,
    plan, trueMDP,
    FiniteHorizonRL.MDP.EstimatedModelPlan.upperValueRemaining,
    FiniteHorizonRL.MDP.EstimatedModelPlan.optimisticAction,
    FiniteHorizonRL.MDP.decisionStageRemaining] at h
  exact h

noncomputable def zeroMDP : FiniteHorizonRL.MDP State Action where
  horizon := 0
  transition := ProbabilityTheory.Kernel.deterministic
