        (UCB.finiteArmCanonicalKernelTrajectoryMeasure
          hK 4 sigma2 armLaw hprob) armLaw
        UCB.canonicalKernelTrajectoryAction)
      Filter.atTop (nhds 0) := by
  exact
    UCB.canonicalKernelTrajectoryArmwiseBoundedFiniteArmExpectedAverageRegret_tendsto_zero
      hK armLaw hprob lo hi hbound

