def initialTable : FiniteHorizonRL.DeterministicMarkovPolicyTable mdp :=
  fun _stage _state => false

noncomputable def support :
    FiniteHorizonRL.ExploratoryPathSupport mdp initialState where
  initialFloor := fun _state => 1 / 2
  predecessorState := fun _stage _state => false
  predecessorAction := fun _stage state => state
  transitionFloor := fun _stage _state => 1
  initialFloor_nonneg := by norm_num
  initialFloor_le := by
    intro state
    change (1 / 2 : Real) <=
      (((PMF.uniformOfFintype Bool).toMeasure {state}).toReal)
    rw [(PMF.uniformOfFintype Bool).toMeasure_apply_singleton state
      (measurableSet_singleton state)]
    norm_num [PMF.uniformOfFintype_apply]
  transitionFloor_nonneg := by norm_num
  transitionFloor_le := by
    intro stage hstage state
    change (1 : Real) <=
      ((ProbabilityTheory.Kernel.deterministic
        (fun pair : Bool × Bool => pair.2) measurable_snd (false, state)
          {state}).toReal)
    rw [ProbabilityTheory.Kernel.deterministic_apply]
    rw [Measure.dirac_apply' _ (measurableSet_singleton state)]
    norm_num

