theorem distinctOptimisticQ
    (summary : FiniteHorizonRL.TransitionCountSummary distinctMDP)
    (action : Bool) :
    (summary.optimisticPlan distinctMDP () 0).optimisticQ distinctStage
        ((summary.optimisticPlan distinctMDP () 0).upperValueRemaining
          0 (by simp)) () action =
      if action then 1 else 0 := by
  simp [FiniteHorizonRL.TransitionCountSummary.optimisticPlan,
    FiniteHorizonRL.MDP.EstimatedModelPlan.optimisticQ,
    FiniteHorizonRL.MDP.EstimatedModelPlan.bellmanQ,
    FiniteHorizonRL.MDP.EstimatedModelPlan.transitionValue,
    FiniteHorizonRL.MDP.EstimatedModelPlan.upperValueRemaining,
    distinctMDP, distinctStage]

theorem distinctOptimisticTable_selects_true
    (summary : FiniteHorizonRL.TransitionCountSummary distinctMDP) :
    summary.optimisticPolicyTable distinctMDP () 0 distinctStage () = true := by
  let plan := summary.optimisticPlan distinctMDP () 0
  by_contra hnot
  have hchosen :
      summary.optimisticPolicyTable distinctMDP () 0 distinctStage () = false :=
    Bool.eq_false_of_not_eq_true hnot
  have hmax := plan.optimisticQ_le_optimisticAction distinctStage
    (plan.upperValueRemaining 0 (by simp)) () true
  change plan.optimisticQ distinctStage (plan.upperValueRemaining 0 (by simp))
      () true <=
    plan.optimisticQ distinctStage (plan.upperValueRemaining 0 (by simp)) ()
      (summary.optimisticPolicyTable distinctMDP () 0 distinctStage ()) at hmax
  rw [hchosen] at hmax
  norm_num [plan, distinctOptimisticQ] at hmax

theorem distinctSuccessorTable_eq_trueTable (n : Nat)
    (history : FiniteHorizonRL.EpisodeBatchPrefix distinctMDP 1 n) :
    FiniteHorizonRL.AdaptiveEmpiricalOptimisticSource.successorTable
      () 0 n history = trueTable := by
  funext stage state
  cases state
  have hstage : stage = distinctStage := by
    apply Fin.ext
    change stage.val = 0
    have hlt := stage.isLt
    change stage.val < 1 at hlt
    omega
  subst stage
  exact distinctOptimisticTable_selects_true _

theorem falseTable_exploratory_true_mass_eq_quarter :
    ((falseTable.exploratoryPolicy (1 / 2) (by norm_num)).actionKernel
      distinctStage () {true}).toReal = 1 / 4 := by
  change (((falseTable.exploratoryActionPMF (1 / 2) (by norm_num)
    distinctStage ()).toMeasure {true}).toReal) = 1 / 4
  rw [(falseTable.exploratoryActionPMF (1 / 2) (by norm_num)
    distinctStage ()).toMeasure_apply_singleton true
      (measurableSet_singleton true)]
  rw [FiniteHorizonRL.DeterministicMarkovPolicyTable.exploratoryActionPMF,
    PMF.bind_apply, tsum_fintype, Fintype.sum_bool]
  norm_num [falseTable, PMF.bernoulli_apply,
    PMF.uniformOfFintype_apply, PMF.pure_apply]

theorem trueTable_exploratory_true_mass_eq_three_quarters :
    ((trueTable.exploratoryPolicy (1 / 2) (by norm_num)).actionKernel
      distinctStage () {true}).toReal = 3 / 4 := by
  change (((trueTable.exploratoryActionPMF (1 / 2) (by norm_num)
    distinctStage ()).toMeasure {true}).toReal) = 3 / 4
  rw [(trueTable.exploratoryActionPMF (1 / 2) (by norm_num)
    distinctStage ()).toMeasure_apply_singleton true
      (measurableSet_singleton true)]
  rw [FiniteHorizonRL.DeterministicMarkovPolicyTable.exploratoryActionPMF,
    PMF.bind_apply, tsum_fintype, Fintype.sum_bool]
  norm_num [trueTable, PMF.bernoulli_apply,
    PMF.uniformOfFintype_apply, PMF.pure_apply]
  rw [ENNReal.toReal_add
    (ENNReal.mul_ne_top (by norm_num) (by norm_num)) (by norm_num),
    ENNReal.toReal_mul]
  norm_num

theorem trueTable_exploratory_reward_integral_eq_three_quarters :
    (∫ action, distinctMDP.reward () action ∂
      (trueTable.exploratoryActionPMF (1 / 2) (by norm_num)
        distinctStage ()).toMeasure) = 3 / 4 := by
  rw [trueTable.integral_exploratoryActionPMF]
  norm_num [distinctMDP, trueTable]

theorem trueTable_exploratory_value_gap_eq_quarter :
    trueTable.toMarkovPolicy.valueRemaining 1 (by simp [distinctMDP]) () -
        (trueTable.exploratoryPolicy (1 / 2) (by norm_num)).valueRemaining
          1 (by simp [distinctMDP]) () = 1 / 4 := by
  simp only [FiniteHorizonRL.MarkovPolicy.valueRemaining]
  rw [trueTable.toMarkovPolicy_bellman, trueTable.exploratoryPolicy_bellman]
  simp [FiniteHorizonRL.MDP.bellmanQ, FiniteHorizonRL.MDP.transitionValue,
    distinctMDP, trueTable]
  norm_num

theorem distinctSource_initial_and_successor_true_masses
    (history : FiniteHorizonRL.EpisodeBatchPrefix distinctMDP 1 0) :
    (distinctSource.initialPolicy.actionKernel distinctStage () {true}).toReal =
        1 / 4 /\
      ((distinctSource.successorPolicy 0 history).actionKernel
        distinctStage () {true}).toReal = 3 / 4 := by
  constructor
  · exact falseTable_exploratory_true_mass_eq_quarter
  · change
      ((((FiniteHorizonRL.AdaptiveEmpiricalOptimisticSource.successorTable
        () 0 0 history).exploratoryPolicy (1 / 2) (by norm_num)).actionKernel
          distinctStage () {true}).toReal) = 3 / 4
    rw [distinctSuccessorTable_eq_trueTable]
    exact trueTable_exploratory_true_mass_eq_three_quarters

