def nonidenticalOneArmHalfModelCanary : FiniteBanditModel 1 where
  hK := by decide
  mean := fun _ => (1 / 2 : Rat)

noncomputable def nonidenticalHalfMixCanary : Measure Rat :=
  (2 : ENNReal)⁻¹ • Measure.dirac (0 : Rat) +
    (2 : ENNReal)⁻¹ • Measure.dirac (1 : Rat)

noncomputable instance :
    IsProbabilityMeasure nonidenticalHalfMixCanary where
  measure_univ := by
    simp [nonidenticalHalfMixCanary]
    exact ENNReal.inv_two_add_inv_two

theorem integral_nonidenticalHalfMixCanary :
    integral nonidenticalHalfMixCanary
        (fun reward : Rat => ((reward : Rat) : Real)) =
      (1 / 2 : Real) := by
  have h0 : Integrable (fun reward : Rat => ((reward : Rat) : Real))
      ((2 : ENNReal)⁻¹ • Measure.dirac (0 : Rat)) :=
    (integrable_dirac (by simp)).smul_measure (by simp)
  have h1 : Integrable (fun reward : Rat => ((reward : Rat) : Real))
      ((2 : ENNReal)⁻¹ • Measure.dirac (1 : Rat)) :=
    (integrable_dirac (by simp)).smul_measure (by simp)
  rw [nonidenticalHalfMixCanary, integral_add_measure h0 h1]
  norm_num

noncomputable def nonidenticalFixedMeanArmLawCanary
    (t : Nat) (_arm : Fin 1) : Measure Rat :=
  if Even t then Measure.dirac (1 / 2 : Rat)
  else nonidenticalHalfMixCanary

example :
    nonidenticalFixedMeanArmLawCanary 0 (0 : Fin 1) ≠
      nonidenticalFixedMeanArmLawCanary 1 (0 : Fin 1) := by
  intro h
  have hmass := congrArg
    (fun mu : Measure Rat => mu {(1 / 2 : Rat)}) h
  simp [nonidenticalFixedMeanArmLawCanary,
    nonidenticalHalfMixCanary] at hmass

example (horizon : Nat) : True := by
  have _hroute :=
    Tsallis.integral_sampledScheduledHalfTsallisFiniteArmIndependentRewardLawRegret_le_log
      nonidenticalOneArmHalfModelCanary nonidenticalFixedMeanArmLawCanary
      (fun t arm => by
        simp only [nonidenticalFixedMeanArmLawCanary]
        split
        · infer_instance
        · infer_instance)
      (fun t arm => by
        simp only [nonidenticalFixedMeanArmLawCanary]
        split
        · simp
          norm_num
        · simp [nonidenticalHalfMixCanary])
      (fun t arm => by
        simp only [nonidenticalFixedMeanArmLawCanary]
        split
        · simp [nonidenticalOneArmHalfModelCanary]
        · rw [integral_nonidenticalHalfMixCanary]
          norm_num [nonidenticalOneArmHalfModelCanary])
      (fun arm hne =>
        (hne (Subsingleton.elim arm
          nonidenticalOneArmHalfModelCanary.bestArm)).elim)
      horizon 0 le_rfl
  trivial

