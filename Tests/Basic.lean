namespace FiniteHorizonAdaptiveEmpiricalOptimisticSemanticCanary

local instance : MeasurableSpace Bool := ⊤

noncomputable def mdp : FiniteHorizonRL.MDP Bool Bool where
  horizon := 2
  transition := ProbabilityTheory.Kernel.const _ (Measure.dirac false)
  transition_isMarkov := by infer_instance
  reward state _action := if state then 1 else 0
  measurable_reward := measurable_of_finite _

def forwardSummary : FiniteHorizonRL.TransitionCountSummary mdp :=
  fun stage _state action nextState =>
    if stage.val = 0 ∧ nextState = action then 1 else 0

def reverseSummary : FiniteHorizonRL.TransitionCountSummary mdp :=
  fun stage _state action nextState =>
    if stage.val = 0 ∧ nextState = !action then 1 else 0

def mixedSummary : FiniteHorizonRL.TransitionCountSummary mdp :=
  fun stage _state action nextState =>
    if stage.val = 0 ∧ action = true then
      if nextState then 3 else 1
    else 0

def stageZero : Fin mdp.horizon := ⟨0, by simp [mdp]⟩
def stageOne : Fin mdp.horizon := ⟨1, by simp [mdp]⟩

example :
    FiniteHorizonRL.TransitionCountSummary.visitCount mixedSummary
      stageZero false true = 4 := by
  simp [FiniteHorizonRL.TransitionCountSummary.visitCount, mixedSummary,
    stageZero]

example :
    FiniteHorizonRL.TransitionCountSummary.empiricalTransitionPMF
        mixedSummary false stageZero false true true =
      (3 : ENNReal) / 4 := by
  simp [FiniteHorizonRL.TransitionCountSummary.empiricalTransitionPMF,
    FiniteHorizonRL.TransitionCountSummary.visitCount, mixedSummary, stageZero]

example :
    FiniteHorizonRL.TransitionCountSummary.empiricalTransitionPMF
        mixedSummary false stageZero false true false =
      (1 : ENNReal) / 4 := by
  simp [FiniteHorizonRL.TransitionCountSummary.empiricalTransitionPMF,
    FiniteHorizonRL.TransitionCountSummary.visitCount, mixedSummary, stageZero]

example :
    FiniteHorizonRL.TransitionCountSummary.empiricalTransitionPMF
      mixedSummary false stageOne false false = PMF.pure false := by
  simp [FiniteHorizonRL.TransitionCountSummary.empiricalTransitionPMF,
    FiniteHorizonRL.TransitionCountSummary.visitCount, mixedSummary, stageOne]

theorem forwardPMF (action : Bool) :
    FiniteHorizonRL.TransitionCountSummary.empiricalTransitionPMF
      forwardSummary false stageZero false action = PMF.pure action := by
  ext nextState
  cases action <;> cases nextState <;>
    simp [FiniteHorizonRL.TransitionCountSummary.empiricalTransitionPMF,
      FiniteHorizonRL.TransitionCountSummary.visitCount, forwardSummary,
      stageZero, PMF.pure_apply]

theorem reversePMF (action : Bool) :
    FiniteHorizonRL.TransitionCountSummary.empiricalTransitionPMF
      reverseSummary false stageZero false action = PMF.pure (!action) := by
  ext nextState
  cases action <;> cases nextState <;>
    simp [FiniteHorizonRL.TransitionCountSummary.empiricalTransitionPMF,
      FiniteHorizonRL.TransitionCountSummary.visitCount, reverseSummary,
      stageZero, PMF.pure_apply]

def boolTable : FiniteHorizonRL.DeterministicMarkovPolicyTable mdp :=
  fun _stage _state => false

example (stage : Fin mdp.horizon) (state action : Bool) :
    boolTable.exploratoryActionPMF 1 (by norm_num) stage state action =
      (2 : ENNReal)⁻¹ := by
  rw [FiniteHorizonRL.DeterministicMarkovPolicyTable.exploratoryActionPMF,
    PMF.bind_apply, tsum_fintype, Fintype.sum_bool]
  simp [PMF.bernoulli_apply, PMF.uniformOfFintype_apply]

noncomputable def forwardPlan :=
  FiniteHorizonRL.TransitionCountSummary.optimisticPlan
    mdp forwardSummary false 0

noncomputable def reversePlan :=
  FiniteHorizonRL.TransitionCountSummary.optimisticPlan
    mdp reverseSummary false 0

theorem forwardUpperValueOne (state : Bool) :
    forwardPlan.upperValueRemaining 1 (by simp [mdp]) state =
      if state then 1 else 0 := by
  simp [forwardPlan, FiniteHorizonRL.TransitionCountSummary.optimisticPlan,
    FiniteHorizonRL.MDP.EstimatedModelPlan.upperValueRemaining,
    FiniteHorizonRL.MDP.EstimatedModelPlan.optimisticBellman,
    FiniteHorizonRL.MDP.EstimatedModelPlan.optimisticQ,
    FiniteHorizonRL.MDP.EstimatedModelPlan.bellmanQ,
    FiniteHorizonRL.MDP.EstimatedModelPlan.transitionValue, mdp]

theorem reverseUpperValueOne (state : Bool) :
    reversePlan.upperValueRemaining 1 (by simp [mdp]) state =
      if state then 1 else 0 := by
  simp [reversePlan, FiniteHorizonRL.TransitionCountSummary.optimisticPlan,
    FiniteHorizonRL.MDP.EstimatedModelPlan.upperValueRemaining,
    FiniteHorizonRL.MDP.EstimatedModelPlan.optimisticBellman,
    FiniteHorizonRL.MDP.EstimatedModelPlan.optimisticQ,
    FiniteHorizonRL.MDP.EstimatedModelPlan.bellmanQ,
    FiniteHorizonRL.MDP.EstimatedModelPlan.transitionValue, mdp]

theorem forwardOptimisticQStageZero (action : Bool) :
    forwardPlan.optimisticQ stageZero
        (forwardPlan.upperValueRemaining 1 (by simp [mdp])) false action =
      if action then 1 else 0 := by
  change
    (if false then 1 else 0) +
          (∫ nextState,
            forwardPlan.upperValueRemaining 1 (by simp [mdp]) nextState ∂
              (FiniteHorizonRL.TransitionCountSummary.empiricalTransitionPMF
                forwardSummary false stageZero false action).toMeasure) +
        0 + 0 = _
  rw [forwardPMF, PMF.toMeasure_pure]
  simp [forwardUpperValueOne]

theorem reverseOptimisticQStageZero (action : Bool) :
    reversePlan.optimisticQ stageZero
        (reversePlan.upperValueRemaining 1 (by simp [mdp])) false action =
      if !action then 1 else 0 := by
  change
    (if false then 1 else 0) +
          (∫ nextState,
            reversePlan.upperValueRemaining 1 (by simp [mdp]) nextState ∂
              (FiniteHorizonRL.TransitionCountSummary.empiricalTransitionPMF
                reverseSummary false stageZero false action).toMeasure) +
        0 + 0 = _
  rw [reversePMF, PMF.toMeasure_pure]
  simp [reverseUpperValueOne]

theorem forwardSelectedTrue :
    forwardPlan.optimisticActionAt stageZero false = true := by
  by_contra hnot
  have hchosen : forwardPlan.optimisticActionAt stageZero false = false :=
    Bool.eq_false_of_not_eq_true hnot
  have hmax := forwardPlan.optimisticQ_le_optimisticAction
    stageZero
    (forwardPlan.upperValueRemaining 1 (by simp [mdp])) false true
  rw [show forwardPlan.optimisticAction stageZero
      (forwardPlan.upperValueRemaining 1 (by simp [mdp])) false =
        forwardPlan.optimisticActionAt stageZero false by rfl,
    hchosen] at hmax
  rw [forwardOptimisticQStageZero true,
    forwardOptimisticQStageZero false] at hmax
  norm_num at hmax

theorem reverseSelectedFalse :
    reversePlan.optimisticActionAt stageZero false = false := by
  by_contra hnot
  have hchosen : reversePlan.optimisticActionAt stageZero false = true :=
    Bool.eq_true_of_not_eq_false hnot
  have hmax := reversePlan.optimisticQ_le_optimisticAction
    stageZero
    (reversePlan.upperValueRemaining 1 (by simp [mdp])) false false
  rw [show reversePlan.optimisticAction stageZero
      (reversePlan.upperValueRemaining 1 (by simp [mdp])) false =
        reversePlan.optimisticActionAt stageZero false by rfl,
    hchosen] at hmax
  rw [reverseOptimisticQStageZero false,
    reverseOptimisticQStageZero true] at hmax
  norm_num at hmax

theorem countDependentOptimisticPolicyTables_ne :
    forwardSummary.optimisticPolicyTable mdp false 0 ≠
      reverseSummary.optimisticPolicyTable mdp false 0 := by
  intro heq
  have hcoordinate := congrFun (congrFun heq stageZero) false
  change forwardPlan.optimisticActionAt stageZero false =
    reversePlan.optimisticActionAt stageZero false at hcoordinate
  rw [forwardSelectedTrue, reverseSelectedFalse] at hcoordinate
  contradiction

end FiniteHorizonAdaptiveEmpiricalOptimisticSemanticCanary

