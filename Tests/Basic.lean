example (horizon : Nat) : True := by
  have _hroute :=
    Tsallis.integral_sampledScheduledHalfTsallisFiniteArmIndependentDriftingMeanDynamicRegret_le_allRegimes
      nonidenticalOneArmHalfModelCanary nonidenticalFixedMeanArmLawCanary
      (fun t arm => by
        simp only [nonidenticalFixedMeanArmLawCanary]
        split <;> infer_instance)
      (fun t arm => by
        simp only [nonidenticalFixedMeanArmLawCanary]
        split
        · simp
          norm_num
        · simp [nonidenticalHalfMixCanary])
      (fun _ _ => 0)
      (fun t arm => by
        simp only [Tsallis.finiteArmIndependentRewardMean,
          nonidenticalFixedMeanArmLawCanary]
        split
        · simp [nonidenticalOneArmHalfModelCanary]
        · rw [integral_nonidenticalHalfMixCanary]
          norm_num [nonidenticalOneArmHalfModelCanary])
      (fun arm hne =>
        (hne (Subsingleton.elim arm
          nonidenticalOneArmHalfModelCanary.bestArm)).elim)
      (fun arm hne =>
        (hne (Subsingleton.elim arm
          nonidenticalOneArmHalfModelCanary.bestArm)).elim)
      horizon
  trivial

example (horizon : Nat) : True := by
  have _hroute :=
    Tsallis.integral_sampledScheduledHalfTsallisFiniteArmIndependentDriftingMeanDynamicRegret_le_allRegimes
      driftingTwoArmModelCanary switchingTwoArmLawCanary
      (fun t arm => by
        simp only [switchingTwoArmLawCanary]
        split_ifs <;> infer_instance)
      (fun t arm => by
        fin_cases arm <;>
          by_cases ht : Even t <;>
          simp [switchingTwoArmLawCanary, ht] <;> norm_num)
      (fun _ _ => 1 / 2)
      (fun t arm => by
        fin_cases arm <;>
          by_cases ht : Even t <;>
          simp [Tsallis.finiteArmIndependentRewardMean,
            switchingTwoArmLawCanary, driftingTwoArmModelCanary, ht] <;>
          norm_num)
      (fun arm harm => by
        rw [driftingTwoArmModelCanary_bestArm] at harm
        fin_cases arm
        · exact (harm rfl).elim
        · rw [FiniteBanditModel.gap]
          simp only [driftingTwoArmModelCanary_bestArm]
          rw [FiniteBanditModel.bestMean,
            driftingTwoArmModelCanary_bestArm]
          norm_num [driftingTwoArmModelCanary])
      (fun arm harm => by
        rw [driftingTwoArmModelCanary_bestArm] at harm
        fin_cases arm
        · exact (harm rfl).elim
        · rw [FiniteBanditModel.gap]
          simp only [driftingTwoArmModelCanary_bestArm]
          rw [FiniteBanditModel.bestMean,
            driftingTwoArmModelCanary_bestArm]
          norm_num [driftingTwoArmModelCanary])
      horizon
  trivial

