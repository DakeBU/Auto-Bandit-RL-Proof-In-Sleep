    [MeasurableSpace Env] [StandardBorelSpace Env]
    [MeasurableSpace Action] [MeasurableSingletonClass Action]
    [StandardBorelSpace Action] [Nonempty Action] [DecidableEq Action]
    (prior : MeasureTheory.Measure Env) [MeasureTheory.IsFiniteMeasure prior]
    (horizon : Nat) (arms : Finset Action) (harms : arms.Nonempty)
    (eta : Real) (heta : 0 < eta)
    (selector : Tsallis.HalfTsallisFiniteHistorySelectorMeasurability
      arms harms eta)
    (loss : Exp3.PredictableLossVector Env Action)
    (hscore : forall n, Measurable
      (Tsallis.sampledHalfTsallisHistoryActionStabilityAt
        arms harms eta loss n)) :
    let mu := prior.compProd (Tsallis.sampledHalfTsallisTrajectoryKernel
      arms harms eta selector loss.environment)
    MeasureTheory.integral mu (fun sample =>
        (Finset.range horizon).sum (fun n =>
          Tsallis.sampledHalfTsallisSuccessorStabilityAt
            arms harms eta loss n sample)) <=
      MeasureTheory.integral mu (fun sample =>
        (Finset.range horizon).sum (fun n =>
          Tsallis.sampledHalfTsallisHalfPowerBoundAt (Env := Env)
            arms harms eta n
            (Tsallis.sampledHalfTsallisHistoryAt n sample))) := by
  exact
    Tsallis.integral_sum_sampledHalfTsallisSuccessorStability_le_integral_sum_halfPowerStabilityBound_of_measurable
      prior horizon arms harms eta heta selector loss hscore

