example {Omega Feature : Type*}
    [mOmega : MeasurableSpace Omega] [StandardBorelSpace Omega]
    [Fintype Feature] [DecidableEq Feature] [Nonempty Feature]
    (mu : Measure Omega) [IsProbabilityMeasure mu]
    (V0 : Matrix Feature Feature Real) (hV0 : V0.PosDef)
    (thetaStar : Feature -> Real)
    (F : Filtration Nat mOmega)
    (feature : Nat -> Omega -> Feature -> Real)
    (response noise : Nat -> Omega -> Real)
    (R : Real) (hR : 0 < R)
    (projectionBound : EuclideanSpace Real Feature -> Nat -> Real)
    (hfeature : forall i j,
      StronglyMeasurable[F i] (fun omega => feature i omega j))
    (hnoise : StronglyAdapted F (fun t omega =>
      match t with
      | 0 => 0
      | i + 1 => noise i omega))
    (hprojectionBound_nonneg : forall theta i,
      0 <= projectionBound theta i)
    (hprojectionBound : forall theta i omega,
      |dotProduct (WithLp.ofLp theta) (feature i omega)| <=
        projectionBound theta i)
    (n : Nat)
    (hsubGaussian : forall i, i < n ->
      HasCondSubgaussianMGF
        (F i) (F.le i) (noise i)
        (OFUL.constantSquaredVarianceProxy R i) mu)
    (delta : Real) (hdelta : 0 < delta) (hdelta_one : delta <= 1)
    (biasRadius : Real)
    (hresponse : forall omega i, i < n ->
      response i omega =
        dotProduct thetaStar (feature i omega) + noise i omega)
    (hbias : forall omega,
      OFUL.matrixNorm
          (V0 + OFUL.finiteHorizonFeatureGram feature n omega)
          ((V0 + OFUL.finiteHorizonFeatureGram feature n omega)⁻¹.mulVec
            (V0.mulVec thetaStar)) <=
        biasRadius) :
    mu {omega |
        OFUL.matrixNorm
            (V0 + OFUL.finiteHorizonFeatureGram feature n omega)
            (OFUL.finiteHorizonRidgeEstimate V0 feature response n omega -
              thetaStar) >
          OFUL.finiteHorizonConfidenceRadius
            V0 feature R delta biasRadius n omega} <=
      ENNReal.ofReal delta := by
  exact
    OFUL.measure_finiteHorizonRidgeEstimate_error_matrixNorm_gt_confidenceRadius_le
      mu V0 hV0 thetaStar F feature response noise R hR projectionBound
      hfeature hnoise hprojectionBound_nonneg hprojectionBound n hsubGaussian
      delta hdelta hdelta_one biasRadius hresponse hbias

