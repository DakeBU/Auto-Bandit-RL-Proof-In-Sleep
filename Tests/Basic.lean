namespace FiniteHorizonAdaptiveCumulativeEmpiricalOptimisticRegretCanary

local instance : MeasurableSpace Unit := ⊤

open FiniteHorizonRL
open FiniteHorizonRL.AdaptiveEpisodeBatchSource
open FiniteHorizonRL.AdaptiveCumulativeEmpiricalOptimisticSource

noncomputable def mdp : MDP Unit Unit where
  horizon := 1
  transition := ProbabilityTheory.Kernel.deterministic
    (fun _pair => ()) measurable_const
  transition_isMarkov := by infer_instance
  reward := fun _state _action => 0
  measurable_reward := measurable_const

def sampleStep : EpisodeStep Unit Unit where
  state := ()
  action := ()
  reward := 0
  nextState := ()

def sampleBatch : EpisodeBatch mdp 1 :=
  fun _episode _stage => sampleStep

def trajectory : EpisodeBatchTrajectory mdp 1 :=
  fun _round => sampleBatch

def stage : Fin mdp.horizon := ⟨0, by simp [mdp]⟩

def countRadius : TransitionCountRadius :=
  TransitionCountRadius.linearDecay 4

noncomputable def initialTable : DeterministicMarkovPolicyTable mdp :=
  fun _stage _state => ()

noncomputable def behaviorSource :=
  exploratorySource mdp (MeasureTheory.Measure.dirac ()) 1 initialTable () countRadius
    1 (by norm_num)

example :
    (cumulativeTransitionCountSummaryAt trajectory 0).visitCount stage () () = 1 := by
  norm_num [cumulativeTransitionCountSummaryAt,
    EpisodeBatchPrefix.cumulativeTransitionCountSummary,
    TransitionCountSummary.visitCount, EpisodeBatch.transitionCount,
    trajectory, sampleBatch, sampleStep, stage, mdp]

example :
    (cumulativeTransitionCountSummaryAt trajectory 1).visitCount stage () () = 2 := by
  norm_num [cumulativeTransitionCountSummaryAt,
    EpisodeBatchPrefix.cumulativeTransitionCountSummary,
    TransitionCountSummary.visitCount, EpisodeBatch.transitionCount,
    trajectory, sampleBatch, sampleStep, stage, mdp]

example :
    countRadius.radius
        ((cumulativeTransitionCountSummaryAt trajectory 0).visitCount stage () ()) = 3 /\
      countRadius.radius
        ((cumulativeTransitionCountSummaryAt trajectory 1).visitCount stage () ()) = 2 := by
  constructor <;>
    norm_num [countRadius, TransitionCountRadius.linearDecay,
      cumulativeTransitionCountSummaryAt,
      EpisodeBatchPrefix.cumulativeTransitionCountSummary,
      TransitionCountSummary.visitCount, EpisodeBatch.transitionCount,
      trajectory, sampleBatch, sampleStep, stage, mdp]

example :
    countRadius.radius
        ((cumulativeTransitionCountSummaryAt trajectory 1).visitCount stage () ()) <=
      countRadius.radius
        ((cumulativeTransitionCountSummaryAt trajectory 0).visitCount stage () ()) := by
  exact countRadius.radius_cumulativeVisitCount_succ_le trajectory 0 stage () ()

noncomputable example (history : EpisodeBatchPrefix mdp 1 0) :
    behaviorSource.successorPolicy 0 history =
      (successorTable () countRadius 0 history).exploratoryPolicy 1 (by norm_num) := by
  exact exploratorySource_successorPolicy
    initialTable () countRadius 1 (by norm_num) 0 history

example :
    adaptiveCumulativeTransitionCoordinateRadius trajectory (0 : Fin 2)
        (1 / 2) stage () () () =
      2 * cumulativeCoordinateConfidenceRadius 1 1
          (cumulativeCountLocalDelta mdp 2 (1 / 2)) := by
  norm_num [adaptiveCumulativeTransitionCoordinateRadius,
    cumulativeTransitionCountSummaryAt,
    EpisodeBatchPrefix.cumulativeTransitionCountSummary,
    TransitionCountSummary.visitCount, EpisodeBatch.transitionCount,
    trajectory, sampleBatch, sampleStep, stage, mdp]

noncomputable example
    [StandardBorelSpace (EpisodeBatch mdp 1)]
    [StandardBorelSpace (EpisodeBatchTrajectory mdp 1)]
    (hcover :
      AdaptiveEpisodeBatchSource.AdaptiveCumulativeCountMartingaleCover
        (rounds := 2) behaviorSource countRadius (1 / 2) 0)
    (radiusEnvelope : Fin 2 -> Real)
    (hradius : forall trajectory,
      trajectory ∉ behaviorSource.adaptiveCumulativeCountBadEvent 2 (1 / 2) ->
      forall (round : Fin 2) (remaining : Nat)
        (hremaining : remaining + 1 <= mdp.horizon) (state : Unit),
        (adaptiveCumulativeEmpiricalOptimisticPlanAt
          trajectory () countRadius round).selectedRadiusRemaining
            remaining hremaining state <= radiusEnvelope round) :
    let bad := behaviorSource.adaptiveCumulativeCountBadEvent 2 (1 / 2)
    MeasurableSet bad /\
      behaviorSource.trajectoryMeasure bad <= ENNReal.ofReal (1 / 2) /\
      forall trajectory, trajectory ∉ bad ->
        (forall round : Fin 2, forall state,
          mdp.optimalValueRemaining mdp.horizon le_rfl state <=
            (adaptiveCumulativeEmpiricalOptimisticPlanAt
              trajectory () countRadius round).upperValueRemaining
                mdp.horizon le_rfl state) /\
        adaptiveCumulativeEmpiricalOptimisticRecommendedExpectedRegret
            (initialState := MeasureTheory.Measure.dirac ())
            trajectory () countRadius 2 <=
          ∑ round : Fin 2,
            (mdp.horizon : Real) * (2 * radiusEnvelope round) := by
  simpa [behaviorSource] using
    exploratorySource_trajectoryMeasure_cumulativeCountMartingale_optimism_and_explicitRecommendedExpectedRegret
      (mdp := mdp) (initialState := MeasureTheory.Measure.dirac ())
      (episodes := 1) (rounds := 2) initialTable () countRadius
      1 (by norm_num) 0 (by simp [mdp]) (by simp [mdp])
      (by norm_num) (by norm_num) (1 / 2)
      (by norm_num) (by norm_num) hcover radiusEnvelope hradius

noncomputable example
    (confidence : forall round : Fin 2,
      (adaptiveCumulativeEmpiricalOptimisticPlanAt
        trajectory () countRadius round).CoordinateConfidence)
    (radiusEnvelope : Fin 2 -> Real)
    (hradius : forall (round : Fin 2) (remaining : Nat)
      (hremaining : remaining + 1 <= mdp.horizon) (state : Unit),
      (adaptiveCumulativeEmpiricalOptimisticPlanAt
        trajectory () countRadius round).selectedRadiusRemaining
          remaining hremaining state <= radiusEnvelope round) :
    (forall round : Fin 2, forall state,
      mdp.optimalValueRemaining mdp.horizon le_rfl state <=
        (adaptiveCumulativeEmpiricalOptimisticPlanAt
          trajectory () countRadius round).upperValueRemaining
            mdp.horizon le_rfl state) /\
    adaptiveCumulativeEmpiricalOptimisticRecommendedExpectedRegret
        (initialState := MeasureTheory.Measure.dirac ()) trajectory () countRadius 2 <=
      ∑ round : Fin 2, (mdp.horizon : Real) * (2 * radiusEnvelope round) := by
  exact adaptiveCumulativeCoordinateConfidence_optimism_and_recommendedExpectedRegret
    trajectory () countRadius radiusEnvelope confidence hradius

