namespace FiniteHorizonAdaptiveEpisodeBatchHistorySensitiveCanary

local instance : MeasurableSpace Unit := ⊤
local instance : MeasurableSpace Bool := ⊤

noncomputable def mdp : FiniteHorizonRL.MDP Unit Bool where
  horizon := 1
  transition := ProbabilityTheory.Kernel.const _ (Measure.dirac ())
  transition_isMarkov := by infer_instance
  reward _state action := if action then 1 else 0
  measurable_reward := measurable_of_finite _

noncomputable def falsePolicy : FiniteHorizonRL.MarkovPolicy mdp where
  actionKernel _stage := ProbabilityTheory.Kernel.deterministic
    (fun _state => false) measurable_const
  actionKernel_isMarkov _stage := by infer_instance

noncomputable def truePolicy : FiniteHorizonRL.MarkovPolicy mdp where
  actionKernel _stage := ProbabilityTheory.Kernel.deterministic
    (fun _state => true) measurable_const
  actionKernel_isMarkov _stage := by infer_instance

noncomputable def initialPolicy : FiniteHorizonRL.MarkovPolicy mdp where
  actionKernel _stage := ProbabilityTheory.Kernel.const _
    (PMF.uniformOfFintype Bool).toMeasure
  actionKernel_isMarkov _stage := by infer_instance

def firstActionTrue (n : Nat) :
    Set (FiniteHorizonRL.EpisodeBatchPrefix mdp 1 n) :=
  {history |
    (history ⟨0, Finset.mem_Iic.mpr (Nat.zero_le n)⟩ 0
      ⟨0, by simp [mdp]⟩).action = true}

theorem measurableSet_firstActionTrue (n : Nat) :
    MeasurableSet (firstActionTrue n) := by
  let index : Finset.Iic n := ⟨0, Finset.mem_Iic.mpr (Nat.zero_le n)⟩
  let stage : Fin mdp.horizon := ⟨0, by simp [mdp]⟩
  have haction : Measurable
      (fun history : FiniteHorizonRL.EpisodeBatchPrefix mdp 1 n =>
        (history index 0 stage).action) := by
    exact FiniteHorizonRL.EpisodeStep.measurable_action.comp
      ((measurable_pi_apply stage).comp
        ((measurable_pi_apply (0 : Fin 1)).comp
          (measurable_pi_apply index)))
  change MeasurableSet
    ((fun history : FiniteHorizonRL.EpisodeBatchPrefix mdp 1 n =>
      (history index 0 stage).action) ⁻¹' {true})
  exact (measurableSet_singleton true).preimage haction

noncomputable def successorPolicy (n : Nat)
    (history : FiniteHorizonRL.EpisodeBatchPrefix mdp 1 n) :
    FiniteHorizonRL.MarkovPolicy mdp := by
  classical
  exact if history ∈ firstActionTrue n then truePolicy else falsePolicy

noncomputable def batchKernel (n : Nat) :
    ProbabilityTheory.Kernel
      (FiniteHorizonRL.EpisodeBatchPrefix mdp 1 n)
      (FiniteHorizonRL.EpisodeBatch mdp 1) := by
  classical
  exact ProbabilityTheory.Kernel.piecewise (measurableSet_firstActionTrue n)
    (ProbabilityTheory.Kernel.const _
      (truePolicy.iidEpisodeBatchMeasure (Measure.dirac ()) 1))
    (ProbabilityTheory.Kernel.const _
      (falsePolicy.iidEpisodeBatchMeasure (Measure.dirac ()) 1))

noncomputable def source :
    FiniteHorizonRL.AdaptiveEpisodeBatchSource mdp (Measure.dirac ()) 1 where
  initialPolicy := initialPolicy
  successorPolicy := successorPolicy
  batchKernel := batchKernel
  batchKernel_isMarkov _n := by
    unfold batchKernel
    infer_instance
  batchKernel_eq_iidEpisodeBatchMeasure n history := by
    classical
    rw [batchKernel, ProbabilityTheory.Kernel.piecewise_apply]
    by_cases hhistory : history ∈ firstActionTrue n
    · simp [successorPolicy, hhistory]
    · simp [successorPolicy, hhistory]

def step (action : Bool) : FiniteHorizonRL.EpisodeStep Unit Bool where
  state := ()
  action := action
  reward := if action then 1 else 0
  nextState := ()

def batch (action : Bool) : FiniteHorizonRL.EpisodeBatch mdp 1 :=
  fun _episode _stage => step action

def constantPrefix (n : Nat) (action : Bool) :
    FiniteHorizonRL.EpisodeBatchPrefix mdp 1 n :=
  fun _index => batch action

theorem successorPolicy_true_branch (n : Nat) :
    source.successorPolicy n (constantPrefix n true) = truePolicy := by
  simp [source, successorPolicy, firstActionTrue, constantPrefix, batch, step]

theorem successorPolicy_false_branch (n : Nat) :
    source.successorPolicy n (constantPrefix n false) = falsePolicy := by
  simp [source, successorPolicy, firstActionTrue, constantPrefix, batch, step]

theorem measurableSuccessorCountBadEvent (n : Nat) :
    MeasurableSet
      (source.successorSimultaneousCountBadEvent 2 (1 / 2 : Real) n) := by
  let localDelta := FiniteHorizonRL.multiBatchLocalDelta 2 (1 / 2 : Real)
  let trueBad := truePolicy.simultaneousCountBadEvent
    (Measure.dirac ()) 1 localDelta
  let falseBad := falsePolicy.simultaneousCountBadEvent
    (Measure.dirac ()) 1 localDelta
  have htrue : MeasurableSet trueBad :=
    truePolicy.measurableSet_simultaneousCountBadEvent
      (Measure.dirac ()) 1 localDelta
  have hfalse : MeasurableSet falseBad :=
    falsePolicy.measurableSet_simultaneousCountBadEvent
      (Measure.dirac ()) 1 localDelta
  have heq : source.successorSimultaneousCountBadEvent 2
      (1 / 2 : Real) n =
      (firstActionTrue n ×ˢ trueBad) ∪
        ((firstActionTrue n)ᶜ ×ˢ falseBad) := by
    ext pair
    by_cases hhistory : pair.1 ∈ firstActionTrue n
    · simp [FiniteHorizonRL.AdaptiveEpisodeBatchSource.successorSimultaneousCountBadEvent,
        source, successorPolicy, localDelta, trueBad, falseBad, hhistory]
    · simp [FiniteHorizonRL.AdaptiveEpisodeBatchSource.successorSimultaneousCountBadEvent,
        source, successorPolicy, localDelta, trueBad, falseBad, hhistory]
  rw [heq]
  exact ((measurableSet_firstActionTrue n).prod htrue).union
    ((measurableSet_firstActionTrue n).compl.prod hfalse)

noncomputable example :
    MeasurableSet
        (source.adaptiveSimultaneousCountBadEvent 2 (1 / 2 : Real)) ∧
    source.trajectoryMeasure
        (source.adaptiveSimultaneousCountBadEvent 2 (1 / 2 : Real)) ≤
      ENNReal.ofReal (1 / 2 : Real) ∧
    ∀ trajectory,
      trajectory ∉
          source.adaptiveSimultaneousCountBadEvent 2 (1 / 2 : Real) ->
      ∀ round : Fin 2, ∀ coordinate : FiniteHorizonRL.CountCoordinate mdp,
        |coordinate.deviation (source.policyAt trajectory round)
            (Measure.dirac ()) (trajectory round)| <
          FiniteHorizonRL.simultaneousCountConfidenceRadius mdp 1
            (FiniteHorizonRL.multiBatchLocalDelta 2 (1 / 2 : Real)) := by
  exact source.trajectoryMeasure_adaptiveSimultaneousCountConfidence
    2 (by norm_num) (by norm_num) (1 / 2 : Real)
      (by norm_num) (by norm_num)
      (fun n _hn => measurableSuccessorCountBadEvent n)

end FiniteHorizonAdaptiveEpisodeBatchHistorySensitiveCanary

