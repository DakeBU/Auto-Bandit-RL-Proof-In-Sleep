        arms harms eta loss q horizon) <=
      2 * eta * Tsallis.powerSum arms (1 / 2 : Real)
          (Tsallis.initialHalfTsallisDistribution arms harms eta) +
        integral mu (fun sample => (Finset.range horizon).sum (fun n =>
          Tsallis.sampledHalfTsallisHalfPowerBoundAt (Env := Env)
            arms harms eta n
              (Tsallis.sampledHalfTsallisHistoryAt n sample))) +
        ((Tsallis.powerSum arms (1 / 2 : Real)
