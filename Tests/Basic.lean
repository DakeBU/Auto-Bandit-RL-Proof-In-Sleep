    let mu := prior ⊗ₘ Exp3.sampledImportanceWeightedTrajectoryKernel arms harms
      eta gamma
        (Exp3.doubleVarianceProbabilisticSparseLossClippedExplorationRate_pos
          (arms.card : Real) (sparsity : Real) (horizon : Real) deltaArm
