noncomputable def rewardSource :
    FiniteHorizonRL.MDP.MeanCompatibleRewardKernel mdp :=
  FiniteHorizonRL.MDP.MeanCompatibleRewardKernel.deterministic mdp

def firstActionTrue (n : Nat) :
    Set (FiniteHorizonRL.StochasticEpisodeBatchPrefix mdp 1 n) :=
  {history |
    FiniteHorizonRL.RewardStepTrace.headAction
      (Action := Bool) (State := Unit) 0
      (history ⟨0, Finset.mem_Iic.mpr (Nat.zero_le n)⟩ 0).2 = true}

theorem measurableSet_firstActionTrue (n : Nat) :
    MeasurableSet (firstActionTrue n) := by
  let index : Finset.Iic n := ⟨0, Finset.mem_Iic.mpr (Nat.zero_le n)⟩
  have haction : Measurable
      (fun history : FiniteHorizonRL.StochasticEpisodeBatchPrefix mdp 1 n =>
        FiniteHorizonRL.RewardStepTrace.headAction
          (Action := Bool) (State := Unit) 0 (history index 0).2) := by
    exact (FiniteHorizonRL.RewardStepTrace.measurable_headAction 0).comp
      (measurable_snd.comp
        ((measurable_pi_apply (0 : Fin 1)).comp
          (measurable_pi_apply index)))
  change MeasurableSet
    ((fun history : FiniteHorizonRL.StochasticEpisodeBatchPrefix mdp 1 n =>
      FiniteHorizonRL.RewardStepTrace.headAction
        (Action := Bool) (State := Unit) 0 (history index 0).2) ⁻¹' {true})
  exact (measurableSet_singleton true).preimage haction

noncomputable def successorPolicy (n : Nat)
    (history : FiniteHorizonRL.StochasticEpisodeBatchPrefix mdp 1 n) :
    FiniteHorizonRL.MarkovPolicy mdp := by
  classical
  exact if history ∈ firstActionTrue n then truePolicy else falsePolicy

noncomputable def batchKernel (n : Nat) :
    ProbabilityTheory.Kernel
      (FiniteHorizonRL.StochasticEpisodeBatchPrefix mdp 1 n)
      (FiniteHorizonRL.StochasticEpisodeBatch mdp 1) := by
  classical
  exact ProbabilityTheory.Kernel.piecewise (measurableSet_firstActionTrue n)
    (ProbabilityTheory.Kernel.const _
      (rewardSource.iidStochasticTrajectoryFamilyMeasure
        truePolicy (Measure.dirac ()) 1))
    (ProbabilityTheory.Kernel.const _
      (rewardSource.iidStochasticTrajectoryFamilyMeasure
        falsePolicy (Measure.dirac ()) 1))

noncomputable def source :
    FiniteHorizonRL.AdaptiveStochasticEpisodeBatchSource
      mdp (Measure.dirac ()) 1 where
  rewardSource := rewardSource
  initialPolicy := initialPolicy
  successorPolicy := successorPolicy
  batchKernel := batchKernel
  batchKernel_isMarkov := by
    intro n
    unfold batchKernel
    infer_instance
  batchKernel_eq_iidStochasticTrajectoryFamilyMeasure := by
    intro n history
    classical
    rw [batchKernel, ProbabilityTheory.Kernel.piecewise_apply]
    by_cases hhistory : history ∈ firstActionTrue n
    · simp [successorPolicy, hhistory]
    · simp [successorPolicy, hhistory]
  measurable_successorSampledReturnDeviation := by
    intro n
    classical
    have heq :
        (fun pair :
            FiniteHorizonRL.StochasticEpisodeBatchPrefix mdp 1 n ×
              FiniteHorizonRL.StochasticEpisodeBatch mdp 1 =>
          mdp.sampledCumulativeReturnDeviationSum
            (successorPolicy n pair.1) 1 pair.2) =
          (fun pair =>
            if pair.1 ∈ firstActionTrue n then
              mdp.sampledCumulativeReturnDeviationSum truePolicy 1 pair.2
            else
              mdp.sampledCumulativeReturnDeviationSum falsePolicy 1 pair.2) := by
      funext pair
      by_cases hpair : pair.1 ∈ firstActionTrue n <;>
        simp [successorPolicy, hpair]
    rw [heq]
    exact Measurable.ite
      ((measurableSet_firstActionTrue n).preimage measurable_fst)
      ((mdp.measurable_sampledCumulativeReturnDeviationSum
        truePolicy 1).comp measurable_snd)
      ((mdp.measurable_sampledCumulativeReturnDeviationSum
        falsePolicy 1).comp measurable_snd)

