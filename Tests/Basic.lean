theorem simultaneousCountConfidenceRadius_sixteen_quarter_lt_sixteen :
    FiniteHorizonRL.simultaneousCountConfidenceRadius mdp 16 (1 / 4) < 16 := by
  have hsquare := Concentration.subGaussianSumConfidenceRadius_sq
    (FiniteHorizonRL.MarkovPolicy.iidBernoulliVarianceProxy 16)
    (FiniteHorizonRL.simultaneousCountDelta mdp (1 / 4))
    (by rw [simultaneousCountDelta_quarter_eq_eighth]; norm_num)
    (by rw [simultaneousCountDelta_quarter_eq_eighth]; norm_num)
  rw [FiniteHorizonRL.MarkovPolicy.iidBernoulliVarianceProxy_eq,
    simultaneousCountDelta_quarter_eq_eighth] at hsquare
  norm_num at hsquare
  have hlog : Real.log 16 < 15 := by
    have h := Real.log_lt_sub_one_of_pos (x := (16 : Real))
      (by norm_num) (by norm_num)
    norm_num at h
    exact h
  have hradius_nonneg :
      0 <= FiniteHorizonRL.simultaneousCountConfidenceRadius mdp 16 (1 / 4) :=
    Concentration.subGaussianSumConfidenceRadius_nonneg _ _
  have hradius_eq :
      FiniteHorizonRL.simultaneousCountConfidenceRadius mdp 16 (1 / 4) =
        Concentration.subGaussianSumConfidenceRadius 4 (1 / 8) := by
    rw [FiniteHorizonRL.simultaneousCountConfidenceRadius,
      FiniteHorizonRL.MarkovPolicy.iidBernoulliVarianceProxy_eq,
      simultaneousCountDelta_quarter_eq_eighth]
    norm_num
  rw [hradius_eq] at hradius_nonneg ⊢
  nlinarith

