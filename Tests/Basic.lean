namespace FiniteHorizonAdaptiveStochasticRewardProjectedSelectorSemanticCanary

local instance : MeasurableSpace Bool := ⊤

open FiniteHorizonAdaptiveEmpiricalOptimisticSemanticCanary

noncomputable def rewardSource :
    FiniteHorizonRL.MDP.MeanCompatibleRewardKernel mdp :=
  FiniteHorizonRL.MDP.MeanCompatibleRewardKernel.deterministic mdp

def sampledBatch (sampledReward : Real) (reverse : Bool) :
    FiniteHorizonRL.StochasticEpisodeBatch mdp 2 :=
  fun episode =>
    let action : Bool := episode.val = 1
    (false, fun stage =>
      if stage.val = 0 then
        (action, (sampledReward, if reverse then !action else action))
      else
        (false, (sampledReward, false)))

def sampledHistory (sampledReward : Real) (reverse : Bool) :
    FiniteHorizonRL.StochasticEpisodeBatchPrefix mdp 2 0 :=
  fun _coordinate => sampledBatch sampledReward reverse

noncomputable def stochasticSource :=
  FiniteHorizonRL.AdaptiveStochasticEmpiricalOptimisticSource.exploratorySource
    mdp (Measure.dirac false) 2 rewardSource boolTable false 0 0 (by norm_num)

theorem projectedHistory_eq_of_reward_change (reverse : Bool) :
    FiniteHorizonRL.MDP.MeanCompatibleRewardKernel.knownRewardEpisodeBatchPrefix
        (mdp := mdp) 2 0 (sampledHistory 7 reverse) =
      FiniteHorizonRL.MDP.MeanCompatibleRewardKernel.knownRewardEpisodeBatchPrefix
        (mdp := mdp) 2 0 (sampledHistory (-3) reverse) := by
  have herase :
      FiniteHorizonRL.MDP.MeanCompatibleRewardKernel.eraseTrajectoryFamily
          (mdp := mdp) 2 (sampledBatch 7 reverse) =
        FiniteHorizonRL.MDP.MeanCompatibleRewardKernel.eraseTrajectoryFamily
          (mdp := mdp) 2 (sampledBatch (-3) reverse) := by
    funext episode
    apply Prod.ext
    · rfl
    · funext stage
      by_cases hstage : stage.val = 0 <;>
        simp [FiniteHorizonRL.MDP.MeanCompatibleRewardKernel.eraseTrajectoryFamily,
          FiniteHorizonRL.MDP.MeanCompatibleRewardKernel.eraseTrajectory,
          FiniteHorizonRL.RewardStepTrace.eraseRewards, sampledBatch, hstage]
  funext coordinate
  change
    FiniteHorizonRL.MDP.episodeBatchOfTrajectories mdp 2
        (FiniteHorizonRL.MDP.MeanCompatibleRewardKernel.eraseTrajectoryFamily
          (mdp := mdp) 2 (sampledBatch 7 reverse)) =
      FiniteHorizonRL.MDP.episodeBatchOfTrajectories mdp 2
        (FiniteHorizonRL.MDP.MeanCompatibleRewardKernel.eraseTrajectoryFamily
          (mdp := mdp) 2 (sampledBatch (-3) reverse))
  rw [herase]

theorem successorPolicy_eq_of_reward_change (reverse : Bool) :
    stochasticSource.successorPolicy 0 (sampledHistory 7 reverse) =
      stochasticSource.successorPolicy 0 (sampledHistory (-3) reverse) := by
  unfold stochasticSource
  rw [FiniteHorizonRL.AdaptiveStochasticEmpiricalOptimisticSource.exploratorySource_successorPolicy]
  rw [FiniteHorizonRL.AdaptiveStochasticEmpiricalOptimisticSource.exploratorySource_successorPolicy]
  rw [projectedHistory_eq_of_reward_change]

noncomputable def projectedSummary (reverse : Bool) :
    FiniteHorizonRL.TransitionCountSummary mdp :=
  (FiniteHorizonRL.MDP.MeanCompatibleRewardKernel.knownRewardEpisodeBatch
    (mdp := mdp) 2 (sampledBatch 7 reverse)).transitionCountSummary

theorem projectedSummary_empiricalTransitionPMF
    (reverse action : Bool) :
    (projectedSummary reverse).empiricalTransitionPMF
        false stageZero false action =
      PMF.pure (if reverse then !action else action) := by
  have hcardEq :
      ({episode : Fin 2 | episode.val = 1} : Finset (Fin 2)).card = 1 := by
    native_decide
  have hcardNe :
      ({episode : Fin 2 | ¬ episode.val = 1} : Finset (Fin 2)).card = 1 := by
    native_decide
  ext nextState
  cases reverse <;> cases action <;> cases nextState <;>
    simp [projectedSummary, sampledBatch,
      FiniteHorizonRL.MDP.MeanCompatibleRewardKernel.knownRewardEpisodeBatch,
      FiniteHorizonRL.MDP.MeanCompatibleRewardKernel.knownRewardEpisodeBatchOfStochasticTrajectories,
      FiniteHorizonRL.MDP.MeanCompatibleRewardKernel.eraseTrajectoryFamily,
      FiniteHorizonRL.MDP.MeanCompatibleRewardKernel.eraseTrajectory,
      FiniteHorizonRL.RewardStepTrace.eraseRewards,
      FiniteHorizonRL.MDP.episodeBatchOfTrajectories,
      FiniteHorizonRL.MDP.episodeStepOfTrajectory,
      FiniteHorizonRL.MDP.trajectoryStateAt,
      FiniteHorizonRL.EpisodeBatch.transitionCountSummary,
      FiniteHorizonRL.EpisodeBatch.transitionCount,
      FiniteHorizonRL.TransitionCountSummary.empiricalTransitionPMF,
      FiniteHorizonRL.TransitionCountSummary.visitCount,
      stageZero, mdp, PMF.pure_apply, hcardEq, hcardNe]

noncomputable def projectedPlan (reverse : Bool) :=
  (projectedSummary reverse).optimisticPlan mdp false 0

theorem projectedPlan_upperValueOne (reverse state : Bool) :
    (projectedPlan reverse).upperValueRemaining 1 (by simp [mdp]) state =
      if state then 1 else 0 := by
  simp [projectedPlan, FiniteHorizonRL.TransitionCountSummary.optimisticPlan,
    FiniteHorizonRL.MDP.EstimatedModelPlan.upperValueRemaining,
    FiniteHorizonRL.MDP.EstimatedModelPlan.optimisticBellman,
    FiniteHorizonRL.MDP.EstimatedModelPlan.optimisticQ,
    FiniteHorizonRL.MDP.EstimatedModelPlan.bellmanQ,
    FiniteHorizonRL.MDP.EstimatedModelPlan.transitionValue, mdp]

theorem projectedPlan_optimisticQStageZero (reverse action : Bool) :
    (projectedPlan reverse).optimisticQ stageZero
        ((projectedPlan reverse).upperValueRemaining 1 (by simp [mdp]))
        false action =
      if (if reverse then !action else action) then 1 else 0 := by
  change
    (if false then 1 else 0) +
          (∫ nextState,
            (projectedPlan reverse).upperValueRemaining 1 (by simp [mdp])
              nextState ∂
              ((projectedSummary reverse).empiricalTransitionPMF
                false stageZero false action).toMeasure) +
        0 + 0 = _
  rw [projectedSummary_empiricalTransitionPMF, PMF.toMeasure_pure]
  simp [projectedPlan_upperValueOne]

theorem projectedPlan_forwardSelectedTrue :
    (projectedPlan false).optimisticActionAt stageZero false = true := by
  by_contra hnot
  have hchosen :
      (projectedPlan false).optimisticActionAt stageZero false = false :=
    Bool.eq_false_of_not_eq_true hnot
  have hmax := (projectedPlan false).optimisticQ_le_optimisticAction
    stageZero
    ((projectedPlan false).upperValueRemaining 1 (by simp [mdp])) false true
  rw [show (projectedPlan false).optimisticAction stageZero
      ((projectedPlan false).upperValueRemaining 1 (by simp [mdp])) false =
        (projectedPlan false).optimisticActionAt stageZero false by rfl,
    hchosen] at hmax
  rw [projectedPlan_optimisticQStageZero false true,
    projectedPlan_optimisticQStageZero false false] at hmax
  norm_num at hmax

theorem projectedPlan_reverseSelectedFalse :
    (projectedPlan true).optimisticActionAt stageZero false = false := by
  by_contra hnot
  have hchosen :
      (projectedPlan true).optimisticActionAt stageZero false = true :=
    Bool.eq_true_of_not_eq_false hnot
  have hmax := (projectedPlan true).optimisticQ_le_optimisticAction
    stageZero
    ((projectedPlan true).upperValueRemaining 1 (by simp [mdp])) false false
  rw [show (projectedPlan true).optimisticAction stageZero
      ((projectedPlan true).upperValueRemaining 1 (by simp [mdp])) false =
        (projectedPlan true).optimisticActionAt stageZero false by rfl,
    hchosen] at hmax
  rw [projectedPlan_optimisticQStageZero true false,
    projectedPlan_optimisticQStageZero true true] at hmax
  norm_num at hmax

theorem projectedSuccessorTables_ne :
    FiniteHorizonRL.AdaptiveEmpiricalOptimisticSource.successorTable
        false 0 0
        (FiniteHorizonRL.MDP.MeanCompatibleRewardKernel.knownRewardEpisodeBatchPrefix
          (mdp := mdp) 2 0 (sampledHistory 7 false)) ≠
      FiniteHorizonRL.AdaptiveEmpiricalOptimisticSource.successorTable
        false 0 0
        (FiniteHorizonRL.MDP.MeanCompatibleRewardKernel.knownRewardEpisodeBatchPrefix
          (mdp := mdp) 2 0 (sampledHistory 7 true)) := by
  intro heq
  have hcoordinate := congrFun (congrFun heq stageZero) false
  change (projectedPlan false).optimisticActionAt stageZero false =
    (projectedPlan true).optimisticActionAt stageZero false at hcoordinate
  rw [projectedPlan_forwardSelectedTrue,
    projectedPlan_reverseSelectedFalse] at hcoordinate
  contradiction

end FiniteHorizonAdaptiveStochasticRewardProjectedSelectorSemanticCanary

