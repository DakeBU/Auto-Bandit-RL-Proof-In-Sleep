namespace FiniteHorizonStageVisitFactorizationCanary

local instance : MeasurableSpace Unit := ⊤
local instance : MeasurableSpace Bool := ⊤

noncomputable def mdp : FiniteHorizonRL.MDP Unit Bool where
  horizon := 2
  transition := ProbabilityTheory.Kernel.const _ (Measure.dirac ())
  transition_isMarkov := by infer_instance
  reward := fun _state _action => 0
  measurable_reward := measurable_const

noncomputable def policy : FiniteHorizonRL.MarkovPolicy mdp where
  actionKernel stage := if stage.val = 0 then
    ProbabilityTheory.Kernel.deterministic
      (fun _state => false) measurable_const
  else
    ProbabilityTheory.Kernel.const _ (PMF.uniformOfFintype Bool).toMeasure
  actionKernel_isMarkov stage := by
    split <;> infer_instance

def stageZero : Fin mdp.horizon := ⟨0, by simp [mdp]⟩
def stageOne : Fin mdp.horizon := ⟨1, by simp [mdp]⟩

theorem stageZero_actionMass_true_eq_zero :
    (policy.actionKernel stageZero () {true}).toReal = 0 := by
  change ((ProbabilityTheory.Kernel.deterministic
    (fun _state : Unit => false) measurable_const () {true}).toReal) = 0
  rw [ProbabilityTheory.Kernel.deterministic_apply]
  rw [Measure.dirac_apply' _ (measurableSet_singleton true)]
  norm_num

theorem stageOne_actionMass_true_eq_half :
    (policy.actionKernel stageOne () {true}).toReal = 1 / 2 := by
  change (((PMF.uniformOfFintype Bool).toMeasure {true}).toReal) = 1 / 2
  rw [(PMF.uniformOfFintype Bool).toMeasure_apply_singleton true
    (measurableSet_singleton true)]
  norm_num [PMF.uniformOfFintype_apply]

theorem stageStateProbability_eq_one (stage : Fin mdp.horizon) :
    policy.stageStateProbability (Measure.dirac ()) stage () = 1 := by
