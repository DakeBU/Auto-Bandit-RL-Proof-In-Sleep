example (probability : Fin 2 -> Real)
    (hprobability : FTRL.finiteSimplex Finset.univ probability) :
    Finset.univ.sum (fun action =>
        Real.sqrt (probability action) * (1 - probability action)) <=
      2 * (Finset.univ.erase (0 : Fin 2)).sum (fun action =>
        Real.sqrt (probability action)) := by
  exact Tsallis.sum_sqrt_mul_one_sub_le_two_mul_sum_erase_sqrt
    Finset.univ (by simp) probability hprobability

example (probability loss : Fin 2 -> Real)
    (hprobability : FTRL.finiteSimplex Finset.univ probability)
    (hprob : forall action : Fin 2, 0 < probability action)
    (hloss : forall action : Fin 2,
      0 <= loss action ∧ loss action <= 1) :
    Finset.univ.sum (fun chosen =>
        probability chosen *
          Tsallis.shiftedHalfPowerImportanceWeightedMoment
            Finset.univ probability loss chosen) <=
      Finset.univ.sum (fun action =>
        Real.sqrt (probability action) * (1 - probability action)) := by
  exact
    Tsallis.sum_prob_mul_shiftedHalfPowerImportanceWeightedMoment_le
      Finset.univ probability loss hprobability
      (by simpa using hprob) (by simpa using hloss)

example
    {Index : Type u} (indices : Finset Index)
    (probability coeff gap : Index -> Real)
    (regret base corruption : Real)
    (hprobability : ∀ index ∈ indices, 0 ≤ probability index)
    (hgap : ∀ index ∈ indices, 0 < gap index)
    (hselfBounding :
      indices.sum (fun index => gap index * probability index) -
          corruption ≤ regret)
    (hupper :
      regret ≤ base + indices.sum (fun index =>
        coeff index * Real.sqrt (probability index))) :
    regret ≤
      2 * base + indices.sum (fun index => coeff index ^ 2 / gap index) +
        corruption := by
  exact Tsallis.regret_le_two_mul_base_add_sum_sq_div_gap_add_corruption
    indices probability coeff gap regret base corruption
      hprobability hgap hselfBounding hupper

