def driftingTwoArmModelCanary : FiniteBanditModel 2 where
  hK := by decide
  mean := fun arm => if arm = 0 then 3 / 4 else 1 / 4

theorem driftingTwoArmModelCanary_bestArm :
    driftingTwoArmModelCanary.bestArm = 0 := by
  norm_num [FiniteBanditModel.bestArm, driftingTwoArmModelCanary,
    List.finRange]

noncomputable def driftingTwoArmLawCanary
    (t : Nat) (arm : Fin 2) : Measure Rat :=
  if Even t then
    Measure.dirac (if arm = 0 then (3 / 4 : Rat) else (1 / 4 : Rat))
  else
    Measure.dirac (1 / 2 : Rat)

example :
    driftingTwoArmLawCanary 0 0 ≠ driftingTwoArmLawCanary 1 0 := by
  intro h
  have hmass := congrArg
    (fun measure : Measure Rat =>
      integral measure (fun reward : Rat => ((reward : Rat) : Real))) h
  norm_num [driftingTwoArmLawCanary] at hmass

example (horizon : Nat) : True := by
  have _hroute :=
    Tsallis.integral_sampledScheduledHalfTsallisFiniteArmIndependentDriftingMeanRewardLawRegret_le_log
      driftingTwoArmModelCanary driftingTwoArmLawCanary
      (fun t arm => by
        simp only [driftingTwoArmLawCanary]
        split_ifs <;> infer_instance)
      (fun t arm => by
        fin_cases arm <;>
          by_cases ht : Even t <;>
          simp [driftingTwoArmLawCanary, ht] <;> norm_num)
      (fun _ _ => 1 / 4)
      (fun t arm => by
        fin_cases arm <;>
          by_cases ht : Even t <;>
          simp [Tsallis.finiteArmIndependentRewardMean,
            driftingTwoArmLawCanary, driftingTwoArmModelCanary, ht] <;>
          norm_num)
      (fun arm harm => by
        rw [driftingTwoArmModelCanary_bestArm] at harm
        fin_cases arm
        · exact (harm rfl).elim
        · rw [FiniteBanditModel.gap]
          simp only [driftingTwoArmModelCanary_bestArm]
          rw [FiniteBanditModel.bestMean,
            driftingTwoArmModelCanary_bestArm]
          norm_num [driftingTwoArmModelCanary])
      horizon
  trivial

