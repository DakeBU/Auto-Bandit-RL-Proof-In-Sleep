local instance : MeasurableSpace Bool := ⊤

noncomputable def mdp : FiniteHorizonRL.MDP Bool Bool where
  horizon := 2
  transition := ProbabilityTheory.Kernel.deterministic
    (fun pair : Bool × Bool => pair.2) measurable_snd
  transition_isMarkov := by infer_instance
  reward := fun _state _action => 0
  measurable_reward := measurable_const

noncomputable def initialState : Measure Bool :=
  (PMF.uniformOfFintype Bool).toMeasure

local instance : IsProbabilityMeasure initialState := by
  unfold initialState
