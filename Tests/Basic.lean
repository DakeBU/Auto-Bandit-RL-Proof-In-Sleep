noncomputable def twoStepMDP : FiniteHorizonRL.MDP Unit Unit where
  horizon := 2
  transition := ProbabilityTheory.Kernel.deterministic
    (fun _pair => ()) measurable_const
  transition_isMarkov := by infer_instance
  reward := fun _state _action => 0
  measurable_reward := measurable_const

noncomputable def twoStepPolicy : FiniteHorizonRL.MarkovPolicy twoStepMDP where
  actionKernel _stage := ProbabilityTheory.Kernel.deterministic
    (fun _state => ()) measurable_const
  actionKernel_isMarkov _stage := by infer_instance

noncomputable def twoStepSymmetricSource :
    FiniteHorizonRL.MDP.MeanCompatibleRewardKernel twoStepMDP where
  rewardKernel := RewardKernel.const symmetricRewardMeasure <| by
    unfold symmetricRewardMeasure
    exact Measure.isProbabilityMeasure_map
      (measurable_of_finite symmetricReward).aemeasurable
  integrable_reward := by
    intro state action
    change Integrable (fun reward : Real => reward) symmetricRewardMeasure
    unfold symmetricRewardMeasure
    apply (integrable_map_measure measurable_id.aestronglyMeasurable
      (measurable_of_finite symmetricReward).aemeasurable).2
    exact FiniteHorizonRL.integrable_of_fintype
      (PMF.uniformOfFintype Bool).toMeasure symmetricReward
      (measurable_of_finite symmetricReward)
  integral_reward_eq := by
    intro state action
    change integral symmetricRewardMeasure id = 0
    rw [symmetricRewardMeasure,
      integral_map_of_stronglyMeasurable
        (measurable_of_finite symmetricReward)
        measurable_id.stronglyMeasurable]
    rw [PMF.integral_eq_sum]
    norm_num [symmetricReward, PMF.uniformOfFintype_apply]

