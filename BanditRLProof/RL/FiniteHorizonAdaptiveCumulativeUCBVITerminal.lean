import BanditRLProof.RL.FiniteHorizonAdaptiveCumulativeUCBVIMartingaleTuning

/-!
# Canonical generated Hoeffding UCBVI-CH terminal

The terminal below uses one recurrent source, its exact `Kernel.trajMeasure`,
the confidence family proved on that law, the policy-value regret generated by
the same strict-prefix planner, and no caller-supplied confidence premise.
-/

open MeasureTheory
open scoped ENNReal ProbabilityTheory BigOperators

universe u v

namespace BanditRLProof.FiniteHorizonRL

variable {State : Type u} {Action : Type v}
    [MeasurableSpace State] [MeasurableSpace Action]
    [Fintype State] [Fintype Action]
    [DecidableEq State] [DecidableEq Action]
    [MeasurableSingletonClass State] [MeasurableSingletonClass Action]
    [Nonempty State] [Nonempty Action]

namespace AdaptiveCumulativeHoeffdingUCBVI

/-- Frozen Azar--Osband--Munos-shaped Hoeffding UCBVI-CH bound. -/
noncomputable def canonicalRegretBound
    (mdp : MDP State Action) (episodes : Nat) (delta : Real) : Real :=
  20 * (mdp.horizon : Real) * Real.sqrt mdp.horizon *
      logFactor (State := State) (Action := Action) mdp episodes delta *
      Real.sqrt
        ((Fintype.card State : Real) * Fintype.card Action * episodes) +
    250 * (mdp.horizon : Real) ^ 2 *
      (Fintype.card State : Real) ^ 2 * Fintype.card Action *
      logFactor (State := State) (Action := Action) mdp episodes delta ^ 2

theorem canonicalRegretBound_nonneg
    (mdp : MDP State Action) (episodes : Nat) (delta : Real) :
    0 <= canonicalRegretBound (State := State) (Action := Action)
      mdp episodes delta := by
  unfold canonicalRegretBound
  have hL := logFactor_nonneg (State := State) (Action := Action)
    mdp episodes delta
  positivity

noncomputable def alignmentFailureEvent
    (mdp : MDP State Action) (defaultState : State)
    (episodes : Nat) (delta : Real) :
    Set (EpisodeBatchTrajectory mdp 1) :=
  {trajectory | ∃ n, n + 1 < episodes ∧
    ¬ SuccessorBatchAligned mdp defaultState episodes delta trajectory n}

/-- Complete terminal failure set: same-source confidence, Bellman innovation,
and the measure-zero generated-record alignment complement. -/
noncomputable def canonicalFailureEvent
    {mdp : MDP State Action} {initialState : Measure State}
    [IsProbabilityMeasure initialState]
    (defaultState : State) (episodes : Nat) (delta : Real) :
    Set (EpisodeBatchTrajectory mdp 1) :=
  let source := recurrentSource mdp initialState defaultState episodes delta
  AdaptiveEpisodeBatchSource.simultaneousTransitionFailureEvent source episodes
      (logFactor (State := State) (Action := Action) mdp episodes delta) ∪
    {trajectory |
      bellmanInnovationThreshold (State := State) (Action := Action)
            mdp episodes delta <=
        (Finset.range episodes).sum (fun round =>
          recurrentBellmanInnovationProcess mdp defaultState episodes delta
            round trajectory)} ∪
    alignmentFailureEvent mdp defaultState episodes delta

theorem recurrentSource_trajectoryMeasure_alignmentFailureEvent_eq_zero
    (mdp : MDP State Action) (initialState : Measure State)
    [IsProbabilityMeasure initialState]
    (defaultState : State) (episodes : Nat) (delta : Real)
    (hhorizon : 0 < mdp.horizon) :
    (recurrentSource mdp initialState defaultState episodes delta).trajectoryMeasure
        (alignmentFailureEvent mdp defaultState episodes delta) = 0 := by
  unfold alignmentFailureEvent
  let μ :=
    (recurrentSource mdp initialState defaultState episodes delta).trajectoryMeasure
  have hnull : μ {trajectory |
      ¬ ∀ n, SuccessorBatchAligned mdp defaultState episodes delta trajectory n} = 0 := by
    rw [← ae_iff]
    exact recurrentSource_trajectoryMeasure_all_successorBatchAligned_ae
      mdp initialState defaultState episodes delta hhorizon
  apply measure_mono_null (t := {trajectory |
      ¬ ∀ n, SuccessorBatchAligned mdp defaultState episodes delta trajectory n})
    _ hnull
  intro trajectory htrajectory
  simp only [Set.mem_setOf_eq, not_forall]
  obtain ⟨n, _hn, hnot⟩ := htrajectory
  exact ⟨n, hnot⟩

/-- The complete generated terminal failure set costs at most `delta`. -/
theorem recurrentSource_trajectoryMeasure_canonicalFailureEvent_le
    (mdp : MDP State Action) (initialState : Measure State)
    [IsProbabilityMeasure initialState]
    [StandardBorelSpace (EpisodeBatch mdp 1)]
    [StandardBorelSpace (EpisodeBatchTrajectory mdp 1)]
    (defaultState : State) (episodes : Nat) (delta : Real)
    (hhorizon : 0 < mdp.horizon) (hepisodes : 0 < episodes)
    (hdelta : 0 < delta) (hdelta_le_one : delta <= 1)
    (hrewardNonneg : ∀ state action, 0 <= mdp.reward state action)
    (hrewardOne : ∀ state action, mdp.reward state action <= 1) :
    (recurrentSource mdp initialState defaultState episodes delta).trajectoryMeasure
        (canonicalFailureEvent (initialState := initialState)
          defaultState episodes delta) <= ENNReal.ofReal delta := by
  let source := recurrentSource mdp initialState defaultState episodes delta
  let transitionBad :=
    AdaptiveEpisodeBatchSource.simultaneousTransitionFailureEvent source episodes
      (logFactor (State := State) (Action := Action) mdp episodes delta)
  let innovationBad : Set (EpisodeBatchTrajectory mdp 1) :=
    {trajectory |
      bellmanInnovationThreshold (State := State) (Action := Action)
            mdp episodes delta <=
        (Finset.range episodes).sum (fun round =>
          recurrentBellmanInnovationProcess mdp defaultState episodes delta
            round trajectory)}
  let alignmentBad := alignmentFailureEvent mdp defaultState episodes delta
  have hreward : ∀ state action, |mdp.reward state action| <= 1 := by
    intro state action
    rw [abs_of_nonneg (hrewardNonneg state action)]
    exact hrewardOne state action
  have htransition : source.trajectoryMeasure transitionBad <=
      ENNReal.ofReal (delta / 5) := by
    exact recurrentSource_trajectoryMeasure_simultaneousTransitionFailureEvent_le_fifth
      mdp initialState defaultState episodes delta hhorizon hepisodes hdelta
        hdelta_le_one hreward
  have hinnovation : source.trajectoryMeasure innovationBad <=
      ENNReal.ofReal (delta / 5) := by
    exact recurrentSource_trajectoryMeasure_bellmanInnovation_sum_ge_threshold_le_fifth
      mdp initialState defaultState episodes delta hhorizon hepisodes
        hdelta hdelta_le_one
  have halignment : source.trajectoryMeasure alignmentBad = 0 :=
    recurrentSource_trajectoryMeasure_alignmentFailureEvent_eq_zero
      mdp initialState defaultState episodes delta hhorizon
  unfold canonicalFailureEvent
  change source.trajectoryMeasure (transitionBad ∪ innovationBad ∪ alignmentBad) <= _
  calc
    _ <= source.trajectoryMeasure transitionBad +
        source.trajectoryMeasure innovationBad +
        source.trajectoryMeasure alignmentBad := by
      exact (measure_union_le _ _).trans
        (add_le_add_left (measure_union_le _ _) _)
    _ <= ENNReal.ofReal (delta / 5) + ENNReal.ofReal (delta / 5) + 0 := by
      exact add_le_add (add_le_add htransition hinnovation) halignment.le
    _ = ENNReal.ofReal (2 * delta / 5) := by
      have hfifth : 0 <= delta / 5 := div_nonneg hdelta.le (by norm_num)
      rw [add_zero, ← ENNReal.ofReal_add hfifth hfifth]
      congr 1
      ring
    _ <= ENNReal.ofReal delta := by
      apply ENNReal.ofReal_le_ofReal
      nlinarith

private theorem sum_shift_recurrentBellmanInnovation_eq
    (mdp : MDP State Action) (defaultState : State)
    (episodes : Nat) (delta : Real)
    (trajectory : EpisodeBatchTrajectory mdp 1) :
    (Finset.range (episodes - 1)).sum (fun n =>
        recurrentBellmanInnovationProcess mdp defaultState episodes delta
          (n + 1) trajectory) =
      (Finset.range episodes).sum (fun round =>
        recurrentBellmanInnovationProcess mdp defaultState episodes delta
          round trajectory) := by
  cases episodes with
  | zero => simp
  | succ episodes =>
      rw [Nat.add_sub_cancel, Finset.sum_range_succ']
      simp [recurrentBellmanInnovationProcess,
        recurrentBellmanInnovationPrefix]

theorem sqrt_totalSteps_mul_card_eq_paper
    (mdp : MDP State Action) (episodes : Nat) :
    Real.sqrt (totalSteps mdp episodes : Nat) *
        Real.sqrt ((Fintype.card State * Fintype.card Action : Nat) : Real) =
      Real.sqrt mdp.horizon *
        Real.sqrt
          ((Fintype.card State : Real) * Fintype.card Action * episodes) := by
  rw [← Real.sqrt_mul (Nat.cast_nonneg (totalSteps mdp episodes))]
  rw [← Real.sqrt_mul (Nat.cast_nonneg mdp.horizon)]
  congr 1
  simp only [totalSteps, Nat.cast_mul]
  ring

/-- Pathwise generated regret bound outside the proved terminal failure set. -/
theorem cumulativeEpisodePseudoRegret_le_canonicalRegretBound_of_not_mem
    (mdp : MDP State Action) (initialState : Measure State)
    [IsProbabilityMeasure initialState]
    (defaultState : State) (episodes : Nat) (delta : Real)
    (hhorizon : 0 < mdp.horizon) (hepisodes : 0 < episodes)
    (hdelta : 0 < delta) (hdelta_le_one : delta <= 1)
    (hrewardNonneg : ∀ state action, 0 <= mdp.reward state action)
    (hrewardOne : ∀ state action, mdp.reward state action <= 1)
    (trajectory : EpisodeBatchTrajectory mdp 1)
    (htrajectory : trajectory ∉ canonicalFailureEvent
      (initialState := initialState) defaultState episodes delta) :
    cumulativeEpisodePseudoRegret
        (recurrentSource mdp initialState defaultState episodes delta)
        defaultState episodes trajectory <=
      canonicalRegretBound (State := State) (Action := Action)
        mdp episodes delta := by
  let source := recurrentSource mdp initialState defaultState episodes delta
  let L := logFactor (State := State) (Action := Action) mdp episodes delta
  let transitionBad :=
    AdaptiveEpisodeBatchSource.simultaneousTransitionFailureEvent source episodes L
  let innovationSum := (Finset.range episodes).sum (fun round =>
    recurrentBellmanInnovationProcess mdp defaultState episodes delta
      round trajectory)
  have htransition : trajectory ∉ transitionBad := by
    intro h
    apply htrajectory
    exact Set.mem_union_left _ (Set.mem_union_left _ h)
  have hinnovation : innovationSum <
      bellmanInnovationThreshold (State := State) (Action := Action)
        mdp episodes delta := by
    apply lt_of_not_ge
    intro h
    apply htrajectory
    exact Set.mem_union_left _ (Set.mem_union_right _ h)
  have haligned : ∀ n, n + 1 < episodes →
      SuccessorBatchAligned mdp defaultState episodes delta trajectory n := by
    intro n hn
    by_contra h
    apply htrajectory
    exact Set.mem_union_right _ ⟨n, hn, h⟩
  have hzero := (generatedEpisodePseudoRegret_mem_Icc source defaultState
    trajectory 0 hrewardNonneg hrewardOne).2
  have hsuccessor :
      (Finset.range (episodes - 1)).sum (fun n =>
        generatedEpisodePseudoRegret source defaultState trajectory (n + 1)) <=
      bellmanWeightCap *
        ((Finset.range (episodes - 1)).sum (fun n =>
            successorCanonicalWeightedCharge mdp defaultState episodes delta
              trajectory n) +
          (Finset.range (episodes - 1)).sum (fun n =>
            recurrentBellmanInnovationProcess mdp defaultState episodes delta
              (n + 1) trajectory)) := by
    calc
      _ <= (Finset.range (episodes - 1)).sum (fun n =>
          bellmanWeightCap *
            (successorCanonicalWeightedCharge mdp defaultState episodes delta
                trajectory n +
              recurrentBellmanInnovationProcess mdp defaultState episodes delta
                (n + 1) trajectory)) := by
        apply Finset.sum_le_sum
        intro n hn
        exact AdaptiveEpisodeBatchSource.recurrentSource_generatedSuccessorPseudoRegret_le_charge_add_innovation
          initialState hhorizon hepisodes hdelta hdelta_le_one
          hrewardNonneg hrewardOne defaultState htransition n
          (by have := Finset.mem_range.mp hn; omega)
      _ = _ := by rw [← Finset.mul_sum, Finset.sum_add_distrib]
  have hcharge := sum_successorCanonicalWeightedCharge_le_totalGeneratedPairCharge
    hhorizon haligned
  have htotal := totalGeneratedPairCharge_le_explicit mdp episodes delta trajectory
    hhorizon hepisodes hdelta hdelta_le_one
  have hcap : 0 <= bellmanWeightCap := by norm_num [bellmanWeightCap]
  have hinterior :
      (Finset.range (episodes - 1)).sum (fun n =>
          successorCanonicalWeightedCharge mdp defaultState episodes delta
            trajectory n) +
        (Finset.range (episodes - 1)).sum (fun n =>
          recurrentBellmanInnovationProcess mdp defaultState episodes delta
            (n + 1) trajectory) <=
      (18 * (mdp.horizon : Real) * L *
          (Real.sqrt (totalSteps mdp episodes : Nat) *
            Real.sqrt ((Fintype.card State * Fintype.card Action : Nat) : Real)) +
        238 * (Fintype.card State : Real) ^ 2 * Fintype.card Action *
          (mdp.horizon : Real) ^ 2 * L ^ 2) +
        bellmanInnovationThreshold (State := State) (Action := Action)
          mdp episodes delta := by
    rw [sum_shift_recurrentBellmanInnovation_eq]
    exact add_le_add (hcharge.trans htotal) hinnovation.le
  have hcumulative :
      cumulativeEpisodePseudoRegret source defaultState episodes trajectory <=
        (mdp.horizon : Real) + bellmanWeightCap *
          ((18 * (mdp.horizon : Real) * L *
              (Real.sqrt (totalSteps mdp episodes : Nat) *
                Real.sqrt ((Fintype.card State * Fintype.card Action : Nat) : Real)) +
            238 * (Fintype.card State : Real) ^ 2 * Fintype.card Action *
              (mdp.horizon : Real) ^ 2 * L ^ 2) +
            bellmanInnovationThreshold (State := State) (Action := Action)
              mdp episodes delta) := by
    cases episodes with
    | zero => simp at hepisodes
    | succ episodes =>
        unfold cumulativeEpisodePseudoRegret
        rw [Fin.sum_univ_eq_sum_range, Finset.sum_range_succ']
        simpa [Nat.add_sub_cancel, add_comm] using
          add_le_add
            (hsuccessor.trans (mul_le_mul_of_nonneg_left hinterior hcap))
            hzero
  have hH : (1 : Real) <= mdp.horizon := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr hhorizon.ne'
  have hS : (1 : Real) <= Fintype.card State := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Fintype.card_ne_zero (α := State))
  have hA : (1 : Real) <= Fintype.card Action := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Fintype.card_ne_zero (α := Action))
  have hL : 1 <= L := one_le_logFactor mdp episodes delta
    hhorizon hepisodes hdelta hdelta_le_one
  rw [sqrt_totalSteps_mul_card_eq_paper] at hcumulative
  have hsqrtS : (1 : Real) <= Real.sqrt (Fintype.card State) :=
    Real.one_le_sqrt.mpr hS
  have hsqrtA : (1 : Real) <= Real.sqrt (Fintype.card Action) :=
    Real.one_le_sqrt.mpr hA
  have hsqrtSA : (1 : Real) <=
      Real.sqrt (Fintype.card State) * Real.sqrt (Fintype.card Action) := by
    simpa only [one_mul] using
      (mul_le_mul hsqrtS hsqrtA (by norm_num : (0 : Real) <= 1)
        (Real.sqrt_nonneg _))
  have hroot :
      Real.sqrt ((mdp.horizon : Real) * episodes) <=
        Real.sqrt mdp.horizon *
          Real.sqrt
            ((Fintype.card State : Real) * Fintype.card Action * episodes) := by
    rw [Real.sqrt_mul (Nat.cast_nonneg mdp.horizon)]
    rw [Real.sqrt_mul
      (mul_nonneg (Nat.cast_nonneg (Fintype.card State))
        (Nat.cast_nonneg (Fintype.card Action)))]
    rw [Real.sqrt_mul (Nat.cast_nonneg (Fintype.card State))]
    have hepisodeRoot : Real.sqrt (episodes : Real) <=
        (Real.sqrt (Fintype.card State) * Real.sqrt (Fintype.card Action)) *
          Real.sqrt episodes := by
      simpa only [one_mul] using
        mul_le_mul_of_nonneg_right hsqrtSA (Real.sqrt_nonneg _)
    exact mul_le_mul_of_nonneg_left hepisodeRoot (Real.sqrt_nonneg _)
  have hthreshold :
      bellmanInnovationThreshold (State := State) (Action := Action)
          mdp episodes delta <=
        (11 / 8 : Real) * mdp.horizon *
          (Real.sqrt mdp.horizon *
            Real.sqrt
              ((Fintype.card State : Real) * Fintype.card Action * episodes)) *
          logFactor (State := State) (Action := Action)
            mdp episodes delta := by
    unfold bellmanInnovationThreshold
    exact mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_left hroot
        (mul_nonneg (by norm_num) (Nat.cast_nonneg mdp.horizon)))
      (logFactor_nonneg mdp episodes delta)
  have hbase :
      (mdp.horizon : Real) <=
        (mdp.horizon : Real) ^ 2 *
          (Fintype.card State : Real) ^ 2 * Fintype.card Action *
          logFactor (State := State) (Action := Action)
            mdp episodes delta ^ 2 := by
    have hH2 : (mdp.horizon : Real) <= (mdp.horizon : Real) ^ 2 := by
      nlinarith [sq_nonneg ((mdp.horizon : Real) - 1)]
    have hS2 : (1 : Real) <= (Fintype.card State : Real) ^ 2 := by
      nlinarith [sq_nonneg ((Fintype.card State : Real) - 1)]
    have hSA : (1 : Real) <=
        (Fintype.card State : Real) ^ 2 * Fintype.card Action := by
      simpa only [one_mul] using
        (mul_le_mul hS2 hA (by norm_num : (0 : Real) <= 1)
          (sq_nonneg (Fintype.card State : Real)))
    have hL2 : (1 : Real) <=
        logFactor (State := State) (Action := Action)
          mdp episodes delta ^ 2 := by
      nlinarith [sq_nonneg (logFactor (State := State) (Action := Action)
        mdp episodes delta - 1)]
    have hscale : (1 : Real) <=
        (Fintype.card State : Real) ^ 2 * Fintype.card Action *
          logFactor (State := State) (Action := Action)
            mdp episodes delta ^ 2 := by
      simpa only [one_mul] using
        (mul_le_mul hSA hL2 (by norm_num : (0 : Real) <= 1)
          (mul_nonneg (sq_nonneg (Fintype.card State : Real))
            (by positivity : (0 : Real) <= Fintype.card Action)))
    calc
      (mdp.horizon : Real) <= (mdp.horizon : Real) ^ 2 := hH2
      _ = (mdp.horizon : Real) ^ 2 * 1 := by ring
      _ <= (mdp.horizon : Real) ^ 2 *
          ((Fintype.card State : Real) ^ 2 * Fintype.card Action *
            logFactor (State := State) (Action := Action)
              mdp episodes delta ^ 2) :=
        mul_le_mul_of_nonneg_left hscale (sq_nonneg _)
      _ = _ := by ring
  have hcumulative' :
      cumulativeEpisodePseudoRegret source defaultState episodes trajectory <=
        (mdp.horizon : Real) + bellmanWeightCap *
          ((18 * (mdp.horizon : Real) * L *
              (Real.sqrt mdp.horizon *
                Real.sqrt
                  ((Fintype.card State : Real) * Fintype.card Action * episodes)) +
            238 * (Fintype.card State : Real) ^ 2 * Fintype.card Action *
              (mdp.horizon : Real) ^ 2 * L ^ 2) +
            (11 / 8 : Real) * mdp.horizon *
              (Real.sqrt mdp.horizon *
                Real.sqrt
                  ((Fintype.card State : Real) * Fintype.card Action * episodes)) *
              logFactor (State := State) (Action := Action)
                mdp episodes delta) := by
    exact hcumulative.trans <| add_le_add le_rfl
      (mul_le_mul_of_nonneg_left (add_le_add le_rfl hthreshold) hcap)
  unfold canonicalRegretBound
  dsimp [source, L] at hcumulative' ⊢
  norm_num [bellmanWeightCap] at hcumulative' ⊢
  ring_nf at hcumulative' ⊢
  nlinarith

/-- Canonical generated-policy high-probability regret terminal. -/
theorem recurrentSource_trajectoryMeasure_cumulativeEpisodePseudoRegret_gt_canonicalRegretBound_le
    (mdp : MDP State Action) (initialState : Measure State)
    [IsProbabilityMeasure initialState]
    [StandardBorelSpace (EpisodeBatch mdp 1)]
    [StandardBorelSpace (EpisodeBatchTrajectory mdp 1)]
    (defaultState : State) (episodes : Nat) (delta : Real)
    (hhorizon : 0 < mdp.horizon) (hepisodes : 0 < episodes)
    (hdelta : 0 < delta) (hdelta_le_one : delta <= 1)
    (hrewardNonneg : ∀ state action, 0 <= mdp.reward state action)
    (hrewardOne : ∀ state action, mdp.reward state action <= 1) :
    let source := recurrentSource mdp initialState defaultState episodes delta
    source.trajectoryMeasure
        {trajectory |
          canonicalRegretBound (State := State) (Action := Action)
              mdp episodes delta <
            cumulativeEpisodePseudoRegret source defaultState episodes trajectory} <=
      ENNReal.ofReal delta := by
  dsimp only
  let source := recurrentSource mdp initialState defaultState episodes delta
  calc
    source.trajectoryMeasure
        {trajectory |
          canonicalRegretBound (State := State) (Action := Action)
              mdp episodes delta <
            cumulativeEpisodePseudoRegret source defaultState episodes trajectory} <=
      source.trajectoryMeasure
        (canonicalFailureEvent (initialState := initialState)
          defaultState episodes delta) := by
        apply measure_mono
        intro trajectory hbad
        by_contra hnot
        have hgood := cumulativeEpisodePseudoRegret_le_canonicalRegretBound_of_not_mem
          mdp initialState defaultState episodes delta hhorizon hepisodes
            hdelta hdelta_le_one hrewardNonneg hrewardOne trajectory hnot
        exact (not_lt_of_ge hgood) hbad
    _ <= ENNReal.ofReal delta :=
      recurrentSource_trajectoryMeasure_canonicalFailureEvent_le
        mdp initialState defaultState episodes delta hhorizon hepisodes
          hdelta hdelta_le_one hrewardNonneg hrewardOne

end AdaptiveCumulativeHoeffdingUCBVI
end BanditRLProof.FiniteHorizonRL
