-/
theorem sum_range_min_prefix_update_le_two_trace_average_dim_scaled
    {Feature : Type u} [Fintype Feature] [DecidableEq Feature] [Nonempty Feature]
    (lambda : Real) (hlambda : 0 < lambda)
