/--
Timewise measurable reward traces give raw reward a.e. measurability after
casting `Rat` rewards to `Real`.
-/
theorem rawReward_succ_aemeasurable_of_measurable_reward
    {Omega : Type u} [mOmega : MeasurableSpace Omega]
    (mu : MeasureTheory.Measure Omega)
