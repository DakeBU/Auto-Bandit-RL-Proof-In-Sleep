              (defaultAction := defaultAction) (reward := reward)
              hreward source.definitional_map_source.hstate)
            hreward).le i))) := by
  exact
    actionRewardPartialTrajectoryKernel_map_eq_historyFiltrationSucc_finitePairHistoryOfTrace_of_generatedActionRandomPairCenteredSource
      (mu := mu)
      (action :=
        generatedActionFromRewardHistory policy state defaultAction reward)
