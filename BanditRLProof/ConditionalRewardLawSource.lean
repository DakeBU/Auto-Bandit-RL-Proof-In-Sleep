    (hraw :
      forall i : Nat, forall omega : Omega,
        Set.Icc (rewardLo i) (rewardHi i)
          (((reward omega (i + 1) : Rat) : Real)))
    (hmean_range :
      forall i : Nat, forall context : Context, forall action : Action,
        Set.Icc (meanLo i) (meanHi i)
          (((mean context action : Rat) : Real)))
    (i : Nat) :
    MeasureTheory.Integrable
      (fun omega : Omega =>
        (((reward omega (i + 1) -
          mean
            (context i
              (History.finiteRewardHistoryOfTrace (reward omega) i))
            ((policy i).action
              (state i
                (History.finiteRewardHistoryOfTrace (reward omega) i))) :
          Rat) : Real))) mu := by
  have hraw_aemeasurable :
      AEMeasurable
        (fun omega : Omega =>
          (((reward omega (i + 1) : Rat) : Real))) mu :=
    rawReward_succ_aemeasurable_of_measurable_reward
      (mu := mu) (reward := reward) hreward i
  have hmean_aemeasurable :
      AEMeasurable
        (fun omega : Omega =>
          (((mean
            (context i
              (History.finiteRewardHistoryOfTrace (reward omega) i))
            ((policy i).action
              (state i
                (History.finiteRewardHistoryOfTrace (reward omega) i))) :
            Rat) : Real))) mu :=
    selectedMean_succ_aemeasurable_of_measurable_mean
      (mu := mu)
      (policy := policy)
      (context := context)
      (state := state)
      (mean := mean)
      (reward := reward)
      (hreward := hreward)
      (hcontext := hcontext)
      (hstate := hstate)
      (hmean := hmean)
      i
  have hcenter_aemeasurable :
      AEMeasurable
        (fun omega : Omega =>
          (((reward omega (i + 1) -
            mean
              (context i
                (History.finiteRewardHistoryOfTrace (reward omega) i))
              ((policy i).action
                (state i
                  (History.finiteRewardHistoryOfTrace (reward omega) i))) :
            Rat) : Real))) mu := by
    simpa [Rat.cast_sub] using hraw_aemeasurable.sub hmean_aemeasurable
  have hraw_bound :
      Filter.Eventually
        (fun omega : Omega =>
          Set.Icc (rewardLo i) (rewardHi i)
            (((reward omega (i + 1) : Rat) : Real)))
        (ae mu) :=
    rawReward_succ_bound_of_reward_range_bound
      (mu := mu) (reward := reward)
      (rewardLo := rewardLo) (rewardHi := rewardHi)
      hraw i
  have hmean_bound :
      Filter.Eventually
        (fun omega : Omega =>
          Set.Icc (meanLo i) (meanHi i)
            (((mean
              (context i
                (History.finiteRewardHistoryOfTrace (reward omega) i))
              ((policy i).action
                (state i
                  (History.finiteRewardHistoryOfTrace (reward omega) i))) :
              Rat) : Real)))
        (ae mu) :=
    selectedMean_succ_bound_of_mean_range_bound
      (mu := mu)
      (policy := policy)
      (context := context)
      (state := state)
      (mean := mean)
      (reward := reward)
      (meanLo := meanLo)
      (meanHi := meanHi)
      hmean_range i
  have hcenter_bound :
      Filter.Eventually
        (fun omega : Omega =>
          Set.Icc (rewardLo i - meanHi i) (rewardHi i - meanLo i)
            (((reward omega (i + 1) -
              mean
                (context i
                  (History.finiteRewardHistoryOfTrace (reward omega) i))
                ((policy i).action
                  (state i
                    (History.finiteRewardHistoryOfTrace (reward omega) i))) :
              Rat) : Real)))
        (ae mu) := by
    filter_upwards [hraw_bound, hmean_bound]
      with omega hreward_bound hmean_bound
    constructor
    · have hraw_lo :
          rewardLo i <= (((reward omega (i + 1) : Rat) : Real)) :=
        hreward_bound.1
      have hmean_hi :
          (((mean
            (context i
              (History.finiteRewardHistoryOfTrace (reward omega) i))
            ((policy i).action
              (state i
                (History.finiteRewardHistoryOfTrace (reward omega) i))) :
            Rat) : Real)) <= meanHi i :=
        hmean_bound.2
      rw [Rat.cast_sub]
      linarith
    · have hraw_hi :
          (((reward omega (i + 1) : Rat) : Real)) <= rewardHi i :=
        hreward_bound.2
      have hmean_lo :
          meanLo i <=
            (((mean
              (context i
                (History.finiteRewardHistoryOfTrace (reward omega) i))
              ((policy i).action
                (state i
                  (History.finiteRewardHistoryOfTrace (reward omega) i))) :
              Rat) : Real)) :=
        hmean_bound.1
      rw [Rat.cast_sub]
      linarith
  exact
    MeasureTheory.Integrable.of_mem_Icc
      (rewardLo i - meanHi i) (rewardHi i - meanLo i)
      hcenter_aemeasurable hcenter_bound

