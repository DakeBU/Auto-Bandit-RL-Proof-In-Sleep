obtain the full finite-pair-trace `partialTraj` law.
-/
theorem actionRewardPartialTrajectoryKernel_map_eq_historyFiltrationSucc_finitePairHistoryOfTrace_of_generatedActionRandomPairDefinitionalCenteredSource
    {Omega : Type u} {Context : Type v} {State : Type w} {Action : Type x}
    [mOmega : MeasurableSpace Omega] [StandardBorelSpace Omega]
