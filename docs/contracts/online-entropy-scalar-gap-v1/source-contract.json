      "declaration": {
        "utf8_text": "theorem scalarGap_curvature (u : ℝ) (hu : 0 < u) :\n    HasDerivAt scalarGap (Real.log u - 1 - 1 / u + 8 / (u + 1)^2) u ∧\n    HasDerivAt (deriv scalarGap)\n      ((u - 1)^2 * (u^2 + 6*u + 1) / (u^2 * (u + 1)^3)) u ∧\n    0 ≤ deriv (deriv scalarGap) u ∧ (deriv (deriv scalarGap) u = 0 ↔ u = 1)\n",
        "bytes": 302,
