      "declaration": {
        "utf8_text": "theorem positive_pair_log_ratio (x y : ℝ) (hx : 0 < x) (hy : 0 < y) :\n    2 * (x-y)^2 / (x+y) ≤ (x-y) * (Real.log x - Real.log y) ∧\n    (x = y → 2 * (x-y)^2 / (x+y) = (x-y) * (Real.log x - Real.log y))\n",
